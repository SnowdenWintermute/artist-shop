@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Utilities
@rendermode InteractiveServer
@inject IJSRuntime JS
@implements IAsyncDisposable

@code {
  [Parameter, EditorRequired]
  public string FieldName { get; set; } = default!;
  [Parameter, EditorRequired]
  public string PrimaryFieldName { get; set; } = default!;

  // what the form already holds: an artwork's saved images on the edit page, and on either page
  // whatever was posted by a submit that came back with an error. A List, not IReadOnlyList: an
  // island parameter is rebuilt from its runtime type, and a collection expression's type is one
  // the compiler made, which JSON can't create
  [Parameter]
  public List<ArtworkImage> SelectedImages { get; set; } = [];
  [Parameter]
  public string? SelectedPrimaryImageKey { get; set; }

  [Parameter]
  public string? SuggestNameInto { get; set; }

  private ImageListState _state = new([], MainImageKey: null, IsUploading: false);

  protected override void OnInitialized() => _state = new ImageListState(SelectedImages, SelectedPrimaryImageKey, IsUploading: false);

  // the page closed, so there is no name field left to fill in
  private async Task FirstFileSelectedAsync(string fileName)
  {
    try
    {
      if (SuggestNameInto is not null && _module is not null)
      {
        await _module.InvokeVoidAsync("fillInputIfEmpty", SuggestNameInto, FileNameStringUtils.NameFromFileName(fileName));
      }
    }
    catch (JSDisconnectedException)
    {
    }
  }

  private IJSObjectReference? _module;

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    // the page closed before the script loaded; it only ever fills in a field on the page
    try
    {
      if (firstRender)
      {
        _module = await JS.InvokeAsync<IJSObjectReference>(
          "import",
          "./Components/Forms/FileUpload/Images/ImagesField.razor.js"
        );
      }
    }
    catch (JSDisconnectedException)
    {
    }
  }

  public async ValueTask DisposeAsync()
  {
    try
    {
      if (_module is not null)
      {
        await _module.DisposeAsync();
      }
    }
    catch (JSDisconnectedException)
    {
    }
  }
}

@* a submit clicked while uploading waits for it (static-form-submit.js), so the images still
   processing are posted with the form *@
<div class="mb-4" data-pending="@_state.IsUploading">
  @* only the controls: the hidden inputs below must stay enabled, since a disabled input posts nothing *@
  <DisabledUntilInteractive>
    <ImageListEditor SavedImages="SelectedImages" SavedMainImageKey="@SelectedPrimaryImageKey" StarName="@PrimaryFieldName"
                     OnChanged="state => _state = state" OnFirstFileSelected="FirstFileSelectedAsync" />
  </DisabledUntilInteractive>

  @for (var index = 0; index < _state.Images.Count; index++)
  {
    var image = _state.Images[index];

    <input type="hidden" name="@($"{FieldName}[{index}].StorageKey")" value="@image.StorageKey" />
    <input type="hidden" name="@($"{FieldName}[{index}].OriginalFileName")" value="@image.OriginalFileName" />
    <input type="hidden" name="@($"{FieldName}[{index}].Width")" value="@image.Width" />
    <input type="hidden" name="@($"{FieldName}[{index}].Height")" value="@image.Height" />
    <input type="hidden" name="@($"{FieldName}[{index}].BlurDataUri")" value="@image.BlurDataUri" />
  }
</div>
