@using ArtistShop.Web.Components.Atoms
@using BlazorBlueprint.Primitives.Progress
@code {
  [Parameter, EditorRequired]
  public SelectedImage SelectedImage { get; set; } = default!;

  private string StatusLabel =>
  SelectedImage.Error is not null ? SelectedImage.Error
  : SelectedImage.Result is not null ? "Done"
  : SelectedImage.UploadPercentComplete is 100 ? "Processing…"
  : $"{SelectedImage.UploadPercentComplete}%";
}

@* the placeholder holds the box while the upload runs, so the row doesn't jump when the
   image lands *@
<ArtworkThumbnail Image="SelectedImage.Result" />

<div class="grow">
  <div class="mb-1 flex justify-between">
    <span>@SelectedImage.Name</span>
    <span>@StatusLabel</span>
  </div>

  @if (SelectedImage.Error is null && SelectedImage.Result is null)
  {
    <BbProgress Value="SelectedImage.UploadPercentComplete" Max="100" class="block h-1 bg-gray-200">
      <BbProgressIndicator class="block h-1 bg-blue-500" style="@($"width: {SelectedImage.UploadPercentComplete}%")" />
    </BbProgress>
  }
</div>
