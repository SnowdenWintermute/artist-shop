@using ArtistShop.Web.Components.Atoms
@using BlazorBlueprint.Primitives.Progress
@code {
  [Parameter, EditorRequired]
  public SelectedImage SelectedImage { get; set; } = default!;

  // null once the image is in: its thumbnail shows that
  private string? StatusLabel =>
  SelectedImage.Error is not null ? SelectedImage.Error
  : SelectedImage.Result is not null ? null
  : SelectedImage.UploadPercentComplete is 100 ? "Processing…"
  : $"{SelectedImage.UploadPercentComplete}%";
}

@* the placeholder holds the box while the upload runs, so the row doesn't jump when the
   image lands *@
<WorkThumbnail Image="SelectedImage.Result" />

@* data-failed: a submit that waited for uploads doesn't post while a row has it (static-form-submit.js) *@
@* min-w-0: a flex item is otherwise as wide as its content, and a long name would widen the row
   past the screen instead of being cut short *@
<div class="min-w-0 grow" data-failed="@(SelectedImage.Error is not null)">
  <div class="mb-1 flex justify-between gap-2">
    <span class="truncate" title="@SelectedImage.Name">@SelectedImage.Name</span>
    @if (StatusLabel is { } statusLabel)
    {
      @* can wrap, since an error can be a sentence *@
      <span class="text-right">@statusLabel</span>
    }
  </div>

  @if (SelectedImage.Error is null && SelectedImage.Result is null)
  {
    <BbProgress Value="SelectedImage.UploadPercentComplete" Max="100" class="block h-1 bg-placeholder">
      <BbProgressIndicator class="block h-1 bg-accent" style="@($"width: {SelectedImage.UploadPercentComplete}%")" />
    </BbProgress>
  }
</div>
