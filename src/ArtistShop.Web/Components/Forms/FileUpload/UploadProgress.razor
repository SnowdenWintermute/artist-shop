@using ArtistShop.Web.Components.Atoms
@using BlazorBlueprint.Primitives.Progress
@* an upload run under way: a bar of the bytes sent, and Stop when there is one *@

@code {
  [Parameter, EditorRequired]
  public int PercentComplete { get; set; }

  // none for a run whose stopping would leave things half done, such as works already added
  [Parameter]
  public EventCallback OnStop { get; set; }

  // more about the run, like how many images are in
  [Parameter]
  public string? Detail { get; set; }
}

<div class="mb-4">
  <BbProgress Value="PercentComplete" Max="100" class="mb-2 block h-1 bg-placeholder">
    <BbProgressIndicator class="block h-1 bg-accent" style="@($"width: {PercentComplete}%")" />
  </BbProgress>

  @* at 100 every byte is sent, but the server is still making the last images' web copies *@
  <p class="mb-2 text-sm">
    @(PercentComplete == 100 ? "Processing the last images…" : $"Uploading… {PercentComplete}%")
    @if (Detail is not null)
    {
      <span>&nbsp</span><span>@Detail</span>
    }
  </p>

  @if (OnStop.HasDelegate)
  {
    <ButtonBasic type="button" Variant="ButtonVariant.Outline" @onclick="OnStop">Stop</ButtonBasic>
  }
</div>
