@using ArtistShop.Web.Components.Atoms

@code {
  [Parameter, EditorRequired]
  public string Prompt { get; set; } = default!;
  [Parameter, EditorRequired]
  public string ButtonLabel { get; set; } = default!;

  // set this to also offer a folder picker. A webkitdirectory input's dialog can only choose
  // folders, so picking loose files and picking a folder need separate inputs and separate buttons
  [Parameter]
  public string? DirectoryButtonLabel { get; set; }

  // must contain one <input type="file">; the frame's script hands it the picked or dropped files
  [Parameter, EditorRequired]
  public RenderFragment ChildContent { get; set; } = default!;
}

@* <file-drop-zone> is defined in FileDropZoneFrame.razor.js, loaded on every page, so it works on static
   pages as well as in islands. Custom elements display inline by default, so "block" makes it lay out like a div *@
<file-drop-zone class="mb-2 block border border-dashed p-6 text-center">
  <p class="mb-2 text-sm">@Prompt</p>

  @* data-part is how the script finds the button *@
  <ButtonBasic type="button" Variant="ButtonVariant.Outline" data-part="choose">
    @ButtonLabel
  </ButtonBasic>

  @if (DirectoryButtonLabel is not null)
  {
    <ButtonBasic type="button" Variant="ButtonVariant.Outline" Class="ml-2" data-part="choose-directory">
      @DirectoryButtonLabel
    </ButtonBasic>
  }

  @ChildContent
</file-drop-zone>
