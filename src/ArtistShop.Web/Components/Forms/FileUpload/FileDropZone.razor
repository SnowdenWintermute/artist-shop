@typeparam TResult
@using System.Text.Json
@implements IAsyncDisposable
@inject IJSRuntime JS

@code {
  [Parameter, EditorRequired]
  public string UploadUrl { get; set; } = default!;
  [Parameter, EditorRequired]
  public string Prompt { get; set; } = default!;
  [Parameter]
  public string? Accept { get; set; }
  [Parameter]
  public bool Multiple { get; set; }
  [Parameter]
  public EventCallback<(string Id, string Name, long Size)> OnSelected { get; set; }
  [Parameter]
  public EventCallback<(string Id, int PercentComplete)> OnProgress { get; set; }
  [Parameter]
  public EventCallback<(string Id, TResult Result)> OnCompleted { get; set; }
  [Parameter]
  public EventCallback<(string Id, string Message)> OnFailed { get; set; }

  // populated by the @ref after the first render, and can be passed to JS as the real DOM element
  private ElementReference _fileInput;

  private InteropObject<FileDropZone<TResult>>? _uploader;

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender)
    {
      return;
    }

    // null when the page closed before the uploader started, so nothing will be dropped on it
    _uploader = await InteropObject<FileDropZone<TResult>>.CreateAsync(
      JS, "./Components/Forms/FileUpload/FileDropZone.razor.js", "createUploader", this, self => [_fileInput, self, UploadUrl]);
  }

  // once the page has closed, the file went with it
  public async Task UploadAsync(string id)
  {
    if (_uploader is not null)
    {
      await _uploader.InvokeIfOpenAsync("upload", id);
    }
  }

  public async Task ForgetAsync(string id)
  {
    if (_uploader is not null)
    {
      await _uploader.InvokeIfOpenAsync("forget", id);
    }
  }

  // allows JS to call this method via dotNetReference.invokeMethodAsync
  // the name must match the string passed to dotNetReference.invokeMethodAsync
  // in js
  [JSInvokable]
  public async Task OnFileSelected(string id, string name, long size)
  {
    await OnSelected.InvokeAsync((id, name, size));
    await UploadAsync(id);
  }

  [JSInvokable]
  public Task OnUploadProgress(string id, int percentComplete) =>
    OnProgress.InvokeAsync((id, percentComplete));

  [JSInvokable]
  public Task OnUploadCompleted(string id, JsonElement result) =>
    OnCompleted.InvokeAsync((id, result.Deserialize<TResult>(JsonSerializerOptions.Web)!));

  [JSInvokable]
  public Task OnUploadFailed(string id, string message) =>
    OnFailed.InvokeAsync((id, message));

  public async ValueTask DisposeAsync()
  {
    if (_uploader is not null)
    {
      await _uploader.DisposeAsync();
    }
  }
}

@* the frame opens the picker and turns a drop into the input's "change" event, which the uploader listens to *@
<FileDropZoneFrame Prompt="@Prompt" ButtonLabel="@(Multiple ? "Choose files" : "Choose file")">
  <input @ref="_fileInput" type="file" multiple="@Multiple" accept="@Accept" class="hidden" />
</FileDropZoneFrame>
