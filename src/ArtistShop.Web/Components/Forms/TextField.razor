@code {
  [Parameter, EditorRequired]
  public string Label { get; set; } = default!;

  [Parameter, EditorRequired]
  public string? Value { get; set; }

  [Parameter]
  public EventCallback<string?> ValueChanged { get; set; }

  [Parameter]
  public Expression<Func<string?>> ValueExpression { get; set; } = default!;

  // for an island that reacts to the text as it's typed, like a Save button enabled by a change
  [Parameter]
  public bool UpdatesPerKeystroke { get; set; }

  // any other attributes, such as type="password" or autocomplete, go on the input
  [Parameter(CaptureUnmatchedValues = true)]
  public Dictionary<string, object>? InputAttributes { get; set; }

  private InputText? _input;

  // islands only, for moving the cursor here, as after Enter saved the field before it
  public async Task FocusAsync()
  {
    if (_input?.Element is { } element)
    {
      await element.FocusAsync();
    }
  }
}

<FieldLayout Label="@Label" ValueExpression="ValueExpression" Context="elementId">
  @if (UpdatesPerKeystroke)
  {
    <InputTextPerKeystroke @ref="_input" @attributes="InputAttributes" class="artist-shop-field-input" id="@elementId" Value="@Value" ValueChanged="ValueChanged"
                           ValueExpression="ValueExpression" />
  }
  else
  {
    <InputText @ref="_input" @attributes="InputAttributes" class="artist-shop-field-input" id="@elementId" Value="@Value" ValueChanged="ValueChanged"
               ValueExpression="ValueExpression" />
  }
</FieldLayout>
