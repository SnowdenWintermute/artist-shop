@* every checked box posts its value under the same name. Nothing is bound: the page reads
   these back out of the query string *@

@code {
  [Parameter, EditorRequired]
  public string Legend { get; set; } = default!;
  [Parameter, EditorRequired]
  public string Name { get; set; } = default!;
  [Parameter, EditorRequired]
  public IReadOnlyList<(int Value, string Label)> Options { get; set; } = default!;
  [Parameter, EditorRequired]
  public IReadOnlySet<int> SelectedValues { get; set; } = default!;
}

<fieldset class="mb-3">
  <legend class="artist-shop-field-label">@Legend</legend>

  <div class="flex flex-wrap gap-x-4 gap-y-1">
    @foreach (var option in Options)
    {
      <label @key="option.Value" class="flex items-center gap-1">
        <input type="checkbox" name="@Name" value="@option.Value"
               checked="@SelectedValues.Contains(option.Value)" class="cursor-pointer" />
        @option.Label
      </label>
    }
  </div>
</fieldset>
