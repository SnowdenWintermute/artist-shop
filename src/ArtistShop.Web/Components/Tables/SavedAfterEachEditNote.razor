@using ArtistShop.Web.Components.Atoms

@* Above an editable table: what it holds, such as "Images", are saved after each edit *@

@code {
  [Parameter, EditorRequired]
  public string What { get; set; } = default!;
}

<p class="mb-4 flex items-center">
  <span class="text-ink flex items-center justify-center mr-2">
    <SvgIcon Name="floppy-disc" Class="size-5" />
  </span>
  <span>@What are saved after each edit</span>
</p>
