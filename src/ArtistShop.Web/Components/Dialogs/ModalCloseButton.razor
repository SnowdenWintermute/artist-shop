@using ArtistShop.Web.Components.Atoms

@* closes the ModalDialog it's in; ModalDialog.razor.js handles the click *@

@code {
  [Parameter, EditorRequired]
  public string Label { get; set; } = default!;
  [Parameter]
  public bool Disabled { get; set; }
}

<ButtonBasic type="button" Class="border" data-modal-dialog="close" disabled="@Disabled">@Label</ButtonBasic>
