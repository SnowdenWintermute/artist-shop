@using ArtistShop.Web.Components.Atoms

@code {
  [Parameter]
  public bool Open { get; set; }
  [Parameter]
  public EventCallback<bool> OpenChanged { get; set; }
  [Parameter, EditorRequired]
  public string Title { get; set; } = default!;
  [Parameter, EditorRequired]
  public string ConfirmLabel { get; set; } = default!;
  [Parameter, EditorRequired]
  public EventCallback OnConfirm { get; set; }
  [Parameter]
  public bool IsWorking { get; set; }
  [Parameter, EditorRequired]
  public RenderFragment ChildContent { get; set; } = default!;

  private readonly string _descriptionId = $"confirm-description-{Guid.NewGuid():n}";
}

@if (Open)
{
  @* alertdialog tells screen readers this needs an answer; aria-describedby reads the question out *@
  <ModalDialog Title="@Title" Width="ModalDialogWidth.Narrow" OnClose="() => OpenChanged.InvokeAsync(false)"
               KeepOpen="IsWorking" role="alertdialog" aria-describedby="@_descriptionId">
    <div id="@_descriptionId" class="mb-6">@ChildContent</div>

    <ModalDialogActions>
      <ModalCloseButton Label="Cancel" Disabled="IsWorking" />
      <ButtonBasic type="button" Class="bg-red-600 text-white" disabled="@IsWorking" @onclick="OnConfirm">
        @ConfirmLabel
      </ButtonBasic>
    </ModalDialogActions>
  </ModalDialog>
}
