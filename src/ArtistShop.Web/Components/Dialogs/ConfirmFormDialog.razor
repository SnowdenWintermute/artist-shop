@using ArtistShop.Web.Components.Atoms

@* ConfirmDialog for a static page, holding a form that its confirm button posts. It starts closed: a
   button with data-opens-dialog set to Id opens it. Id and FormName must be unique on the page, so
   one in a table's row includes the row's id.
   Not enhanced: an enhanced post patches the page in place, and when a row is gone afterwards the
   rows below it take over its elements, the open dialog among them. A full load starts closed *@

@code {
  [Parameter, EditorRequired]
  public string Id { get; set; } = default!;
  [Parameter, EditorRequired]
  public string Title { get; set; } = default!;
  [Parameter, EditorRequired]
  public string ConfirmLabel { get; set; } = default!;
  [Parameter, EditorRequired]
  public string FormName { get; set; } = default!;
  [Parameter, EditorRequired]
  public EventCallback OnConfirm { get; set; }
  [Parameter, EditorRequired]
  public RenderFragment ChildContent { get; set; } = default!;

  private readonly string _descriptionId = $"confirm-description-{Guid.NewGuid():n}";
}

@* alertdialog tells screen readers this needs an answer; aria-describedby reads the question out *@
<ModalDialog Title="@Title" Width="ModalDialogWidth.Narrow" Id="@Id" StartsClosed role="alertdialog"
             aria-describedby="@_descriptionId">
  <div id="@_descriptionId" class="mb-6">@ChildContent</div>

  <form method="post" @formname="@FormName" @onsubmit="OnConfirm">
    <AntiforgeryToken />
    <ModalDialogActions>
      <ModalCloseButton Label="Cancel" />
      <ButtonBasic type="submit" Variant="ButtonVariant.Danger">@ConfirmLabel</ButtonBasic>
    </ModalDialogActions>
  </form>
</ModalDialog>
