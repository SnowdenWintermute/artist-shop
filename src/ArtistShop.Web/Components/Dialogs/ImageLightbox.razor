@using ArtistShop.Web.Components.Atoms

@* <image-lightbox> is defined in ImageLightbox.razor.js. It starts closed and is opened by script,
   which is why it isn't ModalDialog: that one opens as soon as it is rendered, and carries a title
   bar and padding a picture has no use for. What it shows is handed to it, so it knows nothing
   about works. The picture itself, with its swiping and zooming, is PhotoSwipe's, loaded the
   first time the lightbox opens; the buttons over it are ours *@

@* data-permanent: enhanced navigation leaves it as it is, so it can stay open while a work's
   arrows step on to the next work's page *@
<image-lightbox class="contents" data-permanent="image-lightbox"
                data-photoswipe-src="@Assets["lib/photoswipe/photoswipe.esm.min.js"]">
  <link rel="stylesheet" href="@Assets["lib/photoswipe/photoswipe.css"]" />

  <dialog data-lightbox-dialog class="artist-shop-lightbox" aria-label="Full screen image">
    @* the buttons are placed from this box rather than the dialog, because a positioned child
       is measured from its container's edge, padding included. Placed from the dialog they would
       ignore the padding that keeps them clear of a phone's notch *@
    <div class="relative size-full">
      <ButtonBasic type="button" data-lightbox-close Variant="ButtonVariant.Outline"
                   Class="absolute top-4 right-4 z-10 border-on-lightbox/40 text-on-lightbox">Close</ButtonBasic>

      <ButtonBasic type="button" data-lightbox-step="-1" hidden="@true" aria-label="Previous image" Variant="ButtonVariant.Outline"
                   Class="absolute top-1/2 left-4 z-10 -translate-y-1/2 border-on-lightbox/40 text-on-lightbox">←</ButtonBasic>

      <ButtonBasic type="button" data-lightbox-step="1" hidden="@true" aria-label="Next image" Variant="ButtonVariant.Outline"
                   Class="absolute top-1/2 right-4 z-10 -translate-y-1/2 border-on-lightbox/40 text-on-lightbox">→</ButtonBasic>

      <p data-lightbox-counter aria-live="polite" hidden
         class="absolute bottom-4 left-1/2 z-10 -translate-x-1/2 text-sm text-on-lightbox"></p>
    </div>
  </dialog>
</image-lightbox>
