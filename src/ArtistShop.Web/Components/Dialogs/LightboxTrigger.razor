@* Makes whatever opens the full-screen view, usually a picture, into the button that does. The
   click itself is handled by whoever holds the lightbox, which finds it by data-lightbox-open *@

@code {
  [Parameter, EditorRequired]
  public RenderFragment ChildContent { get; set; } = default!;

  // what a screen reader announces in place of the picture's own alt
  [Parameter]
  public string Label { get; set; } = "View full screen";
}

<button type="button" data-lightbox-open aria-label="@Label"
        class="relative block w-full focus-visible:outline-2 focus-visible:outline-offset-2">
  @ChildContent
</button>
