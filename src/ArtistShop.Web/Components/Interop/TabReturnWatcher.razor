@* renders nothing; only works inside an interactive island *@
@implements IAsyncDisposable
@inject IJSRuntime JS

@code {
  [Parameter, EditorRequired]
  public EventCallback OnTabReturn { get; set; }

  private InteropObject<TabReturnWatcher>? _watcher;

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender)
    {
      return;
    }

    // null when the page closed before the watcher started, so there is nothing to watch
    _watcher = await InteropObject<TabReturnWatcher>.CreateAsync(
      JS, "./Components/Interop/TabReturnWatcher.razor.js", "watchTabReturn", this, self => [self]);
  }

  [JSInvokable]
  public Task NotifyTabReturn() => OnTabReturn.InvokeAsync();

  public async ValueTask DisposeAsync()
  {
    if (_watcher is not null)
    {
      await _watcher.DisposeAsync();
    }
  }
}
