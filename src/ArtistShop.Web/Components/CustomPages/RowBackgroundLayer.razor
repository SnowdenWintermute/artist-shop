@* What's drawn behind a row's content, across the screen: its colour, and its image, centred. Nothing
   for no background, or for an image not chosen or gone, past its colour. The caller's box must be
   relative and isolate, so this sits behind the content and above the page *@
@using System.Globalization
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@inject UploadedImageRepository UploadedImageRepository
@inject WorkRepository WorkRepository

@code {
  [Parameter, EditorRequired]
  public required RowBackground Background { get; set; }

  // the first row's image is in view as the page opens, so it isn't left to load lazily
  [Parameter, EditorRequired]
  public required bool IsFirstRow { get; set; }

  private ImageComponentPicture? _picture;

  // an inline style, since a colour is anything the artist picks; none where the page colour shows
  private string? ColorStyle => Background.DrawnColor is { } color ? $"background-color: {color.Hex};" : null;

  // Covering a row taller than the screen is wide for the picture's shape, the picture is drawn wider
  // than the screen, its sides cropped. A screen-high row bounds that, which most rows are no taller than
  private static string SizesFor(WorkImage image, ImageFit fit) =>
    fit is ImageFit.Cover
      ? $"max(100vw, calc(100vh * {image.Width.ToString(CultureInfo.InvariantCulture)} / {image.Height.ToString(CultureInfo.InvariantCulture)}))"
      : "100vw";

  protected override async Task OnParametersSetAsync() =>
    _picture = Background is RowBackground.Image image
      ? await ImageComponentPicture.ReadAsync(image.Source, UploadedImageRepository, WorkRepository)
      : null;
}

@if (Background is not RowBackground.None)
{
  <div class="absolute inset-0 -z-10 overflow-hidden" style="@ColorStyle" data-row-background>
    @if (Background is RowBackground.Image { Fit: var fit } && _picture is ImageComponentPicture.Shown { Image: var image })
    {
      @* decoration, so no alt text for a screen reader *@
      <FittedPicture Image="image" Fit="fit" IsFullBleed Sizes="@SizesFor(image, fit)" Alt="" IsEager="IsFirstRow"
                     Class="absolute inset-0 size-full" data-test="row-background-image" />
    }
  </div>
}
