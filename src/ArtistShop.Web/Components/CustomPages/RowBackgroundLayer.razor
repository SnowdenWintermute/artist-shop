@* What's drawn behind a row's content, across the screen: its colour, and its image, centred. Nothing
   for no background, or for an image not chosen or gone, past its colour. The caller's box must be
   relative and isolate, so this sits behind the content and above the page *@
@using System.Globalization
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Images
@inject UploadedImageRepository UploadedImageRepository
@inject WorkRepository WorkRepository
@inject ImageSizeQueue ImageSizeQueue
@inject FullBleedImageSizes FullBleedImageSizes

@code {
  [Parameter, EditorRequired]
  public required RowBackground Background { get; set; }

  // the first row's image is in view as the page opens, so it isn't left to load lazily
  [Parameter, EditorRequired]
  public required bool IsFirstRow { get; set; }

  private ImageComponentPicture? _picture;

  // an inline style, since a colour is anything the artist picks; none where the page colour shows
  private string? ColorStyle =>
    Background switch
    {
      RowBackground.Color color => $"background-color: {color.Value.Hex};",
      RowBackground.Image { Behind: { } behind } => $"background-color: {behind.Hex};",
      _ => null,
    };

  protected override async Task OnParametersSetAsync() =>
    _picture = Background is RowBackground.Image image
      ? await ImageComponentPicture.ReadAsync(image.Source, UploadedImageRepository, WorkRepository)
      : null;
}

@if (Background is not RowBackground.None)
{
  <div class="absolute inset-0 -z-10 overflow-hidden" style="@ColorStyle" data-row-background>
    @if (Background is RowBackground.Image { Fit: var fit } && _picture is ImageComponentPicture.Shown { Image: var image })
    {
      var (readyWidths, width) = FullBleedImageSizes.For(image.StorageKey, image.Width, isFullBleed: true);

      @* decoration, so no alt text for a screen reader *@
      <img src="@ImageUrls.Variant(image.StorageKey, readyWidths, width, ImageVariantFormat.Avif)"
           srcset="@ImageUrls.SourceSet(image.StorageKey, readyWidths, width, ImageVariantFormat.Avif)"
           sizes="100vw" alt=""
           width="@image.Width.ToString(CultureInfo.InvariantCulture)" height="@image.Height.ToString(CultureInfo.InvariantCulture)"
           loading="@(IsFirstRow ? "eager" : "lazy")" data-test="row-background-image"
           class="@($"absolute inset-0 size-full {ImageClasses.PlaceholderFit(fit)} {ImageClasses.Fit(fit)}")"
           style="@(image.BlurDataUri is { } blurDataUri ? $"background-image: url({blurDataUri});" : "")" />
      @if (ImageSizeQueue.IsProcessing(image.StorageKey, width))
      {
        <ProcessingLabel />
      }
    }
  </div>
}
