@using ArtistShop.Web.Components.CustomPages.CardGrids
@using ArtistShop.Web.Components.CustomPages.Slides


@code {
  [Parameter, EditorRequired]
  public required CustomComponent Component { get; set; }

  [Parameter, EditorRequired]
  public required SlotWidth Slot { get; set; }

  // first in a column of the page's first row
  [Parameter, EditorRequired]
  public required bool IsPageTop { get; set; }

  // the page's first heading component, which is its h1
  [Parameter, EditorRequired]
  public required bool IsPageTitle { get; set; }
}

@* what the editors' preview finds a component by. contents: it lays nothing out itself *@
<div class="contents" data-component-id="@Component.Id.Value">
  @switch (Component.Settings)
  {
    case CardGridSettings cardGrid:
      <CardGridView Settings="cardGrid" ComponentId="Component.Id" PageKey="@CustomComponentPageKey.For(Component.Id)"
                    IsPageTop="IsPageTop" />
      break;
    case PostListSettings:
      <PostList PageKey="@CustomComponentPageKey.For(Component.Id)" IsPageTop="IsPageTop" />
      break;
    case TextSettings text:
      <TextView Settings="text" />
      break;
    case HeadingSettings heading:
      <HeadingView Settings="heading" IsPageTitle="IsPageTitle" />
      break;
    case ImageSettings image:
      <ImageView Settings="image" Slot="Slot" />
      break;
    case CarouselSettings carousel:
      <CarouselView Settings="carousel" ComponentId="Component.Id" Slot="Slot" />
      break;
    default:
      throw new InvalidOperationException($"{Component.Settings.Type} has no view.");
  }
</div>
