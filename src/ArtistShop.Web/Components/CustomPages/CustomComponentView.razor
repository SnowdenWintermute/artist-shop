@using ArtistShop.Web.Components.CustomPages.CardGrids


@code {
  [Parameter, EditorRequired]
  public required CustomComponent Component { get; set; }
}

@switch (Component.Settings)
{
  case CardGridSettings cardGrid:
    <CardGridView Settings="cardGrid" ComponentId="Component.Id" PageKey="@CustomComponentPageKey.For(Component.Id)" />
    break;
  case PostListSettings:
    <PostList PageKey="@CustomComponentPageKey.For(Component.Id)" />
    break;
  case TextSettings text:
    <TextView Settings="text" />
    break;
  default:
    throw new InvalidOperationException($"{Component.Settings.Type} has no view.");
}
