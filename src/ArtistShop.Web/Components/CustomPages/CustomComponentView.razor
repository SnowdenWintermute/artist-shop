
@code {
  [Parameter, EditorRequired]
  public required CustomComponent Component { get; set; }
}

@switch (Component.Settings)
{
  case CollectionViewerSettings:
    <CollectionViewer />
    break;
  case PostListSettings:
    <PostList />
    break;
  case TextSettings text:
    <TextView Settings="text" />
    break;
  default:
    throw new InvalidOperationException($"{Component.Settings.Type} has no view.");
}
