@* a heading component's line of text, on its side of the slot, spaced below as a text is. A link is inside
   the heading, so the heading is still read as one *@
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Domain.Publishing
@using ArtistShop.Web.Utilities

@code {
  [Parameter, EditorRequired]
  public required HeadingSettings Settings { get; set; }

  // the page's first heading component, an h1; the rest are h2s, as a text's headings are
  [Parameter, EditorRequired]
  public required bool IsPageTitle { get; set; }

  private string AlignmentClass =>
    Settings.Alignment switch
    {
      ComponentAlignment.Left => "text-left",
      ComponentAlignment.Center => "text-center",
      ComponentAlignment.Right => "text-right",
      _ => throw new InvalidOperationException($"{Settings.Alignment} has no class."),
    };

  private string FontClass =>
    Settings.Font switch
    {
      FontRole.Heading => "font-heading",
      FontRole.Text => "font-text",
      _ => throw new InvalidOperationException($"{Settings.Font} has no class."),
    };

  private string Class =>
    ClassNames.Join(
      $"mb-4 break-words {FontClass} {TextSizeNames.ClassOf(Settings.Size)} {AlignmentClass}",
      Settings.Bold ? "font-bold" : null
    );
}

@if (IsPageTitle)
{
  <h1 class="@Class"><TargetLink Target="Settings.LinkTarget" Class="@LinkStyles.Standalone">@Settings.Text</TargetLink></h1>
}
else
{
  <h2 class="@Class"><TargetLink Target="Settings.LinkTarget" Class="@LinkStyles.Standalone">@Settings.Text</TargetLink></h2>
}
