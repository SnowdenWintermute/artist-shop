@using System.Globalization
@using ArtistShop.Web.Components.CustomPages.Slides
@using ArtistShop.Web.Components.Icons
@using ArtistShop.Web.Components.Layout
@code {
  [Parameter, EditorRequired]
  public required PageRow Row { get; set; }
  [Parameter, EditorRequired]
  public required RowPosition Position { get; set; }

  // in a box MainLayout makes a screen high with the nav or the footer, a row that fills the screen
  // grows to fill what they leave rather than being a screen high itself
  [Parameter]
  public bool FillsBox { get; set; }

  // in the box with the footer, which draws the row's page colour and background behind the footer too
  [Parameter]
  public bool LeavesBackgroundToBox { get; set; }

  private bool FillsScreen => Row.Height is RowHeight.FillScreen;

  private bool DrawsBackground => !LeavesBackgroundToBox && Row.Background is not RowBackground.None;

  private bool HasSlideshow => Row.Background is RowBackground.Slideshow;

  private string RowClass =>
    RowPaddingClasses.Vertical(Row.Padding, Position)
    + (DrawsBackground ? " relative isolate" : HasSlideshow ? " relative" : "")
    + (FillsScreen ? $" flex flex-col {(FillsBox ? "flex-1" : RowClasses.ScreenHeightClass)}" : "")
    + (Row.Theme is null ? "" : LeavesBackgroundToBox ? " font-text text-ink" : " bg-page font-text text-ink");

  // what a row's own theme is scoped to; a bare value, since a <style>'s text can't hold quotes
  public static string ThemeMarkerOf(PageRow row) => $"row-{row.Id.Value.ToString(CultureInfo.InvariantCulture)}";

  private string ThemeMarker => ThemeMarkerOf(Row);

  // slots stretch to the row's height, which in a row that fills the screen is at least the screen's
  private string ContentClass =>
    $"mx-auto flex w-full flex-wrap items-stretch {CustomPageWidths.MaximumClass(Row.ContentWidth)} "
    + $"{RowPaddingClasses.Sides(Row.Padding.Sides)} {RowClasses.GapClass(Row.Gap)}{(FillsScreen ? " flex-1" : "")}";

  private string SlotClass(SlotWidth width) =>
    $"flex {RowClasses.SlotMinimumWidthClass} basis-0 flex-col {RowClasses.GapClass(Row.Gap)} {width.GrowthClass} "
    + RowClasses.StackAlignment(Row.Alignment);

  // the database keeps a row's slots matching its widths, so a mismatch is a bug
  private IEnumerable<(RowSlot Slot, SlotWidth Width)> Slots =>
    RowClasses.SlotShares(Row.Widths).Count == Row.Slots.Count
      ? Row.Slots.Select((slot, index) => (slot, new SlotWidth(Row, index)))
      : throw new InvalidOperationException($"A {Row.Widths} row has {Row.Slots.Count} slots.");
}

@* a row on a theme of its own takes its colours and fonts, with its page colour behind it *@
@if (Row.Theme is { } theme)
{
  <ThemeStyle Selector="@($"[data-row-theme={ThemeMarker}]")" Theme="theme.Theme" />
}
@* data-row-id: what the editors' preview finds a row by *@
<div class="@RowClass" data-row-theme="@(Row.Theme is null ? null : ThemeMarker)" data-row-id="@Row.Id.Value">
  @if (DrawsBackground)
  {
    <RowBackgroundLayer Background="Row.Background" RowId="Row.Id" IsFirstRow="Position.IsFirst" />
  }
  @if (HasSlideshow)
  {
    @* The slideshow's pause, in the row's own box: a last row's background runs on under the footer. First, so the
       keyboard reaches it before the row's content. RowBackgroundLayer.razor.js shows it once the slideshow plays,
       which it never does under reduced motion, labels it and swaps the icon *@
    <button type="button" aria-label="Pause background slideshow" data-pauses="@RowBackgroundLayer.SlideshowIdOf(Row.Id)"
            class="@($"{SlideControlClasses.ButtonShape} group/pause absolute bottom-2 left-[max(0.5rem,env(safe-area-inset-left))] z-10 hidden bg-page/80 text-ink data-ready:inline-flex")">
      <SvgIcon Name="pause" Class="hidden size-5 group-data-playing/pause:block" />
      <SvgIcon Name="play" Class="size-5 group-data-playing/pause:hidden" />
    </button>
  }
  <div class="@ContentClass">
    @foreach (var (slot, width) in Slots)
    {
      <div class="@SlotClass(width)">
        @foreach (var component in slot.Stack)
        {
          <CustomComponentView @key="component.Id" Component="component" Slot="width" />
        }
      </div>
    }
  </div>
</div>
