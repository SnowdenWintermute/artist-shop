
@code {
  [Parameter, EditorRequired]
  public required PageRow Row { get; set; }

  // the database keeps a row's slots matching its widths, so a mismatch is a bug
  private IReadOnlyList<string> SlotGrowth =>
    RowClasses.SlotGrowth(Row.Widths) is var growth && growth.Count == Row.Slots.Count
      ? growth
      : throw new InvalidOperationException($"A {Row.Widths} row has {Row.Slots.Count} slots.");
}

<div class="@($"flex flex-wrap gap-8 {RowClasses.Alignment(Row.Alignment)}")">
  @foreach (var (slot, growth) in Row.Slots.Zip(SlotGrowth))
  {
    <div class="@($"flex min-w-[min(100%,18rem)] basis-0 flex-col gap-8 {growth}")">
      @foreach (var component in slot.Stack)
      {
        <CustomComponentView @key="component.Id" Component="component" />
      }
    </div>
  }
</div>
