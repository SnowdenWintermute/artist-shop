@* a page of collection and work cards, all of them ones a visitor may see *@
@using ArtistShop.Web.Components.Catalog
@using ArtistShop.Web.Components.Lists
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@inject CollectionRepository CollectionRepository
@inject WorkRepository WorkRepository
@inject CardGridChosenCardRepository CardGridChosenCardRepository
@inject NavigationManager NavigationManager

@code {
  [Parameter, EditorRequired]
  public required CardGridSettings Settings { get; set; }

  // the component drawn, whose custom list a ChosenCards source shows; null for the collection page's grid,
  // which isn't one
  [Parameter, EditorRequired]
  public required CustomComponentId? ComponentId { get; set; }

  // the query parameter its page number is kept in
  [Parameter, EditorRequired]
  public required string PageKey { get; set; }

  // its page links start the page from its top; see PageLinks
  [Parameter, EditorRequired]
  public required bool IsPageTop { get; set; }

  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  private LoadedCardGrid? _loaded;

  // not OnInitializedAsync: turning a page is the same page with a new query parameter
  protected override async Task OnParametersSetAsync()
  {
    var pageNumber = Settings.HasPageLinks ? PageLinks.ReadPageNumber(NavigationManager, PageKey) : 1;
    var loaded = await LoadAsync(pageNumber);

    if (PageLinks.LeaveEmptiedPage(NavigationManager, PageKey, pageNumber, loaded.Page.Cards.Count))
    {
      return;
    }

    _loaded = loaded;
  }

  private async Task<LoadedCardGrid> LoadAsync(int pageNumber)
  {
    var pageSize = Settings.CardsPerPage;

    switch (Settings.Source)
    {
      case CardGridSource.AllCollections:
        // few enough to page here
        var collections = await CollectionRepository.GetVisibleWithCoversAsync();
        var page = new CardGridPage(
          [.. collections.Skip((pageNumber - 1) * pageSize).Take(pageSize).Select(collection => new GridCard.OfCollection(collection))],
          collections.Count, pageNumber, pageSize);

        return new LoadedCardGrid(HeadingText(Wording.Collection.PluralHeading), page, WorksCollection: null);

      case CardGridSource.WorksInCollection inCollection:
        // a collection deleted since leaves the grid empty
        if (await CollectionRepository.GetByIdAsync(inCollection.CollectionId) is not { } collection)
        {
          return new LoadedCardGrid(HeadingText(automatic: null), new CardGridPage([], 0, pageNumber, pageSize),
            WorksCollection: null);
        }

        var works = await WorkRepository.GetListAsync(WorkListFilter.VisibleWorksIn(collection.Id, pageNumber), searchMatches: null,
          exclusion: null, pageSize);

        return new LoadedCardGrid(HeadingText(collection.Name.Value),
          new CardGridPage([.. works.Items.Select(work => new GridCard.OfWork(work.Id, work.Name, work.Slug, work.PrimaryImage))],
            works.TotalCount, pageNumber, pageSize),
          collection.Slug);

      case CardGridSource.CollectionsAndLooseWorks:
        return new LoadedCardGrid(HeadingText(Wording.Work.PluralHeading),
          await CollectionsThenLooseWorksAsync(pageNumber, pageSize), WorksCollection: null);

      case CardGridSource.ChosenCards:
        // the ones a visitor wouldn't see are left out, and the settings page says why
        return new LoadedCardGrid(HeadingText(automatic: null),
          await CardGridChosenCardRepository.GetVisiblePageAsync(
            ComponentId ?? throw new InvalidOperationException("A custom list needs the component it belongs to."),
            pageNumber, pageSize),
          WorksCollection: null);

      default:
        throw new InvalidOperationException($"A card grid can't show {Settings.Source.Type}.");
    }
  }

  // The loose works pick up where the collections end, so a page can hold some of each
  private async Task<CardGridPage> CollectionsThenLooseWorksAsync(int pageNumber, int pageSize)
  {
    var collections = await CollectionRepository.GetVisibleWithCoversAsync();
    var start = (pageNumber - 1) * pageSize;
    List<GridCard> cards = [.. collections.Skip(start).Take(pageSize).Select(collection => new GridCard.OfCollection(collection))];

    // at least one, even on a page the collections fill, as the works' count comes back only on a work
    var looseWorks = await WorkRepository.GetSliceAsync(LooseWorks, searchMatches: null, exclusion: null,
      offset: Math.Max(0, start - collections.Count), count: Math.Max(1, pageSize - cards.Count));

    cards.AddRange(looseWorks.Items.Take(pageSize - cards.Count)
      .Select(work => new GridCard.OfWork(work.Id, work.Name, work.Slug, work.PrimaryImage)));

    return new CardGridPage(cards, collections.Count + looseWorks.TotalCount, pageNumber, pageSize);
  }

  // the cards missing from a short last page, when there are other pages to keep it level with
  // only the even grid and rows take the theme's corners, not masonry (Mike, 2026-10-23)
  private bool HasThemeCorners => Settings.Layout is not CardGridLayout.Masonry;

  private int PlaceholderCount(CardGridPage page) =>
    Settings.HasSameSizeCards && Settings.HasPageLinks && page.PageCount > 1 ? page.PageSize - page.Cards.Count : 0;

  // automatic is what Automatic says for this source
  private string? HeadingText(string? automatic) =>
    Settings.Heading switch
    {
      CardGridHeading.Automatic => automatic,
      CardGridHeading.Custom custom => custom.Text,
      _ => null,
    };

  // works in no collection that have something to show, newest first
  private static readonly WorkListFilter LooseWorks =
    new(
      WorkTypeIds: [],
      VocabularyTermIds: [],
      Collection: new WorkCollectionFilter.InNoCollection(),
      SearchText: null,
      HasImages: true,
      IsForSale: null,
      Sort: WorkListSort.RecentlyAdded,
      PageNumber: 1
    );
}

@if (_loaded is { } loaded)
{
  <section data-test="card-grid">
    @if (loaded.Heading is { } heading)
    {
      @* not PageHeading: these keep the text font, rather than the theme's heading font *@
      <h1 class="mb-4">@heading</h1>
    }

    @if (loaded.Page.Cards.Count == 0)
    {
      <p>Nothing here yet.</p>
    }
    else
    {
      <div class="mb-4">
        <TileGrid IsMasonry="Settings.Layout is CardGridLayout.Masonry">
          @foreach (var card in loaded.Page.Cards)
          {
            @switch (card)
            {
              case GridCard.OfCollection collection:
                <CollectionCard @key="collection.Collection.Id" Collection="collection.Collection"
                                IsSameSize="Settings.HasSameSizeCards" HasThemeCorners="HasThemeCorners" />
                break;
              case GridCard.OfWork work:
                <WorkCard @key="work.Id" Work="work" CollectionSlug="loaded.WorksCollection"
                          IsSameSize="Settings.HasSameSizeCards" HasThemeCorners="HasThemeCorners" />
                break;
            }
          }
          @for (var index = 0; index < PlaceholderCount(loaded.Page); index++)
          {
            <CardPlaceholder />
          }
        </TileGrid>
      </div>

      @if (Settings.HasPageLinks)
      {
        <div class="flex justify-end">
          <PageLinks Key="@PageKey" IsPageTop="IsPageTop" PageNumber="loaded.Page.PageNumber" PageCount="loaded.Page.PageCount" />
        </div>
      }
    }
  </section>
}
