@using ArtistShop.Web.Components.Catalog
@using ArtistShop.Web.Components.Pages.Catalog
@using ArtistShop.Web.Domain.Catalog

@code {
  [Parameter, EditorRequired]
  public required GridCard.OfWork Work { get; set; }

  // the collection the visitor is walking through, so the work page can step to its neighbours
  [Parameter, EditorRequired]
  public required CollectionSlug? CollectionSlug { get; set; }

  [Parameter, EditorRequired]
  public required bool IsSameSize { get; set; }
}

<LinkTile Href="@WorkPageQuery.Url(Work.Slug.Value, CollectionSlug?.Value, imageNumber: null)" Title="@Work.Name.Value"
          Image="Work.Image" IsSameSize="IsSameSize" />
