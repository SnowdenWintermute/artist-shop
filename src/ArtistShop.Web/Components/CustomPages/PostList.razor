@* the published posts, newest first, a page at a time; admins too, since drafts are on the admin post list.
   Headed with the custom page's name, as the blog was with "Blog" *@
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Lists
@using ArtistShop.Web.Components.Pages.Publishing
@using ArtistShop.Web.Components.Publishing
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Publishing
@inject PostRepository PostRepository
@inject NavigationManager NavigationManager

@code {
  // none in a component's preview on its own, which leaves out the heading
  [CascadingParameter]
  public CustomPage? Page { get; set; }

  // the query parameter its page number is kept in
  [Parameter, EditorRequired]
  public required string PageKey { get; set; }

  private PostListPage? _posts;

  // not OnInitializedAsync: turning a page is the same page with a new query parameter
  protected override async Task OnParametersSetAsync()
  {
    var pageNumber = PageLinks.ReadPageNumber(NavigationManager, PageKey);
    var posts = await PostRepository.GetPublishedPageAsync(pageNumber);

    if (PageLinks.LeaveEmptiedPage(NavigationManager, PageKey, pageNumber, posts.Items.Count))
    {
      return;
    }

    _posts = posts;
  }
}

<section class="@RichTextColumn.CenteredClass">
  @if (Page is not null)
  {
    <PageHeading Class="mb-4">@Page.Name</PageHeading>
  }

  @if (_posts is { } posts)
  {
    @if (posts.Items.Count == 0)
    {
      <div class="flex">
        <p>No posts yet.</p>

        <span>
          <AuthorizeView>
            <Authorized>
              <span>&nbsp</span><a href="@PageUrls.NewPost" class="@LinkStyles.InSentence">Create one?</a>
            </Authorized>
          </AuthorizeView>
        </span>
      </div>
    }
    else
    {
      <ul>
        @foreach (var post in posts.Items)
        {
          <BlogEntry @key="post.Id" Post="post" />
        }
      </ul>
    }

    <PageLinks Key="@PageKey" PageNumber="posts.PageNumber" PageCount="posts.PageCount" PreviousText="← Newer" NextText="Older →" />
  }
</section>
