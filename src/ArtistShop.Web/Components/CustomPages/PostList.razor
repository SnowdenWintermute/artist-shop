@* the published posts, newest first, a page at a time; admins too, since drafts are on the admin post list.
   Headed with the custom page's name, as the blog was with "Blog" *@
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Lists
@using ArtistShop.Web.Components.Pages.Publishing
@using ArtistShop.Web.Components.Publishing
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Publishing
@inject PostRepository PostRepository
@inject NavigationManager NavigationManager

@code {
  [CascadingParameter]
  public CustomPage Page { get; set; } = default!;

  [SupplyParameterFromQuery(Name = PageLinks.PageKey)]
  private string? PageValue { get; set; }

  private PostListPage? _posts;

  // not OnInitializedAsync: turning a page is the same page with a new query parameter
  protected override async Task OnParametersSetAsync()
  {
    var pageNumber = PageLinks.ReadPageNumber(PageValue);
    var posts = await PostRepository.GetPublishedPageAsync(pageNumber);

    // a link to a page that has since emptied, because posts were unpublished or deleted
    if (posts.Items.Count == 0 && pageNumber > 1)
    {
      NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameter(PageLinks.PageKey, (int?)null));
      return;
    }

    _posts = posts;
  }
}

<section class="@($"mx-auto w-full {PostColumn.WidthClass}")">
  <PageHeading Class="mb-4">@Page.Name</PageHeading>

  @if (_posts is { } posts)
  {
    @if (posts.Items.Count == 0)
    {
      <div class="flex">
        <p>No posts yet.</p>

        <span>
          <AuthorizeView>
            <Authorized>
              <span>&nbsp</span><a href="@PageUrls.NewPost" class="@LinkStyles.InSentence">Create one?</a>
            </Authorized>
          </AuthorizeView>
        </span>
      </div>
    }
    else
    {
      <ul>
        @foreach (var post in posts.Items)
        {
          <BlogEntry @key="post.Id" Post="post" />
        }
      </ul>
    }

    <PageLinks PageNumber="posts.PageNumber" PageCount="posts.PageCount" PreviousText="← Newer" NextText="Older →" />
  }
</section>
