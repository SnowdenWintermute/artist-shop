@* an article's text, drawn as a post's is, in a readable column or across its slot *@
@using ArtistShop.Web.Components.Publishing
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Images
@using ArtistShop.Web.Publishing
@inject ImageStorage ImageStorage
@inject WorkRepository WorkRepository

@code {
  [Parameter, EditorRequired]
  public required ArticleSettings Settings { get; set; }

  private LoadedPostDocument? _loaded;

  protected override async Task OnParametersSetAsync() =>
    _loaded = await LoadedPostDocument.LoadAsync(Settings.Body, ImageStorage, WorkRepository);
}

@if (_loaded is { } loaded)
{
  <div class="@ArticleColumns.PageClass(Settings.Width)">
    <PostDocumentView Loaded="loaded" />
  </div>
}
