@using ArtistShop.Web.Domain.Catalog

@code {
  [Parameter, EditorRequired]
  public string Href { get; set; } = default!;
  [Parameter, EditorRequired]
  public string Title { get; set; } = default!;
  [Parameter]
  public WorkImage? Image { get; set; }
  // a second line under the title, such as how many works a collection holds
  [Parameter]
  public string? Caption { get; set; }
  [Parameter]
  public string BoxClass { get; set; } = "w-full aspect-[4/3]";
  // one line of title, cut short, and the caption's line kept even without one, so every tile is one height
  [Parameter]
  public bool IsSameSize { get; set; }
  // the whole picture in its own shape, rather than cropped to the box
  [Parameter]
  public bool IsUncropped { get; set; }
  // the picture's corners as the theme rounds a frame's (FrameCss)
  [Parameter]
  public bool HasThemeCorners { get; set; }
}

<a href="@Href" class="block">
  <span class="mb-2 block">
    <TileImage Image="Image" BoxClass="@(HasThemeCorners ? $"{BoxClass} rounded-(--theme-frame-corners)" : BoxClass)"
               IsUncropped="IsUncropped" />
  </span>

  @if (IsSameSize)
  {
    <span class="block truncate" title="@Title">@Title</span>
    <span class="block truncate text-sm text-ink-faded">@(Caption ?? "\u00a0")</span>
  }
  else
  {
    <span class="block">@Title</span>

    @if (Caption is { } caption)
    {
      <span class="block text-sm text-ink-faded">@caption</span>
    }
  }
</a>
