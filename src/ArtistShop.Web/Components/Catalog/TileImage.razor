@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Images

@code {
  // an artwork with no photograph never reaches a visitor, but the artist's own pages
  // show one, so the empty state stays
  [Parameter]
  public ArtworkImage? Image { get; set; }

  // decorative by default: the tile writes the name beside it
  [Parameter]
  public string Alt { get; set; } = "";

  // the box the picture fills, and the caller's hook for how that box sits in its own layout
  [Parameter]
  public string BoxClass { get; set; } = "w-full aspect-[4/3]";

  // what the picture will be asked to fill, so the browser can pick a width before layout
  [Parameter]
  public string Sizes { get; set; } = "(min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw";

  [Parameter]
  public int MaximumWidth { get; set; } = ImageVariants.CardWidth;

  // a tile in a grid is fetched only once it has been scrolled near, which is wrong for the one
  // image a page is about: the browser would wait for layout before starting the download
  [Parameter]
  public bool IsEager { get; set; }

  // a tile fills its box and is cropped to fit; a work is shown whole, inside whatever shape
  // the caller gave the box
  [Parameter]
  public bool IsUncropped { get; set; }

  // the tiny blurred copy saved with the image, held behind the picture so the box has
  // something to show while it loads
  private string BlurStyle =>
    Image?.BlurDataUri is { } blurDataUri ? $"background-image: url({blurDataUri});" : "";

  // an uncropped box takes the picture's own shape, so the box is the picture and nothing else:
  // the blur sits behind the work rather than beside it, and a click lands only on the work
  private string AspectStyle =>
    IsUncropped && Image is { } shaped ? $"aspect-ratio: {shaped.Width} / {shaped.Height};" : "";
}

@* a span made block rather than a div, so it can sit inside a button or a link *@
<span class="@($"{BoxClass} block overflow-hidden bg-gray-100 bg-cover bg-center")" style="@BlurStyle @AspectStyle">
  @if (Image is { } image)
  {
    <img src="@ImageUrls.Variant(image.StorageKey, image.Width, MaximumWidth, ImageVariantFormat.Avif)"
         srcset="@ImageUrls.SourceSet(image.StorageKey, image.Width, MaximumWidth, ImageVariantFormat.Avif)"
         sizes="@Sizes" alt="@Alt" loading="@(IsEager ? "eager" : "lazy")"
         class="@($"size-full {(IsUncropped ? "object-contain" : "object-cover")}")" />
  }
  else
  {
    <span class="flex size-full items-center justify-center text-center text-[10px] text-gray-500">
      No image
    </span>
  }
</span>
