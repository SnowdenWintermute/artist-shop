@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Images
@inject NavigationManager NavigationManager

@code {
  [Parameter, EditorRequired]
  public string Title { get; set; } = default!;

  [Parameter]
  public string? Description { get; set; }

  [Parameter]
  public ArtworkImage? Image { get; set; }

  // fetched by another company's server, so the address must be complete; WebP because not
  // every site that reads these tags can read AVIF
  private string ImageAddress(ArtworkImage image) =>
    NavigationManager.ToAbsoluteUri(
      ImageUrls.Variant(image.StorageKey, image.Width, ImageVariants.LinkPreviewWidth, ImageVariantFormat.Webp)
    ).ToString();
}

@* the "Open Graph" tags Discord, Slack and iMessage read to build the card a pasted link turns into *@
<HeadContent>
  <meta property="og:type" content="website" />
  <meta property="og:title" content="@Title" />
  <meta property="og:url" content="@NavigationManager.Uri" />

  @if (Description is not null)
  {
    <meta property="og:description" content="@Description" />
  }

  @if (Image is not null)
  {
    <meta property="og:image" content="@ImageAddress(Image)" />
    <meta property="og:image:alt" content="@Title" />
    @* asks for the big picture under the text rather than a thumbnail beside it *@
    <meta name="twitter:card" content="summary_large_image" />
  }
</HeadContent>
