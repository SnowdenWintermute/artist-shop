@code {
  [Parameter, EditorRequired]
  public RenderFragment ChildContent { get; set; } = default!;

  // cards packed into columns by <tile-masonry> (TileGrid.razor.js); rows, as without it, until the script runs
  [Parameter]
  public bool IsMasonry { get; set; }

  // in C#, where @ needs no escaping, so Tailwind reads the classes as written. @container makes the
  // wrapper the box the @min- variants measure
  private const string ContainerClass = "@container";
  // items-start: a tile is its own height, not its row's, so the blank below a short one isn't part of its link, and
  // the masonry script can measure it
  private const string GridClass = "grid grid-cols-1 items-start gap-4 @min-[40rem]:grid-cols-2 @min-[48rem]:grid-cols-3 @min-[64rem]:grid-cols-4";
}

@* Columns by the grid's own width, not the screen's, so it fits a slot of a custom page or the row editor's
   preview as it fits a whole page. The widths are the screen breakpoints this used before (sm, md, lg) *@
@if (IsMasonry)
{
  <tile-masonry class="@($"block {ContainerClass}")">
    <div class="@GridClass" data-masonry-grid>
      @ChildContent
    </div>
  </tile-masonry>
}
else
{
  <div class="@ContainerClass">
    <div class="@GridClass">
      @ChildContent
    </div>
  </div>
}
