@* what a collection's page shows inside its <main>; the settings page's preview draws it too *@
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.CustomPages.CardGrids
@using ArtistShop.Web.Components.Lists
@using ArtistShop.Web.Domain.Catalog

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  [Parameter, EditorRequired]
  public required CollectionId Id { get; set; }
  [Parameter, EditorRequired]
  public required CollectionName Name { get; set; }
  [Parameter, EditorRequired]
  public required CollectionPageSettings Settings { get; set; }
}

<UpLink Class="mb-4" Href="@PageUrls.Home" Label="@($"All {Wording.Collection.PluralInSentence}")" />

@* not PageHeading: a collection's name keeps the text font, rather than the theme's heading font *@
<h1 class="mb-4">@Name.Value</h1>

@* the page's only grid, so it keeps the plain page key *@
<CardGridView Settings="Settings.GridFor(Id)" PageKey="@PageLinks.PageKey" />
