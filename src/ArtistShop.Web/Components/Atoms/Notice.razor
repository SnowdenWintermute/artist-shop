@using ArtistShop.Web.Utilities

@code {
  [Parameter, EditorRequired]
  public RenderFragment ChildContent { get; set; } = default!;

  [Parameter]
  public NoticeVariant Variant { get; set; }

  [Parameter]
  public string? Class { get; set; }

  [Parameter(CaptureUnmatchedValues = true)]
  public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

  private string VariantClass =>
    Variant switch
    {
      NoticeVariant.Info => "",
      NoticeVariant.Success => "border-success text-success",
      NoticeVariant.Error => "border-error text-error",
    };
}

@* a message set apart from the page around it, like a warning or the outcome of a form *@
<div @attributes="AdditionalAttributes"
     class="@ClassNames.Join("mb-4 border bg-page p-3 last:mb-0", VariantClass, Class)">
  @ChildContent
</div>
