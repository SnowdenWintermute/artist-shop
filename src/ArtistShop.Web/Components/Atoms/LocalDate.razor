@using ArtistShop.Web.Utilities

@code {
  [Parameter, EditorRequired]
  public DateTimeOffset Moment { get; set; }
}

@* The server can't know the visitor's time zone, so it writes the date as it falls in UTC, and
   <local-date>, defined in LocalDate.razor.js, rewrites it for the zone the browser is in. Every
   date the site shows goes through here *@
<local-date><time datetime="@DateText.DateTimeAttribute(Moment)">@DateText.Day(Moment)</time></local-date>
