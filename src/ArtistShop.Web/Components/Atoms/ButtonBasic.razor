@using ArtistShop.Web.Utilities

@code {
  [Parameter(CaptureUnmatchedValues = true)]
  public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
  [Parameter, EditorRequired]
  public RenderFragment ChildContent { get; set; } = default!;

  // group, so the label and spinner inside can follow the button's data-busy
  private const string BaseClass = "group cursor-pointer disabled:cursor-auto disabled:opacity-50";

  [Parameter]
  public ButtonVariant Variant { get; set; }

  // for what a variant doesn't cover, like a width or a position
  [Parameter]
  public string? Class { get; set; }

  // islands only: spins as a static page's button does while static-form-submit.js marks it
  [Parameter]
  public bool Busy { get; set; }

  private string CssClass => ClassNames.Join(ButtonStyles.SizeClass, BaseClass, ButtonStyles.VariantClass(Variant), Class);
}

@* While the button carries data-busy, which js/static-form-submit.js sets on the button that
   submitted a static form, the label turns invisible, still holding the button's size so nothing
   beside it moves, and the spinner shows over its middle. The wrapper is what the spinner is placed
   against, since a caller's Class can position the button itself *@
<button @attributes="AdditionalAttributes" class="@CssClass" data-busy="@Busy" aria-busy="@(Busy ? "true" : null)"><span
    class="relative"><span class="group-data-busy:invisible">@ChildContent</span><span
      class="absolute inset-0 m-auto hidden size-4 animate-spin rounded-full border-2 border-current border-t-transparent group-data-busy:block"
      aria-hidden="true"></span></span></button>
