@using ArtistShop.Web.Utilities

@* a link that looks like a ButtonBasic of the same variant, for going somewhere rather than doing
   something. href comes through AdditionalAttributes *@

@code {
  [Parameter(CaptureUnmatchedValues = true)]
  public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
  [Parameter, EditorRequired]
  public RenderFragment ChildContent { get; set; } = default!;

  // a button centres its text by itself; a link needs flex to
  private const string BaseClass = "inline-flex items-center justify-center";

  [Parameter]
  public ButtonVariant Variant { get; set; }

  // for what a variant doesn't cover, like a width or a position
  [Parameter]
  public string? Class { get; set; }

  private string CssClass => ClassNames.Join(ButtonStyles.SizeClass, BaseClass, ButtonStyles.VariantClass(Variant), Class);
}

<a @attributes="AdditionalAttributes" class="@CssClass">@ChildContent</a>
