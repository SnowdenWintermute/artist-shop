@* A chosen list on a settings page: drag to reorder, ✕ to take one off, each saved at once by the owner's island.
   After a save, Refresh re-renders the page, which passes the saved list back in here *@
@typeparam TItem where TItem : class
@using ArtistShop.Web.Database
@using ArtistShop.Web.Utilities
@inject NavigationManager NavigationManager

@code {
  [Parameter, EditorRequired]
  public required IReadOnlyList<TItem> Items { get; set; }

  [Parameter, EditorRequired]
  public required string AriaLabel { get; set; }

  // saves every item, in the new order
  [Parameter, EditorRequired]
  public required Func<IReadOnlyList<TItem>, Task> Reorder { get; set; }

  [Parameter, EditorRequired]
  public required Func<TItem, Task> Remove { get; set; }

  // what the ✕ button names it
  [Parameter, EditorRequired]
  public required Func<TItem, string> NameOf { get; set; }

  // above the list, given how many it holds
  [Parameter, EditorRequired]
  public required RenderFragment<int> Header { get; set; }

  [Parameter, EditorRequired]
  public required RenderFragment<TItem> RowContent { get; set; }

  private List<TItem> _items = [];
  private bool _isSaving;
  private bool _changedElsewhere;

  protected override void OnParametersSet() => _items = [.. Items];

  private Task MoveAsync((int OldIndex, int NewIndex) move) =>
    SaveAsync(async () =>
    {
      var reordered = _items.Moved(move);

      await Reorder(reordered);
      // shown only once saved, so a failed save can't leave an order on screen that isn't in the database
      _items = reordered;
    });

  private Task RemoveAsync(TItem item) =>
    SaveAsync(async () =>
    {
      await Remove(item);
      // at once, as a drag before the refresh lands would otherwise send an order holding this one
      _items = [.. _items.Where(other => !ReferenceEquals(other, item))];
    });

  private async Task SaveAsync(Func<Task> save)
  {
    // a second drag while the first is saving would send an order built from the old list
    if (_isSaving)
    {
      return;
    }

    _isSaving = true;
    _changedElsewhere = false;

    try
    {
      await save();
    }
    catch (ChangedSincePageLoadException)
    {
      _changedElsewhere = true;
    }
    finally
    {
      _isSaving = false;
    }

    NavigationManager.Refresh();
  }
}

<DisabledUntilInteractive>
  @if (_changedElsewhere)
  {
    <p class="mb-2 text-error">The list was changed somewhere else, so it has been reloaded.</p>
  }

  @Header(_items.Count)

  @if (_items.Count > 0)
  {
    <SortableList TItem="TItem" Items="_items" AriaLabel="@AriaLabel" OnMove="MoveAsync">
      <RowContent Context="item">
        @RowContent(item)
      </RowContent>
      <RowActions Context="item">
        <button type="button" class="cursor-pointer px-1" title="Take off the list" aria-label="@($"Take {NameOf(item)} off the list")"
                disabled="@_isSaving" @onclick="() => RemoveAsync(item)">
          ✕
        </button>
      </RowActions>
    </SortableList>
  }
</DisabledUntilInteractive>
