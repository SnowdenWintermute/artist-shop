@using ArtistShop.Web.Components.Atoms
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager NavigationManager

@code {
  // the query parameter a paged list keeps its page number in, unless it shares its page with others
  public const string PageKey = "page";

  // far past any list's end, and small enough that no page size times it overflows an int offset.
  // A page past the end goes back to the first page anyway
  private const int MaximumPageNumber = 1_000_000;

  // anything below the first page is the first page, so a hand-edited link lands somewhere real
  public static int ReadPageNumber(string? value) =>
    int.TryParse(value, out var pageNumber) && pageNumber > 1 ? Math.Min(pageNumber, MaximumPageNumber) : 1;

  // for a key [SupplyParameterFromQuery] can't name, as it's only known at run time
  public static int ReadPageNumber(NavigationManager navigationManager, string key) =>
    ReadPageNumber(QueryHelpers.ParseQuery(navigationManager.ToAbsoluteUri(navigationManager.Uri).Query)
      .TryGetValue(key, out var values) ? values.FirstOrDefault() : null);

  // A link to a page that has since emptied, as items were deleted or a filter narrowed, goes to the first page.
  // True when it went, and the caller stops loading
  public static bool LeaveEmptiedPage(NavigationManager navigationManager, string key, int pageNumber, int itemCount)
  {
    if (itemCount > 0 || pageNumber <= 1)
    {
      return false;
    }

    navigationManager.NavigateTo(navigationManager.GetUriWithQueryParameter(key, (int?)null));
    return true;
  }

  [Parameter, EditorRequired]
  public int PageNumber { get; set; }

  [Parameter]
  public string Key { get; set; } = PageKey;

  [Parameter, EditorRequired]
  public int PageCount { get; set; }

  // the list is the page's top component, so its next page starts from the page's top, as a new page
  // would. Lower down a page, the page stays where it was scrolled
  [Parameter, EditorRequired]
  public required bool IsPageTop { get; set; }

  // a newest-first list reads better as Newer and Older
  [Parameter]
  public string PreviousText { get; set; } = "← Previous";

  [Parameter]
  public string NextText { get; set; } = "Next →";

  // every other query parameter stays in the address as it is; the first page drops the
  // parameter instead of spelling out page=1
  private string UrlFor(int pageNumber) =>
    NavigationManager.GetUriWithQueryParameter(Key, pageNumber <= 1 ? null : (int?)pageNumber);

  private bool IsOnLastPage => PageNumber == PageCount;
  private bool IsOnFirstPage => PageNumber == 1;

  // how many pages either side of this one get a number
  private const int NeighbourCount = 2;

  // the first and last pages and this one's neighbours, with null where pages are skipped.
  // A single skipped page shows its number, as "…" would take as much room
  private IEnumerable<int?> ShownPages()
  {
    var firstNeighbour = Math.Max(2, PageNumber - NeighbourCount);
    var lastNeighbour = Math.Min(PageCount - 1, PageNumber + NeighbourCount);
    int[] pages = [1, .. Enumerable.Range(firstNeighbour, Math.Max(0, lastNeighbour - firstNeighbour + 1)), PageCount];
    var previous = 0;

    foreach (var page in pages)
    {
      if (page - previous == 2)
      {
        yield return page - 1;
      }
      else if (page - previous > 2)
      {
        yield return null;
      }

      yield return page;
      previous = page;
    }
  }
}

@if (PageCount > 1)
{
  @* js/navigation-scroll.js scrolls to the page's top after a link marked data-scrolls-to-top.
     A span where there is no page to go to: a grayed anchor is still reachable by keyboard,
     and following it lands on an empty page past the end *@
  <nav class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm" aria-label="Pages" data-test="page-links">
    @if (IsOnFirstPage)
    {
      <span class="text-ink-unavailable">@PreviousText</span>
    }
    else
    {
      <a href="@UrlFor(PageNumber - 1)" class="@LinkStyles.Standalone" data-scrolls-to-top="@IsPageTop">@PreviousText</a>
    }

    <span class="flex items-center gap-2">
      @foreach (var page in ShownPages())
      {
        if (page is not { } number)
        {
          <span>…</span>
        }
        else if (number == PageNumber)
        {
          <span class="font-bold" aria-current="page" data-test="current-page">@number</span>
        }
        else
        {
          <a href="@UrlFor(number)" class="@LinkStyles.Standalone" data-scrolls-to-top="@IsPageTop">@number</a>
        }
      }
    </span>

    @if (IsOnLastPage)
    {
      <span class="text-ink-unavailable">@NextText</span>
    }
    else
    {
      <a href="@UrlFor(PageNumber + 1)" class="@LinkStyles.Standalone" data-scrolls-to-top="@IsPageTop">@NextText</a>
    }
  </nav>
}
