@typeparam TItem

@code {
  [Parameter, EditorRequired]
  public List<TItem> Items { get; set; } = default!;
  [Parameter, EditorRequired]
  public string AriaLabel { get; set; } = default!;

  // the radio group's name; inside a form the starred item's value is posted under it
  [Parameter, EditorRequired]
  public string StarName { get; set; } = default!;
  [Parameter, EditorRequired]
  public string StarTitle { get; set; } = default!;
  // null for an item that can't be starred
  [Parameter, EditorRequired]
  public Func<TItem, string?> StarValueOf { get; set; } = default!;
  [Parameter, EditorRequired]
  public string? StarredValue { get; set; }
  [Parameter, EditorRequired]
  public EventCallback<TItem> OnStar { get; set; }

  // shown above the list only while a star is chosen by hand, with a button back to the automatic star
  [Parameter, EditorRequired]
  public string ChosenStarMessage { get; set; } = default!;
  [Parameter, EditorRequired]
  public string ClearStarLabel { get; set; } = default!;
  [Parameter, EditorRequired]
  public EventCallback OnClearStar { get; set; }

  // reports a move without applying it, so the owner can save first
  [Parameter, EditorRequired]
  public EventCallback<(int OldIndex, int NewIndex)> OnMove { get; set; }

  [Parameter, EditorRequired]
  public RenderFragment<TItem> RowContent { get; set; } = default!;
  [Parameter, EditorRequired]
  public RenderFragment<TItem> RowActions { get; set; } = default!;

  private bool IsExplicitlyStarred(TItem item) =>
    StarredValue is not null && StarValueOf(item) == StarredValue;

  // with no explicit star, the first item that can be starred stands in
  private string? EffectiveStarredValue =>
    Items.Any(IsExplicitlyStarred) ? StarredValue : Items.Select(StarValueOf).FirstOrDefault(value => value is not null);

  private string StarClass(TItem item) =>
    IsExplicitlyStarred(item) ? "text-blue-400"
    : StarValueOf(item) == EffectiveStarredValue ? "text-yellow-500"
    : "text-gray-300";
}

@if (Items.Any(IsExplicitlyStarred))
{
  <div class="mb-2 flex items-center gap-2 text-sm min-h-8">
    <span><span class="text-blue-400">★</span> @ChosenStarMessage</span>
    <button type="button" class="cursor-pointer border px-2" @onclick="OnClearStar">
      @ClearStarLabel
    </button>
  </div>
}
else if (Items.Count() > 0)
{
  <div class="mb-2 flex items-center gap-2 text-sm min-h-8">
    <span><span class="text-gray-400">★</span> Click a star to override default</span>
  </div>

}

<SortableList TItem="TItem" Items="Items" AriaLabel="@AriaLabel" OnMove="OnMove" RowActions="RowActions">
  <RowContent Context="item">
    @RowContent(item)

    @if (StarValueOf(item) is string starValue)
    {
      <label class="cursor-pointer px-1 text-lg leading-none" title="@StarTitle">
        <input type="radio" name="@StarName" value="@starValue" checked="@(starValue == EffectiveStarredValue)"
               @onchange="() => OnStar.InvokeAsync(item)" class="peer sr-only" />
        <span class="@StarClass(item) peer-focus-visible:outline">★</span>
      </label>
    }
  </RowContent>
</SortableList>
