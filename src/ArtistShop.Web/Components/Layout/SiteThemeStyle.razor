@using ArtistShop.Web.Database.Repositories
@inject ThemeRepository ThemeRepository
@inject ILogger<SiteThemeStyle> Logger
@inject IHostEnvironment Environment

@code {
  private NamedTheme? _theme;

  protected override async Task OnInitializedAsync()
  {
    _theme = await ThemeRepository.GetInUseAsync();

    if (_theme is null)
    {
      MissingThemeInUse.Report(Logger, Environment);
    }
  }
}

@* on :root, as the platform's are, so the nav bar, the html background past the page's end and an
   open lightbox take them too. Only while PublicLayout's marker is on the page: an enhanced
   navigation to an admin page takes the marker away with this, and the platform's show again *@
@if (_theme is { } theme)
{
  <ThemeStyle Selector=":root:has([data-site-theme])" Theme="theme.Theme" />
}
