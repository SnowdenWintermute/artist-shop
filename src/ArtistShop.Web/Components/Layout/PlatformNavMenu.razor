@using ArtistShop.Web.Identity
@* NavMenu's bar on the platform's host, which has none of a site's pages *@

<div class="h-[70px] border-b flex justify-between items-center pl-[max(1rem,env(safe-area-inset-left))] pr-[max(1rem,env(safe-area-inset-right))] bg-theme-sunken">
  <div class="flex items-center">
    <Logo />
    <nav class="flex">
      <NavItem Text="Home" Href="" Match=NavLinkMatch.All></NavItem>

      <AuthorizeView>
        <Authorized>
          <NavItem Text="My websites" Href="@PageUrls.MySites"></NavItem>
        </Authorized>
      </AuthorizeView>

      <AuthorizeView Policy="@PlatformPolicies.Operator">
        <Authorized>
          <NavItem Text="Operator" Href="@PageUrls.Operator"></NavItem>
        </Authorized>
      </AuthorizeView>
    </nav>
  </div>

  <div>
    <UserAuthMenu />
  </div>
</div>
