@inherits LayoutComponentBase

<div class="h-dvh flex flex-col">
  <div class="">
    <NavMenu />
  </div>

  <div class="w-full bg-theme-recessed flex flex-1 flex-col">
    <div class="flex-1 pt-10 pb-20">
      @Body
    </div>
  </div>

  <div id="blazor-error-ui" class="fixed top-1/2 left-1/2 z-50 hidden -translate-x-1/2 -translate-y-1/2 border-2
    border-red-600 bg-theme-recessed p-6" data-nosnippet>
    <div class="flex items-center">
      An unhandled error has occurred.
      <a href="." class="reload mx-2 underline">Reload</a>
      <button type="button" class="dismiss h-6 w-6 cursor-pointer border text-xl leading-0"
              aria-label="Dismiss">🗙</button>
    </div>
  </div>
</div>
