@using ArtistShop.Web.Sites
@inject CurrentHost CurrentHost
@* a stand-in until sites can have a logo of their own *@

@code {
  // the first two letters of the site's main host, "al" from alice.picturecord.com
  private string Letters =>
    CurrentHost switch
    {
      CurrentHost.Site site => FirstLetters(site.MainHost.Value.Split('.')[0]),
      _ => "PC",
    };

  private static string FirstLetters(string label) => label[..Math.Min(2, label.Length)].ToUpperInvariant();
}

<div class="pointer-events-none">
  <div class="rounded-full border h-[45px] w-[45px] text-center leading-0 flex items-center justify-center">@Letters</div>
</div>
