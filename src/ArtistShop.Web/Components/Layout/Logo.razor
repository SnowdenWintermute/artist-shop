@using ArtistShop.Web.Sites
@inject CurrentHost CurrentHost
@inject PlatformSettings PlatformSettings

@* the start of the nav bar, a link home: a site's logo, or its first letters while it has none *@

@if (CurrentHost is CurrentHost.Site site)
{
  <SiteLogo Site="site" />
}
else
{
  <a href="/" aria-label="@PlatformSettings.Name" class="shrink-0">
    <LogoLetters Name="PC" />
  </a>
}
