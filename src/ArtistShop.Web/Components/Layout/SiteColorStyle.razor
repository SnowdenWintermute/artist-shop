@using ArtistShop.Web.Database.Repositories
@inject ColorRepository ColorRepository

@code {
  private SiteColors? _colors;

  protected override async Task OnInitializedAsync() => _colors = await ColorRepository.GetAsync();
}

@* on :root, as the platform's are, so the nav bar, the html background past the page's end and an
   open lightbox take them too. Only while PublicLayout's marker is on the page: an enhanced
   navigation to an admin page takes the marker away with this, and the platform's show again *@
@if (_colors is { } colors)
{
  <ColorStyle Selector=":root:has([data-site-colors])" Colors="colors" />
}
