@using ArtistShop.Web.Sites
@inherits LayoutComponentBase
@layout MainLayout
@inject CurrentHost CurrentHost

@* The layout of a website's public pages, inside MainLayout: the pages a visitor sees take the
   website's theme, while admin, account and platform pages keep the platform's. On the platform's
   own host, which shares the home and not-found pages, it adds nothing *@
@if (CurrentHost is CurrentHost.Site)
{
  <SiteThemeStyle />
}
@* the marker SiteThemeStyle's selector looks for. contents: it lays nothing out itself *@
<div data-site-theme class="contents">
  @Body
</div>
