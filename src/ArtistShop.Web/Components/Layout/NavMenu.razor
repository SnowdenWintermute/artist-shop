@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Sites

@inject NavigationManager NavigationManager
@inject NavEntryRepository NavEntryRepository

@code {
  private IReadOnlyList<CustomPage> _entries = [];

  protected override async Task OnInitializedAsync() => _entries = await NavEntryRepository.GetAllAsync();

  // the button would only lead back to the page it's on
  private bool OnDashboard =>
    string.Equals(new Uri(NavigationManager.Uri).AbsolutePath.TrimEnd('/'), PageUrls.AdminDashboard,
      StringComparison.OrdinalIgnoreCase);
}

@* the nav bar on a website's pages *@
<NavBar>
  <ChildContent>
    @foreach (var customPage in _entries)
    {
      @* a custom page has no addresses under its own, and the home page's / starts every address *@
      <NavItem Text="@customPage.Name" Href="@PageUrls.CustomPage(customPage)" Match="NavLinkMatch.All" />
    }
  </ChildContent>
  <Actions Context="placement">
    <AuthorizeView Policy="@SitePolicies.Admin">
      <Authorized>
        @if (!OnDashboard)
        {
          @* the drawer is a column that stretches what's in it *@
          <LinkButton Variant="ButtonVariant.PrimaryOutline" href="@PageUrls.AdminDashboard"
                      Class="@(placement is NavBarPlacement.Drawer ? "self-start" : null)">
            Manage website
          </LinkButton>
        }
      </Authorized>
    </AuthorizeView>
  </Actions>
</NavBar>
