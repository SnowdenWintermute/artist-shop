@using ArtistShop.Web.Components.Atoms

@code {
  [Parameter, EditorRequired]
  public RenderFragment ChildContent { get; set; } = default!;

  // links between the pages of one section, shown at the top of the panel
  [Parameter]
  public RenderFragment? SectionNav { get; set; }

  // one width for every admin page, so the panel doesn't jump as the artist moves between them.
  // Public for the dashboard, whose boxes sit side by side instead of in one panel
  public const string WidthClass = "mx-auto max-w-[900px]";

  // for a page built around a wide table, like adding artworks from images
  private const string WideWidthClass = "mx-auto max-w-[1400px]";

  [Parameter]
  public bool Wide { get; set; }
}

<div class="@(Wide ? WideWidthClass : WidthClass)">
  <Panel>
    @if (SectionNav is not null)
    {
      <nav class="mb-2 flex flex-wrap gap-4">
        @SectionNav
      </nav>
      <Divider Class="mb-6" />
    }

    @ChildContent
  </Panel>
</div>
