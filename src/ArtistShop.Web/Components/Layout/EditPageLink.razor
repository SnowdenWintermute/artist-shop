@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Sites
@using Microsoft.AspNetCore.Components.Sections

@code {
  // the admin page that edits what this page shows
  [Parameter, EditorRequired]
  public required string Href { get; set; }

  // after Edit page, for a page whose content is edited somewhere else than its settings
  [Parameter]
  public IReadOnlyList<FooterEditLink> MoreLinks { get; set; } = [];
}

@* drawn in the site footer, for admins only *@
<SectionContent SectionName="@SiteFooter.EditLinkSectionName">
  <AuthorizeView Policy="@SitePolicies.Admin">
    <Authorized>
      @* the editors' preview hides these, as a visitor doesn't see them *@
      <span data-admin-footer-links>
        <span class="mx-1">|</span>
        <a href="@Href" class="@LinkStyles.InSentence">Edit page</a>
        @foreach (var link in MoreLinks)
        {
          <span class="mx-1">|</span>
          <a href="@link.Href" class="@LinkStyles.InSentence">@link.Label</a>
        }
      </span>
    </Authorized>
  </AuthorizeView>
</SectionContent>
