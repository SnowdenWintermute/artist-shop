<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

@* The id and the components-* class names are what Blazor drives: it adds a state class to the dialog
   and fills in the seconds span. The wording and styling are ours. *@
<dialog id="components-reconnect-modal" class="artist-shop-modal max-w-[22rem] border border-theme-base text-theme-base"
        data-nosnippet>
    <div class="components-reconnect-container">
        <div class="components-rejoining-animation" aria-hidden="true">
            <div></div>
            <div></div>
        </div>
        <p class="components-reconnect-first-attempt-visible">
            Reconnecting&hellip;
        </p>
        <p class="components-reconnect-repeated-attempt-visible">
            Reconnecting in <span id="components-seconds-to-next-attempt"></span> seconds&hellip;
        </p>
        <p class="components-reconnect-failed-visible">
            Lost connection to the site.<br />Your unsaved changes are still here.
        </p>
        <button id="components-reconnect-button" class="components-reconnect-failed-visible">
            Try again
        </button>
        <p class="components-pause-visible">
            Paused while this page sat in the background.
        </p>
        <p class="components-resume-failed-visible">
            Couldn't pick up where you left off.<br />Reload the page to carry on.
        </p>
        <button id="components-resume-button" class="components-pause-visible components-resume-failed-visible">
            Carry on
        </button>
    </div>
</dialog>
