@inject IWebHostEnvironment Env
<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <base href="/" />
  <ResourcePreloader />
  <link rel="stylesheet" href="@AppCssHref" />
  <ImportMap />
  <link rel="icon" type="image/png" href="favicon.png" />
  <HeadOutlet />
</head>

<body>
  <Routes />
  <ReconnectModal />
  <script src="@Assets["_framework/blazor.web.js"]"></script>
  <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
  @if (Env.IsDevelopment())
  {
    <script src="_framework/aspnetcore-browser-refresh.js"></script>
  }
</body>

</html>

@code
{
  // Assets fingerprints app.css from the bytes it saw at build time, and hot reload never builds,
  // so in development that url is wrong in both directions: it stays frozen while the tailwind
  // watcher rewrites app.css underneath it, and when something does force a build it moves, leaving
  // every open tab pointed at a url that now 404s. Versioning on the file's own write time instead
  // means the url changes exactly when the css does, and the path behind it always resolves.
  private string AppCssHref =>
      Env.IsDevelopment()
          ? $"app.css?v={File.GetLastWriteTimeUtc(Path.Combine(Env.WebRootPath, "app.css")).Ticks}"
          : Assets["app.css"];
}
