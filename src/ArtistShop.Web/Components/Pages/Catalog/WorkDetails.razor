@using ArtistShop.Web.Components.Catalog
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Domain.Commerce
@using ArtistShop.Web.Domain.Publishing
@using ArtistShop.Web.Sites
@using ArtistShop.Web.Utilities

@code {
  [Parameter, EditorRequired]
  public Work Work { get; set; } = default!;

  [Parameter, EditorRequired]
  public IReadOnlyList<PostMention> Mentions { get; set; } = default!;

  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  // nothing is for sale on the site yet, so a price is a label. Sold work keeps its row
  // without its price
  private static string PriceLine(Product product) =>
    product.Stock < 1 ? "Sold"
    : product.Price is { } price ? PriceText.Of(price)
    : "Price on request";

  // grouped under the vocabulary each term came from, so the panel reads "Medium: Oil, Pastel"
  private static string TermNames(VocabularyTermGroup group) =>
    string.Join(", ", group.Terms.Select(term => term.Name.Value));
}

<div>
  <h1 class="mb-1 text-2xl flex justify-between items-center"><span>@Work.Name.Value</span>
    <AuthorizeView Policy="@SitePolicies.Admin">
      <Authorized>
        <a class="cursor-pointer text-base underline" href="@PageUrls.EditWork(Work.Id)">
          Edit
        </a>
      </Authorized>
    </AuthorizeView>
  </h1>
  <p class="mb-6 text-gray-500">@Work.Type.Name.Value</p>

  @if (Work.Products.Count > 0)
  {
    <ul class="mb-6">
      @foreach (var product in Work.Products)
      {
        <li @key="product.Id" class="flex justify-between gap-4 border-b py-2">
          <span>
            @product.Type.Name.Value

            @if (product.Label is { } label)
            {
              <span class="text-sm text-gray-500">@label</span>
            }

            @if (product.EditionSize is > 1)
            {
              <span class="text-sm text-gray-500">Edition of @product.EditionSize</span>
            }
          </span>

          <span>@PriceLine(product)</span>
        </li>
      }
    </ul>
  }

  @* a field the work type has switched off has no value on the work, so showing only what is
     filled in leaves the empty rows out on its own *@
  <dl class="mb-6 text-sm">
    @if (Work.DateCreated is { } dateCreated)
    {
      <dt class="text-gray-500">Date</dt>
      <dd class="mb-2">@dateCreated.Text</dd>
    }

    @if (Work.Dimensions is { } dimensions)
    {
      <dt class="text-gray-500">Size</dt>
      <dd class="mb-2">@dimensions.Text</dd>
    }

    @if (Work.Duration is { } duration)
    {
      <dt class="text-gray-500">Duration</dt>
      <dd class="mb-2">@WorkDuration.ToText(duration)</dd>
    }

    @foreach (var group in VocabularyOrder.GroupedByVocabulary(Work.VocabularyTerms))
    {
      <dt @key="group.VocabularyId" class="text-gray-500">@group.VocabularyName.Value</dt>
      <dd class="mb-2">@TermNames(group)</dd>
    }

    @if (Work.Collections.Count > 0)
    {
      <dt class="text-gray-500">@(Work.Collections.Count is 1 ? Wording.Collection.SingularHeading : Wording.Collection.PluralHeading)</dt>
      <dd class="mb-2">
        @foreach (var (collection, index) in CollectionOrder.SortedByName(Work.Collections).Select((collection, index) => (collection, index)))
        {
          @(index > 0 ? ", " : "")
          <a href="@PageUrls.Collection(collection.Slug)">@collection.Name.Value</a>
        }
      </dd>
    }
  </dl>

  @if (Work.Description is { } description)
  {
    @* whitespace-pre-line keeps the artist's own line breaks without letting a long line overflow *@
    <p class="mb-6 whitespace-pre-line">@description</p>
  }

  @if (Mentions.Count > 0)
  {
    <WorkMentions Posts="Mentions" />
  }
</div>
