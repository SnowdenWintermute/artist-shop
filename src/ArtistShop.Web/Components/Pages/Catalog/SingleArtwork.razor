@page "/artworks/{slug}"
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Images
@inject ArtworkRepository ArtworkRepository
@inject NavigationManager NavigationManager

@code {
  [Parameter]
  public string Slug { get; set; } = default!;

  private Artwork? artwork;

  protected override async Task OnParametersSetAsync()
  {
    artwork = await ArtworkRepository.GetBySlugAsync(Slug);

    if (artwork is null)
    {
      NavigationManager.NotFound();
    }
  }
}

@if (artwork is not null)
{
  <PageTitle>@artwork.Name.Value</PageTitle>
  <h1>@artwork.Name.Value</h1>
  <h1>@artwork.Description</h1>
  @foreach (var image in artwork.Images)
  {

    <img src="@image.BlurDataUri" />
    <img src="@ImageUrls.Variant(image.StorageKey, image.Width, 800, ImageVariantFormat.Webp)" />
    <div>@image.StorageKey </div>
  }
}
