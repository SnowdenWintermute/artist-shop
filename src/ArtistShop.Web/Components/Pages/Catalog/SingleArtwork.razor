@page "/artworks/{slug}"
@using ArtistShop.Web.Components.Catalog
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@inject ArtworkRepository ArtworkRepository
@inject PostRepository PostRepository
@inject NavigationManager NavigationManager

@code {
  [Parameter]
  public string Slug { get; set; } = default!;

  [SupplyParameterFromQuery(Name = ArtworkPageQuery.SeriesKey)]
  private string? SeriesValue { get; set; }

  [SupplyParameterFromQuery(Name = ArtworkPageQuery.ImageKey)]
  private string? ImageValue { get; set; }

  private LoadedArtwork? _loaded;

  // the address counts from one, the way a person reads "image 2", and everything inside counts
  // from zero. A number that is missing, isn't one, or names an image the artwork no longer has
  // falls back to the starred image, so a stale link still shows the work
  private int CurrentImageIndex(Artwork artwork) =>
    int.TryParse(ImageValue, out var number) && number >= 1 && number <= artwork.Images.Count
      ? number - 1
      : artwork.MainImageIndex;

  // the series the visitor is walking through, when the artwork really is in it. Arriving cold, or
  // on a link to a series it has since left, still gets arrows: the first of its own, by name
  private Series? SeriesFor(Artwork artwork) =>
    artwork.Series.FirstOrDefault(series => series.Slug.Value == SeriesValue)
    ?? SeriesOrder.SortedByName(artwork.Series).FirstOrDefault();

  // where stepping past either end of the images goes: the previous artwork's last image, or the
  // next one's first, rather than their starred ones, so the steps run on without a jump
  private static string? PreviousStepUrl(LoadedArtwork loaded) =>
    loaded.Neighbours.Previous is { } previous
      ? ArtworkPageQuery.Url(previous.Slug.Value, previous.SeriesSlug.Value, previous.ImageCount)
      : null;

  private static string? NextStepUrl(LoadedArtwork loaded) =>
    loaded.Neighbours.Next is { } next
      ? ArtworkPageQuery.Url(next.Slug.Value, next.SeriesSlug.Value, imageNumber: 1)
      : null;

  // where Previous and Next go from the image the page opens on, the same as the arrow keys: the
  // image beside it, or past either end the step to the neighbouring artwork
  private static string? PreviousLinkUrl(LoadedArtwork loaded, int currentIndex) =>
    currentIndex > 0
      ? ArtworkPageQuery.ImageUrl(loaded.Artwork.Slug.Value, loaded.Series?.Slug.Value, currentIndex - 1)
      : PreviousStepUrl(loaded);

  private static string? NextLinkUrl(LoadedArtwork loaded, int currentIndex) =>
    currentIndex < loaded.Artwork.Images.Count - 1
      ? ArtworkPageQuery.ImageUrl(loaded.Artwork.Slug.Value, loaded.Series?.Slug.Value, currentIndex + 1)
      : NextStepUrl(loaded);

  protected override async Task OnParametersSetAsync()
  {
    var artwork = await ArtworkRepository.GetBySlugAsync(Slug);

    if (artwork is null)
    {
      NavigationManager.NotFound();
      return;
    }

    var series = SeriesFor(artwork);

    // a visitor is only sent on to work there is something to look at, which is the rule the
    // series page and the home page count by
    var neighbours = series is null
      ? new ArtworkNeighbours(null, null)
      : await ArtworkRepository.GetNeighboursAsync(
          series.Id,
          artwork.Id,
          onlyArtworksWithImages: true
        );

    var mentions = await PostRepository.GetPublishedMentioningArtworkAsync(artwork.Id);

    _loaded = new LoadedArtwork(artwork, series, neighbours, mentions);
  }
}

@if (_loaded is { } loaded)
{
  <PageTitle>@loaded.Artwork.Name.Value</PageTitle>
  <LinkPreview Title="@loaded.Artwork.Name.Value" Description="@loaded.Artwork.Description"
               Image="loaded.Artwork.Images.ElementAtOrDefault(loaded.Artwork.MainImageIndex)" />

  <main class="mx-auto max-w-[1200px] p-4">
    @if (loaded.Series is { } series)
    {
      <ArtworkSeriesNav Series="series"
                        PreviousUrl="@PreviousLinkUrl(loaded, CurrentImageIndex(loaded.Artwork))"
                        NextUrl="@NextLinkUrl(loaded, CurrentImageIndex(loaded.Artwork))" />
    }

    @* one column on a phone, the panel beside the work once there is room. minmax(0,…) rather
       than a bare 2fr: a grid track's smallest size is its content by default, which a wide
       image would stretch past the page *@
    <div class="grid gap-8 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
      <ArtworkGallery Images="loaded.Artwork.Images" CurrentImageIndex="CurrentImageIndex(loaded.Artwork)"
                      Slug="@loaded.Artwork.Slug.Value" SeriesSlug="@loaded.Series?.Slug.Value"
                      Alt="@loaded.Artwork.Name.Value" PreviousUrl="@PreviousStepUrl(loaded)"
                      NextUrl="@NextStepUrl(loaded)" />

      <ArtworkDetails Artwork="loaded.Artwork" Mentions="loaded.Mentions" />
    </div>
  </main>
}
