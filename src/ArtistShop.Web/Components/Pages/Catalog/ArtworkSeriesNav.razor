@using ArtistShop.Web.Domain.Catalog

@code {
  [Parameter, EditorRequired]
  public Series Series { get; set; } = default!;
  // the same steps as the arrow keys, from the image the page opened on: null where there is
  // nowhere to go
  [Parameter, EditorRequired]
  public string? PreviousUrl { get; set; }
  [Parameter, EditorRequired]
  public string? NextUrl { get; set; }

  // an anchor without an href is no link: it isn't focusable, and these classes gray it
  private const string StepClass = "[&:not([href])]:pointer-events-none [&:not([href])]:select-none [&:not([href])]:text-gray-400";
}

@* ArtworkGallery.razor.js takes a plain click on these and steps as the arrow keys do, and moves
   their hrefs along as the image changes, so a middle click still opens the next step *@
<nav class="mb-4 flex items-center justify-between gap-4" aria-label="@Series.Name.Value">
  <a href="@PageUrls.Series(Series.Slug)">← @Series.Name.Value</a>

  <div class="flex gap-4">
    <a href="@PreviousUrl" data-artwork-step="-1" rel="prev" class="@StepClass">← Previous</a>
    <a href="@NextUrl" data-artwork-step="1" rel="next" class="@StepClass">Next →</a>
  </div>
</nav>
