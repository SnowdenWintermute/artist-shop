@page "/collections/{slug}"
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Catalog
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Utilities
@inject CollectionRepository CollectionRepository
@inject CollectionPageRepository CollectionPageRepository
@inject NavigationManager NavigationManager

@code {
  [Parameter]
  public string Slug { get; set; } = default!;

  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  // the cover is for the card a pasted link turns into
  private CollectionWithCover? _collection;
  private CollectionPageSettings? _settings;

  protected override async Task OnParametersSetAsync()
  {
    _collection = await CollectionRepository.GetWithCoverBySlugAsync(Slug);

    if (_collection is null)
    {
      NavigationManager.NotFound();
      return;
    }

    _settings = await CollectionPageRepository.GetAsync();
  }

  // the page's settings are Edit page; which works it shows are the collection's own
  private IReadOnlyList<FooterEditLink> EditWorksLink(CollectionId id) =>
    [new($"Edit {Wording.Work.PluralInSentence}", PageUrls.EditCollection(id))];
}

@if (_collection is { } collection && _settings is { } settings)
{
  <PageTitle>@collection.Name.Value</PageTitle>
  <EditPageLink Href="@PageUrls.CollectionPageSettingsFor(collection.Id)"
                MoreLinks="EditWorksLink(collection.Id)" />
  <LinkPreview Title="@collection.Name.Value" Image="collection.Cover" />

  <main class="mx-auto max-w-[1200px] p-4">
    <CollectionPageContent Collection="collection" Settings="settings" />
  </main>
}
