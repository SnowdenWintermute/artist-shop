@page "/collections/{slug}"
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Catalog
@using ArtistShop.Web.Components.CustomPages.CardGrids
@using ArtistShop.Web.Components.Lists
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Utilities
@inject CollectionRepository CollectionRepository
@inject NavigationManager NavigationManager

@code {
  [Parameter]
  public string Slug { get; set; } = default!;

  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  // the cover is for the card a pasted link turns into
  private CollectionWithCover? _collection;

  protected override async Task OnParametersSetAsync()
  {
    _collection = await CollectionRepository.GetWithCoverBySlugAsync(Slug);

    if (_collection is null)
    {
      NavigationManager.NotFound();
    }
  }

  // headed by the page's own h1, and the page's only grid, so it keeps the plain page key
  private static CardGridSettings GridFor(CollectionId collectionId) =>
    new(new CardGridSource.WorksInCollection(collectionId), new CardGridHeading.None(), ArtistShopLimits.WorkListPageSize,
      HasPageLinks: true, CardGridLayout.EvenGrid);
}

@if (_collection is { } collection)
{
  <PageTitle>@collection.Name.Value</PageTitle>
  <EditPageLink Href="@PageUrls.EditCollection(collection.Id)" />
  <LinkPreview Title="@collection.Name.Value" Image="collection.Cover" />

  <main class="mx-auto max-w-[1200px] p-4">
    <UpLink Class="mb-4" Href="@PageUrls.Home" Label="@($"All {Wording.Collection.PluralInSentence}")" />

    @* not PageHeading: a collection's name keeps the text font, rather than the theme's heading font *@
    <h1 class="mb-4">@collection.Name.Value</h1>

    <CardGridView Settings="GridFor(collection.Id)" PageKey="@PageLinks.PageKey" />
  </main>
}
