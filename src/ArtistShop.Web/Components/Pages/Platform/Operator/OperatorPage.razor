@page "/operator"
@layout OperatorLayout
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Platform
@using ArtistShop.Web.Identity
@using ArtistShop.Web.Sites
@using Microsoft.AspNetCore.Authorization
@attribute [ServedOn(HostTypes.Platform)]
@attribute [Authorize(Policy = PlatformPolicies.Operator)]
@inject SignUpCodeRepository SignUpCodeRepository

@code {
  private List<SignUpCodeListing> _codes = [];

  // newest first, so a code just made is at the top
  protected override async Task OnInitializedAsync() =>
    _codes = [.. (await SignUpCodeRepository.GetAllAsync()).OrderByDescending(code => code.CreatedAt)];
}

<PageTitle>Sign-up codes</PageTitle>

<h1 class="mb-4 text-xl">Sign-up codes</h1>

<MakeSignUpCodeForm />

<h2 class="mb-2 text-lg">Unused codes</h2>
<SignUpCodeTable @rendermode="InteractiveServer" Codes="_codes" />

<Divider Class="my-6" />

<h2 class="mb-2 text-lg">Sign everyone out</h2>
<p class="mb-4">
  Ends every sign-in, so each account passes through signing in again. For a change that signing in sets up for an
  account, such as the profile its dismissed hints are saved on.
</p>
<SignEveryoneOut @rendermode="InteractiveServer" />
