@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Forms
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Platform
@using Microsoft.AspNetCore.DataProtection
@inject SignUpCodeRepository SignUpCodeRepository
@inject TimeProvider TimeProvider
@inject NavigationManager NavigationManager
@inject IDataProtectionProvider DataProtectionProvider

@code {
  [CascadingParameter]
  private HttpContext HttpContext { get; set; } = default!;

  [SupplyParameterFromForm(FormName = "make-sign-up-code")]
  private SignUpCodeForm Input { get; set; } = default!;

  // shown once, on the page the redirect after making it loads: only its hash is kept
  private SignUpCode? _madeCode;

  protected override void OnInitialized()
  {
    Input ??= new();
    _madeCode = MadeSignUpCodeCookie.Take(HttpContext, DataProtectionProvider);
  }

  private async Task MakeAsync()
  {
    var code = SignUpCode.New();

    await SignUpCodeRepository.AddAsync(
      code,
      Input.TrimmedNote,
      TimeProvider.GetUtcNow().AddDays(Input.DaysValid)
    );

    MadeSignUpCodeCookie.Keep(HttpContext, DataProtectionProvider, code);
    // redirect to this same page: the list reloads, and refreshing the browser won't make another code
    NavigationManager.NavigateTo(NavigationManager.Uri);
  }
}

<EditForm EditContext="Input.EditContext" FormName="make-sign-up-code" OnValidSubmit="MakeAsync" Enhance class="mb-6">
  <DataAnnotationsValidator />

  <TextField Label="For" @bind-Value="Input.Note" />
  <NumberField Label="@($"Expires in days (1 to {SignUpCodeForm.MaximumDaysValid})")" @bind-Value="Input.DaysValid" />
  <ButtonBasic type="submit" Variant="ButtonVariant.Primary">Make code</ButtonBasic>
</EditForm>

@if (_madeCode is { } madeCode)
{
  <div class="mb-6 border p-3">
    <p class="mb-2 font-mono text-lg">@madeCode.Text</p>
    <p>Copy it now: it won't be shown again.</p>
  </div>
}
