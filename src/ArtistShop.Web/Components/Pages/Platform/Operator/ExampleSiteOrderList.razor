@using ArtistShop.Web.Components.Lists
@using ArtistShop.Web.Database
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Sites
@using ArtistShop.Web.Utilities
@inject SiteRepository SiteRepository
@inject NavigationManager NavigationManager

@code {
  // List, not IReadOnlyList: an island parameter is rebuilt from its runtime type, and a declared List
  // can't be a compiler-generated collection type that JSON can't create
  [Parameter, EditorRequired]
  public List<ExampleSiteItem> Sites { get; set; } = default!;

  private List<ExampleSiteItem> _sites = [];
  private bool _isSaving;
  private bool _changedElsewhere;

  // after a change on the page, Refresh re-renders it, which passes the saved list back in here
  protected override void OnParametersSet() => _sites = [.. Sites];

  private async Task MoveAsync((int OldIndex, int NewIndex) move)
  {
    // a second drag while the first is saving would send an order built from the old list
    if (_isSaving)
    {
      return;
    }

    _isSaving = true;
    _changedElsewhere = false;

    try
    {
      var reordered = _sites.Moved(move);

      await SiteRepository.ReorderExamplesAsync([.. reordered.Select(item => new SiteId(item.SiteId))]);
      _sites = reordered;
    }
    catch (ChangedSincePageLoadException)
    {
      _changedElsewhere = true;
    }
    finally
    {
      _isSaving = false;
    }

    NavigationManager.Refresh();
  }
}

<DisabledUntilInteractive>
  @if (_changedElsewhere)
  {
    <p class="mb-2 text-error">An example was added or removed somewhere else, so the list has been reloaded.</p>
  }

  @if (_sites.Count == 0)
  {
    <p>None yet. Check Example on a website below.</p>
  }
  else
  {
    <p class="mb-2 text-sm text-ink-faded">Drag to set the order the home page lists them in.</p>

    <SortableList TItem="ExampleSiteItem" Items="_sites" AriaLabel="Example order" OnMove="MoveAsync">
      <RowContent Context="site">
        <span class="grow wrap-anywhere">
          @site.Host
          @if (site.IsBeingDeleted)
          {
            <span class="text-error">(being deleted, so not shown)</span>
          }
        </span>
      </RowContent>
      <RowActions Context="site" />
    </SortableList>
  }
</DisabledUntilInteractive>
