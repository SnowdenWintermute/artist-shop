@using ArtistShop.Web.Components.Lists
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Website
@using ArtistShop.Web.Utilities
@inject FontRepository FontRepository

@code {
  // every font, in the order saved. List, not IReadOnlyList: an island parameter is rebuilt from its
  // runtime type, and a declared List can't be a compiler-generated collection type that JSON can't create
  [Parameter, EditorRequired]
  public List<Font> Order { get; set; } = default!;

  private List<Font> _fonts = [];
  private bool _isSaving;

  protected override void OnParametersSet() => _fonts = [.. Order];

  private async Task MoveAsync((int OldIndex, int NewIndex) move)
  {
    // a second drag while the first is saving would send an order built from the old list
    if (_isSaving)
    {
      return;
    }

    _isSaving = true;

    try
    {
      var reordered = _fonts.Moved(move);

      await FontRepository.ReorderAsync(reordered);
      _fonts = reordered;
    }
    finally
    {
      _isSaving = false;
    }
  }
}

@* each name in its own font, from the page's FontFaces *@
<DisabledUntilInteractive>
  <p class="mb-2 text-sm text-ink-faded">Drag to set the order the Theme page lists them in.</p>

  <SortableList TItem="Font" Items="_fonts" AriaLabel="Font order" OnMove="MoveAsync">
    <RowContent Context="font">
      @{ var definition = Fonts.For(font); }
      <span class="grow wrap-anywhere" style="font-family: @definition.CssFamily">
        <span class="block text-xl">@definition.Family</span>
        <span class="block">The quick brown fox jumps over the lazy dog.</span>
      </span>
      @if (definition.IsHeadingOnly)
      {
        <span class="text-ink-faded">Heading only</span>
      }
    </RowContent>
    <RowActions Context="font" />
  </SortableList>
</DisabledUntilInteractive>
