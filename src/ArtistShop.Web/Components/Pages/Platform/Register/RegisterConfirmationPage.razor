@page "/Account/RegisterConfirmation"
@using ArtistShop.Web.Sites
@attribute [ServedOn(HostTypes.Platform)]

@* the same whether the email had an account or not; the email itself says which *@

<PageTitle>Check your email</PageTitle>

<AdminPanel>
  <h1 class="mb-4 text-xl">Check your email</h1>
