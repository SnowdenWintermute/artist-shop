@page "/Account/ChoosePassword"
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Forms
@using ArtistShop.Web.Identity
@using ArtistShop.Web.Sites
@using ArtistShop.Web.Utilities
@using Microsoft.AspNetCore.Identity
@attribute [ServedOn(HostTypes.Platform)]
@inject AccountRegistration AccountRegistration
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager NavigationManager

@code {
  [SupplyParameterFromForm(FormName = "choose-password")]
  private ChoosePasswordForm Input { get; set; } = default!;

  // the signed email and return address from Register's email; the form posts back to this same address
  [SupplyParameterFromQuery]
  private string? Token { get; set; }

  private RegistrationLink? _link;
  private bool _hasAccount;

  protected override async Task OnInitializedAsync()
  {
    Input ??= new();
    _link = AccountRegistration.ReadLink(Token);
    _hasAccount = _link is not null && await AccountRegistration.HasConfirmedAccountAsync(_link);
  }

  private async Task CreateAccountAsync()
  {
    if (_link is null || _hasAccount)
    {
      return;
    }

    var result = await AccountRegistration.CreateAccountAsync(_link, Unwrap.Value(Input.Password));

    switch (result)
    {
      case AccountCreationResult.Created created:
        await SignInManager.SignInAsync(created.User, isPersistent: false);
        NavigationManager.NavigateTo(LocalUrl.OrNull(_link.ReturnUrl) ?? PageUrls.MySites);
        break;
      // the same link opened twice at once
      case AccountCreationResult.AlreadyExists:
        _hasAccount = true;
        break;
      case AccountCreationResult.PasswordRefused refused:
        Input.AddPasswordErrors(refused.Errors);
        break;
      default:
        throw new InvalidOperationException($"{result.GetType().Name} isn't an account creation result.");
    }
  }
}

<PageTitle>Choose a password</PageTitle>

<AdminPanel>
  @if (_link is null)
  {
    <h1 class="mb-4 text-xl">This link doesn't work</h1>
    <p>It may have expired: links work for @AccountRegistration.LinkLifetime.TotalHours.ToString("0") hours. <a href="@PageUrls.Register" class="underline">Ask for a new one</a>.</p>
  }
  else if (_hasAccount)
  {
    <h1 class="mb-4 text-xl">You already have an account</h1>
    <p><a href="@PageUrls.Login" class="underline">Sign in</a>, or <a href="@PageUrls.ForgotPassword" class="underline">reset your password</a> if you've forgotten it.</p>
  }
  else
  {
    <h1 class="mb-4 text-xl">Choose a password</h1>
    <p class="mb-4">For your account, @_link.Email.</p>

    <EditForm EditContext="Input.EditContext" FormName="choose-password" OnValidSubmit="CreateAccountAsync" method="post" class="mb-6">
      <DataAnnotationsValidator />

      @* lets a password manager save the password under the right name *@
      <input type="email" value="@_link.Email" autocomplete="username" readonly class="hidden" />
      <TextField Label="Password" @bind-Value="Input.Password" type="password" autocomplete="new-password" />
      <TextField Label="Password again" @bind-Value="Input.ConfirmPassword" type="password" autocomplete="new-password" />
      <ButtonBasic type="submit" Variant="ButtonVariant.Primary">Make account</ButtonBasic>
    </EditForm>
  }
</AdminPanel>
