@page "/signup"
@using System.Security.Claims
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Forms
@using ArtistShop.Web.Domain.Sites
@using ArtistShop.Web.Sites
@using Microsoft.AspNetCore.Authorization
@attribute [ServedOn(HostTypes.Platform)]
@* the website belongs to the signed-in account. Signing in first, rather than giving an email and
   password here, means this form never says whether an email has an account *@
@attribute [Authorize]
@inject SiteSignUp SiteSignUp
@inject NavigationManager NavigationManager
@inject PlatformSettings PlatformSettings

@code {
  [CascadingParameter]
  private HttpContext HttpContext { get; set; } = default!;

  [SupplyParameterFromForm(FormName = "sign-up")]
  private SignUpForm Input { get; set; } = default!;

  protected override void OnInitialized() => Input ??= new();

  private async Task SignUpAsync()
  {
    // Identity keeps the account's id in this claim; [Authorize] means there is one
    var ownerUserId =
      HttpContext.User.FindFirstValue(ClaimTypes.NameIdentifier)
      ?? throw new InvalidOperationException("A signed-in account has no id.");

    var result = await SiteSignUp.SignUpAsync(Input.ToCode(), Input.ToSiteName(), ownerUserId);

    switch (result)
    {
      case SiteSignUpResult.Made made:
        NavigationManager.NavigateTo(SiteSignInUrl(made.Host));
        break;
      case SiteSignUpResult.CodeNotUsable:
        Input.AddCodeNotUsableError();
        break;
      case SiteSignUpResult.NameTaken:
        Input.AddNameTakenError();
        break;
      default:
        throw new InvalidOperationException($"{result.GetType().Name} isn't a sign-up result.");
    }
  }

  // The new site's sign-in page, going on to its admin, on this page's scheme and port (5176 in
  // dev). Being signed in here doesn't sign anyone in there: each host has its own cookie
  private string SiteSignInUrl(HostName host) =>
    new UriBuilder(NavigationManager.BaseUri)
    {
      Host = host.Value,
      Path = "/Account/Login",
      Query = "ReturnUrl=%2Fadmin",
    }.Uri.AbsoluteUri;
}

<PageTitle>Make your website</PageTitle>

<AdminPanel>
  <h1 class="mb-4 text-xl">Make your website</h1>
  <p class="mb-4">It will belong to @HttpContext.User.Identity?.Name.</p>

  @* not enhanced: success leaves for another host, which a full page load reaches most simply *@
  <EditForm EditContext="Input.EditContext" FormName="sign-up" OnValidSubmit="SignUpAsync" class="mb-6">
    <DataAnnotationsValidator />

    <TextField Label="Sign-up code" @bind-Value="Input.Code" autocomplete="off" />
    <TextField Label="@($"Website name: its address will be name.{PlatformSettings.Host.Value}")" @bind-Value="Input.Name"
               autocomplete="off" />
    <ButtonBasic type="submit" Variant="ButtonVariant.Primary">Make my website</ButtonBasic>
  </EditForm>
</AdminPanel>
