@page "/{address}"
@using ArtistShop.Web.Components.CustomPages
@using ArtistShop.Web.Database.Repositories
@layout PublicLayout
@inject CustomPageRepository CustomPageRepository
@inject NavigationManager NavigationManager

@* our own pages' addresses are literal, so they win over this one *@

@code {
  [Parameter]
  public string Address { get; set; } = default!;

  private CustomPage? _page;

  protected override async Task OnParametersSetAsync()
  {
    var page = await CustomPageRepository.GetByAddressAsync(new CustomPageAddress(Address));

    if (page is null)
    {
      NavigationManager.NotFound();
      return;
    }

    // the home page has one address, /
    if (page.IsHome)
    {
      NavigationManager.NavigateTo(PageUrls.Home);
      return;
    }

    _page = page;
  }
}

@if (_page is { } page)
{
  <CustomPageView Page="page" />
}
