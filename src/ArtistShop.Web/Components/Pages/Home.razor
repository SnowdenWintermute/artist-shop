@page "/"
@using ArtistShop.Web.Components.Pages.Platform
@using ArtistShop.Web.Sites
@attribute [ServedOn(HostTypes.Platform | HostTypes.Site)]
@inject CurrentHost CurrentHost

@* the one address that is a page on both types of host, and a different page on each *@
@if (CurrentHost is CurrentHost.Platform)
{
  <PlatformHome />
}
else
{
  <SiteHome />
}
