@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Sites
@using Microsoft.AspNetCore.Authorization
@page "/admin"
@inject ArtworkTypeRepository ArtworkTypeRepository

@attribute [Authorize(Policy = SitePolicies.Admin)]

@code {
  private List<ArtworkType> _artworkTypes = [];

  protected override async Task OnInitializedAsync()
  {
    _artworkTypes = await ArtworkTypeRepository.GetAllAsync();
  }
}

<div>admins allowed</div>

<nav class="flex flex-col">
  <NavLink class="font-sans text-xl text-theme-base hover:text-theme-hovered" href="/admin/catalog/vocabularies/new"
           ActiveClass="underline">
    Vocabularies
  </NavLink>
  <NavLink class="font-sans text-xl text-theme-base hover:text-theme-hovered" href="/admin/catalog/artworks"
           ActiveClass="underline">
    Artworks
  </NavLink>
  <NavLink class="font-sans text-xl text-theme-base hover:text-theme-hovered" href="/admin/catalog/series"
           ActiveClass="underline">
    Series
  </NavLink>
  <NavLink class="font-sans text-xl text-theme-base hover:text-theme-hovered" href="/admin/catalog/types/new"
           ActiveClass="underline">
    Artwork types
  </NavLink>
  <NavLink class="font-sans text-xl text-theme-base hover:text-theme-hovered" href="@PageUrls.PostList"
           ActiveClass="underline">
    Posts
  </NavLink>
  <AuthorizeView Policy="@SitePolicies.Owner">
    <Authorized>
      <NavLink class="font-sans text-xl text-theme-base hover:text-theme-hovered" href="@PageUrls.SiteAdmins"
               ActiveClass="underline">
        Admins
      </NavLink>
    </Authorized>
  </AuthorizeView>
  @foreach (var artworkType in _artworkTypes)
  {
    <NavLink class="font-sans text-xl text-theme-base hover:text-theme-hovered"
             href="@($"/admin/catalog/artworks/add?type={artworkType.Id.Value}")">
      Add a @artworkType.Name.Value.ToLower()
    </NavLink>
    <NavLink class="font-sans text-xl text-theme-base hover:text-theme-hovered"
             href="@($"/admin/catalog/artworks/import?type={artworkType.Id.Value}")">
      Import @artworkType.Name.Value.ToLower() artworks
    </NavLink>
    <NavLink class="font-sans text-xl text-theme-base hover:text-theme-hovered"
             href="@($"/admin/catalog/artworks/images?type={artworkType.Id.Value}")">
      Upload @artworkType.Name.Value.ToLower() images
    </NavLink>
  }
</nav>
