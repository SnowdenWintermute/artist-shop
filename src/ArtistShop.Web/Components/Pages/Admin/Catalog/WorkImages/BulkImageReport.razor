@using ArtistShop.Web.Imports
@using ArtistShop.Web.Components.Lists
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Utilities

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  [Parameter, EditorRequired]
  public IReadOnlyList<BulkImageFile> Files { get; set; } = default!;

  // what the artist most needs to see first: what worked, then what needs them to do something
  private static readonly BulkImageOutcome[] Order =
  [
    BulkImageOutcome.Attached,
    BulkImageOutcome.ExtraAdded,
    BulkImageOutcome.WillAttach,
    BulkImageOutcome.WillAddExtra,
    BulkImageOutcome.Failed,
    BulkImageOutcome.DuplicateNameInUpload,
    BulkImageOutcome.SeveralWorks,
    BulkImageOutcome.WorkHasImages,
    BulkImageOutcome.WorkHasThisFile,
    BulkImageOutcome.NoWork,
  ];

  private string Describe(BulkImageOutcome outcome) =>
    outcome switch
    {
      BulkImageOutcome.Attached => "Added",
      BulkImageOutcome.ExtraAdded => "Added as another image",
      BulkImageOutcome.WillAttach => "Will be added",
      BulkImageOutcome.WillAddExtra => "Will be added as another image",
      BulkImageOutcome.WorkHasThisFile => $"That {Wording.Work.SingularInSentence} already has an image from a file of this name",
      BulkImageOutcome.Failed => "Didn't upload",
      BulkImageOutcome.DuplicateNameInUpload => "Named twice in this upload, so neither was used",
      BulkImageOutcome.SeveralWorks => $"More than one {Wording.Work.SingularInSentence} has this name",
      BulkImageOutcome.WorkHasImages => $"That {Wording.Work.SingularInSentence} already has an image",
      BulkImageOutcome.NoWork => $"No {Wording.Work.SingularInSentence} of this type has this name",
    };
}

@foreach (var outcome in Order)
{
  <ReportGroup Heading="@Describe(outcome)" Items="@(Files.Where(file => file.Outcome == outcome).ToList())" Context="file">
    <ItemContent>
      @file.Path
      @foreach (var workId in file.WorkIds)
      {
        <a class="ml-2 underline" href="@PageUrls.EditWork(new WorkId(workId))">Edit @Wording.Work.SingularInSentence @workId</a>
      }
      @if (file.Error is not null)
      {
        <span class="text-error"> — @file.Error</span>
      }
    </ItemContent>
  </ReportGroup>
}
