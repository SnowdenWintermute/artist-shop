@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Forms.FileUpload
@using ArtistShop.Web.Imports
@using ArtistShop.Web.Utilities

@* what the last drop left out, grouped by why, with the files behind a toggle *@

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  [Parameter, EditorRequired]
  public IReadOnlyList<SkippedImage> Skipped { get; set; } = default!;
  [Parameter, EditorRequired]
  public UnusableFileCounts Unusable { get; set; } = default!;

  private string Why(WorkFromImagesSkipReason reason) =>
    reason switch
    {
      WorkFromImagesSkipReason.TooDeep => "in deeply nested folders",
      WorkFromImagesSkipReason.SameNameInUpload => "named the same as another file you dropped",
      WorkFromImagesSkipReason.TitleTooLong => "with a name too long for a title",
      WorkFromImagesSkipReason.NoWebAddress => "with no letters or numbers in their name",
      WorkFromImagesSkipReason.WorkExists => $"named like one of your {Wording.Work.PluralInSentence} of this type",
    };
}

@if (Skipped.Count > 0 || Unusable.Any)
{
  <ul class="mb-4 text-sm">
    <UnusableFileItems Counts="Unusable" />
    @foreach (var reason in Skipped.GroupBy(skipped => skipped.Reason))
    {
      <li @key="reason.Key">
        <Disclosure SummaryClass="text-yellow-700">
          <Summary>@CountText.Of(reason.Count(), "image") skipped, @Why(reason.Key)</Summary>
          <ChildContent>
            <ul class="ml-4 text-gray-600">
              @foreach (var skipped in reason)
              {
                <li>@skipped.Path</li>
              }
            </ul>
          </ChildContent>
        </Disclosure>
      </li>
    }
  </ul>
}
