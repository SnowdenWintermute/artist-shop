@page "/admin/catalog/works/add-from-images"
@using ArtistShop.Web.Components.Hints
@using ArtistShop.Web.Domain.Platform
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Sites
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = SitePolicies.Admin)]

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  // the type to start with; without one the island starts at the type its admin last chose
  [SupplyParameterFromQuery(Name = "type")]
  private int? TypeIdValue { get; set; }
}

<PageTitle>Add @Wording.Work.PluralInSentence from images</PageTitle>

<main>
  <AdminPanel Wide>
    <AdminUpLink />
    <h1 class="mb-4 text-xl">Add @Wording.Work.PluralInSentence from images</h1>

    <Hint Type="HintType.AddWorksFromImages">
      <p class="mb-4">
        Select the @Wording.Work.SingularInSentence type first.
        <WorkTypeExamples /> <a class="@LinkStyles.InSentence" href="@PageUrls.NewWorkType">Define
        your own types here</a>.
      </p>
      <p class="mb-4">
        @Wording.Work.PluralHeading are saved in the catalog under the name of each image uploaded. You will have the
        option to create @Wording.Collection.PluralInSentence from the names each folder uploaded.
      </p>
      <h2 class="font-bold mb-2">FAQ</h2>
      <p class="italic">What if my folders contain images of multiple @Wording.Work.SingularInSentence types?</p>
      <p class="mb-4">
        If you have a folder containing images of multiple @Wording.Work.SingularInSentence types, drop each type's
        images separately.
      </p>
      <p class="italic">Do I need to store duplicate @Wording.Work.SingularInSentence images to put them in multiple
        @Wording.Collection.PluralInSentence?</p>
        <p>
          While @Wording.Work.PluralInSentence are associated with @Wording.Collection.PluralInSentence by their
          containing folder, it is not suggested
          to duplicate images across @Wording.Collection.SingularInSentence folders in the case you wish to include a
          single @Wording.Work.SingularInSentence
          in multiple @Wording.Collection.PluralInSentence. Once uploaded, you can assign
          @Wording.Collection.PluralInSentence to as many @Wording.Collection.PluralInSentence as you wish.
        </p>

      </Hint>

      <p class="mb-4 flex items-center">
        <span class="text-ink flex items-center justify-center mr-2">
          <SvgIcon Name="floppy-disc" Class="size-5" />
        </span>
        <span>@Wording.Work.PluralHeading are saved after each edit</span>
      </p>

      @* the island posts each image to an endpoint that checks the antiforgery token, and there is
       no form on this page to carry one *@
      <AntiforgeryToken />

      <WorksFromImagesEditor InitialWorkTypeId="TypeIdValue" />
    </AdminPanel>
  </main>
