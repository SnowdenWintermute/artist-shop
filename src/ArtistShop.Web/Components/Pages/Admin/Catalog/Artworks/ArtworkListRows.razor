@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Tables
@using ArtistShop.Web.Domain.Catalog

@code {
  [Parameter, EditorRequired]
  public IReadOnlyList<ArtworkListItem> Items { get; set; } = default!;

  // null leaves the title as text
  [Parameter, EditorRequired]
  public Func<ArtworkListItem, string?> RowHref { get; set; } = default!;

  // gives each row a checkbox, which ArtworkListBrowser's form around this table submits. The
  // whole row is its label, and on a phone the box is hidden. The label covers the row's links
  // too, so a list with a selection passes a RowHref that returns null
  [Parameter]
  public ArtworkListSelection? Selection { get; set; }

  // whether an artwork is for sale doesn't bear on picking it, so the checkbox takes that column
  private IReadOnlyList<DataTableHeading> Headings =>
    ["", "Title", new("Type", WideOnly), new("Series", WideOnly), new("Images", WideOnly),
      new(Selection is null ? "For sale" : "", WideOnly)];

  // a phone keeps only the thumbnail and the title
  private const string WideOnly = "max-sm:hidden";

  // the whole row shows the check, as a phone hides the box
  private string? RowClass =>
    Selection is null ? null : "has-checked:bg-theme-selected has-checked:hover:bg-theme-selected has-focus-visible:outline-2";

  private string? CheckboxId(ArtworkListItem item) => Selection is null ? null : $"checkbox-{item.Id.Value}";
}

@if (Items.Count == 0)
{
  <div>
    <p>No artworks match these filters.</p>
    <LoadingIndicator />
  </div>
}
else
{
  @* a table, so every row's cells take their width from the same column: a grid per row
     sized each one to its own contents, which left the headings sitting over nothing *@
  @* the indicator is positioned against this wrapper: a div inside the table itself is
     foster-parented out by the html parser, which leaves it with nothing to sit against *@
  <div class="relative">
    <DataTable Items="Items" Headings="Headings" RowClass="@RowClass"
               Class="artist-shop-fades-while-loading">
      <Row Context="item">
        <ArtworkListCell CheckboxId="@CheckboxId(item)">
          <a href="@RowHref(item)" class="border block w-fit">
            <ArtworkThumbnail Image="item.PrimaryImage" Class="size-15 sm:size-20" />
          </a>
        </ArtworkListCell>

        @* on a phone the title takes the width that's left and stops at its edge: a cell's width
           only holds back its text once max-w-0 stops it growing to fit *@
        <ArtworkListCell CheckboxId="@CheckboxId(item)" Class="max-sm:w-full max-sm:max-w-0">
          @if (RowHref(item) is { } href)
          {
            <a href="@href" class="underline max-sm:block max-sm:truncate">@item.Name.Value</a>
          }
          else
          {
            <span class="max-sm:block max-sm:truncate">@item.Name.Value</span>
          }

          @if (item.DateCreated is { } dateCreated)
          {
            <span class="block text-xs text-gray-500 max-sm:truncate">@dateCreated.Text</span>
          }
        </ArtworkListCell>

        <ArtworkListCell CheckboxId="@CheckboxId(item)" Class="@($"text-sm {WideOnly}")">
          @item.ArtworkTypeName.Value
        </ArtworkListCell>

        <ArtworkListCell CheckboxId="@CheckboxId(item)" Class="@($"text-sm text-gray-600 {WideOnly}")">
          @item.SeriesNames
        </ArtworkListCell>

        <ArtworkListCell CheckboxId="@CheckboxId(item)" Class="@($"text-sm text-gray-600 {WideOnly}")">
          @item.ImageCount
        </ArtworkListCell>

        @if (Selection is null)
        {
          <DataTableCell Class="@($"text-sm text-gray-600 {WideOnly}")">@(item.IsForSale ? "Yes" : "No")</DataTableCell>
        }
        else
        {
          @* sr-only rather than hidden, so a phone's keyboard and screen reader still reach the box *@
          <ArtworkListCell CheckboxId="@CheckboxId(item)" Class="max-sm:sr-only">
            <RowSelectCheckbox ItemName="@item.Name.Value" id="@CheckboxId(item)" name="@Selection.FieldName"
                               value="@item.Id.Value" checked="@Selection.Contains(item.Id)" />
          </ArtworkListCell>
        }
      </Row>
    </DataTable>

    <LoadingIndicator />
  </div>
}
