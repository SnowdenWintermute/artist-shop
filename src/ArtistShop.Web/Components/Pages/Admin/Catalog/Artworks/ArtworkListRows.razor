@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Tables
@using ArtistShop.Web.Domain.Catalog

@code {
  [Parameter, EditorRequired]
  public IReadOnlyList<ArtworkListItem> Items { get; set; } = default!;

  // null leaves the title as text
  [Parameter, EditorRequired]
  public Func<ArtworkListItem, string?> RowHref { get; set; } = default!;

  // gives each row a checkbox, which ArtworkListBrowser's form around this table submits
  [Parameter]
  public ArtworkListSelection? Selection { get; set; }

  private static readonly string[] ColumnHeadings = ["", "Title", "Type", "Series", "Images", "For sale"];

  private IReadOnlyList<string> Headings => Selection is null ? ColumnHeadings : [.. ColumnHeadings, ""];
}

@if (Items.Count == 0)
{
  <div>
    <p>No artworks match these filters.</p>
    <LoadingIndicator />
  </div>
}
else
{
  @* a table, so every row's cells take their width from the same column: a grid per row
     sized each one to its own contents, which left the headings sitting over nothing *@
  @* the indicator is positioned against this wrapper: a div inside the table itself is
     foster-parented out by the html parser, which leaves it with nothing to sit against *@
  <div class="relative">
    <DataTable Items="Items" Headings="Headings"
               Class="artist-shop-fades-while-loading">
      <Row Context="item">
        <DataTableCell>
          <a href="@RowHref(item)" class="border block w-fit">
            <ArtworkThumbnail Image="item.PrimaryImage" Class="size-20" />
          </a>
        </DataTableCell>

        <DataTableCell>
          @if (RowHref(item) is { } href)
          {
            <a href="@href" class="underline">@item.Name.Value</a>
          }
          else
          {
            <span>@item.Name.Value</span>
          }

          @if (item.DateCreated is { } dateCreated)
          {
            <span class="block text-xs text-gray-500">@dateCreated.Text</span>
          }
        </DataTableCell>

        <DataTableCell Class="text-sm">@item.ArtworkTypeName.Value</DataTableCell>

        <DataTableCell Class="text-sm text-gray-600">@item.SeriesNames</DataTableCell>

        <DataTableCell Class="text-sm text-gray-600">@item.ImageCount</DataTableCell>

        <DataTableCell Class="text-sm text-gray-600">@(item.IsForSale ? "Yes" : "No")</DataTableCell>

        @if (Selection is not null)
        {
          <DataTableCell>
            <RowSelectCheckbox ItemName="@item.Name.Value" name="@Selection.FieldName" value="@item.Id.Value"
                               checked="@Selection.Contains(item.Id)" />
          </DataTableCell>
        }
      </Row>
    </DataTable>

    <LoadingIndicator />
  </div>
}
