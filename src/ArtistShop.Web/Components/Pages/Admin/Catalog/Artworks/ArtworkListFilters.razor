@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Catalog
@using ArtistShop.Web.Components.Forms
@using ArtistShop.Web.Domain.Catalog

@code {
  [Parameter, EditorRequired]
  public ArtworkListFilter Filter { get; set; } = default!;
  [Parameter, EditorRequired]
  public IReadOnlyList<ArtworkType> Types { get; set; } = default!;
  [Parameter, EditorRequired]
  public IReadOnlyList<VocabularyWithTerms> Vocabularies { get; set; } = default!;
  // in the artist's order
  [Parameter, EditorRequired]
  public IReadOnlyList<Series> Series { get; set; } = default!;
  [Parameter, EditorRequired]
  public string ClearFiltersHref { get; set; } = default!;
  [Parameter]
  public IReadOnlyDictionary<string, string>? KeptFields { get; set; }

  // Hidden when clearing would change nothing. Compared as filters, not addresses: the form sends
  // its empty fields too, so a list back at the cleared filters never has the same address. The
  // picker's cleared list keeps its images filter
  private string ClearFiltersClass =>
    Filter.HasSameFiltersAs(ArtworkListQuery.ReadAddress(ClearFiltersHref)) ? "invisible" : "";

  // the artist's order inside a series can only sort a list that is one series' worth
  private IEnumerable<ArtworkListSort> SortOptions =>
    Enum.GetValues<ArtworkListSort>()
      .Where(sort => sort != ArtworkListSort.SeriesOrder || Filter.SeriesId is not null);

  private List<(int Value, string Label)> TypeOptions =>
    [.. Types.Select(type => (type.Id.Value, type.Name.Value))];

  private HashSet<int> SelectedTypeIds => [.. Filter.ArtworkTypeIds.Select(id => id.Value)];

  private static List<(int Value, string Label)> TermOptions(VocabularyWithTerms vocabulary) =>
    [.. vocabulary.Terms.Select(term => (term.Id.Value, term.Name.Value))];

  private HashSet<int> SelectedTermIds => [.. Filter.VocabularyTermIds.Select(id => id.Value)];
}

@* a GET form, so submitting it writes the filters into the address bar. It carries no page
   number, which is what sends a changed filter back to the first page.
   data-enhance: blazor builds the address from the fields and patches the page in, instead of
   the browser reloading it, which is what put the address in the tab's title mid-submit *@
<form method="get" data-enhance class="mb-4 border p-4">
  @foreach (var (name, value) in KeptFields ?? new Dictionary<string, string>())
  {
    <input type="hidden" name="@name" value="@value" />
  }

  <SubmitOnChange>
    <div class="mb-3 flex flex-wrap items-end gap-4">
      <label>
        <span class="artist-shop-field-label">Search titles</span>
        <input type="search" name="@ArtworkListQuery.SearchKey" value="@Filter.SearchText"
               class="artist-shop-field-input" />
      </label>

      <label>
        <span class="artist-shop-field-label">Series</span>
        <select name="@ArtworkListQuery.SeriesKey" class="artist-shop-field-input">
          <option value="">Any series</option>
          @foreach (var series in Series)
          {
            <option value="@series.Id.Value" selected="@(Filter.SeriesId == series.Id)">@series.Name.Value</option>
          }
        </select>
      </label>

      <YesNoSelect Label="Images" Name="@ArtworkListQuery.ImagesKey" Value="Filter.HasImages"
                   EitherLabel="With or without" YesLabel="With images" NoLabel="Without images" />

      <YesNoSelect Label="For sale" Name="@ArtworkListQuery.SaleKey" Value="Filter.IsForSale"
                   EitherLabel="For sale or not" YesLabel="For sale" NoLabel="Not for sale" />

      <label>
        <span class="artist-shop-field-label">Sort by</span>
        <select name="@ArtworkListQuery.SortKey" class="artist-shop-field-input">
          @foreach (var sort in SortOptions)
          {
            <option value="@ArtworkListQuery.Value(sort)" selected="@(Filter.Sort == sort)">
              @ArtworkListQuery.Label(sort)
            </option>
          }
        </select>
      </label>
    </div>

    @if (Types.Count > 1)
    {
      <CheckboxGroup Legend="Work type" Name="@ArtworkListQuery.TypeKey" Options="TypeOptions"
                     SelectedValues="SelectedTypeIds" />
    }

    @* several terms from one vocabulary widen the search, while a term from a second
       vocabulary narrows it: an artwork has to match one term in each *@
    @foreach (var vocabulary in Vocabularies.Where(vocabulary => vocabulary.Terms.Count > 0))
    {
      <CheckboxGroup @key="vocabulary.Id" Legend="@vocabulary.Name.Value" Name="@ArtworkListQuery.TermKey"
                     Options="TermOptions(vocabulary)" SelectedValues="SelectedTermIds" />
    }

    <div class="flex items-center gap-4">
      @* app.css hides this unless the browser runs no scripts, which is the only case that
         can't submit the filter bar by itself *@
      <ButtonBasic type="submit" Variant="ButtonVariant.Outline" data-part="apply">Apply filters</ButtonBasic>

      <a href="@ClearFiltersHref" class="@ClearFiltersClass">Clear filters</a>
    </div>
  </SubmitOnChange>
</form>
