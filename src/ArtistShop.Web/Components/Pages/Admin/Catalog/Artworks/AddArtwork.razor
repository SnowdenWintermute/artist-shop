@page "/admin/catalog/artworks/add"
@using System.Globalization
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Catalog
@using ArtistShop.Web.Components.Forms
@using ArtistShop.Web.Components.Forms.FileUpload.Images
@using ArtistShop.Web.Components.Pages.Catalog
@using ArtistShop.Web.Database
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Domain.Sites
@using ArtistShop.Web.Identity
@using ArtistShop.Web.Images
@using ArtistShop.Web.Sites
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = SitePolicies.Admin)]
@inject ArtworkRepository ArtworkRepository
@inject ArtworkTypeRepository ArtworkTypeRepository
@inject VocabularyRepository VocabularyRepository
@inject SeriesRepository SeriesRepository
@inject NavigationManager NavigationManager
@inject ImageStorage ImageStorage
@inject SiteMemberInputValueRepository InputValues
@inject CurrentSite CurrentSite

@code {
  [SupplyParameterFromForm]
  private ArtworkForm Input { get; set; } = default!;
  // the form shows only this type's choices. Without one the page goes to the type its admin last chose
  [SupplyParameterFromQuery(Name = "type")]
  private int? TypeIdValue { get; set; }
  [SupplyParameterFromQuery(Name = "added")]
  private string? AddedSlug { get; set; }

  // the prefix keeps this from clashing with ImagesField's key: sibling keys must differ even
  // between different components, and AddedSlug alone is what both would use
  private string PickersKey => $"pickers-{AddedSlug}";

  [CascadingParameter]
  private HttpContext HttpContext { get; set; } = default!;

  private bool _staleChoices;

  // sorted by name, for the type select
  private List<ArtworkType> _artworkTypes = [];
  private bool _hasNoTypes;

  private List<(string Value, string Label)> TypeOptions =>
    [.. _artworkTypes.Select(type => (type.Id.Value.ToString(CultureInfo.InvariantCulture), type.Name.Value))];

  private ArtworkType? _type;
  private IReadOnlyList<ArtworkField> _fields = [];
  private List<VocabularyWithTerms> _vocabularies = [];
  private List<Vocabulary> _vocabulariesWithoutArtworkTypes = [];
  // in the artist's order
  private List<Series> _series = [];

  protected override async Task OnInitializedAsync()
  {
    Input ??= new();
    _artworkTypes = ArtworkTypeOrder.SortedByName(await ArtworkTypeRepository.GetAllAsync());

    if (TypeIdValue is null)
    {
      await GoToStartingTypeAsync();
      return;
    }

    var typeWithFields = TypeIdValue is int typeId ? await ArtworkTypeRepository.GetAsync(new ArtworkTypeId(typeId)) : null;

    if (typeWithFields is null)
    {
      NavigationManager.NotFound();
      return;
    }

    _type = new ArtworkType(typeWithFields.Id, typeWithFields.Name);
    _fields = typeWithFields.Fields;
    Input.ClearFieldsOutside(_fields);
    _vocabularies = await VocabularyRepository.GetAllWithTermsForArtworkTypeAsync(_type.Id);
    _vocabulariesWithoutArtworkTypes = await VocabularyRepository.GetAllWithoutArtworkTypesAsync();
    _series = await SeriesRepository.GetAllAsync();
  }

  // A redirect rather than showing that type here, so the address names the type the form posts to:
  // the saved choice could change in another tab before this form is submitted
  private async Task GoToStartingTypeAsync()
  {
    var saved = await InputValues.GetAsync(CurrentSite.Id, HttpContext.User.RequiredUserId(), RememberedInputs.AddArtworkType);
    var type = _artworkTypes.FirstOrDefault(type => type.Id.Value.ToString(CultureInfo.InvariantCulture) == saved)
               ?? _artworkTypes.FirstOrDefault();

    if (type is null)
    {
      _hasNoTypes = true;
      return;
    }

    NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameter("type", type.Id.Value));
  }

  private async Task SubmitArtwork(EditContext editContext)
  {
    if (_type is null)
    {
      return;
    }

    // <ValidationMessage /> will show whatever goes in here
    var validationMessages = new ValidationMessageStore(editContext);

    // adding an artwork one at a time without an image is more likely a slip than a plan. The CSV
    // import and the bulk uploader are the way to catalogue first and photograph later
    if (Input.Images.Count is 0)
    {
      validationMessages.Add(() => Input.Images, "Add at least one image.");
      // tells the ValidationMessage components to re-render with the new messages
      editContext.NotifyValidationStateChanged();
      return;
    }

    // if the form sat open longer than the grace period, the sweep may have deleted uploads
    var missingImages = Input.ImagesMissingFrom(ImageStorage);

    if (missingImages.Count > 0)
    {
      foreach (var image in missingImages)
      {
        validationMessages.Add(() => Input.Images, ArtworkForm.MissingImageMessage(image));
      }

      editContext.NotifyValidationStateChanged();
      return;
    }

    ArtworkIdentifiers identifiers;

    try
    {
      identifiers = await ArtworkRepository.AddAsync(Input.ToCatalogAddition(_type.Id));
    }
    catch (ChangedSincePageLoadException)
    {
      // nothing was saved, so the form and its uploads are still here; the pickers below have
      // already dropped whatever no longer exists
      _staleChoices = true;
      return;
    }

    NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
    { ["added"] = identifiers.Slug.Value }));
  }
}

@if (_hasNoTypes)
{
  <PageTitle>Add an artwork</PageTitle>

  <main>
    <AdminPanel>
      <h1 class="mb-4">Add an artwork</h1>
      <p>Adding artworks starts with an <a href="@PageUrls.NewArtworkType" class="underline">artwork type</a>.</p>
    </AdminPanel>
  </main>
}
else if (_type is not null)
{
  var typeName = _type.Name.Value.ToLower();

  <PageTitle>Add a @typeName</PageTitle>

  <main>
    <AdminPanel>
      <h1>Add a @typeName</h1>

      @* outside the form below, since forms can't be nested. The type decides the form's fields, so
         choosing one loads the page for it *@
      <form method="get" data-enhance class="mb-4">
        <SubmitOnChange>
          <label class="mb-4 block">
            <span class="artist-shop-field-label">Artwork type</span>
            <RememberedSelect Name="type" InputName="@RememberedInputs.AddArtworkType" Options="TypeOptions"
                              Value="@_type.Id.Value.ToString(CultureInfo.InvariantCulture)" Class="artist-shop-field-input" />
          </label>

          @* app.css hides this unless the browser runs no scripts *@
          <ButtonBasic type="submit" Variant="ButtonVariant.Outline" data-part="apply">Change type</ButtonBasic>
        </SubmitOnChange>
      </form>

      @if (AddedSlug is not null)
      {
        <p class="text-green-600">
          Added.
          <a href="@ArtworkPageQuery.Url(AddedSlug, seriesSlug: null, imageNumber: null)">View it</a>
        </p>
      }

      @* at the top, so the artist sets these up before filling in the form, not after *@
      <CatalogSetupNotice ArtworkType="_type" TypeVocabularies="_vocabularies"
                          VocabulariesWithoutArtworkTypes="_vocabulariesWithoutArtworkTypes" SeriesCount="_series.Count" />

      <EditForm Model="Input" FormName="new-artwork" OnValidSubmit="SubmitArtwork" Enhance data-waits-for-pending>
        <DataAnnotationsValidator />

        <TextField Label="Title" @bind-Value="Input.Name" />
        @if (_fields.Contains(ArtworkField.DateCreated))
        {
          <PartialDateField Label="Date created" @bind-Year="Input.YearCreated" @bind-Month="Input.MonthCreated"
                            @bind-Day="Input.DayCreated" />
        }
        <TextAreaField Label="Description" @bind-Value="Input.Description" />
        @if (_fields.Contains(ArtworkField.HeightAndWidth))
        {
          <NumberField Label="Height (cm)" @bind-Value="Input.HeightCm" />
          <NumberField Label="Width (cm)" @bind-Value="Input.WidthCm" />
        }
        @if (_fields.Contains(ArtworkField.Depth))
        {
          <NumberField Label="Depth (cm)" @bind-Value="Input.DepthCm" />
        }
        @if (_fields.Contains(ArtworkField.Duration))
        {
          <TextField Label="@($"Duration ({ArtworkDuration.ExpectedFormat})")" @bind-Value="Input.Duration" />
        }

        @* @key: a fresh island after each artwork is added, like ImagesField *@
        <TermAndSeriesPickers @key="PickersKey" ArtworkTypeId="_type.Id" Vocabularies="_vocabularies" AllSeries="_series"
                              SelectedVocabularyTermIds="Input.VocabularyTermIds" SelectedSeriesIds="Input.SeriesIds" />

        <ValidationMessage For="() => Input.Images" class="mb-4 block text-red-400" />
        @* SelectedImages: a submit that came back with an error has already posted these, and the
           island renders the hidden inputs that carry them *@
        <ImagesField @key="AddedSlug" FieldName="Input.Images" PrimaryFieldName="Input.PrimaryImageKey"
                     SelectedImages="Input.ToArtworkImages()" SelectedPrimaryImageKey="@Input.PrimaryImageKey"
                     SuggestNameInto="Input.Name" />

        @if (_staleChoices)
        {
          <p class="mb-4 text-red-400">
            Something on this form was removed in another tab: a term, a series or a field. The form has
            been updated to match. Check it and submit again.
          </p>
        }

        <ButtonBasic type="submit" Variant="ButtonVariant.Primary" Class="text-lg">
          Add @typeName
        </ButtonBasic>
      </EditForm>
    </AdminPanel>
  </main>
}
