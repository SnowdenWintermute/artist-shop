@using System.Globalization
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Catalog
@using ArtistShop.Web.Components.Forms
@using ArtistShop.Web.Components.Lists
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Search
@using ArtistShop.Web.Utilities
@using Microsoft.AspNetCore.WebUtilities
@inject ArtworkRepository ArtworkRepository
@inject ArtworkSearch ArtworkSearch
@inject ArtworkTypeRepository ArtworkTypeRepository
@inject VocabularyRepository VocabularyRepository
@inject SeriesRepository SeriesRepository
@inject NavigationManager NavigationManager

@* The filterable artwork list, read from the address it's on, so it works the same on any page
   that places it: the admin artwork list, and the picker a post's editor opens in a frame *@

@code {
  // where an artwork's row leads: its edit page in the admin, the next step in the post editor's
  // picker. Null leaves the row as text
  [Parameter, EditorRequired]
  public Func<ArtworkListItem, string?> RowHref { get; set; } = default!;

  // the list with no filters, wherever this one is
  [Parameter, EditorRequired]
  public string ClearFiltersHref { get; set; } = default!;

  // Query parameters of the page's own that the filter form keeps when it submits, which a GET
  // form otherwise drops, as it sends only its own fields. Paging keeps them by itself
  [Parameter]
  public IReadOnlyList<(string Name, string Value)>? KeptFields { get; set; }

  // leaves out the artworks already in this series, for a page adding to it
  [Parameter]
  public SeriesId? ExcludedSeriesId { get; set; }

  // gives each row a checkbox; a tick submits at once and lands in the address
  [Parameter]
  public ArtworkListSelection? Selection { get; set; }

  [SupplyParameterFromQuery(Name = ArtworkListQuery.TypeKey)]
  private int[]? TypeIds { get; set; }
  [SupplyParameterFromQuery(Name = ArtworkListQuery.TermKey)]
  private int[]? TermIds { get; set; }
  // read as text and parsed in one place, so an empty or hand-edited value is a missing
  // filter rather than a failure
  [SupplyParameterFromQuery(Name = ArtworkListQuery.SeriesKey)]
  private string? SeriesValue { get; set; }
  [SupplyParameterFromQuery(Name = ArtworkListQuery.SearchKey)]
  private string? SearchValue { get; set; }
  [SupplyParameterFromQuery(Name = ArtworkListQuery.ImagesKey)]
  private string? ImagesValue { get; set; }
  [SupplyParameterFromQuery(Name = ArtworkListQuery.SaleKey)]
  private string? SaleValue { get; set; }
  [SupplyParameterFromQuery(Name = ArtworkListQuery.SortKey)]
  private string? SortValue { get; set; }
  [SupplyParameterFromQuery(Name = PageLinks.PageKey)]
  private string? PageValue { get; set; }

  private LoadedArtworkList? _loaded;

  // not OnInitializedAsync: a filter change is the same page with new query parameters
  protected override async Task OnParametersSetAsync()
  {
    var filter = ArtworkListQuery.Read(
      typeIds: TypeIds,
      termIds: TermIds,
      series: SeriesValue,
      search: SearchValue,
      images: ImagesValue,
      sale: SaleValue,
      sort: SortValue,
      page: PageValue
    );

    // null means nothing was searched for, which is not the same as a search that found nothing
    var searchMatches =
      filter.SearchText is null ? null : await ArtworkSearch.FindAsync(filter.SearchText);

    var artworks = await ArtworkRepository.GetListAsync(filter, searchMatches, ExcludedSeriesId);

    // a link to a page that has since emptied, because the filter narrowed or artworks were deleted
    if (artworks.Items.Count == 0 && filter.PageNumber > 1)
    {
      NavigationManager.NavigateTo(
        NavigationManager.GetUriWithQueryParameter(PageLinks.PageKey, (int?)null)
      );
      return;
    }

    var types = await ArtworkTypeRepository.GetAllAsync();
    var vocabularies = await VocabularyRepository.GetAllWithTermsAsync();

    _loaded = new LoadedArtworkList(
      filter,
      artworks,
      ArtworkTypeOrder.SortedByName(types),
      VocabularyOrder.SortedByName(vocabularies),
      // filtering by the excluded series could only ever show nothing
      [.. (await SeriesRepository.GetAllAsync()).Where(series => series.Id != ExcludedSeriesId)]
    );
  }

  private static (string Name, string Value) SelectionField(ArtworkListSelection selection, ArtworkId id) =>
    (selection.FieldName, id.Value.ToString(CultureInfo.InvariantCulture));

  // the filter form carries the ticks too, or changing a filter would drop them
  private IReadOnlyList<(string Name, string Value)>? FilterKeptFields =>
    Selection is { } selection
      ? [.. KeptFields ?? [], .. selection.Ids.Select(id => SelectionField(selection, id))]
      : KeptFields;

  // What the tick form sends besides this page's boxes: the rest of the address as it is, so the
  // filters and the page stay put, and the ticks on other pages, which have no box here
  private IEnumerable<(string Name, string Value)> TickFormFields(ArtworkListSelection selection, ArtworkListPage artworks)
  {
    var shownIds = artworks.Items.Select(item => item.Id).ToHashSet();

    var addressFields = QueryHelpers.ParseQuery(new Uri(NavigationManager.Uri).Query)
      .Where(parameter => parameter.Key != selection.FieldName)
      .SelectMany(parameter => parameter.Value.Select(value => (parameter.Key, value ?? "")));

    var otherPageTicks = selection.Ids
      .Where(id => !shownIds.Contains(id))
      .Select(id => SelectionField(selection, id));

    return addressFields.Concat(otherPageTicks);
  }
}

@if (_loaded is { } loaded)
{
  <ArtworkListFilters Filter="loaded.Filter" Types="loaded.Types" Vocabularies="loaded.Vocabularies"
                      Series="loaded.Series" ClearFiltersHref="@ClearFiltersHref" KeptFields="FilterKeptFields" />

  <div class="flex justify-between items-center  mb-2">
    <span class="text-sm">@CountText.Of(loaded.Artworks.TotalCount, "artwork")</span>

    <PageLinks PageNumber="loaded.Artworks.PageNumber" PageCount="loaded.Artworks.PageCount" />
  </div>

  @if (Selection is { } selection)
  {
    @* a GET form like the filter bar's, so a tick changes the address and nothing else. A form
       submit, unlike a link, leaves the page where it was scrolled *@
    <form method="get" data-enhance>
      @foreach (var (name, value) in TickFormFields(selection, loaded.Artworks))
      {
        <input type="hidden" name="@name" value="@value" />
      }

      <SubmitOnChange>
        <ArtworkListRows Items="loaded.Artworks.Items" RowHref="RowHref" Selection="selection" />

        <ButtonBasic type="submit" Variant="ButtonVariant.Outline" data-part="apply">Update ticks</ButtonBasic>
      </SubmitOnChange>
    </form>
  }
  else
  {
    <ArtworkListRows Items="loaded.Artworks.Items" RowHref="RowHref" />
  }

  <div class="flex justify-end">
    <PageLinks PageNumber="loaded.Artworks.PageNumber" PageCount="loaded.Artworks.PageCount" />
  </div>
}
