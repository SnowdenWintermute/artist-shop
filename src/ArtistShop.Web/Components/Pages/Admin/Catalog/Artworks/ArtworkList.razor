@page "/admin/catalog/artworks"
@using ArtistShop.Web.Sites
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = SitePolicies.Admin)]

<PageTitle>Artworks</PageTitle>

<main>
  <AdminPanel>

    <h1 class="mb-4">Artworks</h1>

    <ArtworkListBrowser RowHref="item => PageUrls.EditArtwork(item.Id)" ClearFiltersHref="@PageUrls.ArtworkList" />
  </AdminPanel>
</main>
