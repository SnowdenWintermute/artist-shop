@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Dialogs
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Utilities
@inject SeriesRepository SeriesRepository
@inject NavigationManager NavigationManager

@code {
  [Parameter, EditorRequired]
  public SeriesId SeriesId { get; set; } = default!;
  [Parameter, EditorRequired]
  public SeriesName SeriesName { get; set; } = default!;
  [Parameter, EditorRequired]
  public int ArtworkCount { get; set; }

  private bool _renameDialogOpen;
  private bool _deleteDialogOpen;
  private bool _isDeleting;

  private async Task DeleteAsync()
  {
    _isDeleting = true;

    try
    {
      await SeriesRepository.DeleteAsync(SeriesId);
      NavigationManager.NavigateTo("/admin/catalog/series");
    }
    finally
    {
      _isDeleting = false;
    }
  }
}

<DisabledUntilInteractive>
  <div class="flex gap-2">
    <ButtonBasic type="button" @onclick="() => _renameDialogOpen = true">Rename</ButtonBasic>
    <ButtonBasic type="button" Class="text-red-600" @onclick="() => _deleteDialogOpen = true">Delete series</ButtonBasic>
  </div>

  <RenameSeriesDialog @bind-Open="_renameDialogOpen" SeriesId="SeriesId" SeriesName="SeriesName" />

  <ConfirmDialog @bind-Open="_deleteDialogOpen" Title="@($"Delete {SeriesName.Value}?")" ConfirmLabel="Delete"
                 OnConfirm="DeleteAsync" IsWorking="_isDeleting">
    Its artworks stay in the catalog. It holds @CountText.Of(ArtworkCount, "artwork") (count as of page load).
  </ConfirmDialog>
</DisabledUntilInteractive>
