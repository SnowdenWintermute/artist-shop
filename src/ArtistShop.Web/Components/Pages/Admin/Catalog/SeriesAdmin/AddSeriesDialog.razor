@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Forms
@using ArtistShop.Web.Database
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Components.Dialogs
@inject SeriesRepository SeriesRepository

@code {
  [Parameter]
  public bool Open { get; set; }
  [Parameter]
  public EventCallback<bool> OpenChanged { get; set; }
  [Parameter, EditorRequired]
  public EventCallback<SeriesId> OnAdded { get; set; }

  private SeriesNameForm _form = new();
  private bool _wasOpen;
  private bool _isSaving;

  // a fresh form each time it opens, so text typed and then cancelled doesn't come back
  protected override void OnParametersSet()
  {
    if (Open && !_wasOpen)
    {
      _form = new();
    }

    _wasOpen = Open;
  }

  private Task CloseAsync() => _isSaving ? Task.CompletedTask : OpenChanged.InvokeAsync(false);

  private async Task AddAsync()
  {
    _isSaving = true;

    try
    {
      var id = await SeriesRepository.AddAsync(_form.ToSeriesName(), _form.ToSeriesSlug());
      _isSaving = false;
      await OnAdded.InvokeAsync(id);
      await OpenChanged.InvokeAsync(false);
    }
    catch (NameAlreadyInUseException)
    {
      _form.AddNameTakenError();
    }
    finally
    {
      _isSaving = false;
    }
  }
}

@if (Open)
{
  <ModalDialog Title="New series" Width="ModalDialogWidth.Narrow" OnClose="CloseAsync" KeepOpen="_isSaving">
    @* Inside the artwork's form on the page, so this <form> is nested in it. Blazor builds it with DOM
       calls, which allow that, unlike the HTML parser; the island only renders it once open, never
       in the server's HTML. Its field and button belong to this form, so they don't post with the artwork *@
    <EditForm EditContext="_form.EditContext" OnValidSubmit="AddAsync">
      <DataAnnotationsValidator />

      <TextField Label="Name" @bind-Value="_form.Name" UpdatesPerKeystroke />
      <ModalDialogActions>
        <ModalCloseButton Label="Cancel" Disabled="_isSaving" />
        <ButtonBasic type="submit" Variant="ButtonVariant.Primary" Busy="_isSaving"
                     disabled="@(_isSaving || string.IsNullOrWhiteSpace(_form.Name))">
          Add series
        </ButtonBasic>
      </ModalDialogActions>
    </EditForm>
  </ModalDialog>
}
