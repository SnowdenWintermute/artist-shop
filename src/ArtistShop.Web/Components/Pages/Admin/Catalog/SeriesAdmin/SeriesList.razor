@page "/admin/catalog/series"
@layout SeriesLayout
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Identity
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = RoleNames.Admin)]
@inject SeriesRepository SeriesRepository

@code {
  private List<SeriesWithCover> _series = [];

  protected override async Task OnInitializedAsync()
  {
    var series = await SeriesRepository.GetAllWithCoversAsync();
    _series = [.. series.OrderBy(series => series.Name.Value, StringComparer.CurrentCultureIgnoreCase)];
  }
}

<PageTitle>Series</PageTitle>

<h1 class="mb-4 text-xl">Series</h1>

<AddSeriesForm />

@if (_series.Count == 0)
{
  <p>No series yet.</p>
}
else
{
  <ul>
    @foreach (var series in _series)
    {
      <li class="border-t">
        <a href="@($"/admin/catalog/series/{series.Id.Value}")" class="flex items-center gap-4 py-2">
          @if (series.Cover is { } cover)
          {
            <img src="@($"/media/{cover.RelativePath}/400.avif")" alt="" class="size-16 object-cover" />
          }
          else
          {
            <span class="flex p-1 size-16 items-center justify-center bg-gray-100 text-center text-xs text-gray-500">
              No images yet
            </span>
          }
          <span class="grow">@series.Name.Value</span>
          <span class="text-sm">@series.ShopItemCount artworks</span>
        </a>
      </li>
    }
  </ul>
}
