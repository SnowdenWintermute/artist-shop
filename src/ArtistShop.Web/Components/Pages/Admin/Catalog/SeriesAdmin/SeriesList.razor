@page "/admin/catalog/series"
@layout SeriesLayout
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Sites
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = SitePolicies.Admin)]
@inject SeriesRepository SeriesRepository

@code {
  // in the artist's order
  private List<SeriesWithCover> _series = [];

  protected override async Task OnInitializedAsync() =>
    _series = await SeriesRepository.GetAllWithCoversAsync();
}

<PageTitle>Series</PageTitle>

<h1 class="mb-4 text-xl">Series</h1>

<Notice>
  <p>Artworks which share a common thread may be grouped by series. Series function like folders, except than
    a single artwork may be in more than one series.</p>

  </Notice>

  <AddSeriesForm />

  <SeriesOrderList @rendermode="InteractiveServer" Series="_series" />
