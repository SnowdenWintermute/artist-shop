@page "/admin/catalog/series/{Id:int}/add-artworks"
@layout SeriesLayout
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Pages.Admin.Catalog.Artworks
@using ArtistShop.Web.Database
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Sites
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = SitePolicies.Admin)]
@inject SeriesRepository SeriesRepository
@inject NavigationManager NavigationManager

@code {
  private const string AddFormName = "add-series-artworks";

  [Parameter]
  public int Id { get; set; }

  [SupplyParameterFromQuery(Name = PageUrls.AddSeriesArtworksTickKey)]
  private int[]? TickedIds { get; set; }

  private SeriesWithArtworks? _series;

  private SeriesId SeriesId => new(Id);

  // an artwork ticked twice, in an address edited by hand, counts once
  private ArtworkListSelection Selection =>
    new(PageUrls.AddSeriesArtworksTickKey, [.. (TickedIds ?? []).Distinct().Select(id => new ArtworkId(id))]);

  protected override async Task OnInitializedAsync() =>
    _series = await SeriesRepository.GetAsync(SeriesId);

  // the form posts to this page's own address, so the ticks arrive in it
  private async Task AddAsync()
  {
    try
    {
      await SeriesRepository.AddArtworksAsync(SeriesId, Selection.Ids);
    }
    catch (ChangedSincePageLoadException)
    {
      // the series was deleted elsewhere; its page says so
    }

    NavigationManager.NavigateTo(PageUrls.EditSeries(SeriesId));
  }
}

<PageTitle>Add artworks to @(_series?.Name.Value ?? "series")</PageTitle>

@if (_series is null)
{
  <a href="/admin/catalog/series" class="mb-4 inline-block">← All series</a>

  <p>This series doesn't exist. It may have been deleted.</p>
}
else
{
  <a href="@PageUrls.EditSeries(SeriesId)" class="mb-4 inline-block">← @_series.Name.Value</a>

  <div class="mb-4 flex items-baseline justify-between">
    <h1 class="text-xl">Add artworks to @_series.Name.Value</h1>

    <form method="post" @formname="@AddFormName" @onsubmit="AddAsync" data-enhance>
      <AntiforgeryToken />
      <ButtonBasic type="submit" Variant="ButtonVariant.Primary" disabled="@(Selection.Ids.Count == 0)">
        Add selected (@Selection.Ids.Count)
      </ButtonBasic>
    </form>
  </div>

  @* only artworks not in the series yet. A row's title is text, since this page is for ticking
     artworks, not opening them *@
  <ArtworkListBrowser RowHref="_ => null" ClearFiltersHref="@PageUrls.AddSeriesArtworks(SeriesId, Selection.Ids)"
                      ExcludedSeriesId="SeriesId" Selection="Selection" />
}
