@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Dialogs
@using ArtistShop.Web.Components.Lists
@using ArtistShop.Web.Database
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Images
@using ArtistShop.Web.Utilities
@inject SeriesRepository SeriesRepository
@inject NavigationManager NavigationManager

@code {
  [Parameter, EditorRequired]
  public SeriesWithArtworks Series { get; set; } = default!;

  private List<SeriesArtwork> _artworks = [];
  private readonly HashSet<ArtworkId> _selected = [];
  private bool _isSaving;
  private bool _removeDialogOpen;
  private bool _changedElsewhere;

  // after a save, Refresh re-renders the page, which passes the saved list back in here
  protected override void OnParametersSet()
  {
    _artworks = [.. Series.Artworks];
    _selected.RemoveWhere(id => !Series.Artworks.Any(artwork => artwork.Id == id));
  }

  // only artworks with an image can be the cover
  private static string? StarValueOf(SeriesArtwork artwork) =>
    artwork.PrimaryImage is null ? null : artwork.Id.Value.ToString();

  private string? StarredValue =>
    _artworks.FirstOrDefault(artwork => artwork.IsCover) is { } cover ? StarValueOf(cover) : null;

  private void ToggleSelected(ArtworkId id)
  {
    if (!_selected.Remove(id))
    {
      _selected.Add(id);
    }
  }

  private Task MoveAsync((int OldIndex, int NewIndex) move) =>
    SaveAsync(async () =>
    {
      List<SeriesArtwork> reordered = [.. _artworks];
      var artwork = reordered[move.OldIndex];
      reordered.RemoveAt(move.OldIndex);
      reordered.Insert(move.NewIndex, artwork);

      await SeriesRepository.ReorderArtworksAsync(Series.Id, [.. reordered.Select(item => item.Id)]);
      // shown only once saved, so a failed save can't leave an order on screen that isn't in the database
      _artworks = reordered;
    });

  private Task StarAsync(SeriesArtwork artwork) =>
    SaveAsync(() => SeriesRepository.SetCoverAsync(Series.Id, artwork.Id));

  private Task ClearStarAsync() => SaveAsync(() => SeriesRepository.ClearCoverAsync(Series.Id));

  private Task RemoveSelectedAsync() =>
    SaveAsync(async () =>
    {
      await SeriesRepository.RemoveArtworksAsync(Series.Id, _selected);
      _selected.Clear();
      _removeDialogOpen = false;
    });

  private async Task SaveAsync(Func<Task> save)
  {
    // a second drag while the first is saving would send an order built from the old list
    if (_isSaving)
    {
      return;
    }

    _isSaving = true;
    _changedElsewhere = false;

    try
    {
      await save();
    }
    catch (CatalogChangedException)
    {
      _changedElsewhere = true;
      _removeDialogOpen = false;
    }
    finally
    {
      _isSaving = false;
    }

    NavigationManager.Refresh();
  }
}

<DisabledUntilInteractive>
  @if (_changedElsewhere)
  {
    <p class="mb-2 text-red-600">This series was changed somewhere else, so the list has been reloaded.</p>
  }

  @if (_artworks.Count == 0)
  {
    <p>No artworks in this series yet.</p>
  }
  else
  {
    <div class="mb-2 flex items-center justify-between text-sm">
      <span>@CountText.Of(_artworks.Count, "artwork")</span>
      <ButtonBasic type="button" Class="border border-red-600 text-red-600" disabled="@(_selected.Count == 0 || _isSaving)"
                   @onclick="() => _removeDialogOpen = true">
        Remove selected (@_selected.Count)
      </ButtonBasic>
    </div>

    <StarredSortableList TItem="SeriesArtwork" Items="_artworks" AriaLabel="Artwork order" StarName="series-cover"
                         StarTitle="Use as the series cover" StarValueOf="StarValueOf" StarredValue="@StarredValue"
                         OnStar="StarAsync" ChosenStarMessage="Cover chosen by hand"
                         ClearStarLabel="Use the first artwork instead" OnClearStar="ClearStarAsync" OnMove="MoveAsync">
      <RowContent Context="artwork">
        @if (artwork.PrimaryImage is { } image)
        {
          <img src="@ImageUrls.Variant(image.StorageKey, image.Width, ImageVariants.AdminThumbnailWidth, ImageVariantFormat.Avif)" alt=""
               class="size-10 object-cover" />
        }
        else
        {
          <span class="flex size-10 items-center justify-center bg-gray-100 text-center text-[10px] text-gray-500">
            No image
          </span>
        }

        <div class="grow">
          <div>@artwork.Name.Value</div>
          <div class="text-xs text-gray-500">@artwork.ArtworkTypeName.Value</div>
        </div>
      </RowContent>
      <RowActions Context="artwork">
        <input type="checkbox" class="mx-1 cursor-pointer" aria-label="@($"Select {artwork.Name.Value}")"
               checked="@_selected.Contains(artwork.Id)" @onchange="() => ToggleSelected(artwork.Id)" />
      </RowActions>
    </StarredSortableList>
  }

  <ConfirmDialog @bind-Open="_removeDialogOpen" Title="@($"Remove {CountText.Of(_selected.Count, "artwork")} from {Series.Name.Value}?")"
                 ConfirmLabel="Remove" OnConfirm="RemoveSelectedAsync" IsWorking="_isSaving">
    They stay in the catalog.
  </ConfirmDialog>
</DisabledUntilInteractive>
