@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Forms
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@inject SeriesRepository SeriesRepository

@* A checkbox for each series and a field to add one, for a dialog. A series is saved as soon as
   it's added, so it stays even if the dialog is cancelled *@

@code {
  // in the artist's order
  [Parameter, EditorRequired]
  public IReadOnlyList<Series> AllSeries { get; set; } = default!;
  [Parameter, EditorRequired]
  public IReadOnlySet<int> Checked { get; set; } = default!;
  [Parameter, EditorRequired]
  public EventCallback<int> OnToggle { get; set; }
  // the caller lists the new series and checks it
  [Parameter, EditorRequired]
  public EventCallback<Series> OnSeriesAdded { get; set; }
  // for the dialog to stay open and hold its buttons while a series is being added
  [Parameter]
  public bool IsAdding { get; set; }
  [Parameter]
  public EventCallback<bool> IsAddingChanged { get; set; }

  private SeriesNameForm _newSeries = new();

  private async Task AddSeriesAsync()
  {
    await IsAddingChanged.InvokeAsync(true);

    try
    {
      if (await _newSeries.AddAsync(SeriesRepository) is { } series)
      {
        _newSeries = new();
        await OnSeriesAdded.InvokeAsync(series);
      }
    }
    finally
    {
      await IsAddingChanged.InvokeAsync(false);
    }
  }
}

@if (AllSeries.Count is 0)
{
  <p class="mb-4 text-sm">No series yet. Add one below.</p>
}
else
{
  @* the padding keeps a focused checkbox's outline inside the scrolling box, which clips it; the
     negative margin keeps the boxes lined up with the rest of the dialog *@
  <fieldset class="-mx-1 mb-4 min-h-0 overflow-y-auto px-1">
    <legend class="sr-only">Series</legend>
    @foreach (var series in AllSeries)
    {
      <label @key="series.Id.Value" class="flex cursor-pointer items-center gap-2 py-1">
        <input type="checkbox" class="cursor-pointer" checked="@Checked.Contains(series.Id.Value)"
               @onchange="() => OnToggle.InvokeAsync(series.Id.Value)" />
        @series.Name.Value
      </label>
    }
  </fieldset>
}

<EditForm EditContext="_newSeries.EditContext" OnValidSubmit="AddSeriesAsync" class="mb-4 shrink-0">
  <DataAnnotationsValidator />

  <TextField Label="New series" @bind-Value="_newSeries.Name" UpdatesPerKeystroke />
  <ButtonBasic type="submit" Variant="ButtonVariant.Outline" Busy="IsAdding"
               disabled="@(IsAdding || string.IsNullOrWhiteSpace(_newSeries.Name))">
    Add series
  </ButtonBasic>
</EditForm>
