@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Domain.Catalog

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  [Parameter, EditorRequired]
  public VocabularyName Name { get; set; } = default!;

  // what to do about it, which differs by page
  [Parameter, EditorRequired]
  public RenderFragment ChildContent { get; set; } = default!;
}

<Notice>
  @Name.Value isn't linked to any @Wording.Work.SingularInSentence type yet, so it doesn't show on any
  @Wording.Work.SingularInSentence's form.
  @ChildContent
</Notice>
