@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Tables
@using ArtistShop.Web.Domain.Catalog
@inject NavigationManager NavigationManager

@code {
  [Parameter, EditorRequired]
  public IReadOnlyList<VocabularyTermWithUsage> Terms { get; set; } = default!;

  private VocabularyTermWithUsage? _termToRename;
  private VocabularyTermWithUsage? _termToDelete;

  // re-renders the static page, which passes the updated terms back in
  private void RefreshPage() => NavigationManager.Refresh();
}

<DisabledUntilInteractive>
  @if (Terms.Count == 0)
  {
    <p>No terms yet.</p>
  }
  else
  {
    <DataTable Items="Terms" Headings="@(new[] { "Term", "Used on", "" })">
      <Row Context="term">
        <DataTableCell>@term.Name.Value</DataTableCell>
        <DataTableCell>@term.ArtworkCount items</DataTableCell>
        <DataTableCell Class="text-right">
          <ButtonBasic type="button" @onclick="() => _termToRename = term">Rename</ButtonBasic>
          <ButtonBasic type="button" Class="text-red-600" @onclick="() => _termToDelete = term">Delete</ButtonBasic>
        </DataTableCell>
      </Row>
    </DataTable>
  }

  <RenameVocabularyTermDialog @bind-Term="_termToRename" OnRenamed="RefreshPage" />
  <DeleteVocabularyTermDialog @bind-Term="_termToDelete" OnDeleted="RefreshPage" />
</DisabledUntilInteractive>
