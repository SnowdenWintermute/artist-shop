@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Forms
@using ArtistShop.Web.Database
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Components.Dialogs
@inject VocabularyTermRepository VocabularyTermRepository

@code {
  // null means closed; @bind-Term lets the dialog close itself by setting it back to null
  [Parameter, EditorRequired]
  public VocabularyTermWithUsage? Term { get; set; }

  [Parameter]
  public EventCallback<VocabularyTermWithUsage?> TermChanged { get; set; }

  [Parameter, EditorRequired]
  public EventCallback OnRenamed { get; set; }

  private VocabularyTermWithUsage? _formTerm;
  private VocabularyTermNameForm _form = new();
  private bool _isSaving;

  // a fresh form each time it opens, so text typed and then cancelled doesn't come back
  protected override void OnParametersSet()
  {
    if (Term is null)
    {
      _formTerm = null;
      return;
    }

    if (Term != _formTerm)
    {
      _formTerm = Term;
      _form = VocabularyTermNameForm.WithName(Term.Name.Value);
    }
  }

  private Task CloseAsync() => _isSaving ? Task.CompletedTask : TermChanged.InvokeAsync(null);

  private async Task RenameAsync(VocabularyTermWithUsage term)
  {
    _isSaving = true;

    try
    {
      await VocabularyTermRepository.RenameAsync(term.Id, _form.ToVocabularyTermName());
      await OnRenamed.InvokeAsync();
      _isSaving = false;
      await TermChanged.InvokeAsync(null);
    }
    catch (NameAlreadyInUseException exception)
    {
      _form.AddNameTakenError(exception.Name);
    }
    catch (ChangedSincePageLoadException)
    {
      // deleted in another tab; closing and reloading drops it from the table
      _isSaving = false;
      await TermChanged.InvokeAsync(null);
      await OnRenamed.InvokeAsync();
    }
    finally
    {
      _isSaving = false;
    }
  }
}

@if (Term is { } term)
{
  <ModalDialog Title="@($"Rename {term.Name.Value}")" Width="ModalDialogWidth.Narrow" OnClose="CloseAsync"
               KeepOpen="_isSaving">
    <EditForm EditContext="_form.EditContext" OnValidSubmit="() => RenameAsync(term)">
      <DataAnnotationsValidator />

      <TextField Label="Name" @bind-Value="_form.Name" UpdatesPerKeystroke />
      <ModalDialogActions>
        <ModalCloseButton Label="Cancel" Disabled="_isSaving" />
        <ButtonBasic type="submit" Variant="ButtonVariant.Primary" Busy="_isSaving"
                     disabled="@(_isSaving || _form.Name == term.Name.Value)">
          Rename
        </ButtonBasic>
      </ModalDialogActions>
    </EditForm>
  </ModalDialog>
}
