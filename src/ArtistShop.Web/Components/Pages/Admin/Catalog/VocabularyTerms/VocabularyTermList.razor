@page "/admin/catalog/vocabularies/{Id:int}"
@layout VocabularyLayout
@using ArtistShop.Web.Components.Pages.Admin.Catalog
@using ArtistShop.Web.Components.Catalog
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Identity
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = RoleNames.Admin)]
@inject VocabularyRepository VocabularyRepository
@inject VocabularyTermRepository VocabularyTermRepository

@code {
  [Parameter]
  public int Id { get; set; }

  private VocabularyWithArtworkTypes? _vocabulary;
  private List<VocabularyTermWithUsage> _terms = [];

  private VocabularyId VocabularyId => new(Id);

  protected override async Task OnInitializedAsync()
  {
    _vocabulary = await VocabularyRepository.GetAsync(VocabularyId);
    _terms = VocabularyOrder.SortedByName(await VocabularyTermRepository.GetAllWithUsageAsync(VocabularyId));
  }
}

<PageTitle>@(_vocabulary?.Name.Value ?? "Vocabulary")</PageTitle>

@if (_vocabulary is null)
{
  <p>This vocabulary doesn't exist. It may have been deleted.</p>
}
else
{
  <div class="mb-4 flex items-baseline justify-between">
    <h1 class="text-xl">@_vocabulary.Name.Value</h1>
    <a href="@($"/admin/catalog/vocabularies/{Id}/edit")">Edit vocabulary</a>
  </div>

  <AddVocabularyTermForm VocabularyId="VocabularyId" />
  <VocabularyTermTable @rendermode="InteractiveServer" @key="Id" Terms="_terms" />
}
