@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Forms
@using ArtistShop.Web.Database
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@inject VocabularyTermRepository VocabularyTermRepository
@inject NavigationManager NavigationManager

@code {
  [Parameter, EditorRequired]
  public VocabularyId VocabularyId { get; set; } = default!;

  [SupplyParameterFromForm(FormName = "add-vocabulary-term")]
  private VocabularyTermNameForm Input { get; set; } = default!;

  protected override void OnInitialized() => Input ??= new();

  private async Task AddAsync()
  {
    try
    {
      await VocabularyTermRepository.AddAsync(VocabularyId, Input.ToVocabularyTermName());
      // redirect to this same page: the list reloads, and refreshing the browser won't post again
      NavigationManager.NavigateTo(NavigationManager.Uri);
    }
    catch (NameAlreadyInUseException exception)
    {
      Input.AddNameTakenError(exception.Name);
    }
  }
}

<EditForm EditContext="Input.EditContext" FormName="add-vocabulary-term" OnValidSubmit="AddAsync" Enhance class="mb-6">
  <DataAnnotationsValidator />

  <TextField Label="New term" @bind-Value="Input.Name" />
  <ButtonBasic type="submit" Class="bg-blue-400 text-white">Add term</ButtonBasic>
</EditForm>
