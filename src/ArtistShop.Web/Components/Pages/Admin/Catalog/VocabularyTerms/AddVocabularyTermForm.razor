@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Forms
@using ArtistShop.Web.Database
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@inject VocabularyTermRepository VocabularyTermRepository

@code {
  [Parameter, EditorRequired]
  public VocabularyId VocabularyId { get; set; } = default!;

  [Parameter, EditorRequired]
  public EventCallback OnAdded { get; set; }

  private readonly VocabularyTermNameForm _form = new(null);
  private bool _isSaving;

  private async Task AddAsync()
  {
    _isSaving = true;

    try
    {
      await VocabularyTermRepository.AddAsync(VocabularyId, _form.ToVocabularyTermName());
      _form.Reset();
      await OnAdded.InvokeAsync();
    }
    catch (NameAlreadyInUseException exception)
    {
      _form.AddNameTakenError(exception.Name);
    }
    finally
    {
      _isSaving = false;
    }
  }
}

<EditForm EditContext="_form.EditContext" OnValidSubmit="AddAsync" class="mb-6">
  <DataAnnotationsValidator />

  <TextField Label="New term" @bind-Value="_form.Name" />
  <ButtonBasic type="submit" Class="bg-blue-400 text-white" disabled="@_isSaving">Add term</ButtonBasic>
</EditForm>
