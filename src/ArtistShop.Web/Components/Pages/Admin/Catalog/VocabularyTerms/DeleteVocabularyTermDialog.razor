@using ArtistShop.Web.Components.Dialogs
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@inject VocabularyTermRepository VocabularyTermRepository

@code {
  [Parameter, EditorRequired]
  public VocabularyTermWithUsage? Term { get; set; }
  [Parameter]
  public EventCallback<VocabularyTermWithUsage?> TermChanged { get; set; }
  [Parameter, EditorRequired]
  public EventCallback OnDeleted { get; set; }

  private bool _isDeleting;

  private Task HandleOpenChanged(bool open) =>
    open || _isDeleting ? Task.CompletedTask : TermChanged.InvokeAsync(null);

  private async Task DeleteAsync(VocabularyTermWithUsage term)
  {
    _isDeleting = true;

    try
    {
      await VocabularyTermRepository.DeleteAsync(term.Id);
      await OnDeleted.InvokeAsync();
    }
    finally
    {
      _isDeleting = false;
    }

    await TermChanged.InvokeAsync(null);
  }
}

@if (Term is { } term)
{
  <ConfirmDialog Open="true" OpenChanged="HandleOpenChanged" Title="@($"Delete {term.Name.Value}?")" ConfirmLabel="Delete"
                 OnConfirm="() => DeleteAsync(term)" IsWorking="_isDeleting">
    This removes it from @term.ArtworkCount items (count as of page load).
  </ConfirmDialog>
}
