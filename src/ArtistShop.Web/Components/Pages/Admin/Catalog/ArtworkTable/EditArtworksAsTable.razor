@page "/admin/catalog/artworks/table"
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Pages.Admin.Catalog.Artworks
@using ArtistShop.Web.Sites
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = SitePolicies.Admin)]
@inject NavigationManager NavigationManager

<PageTitle>Edit artworks table</PageTitle>

<main>
  <AdminPanel Wide>
    <BackLink Href="@PageUrls.AdminDashboard" Label="Admin" />

    <h1 class="mb-4 flex items-center">
      <span class="text-theme-base inset-0 flex items-center justify-center mr-2">
        <SvgIcon Name="floppy-disc" Class="size-5" />
      </span>
      <span>Artworks are saved after each edit</span>
    </h1>

    @* the images dialog posts each upload to an endpoint that checks the antiforgery token, and there
       is no form on this page to carry one *@
    <AntiforgeryToken />

    <ArtworkListBrowser RowHref="_ => null" ClearFiltersHref="@PageUrls.ArtworkTable" SingleType>
      <Rows Context="loaded">
        <ArtworkTableEditor ArtworkTypeId="loaded.Filter.ArtworkTypeIds[0].Value"
                            ArtworkIds="[.. loaded.Artworks.Items.Select(item => item.Id.Value)]"
                            Address="@NavigationManager.Uri" />
      </Rows>
    </ArtworkListBrowser>
  </AdminPanel>
</main>
