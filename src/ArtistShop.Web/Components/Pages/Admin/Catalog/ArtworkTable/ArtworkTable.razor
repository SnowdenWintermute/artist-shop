@using ArtistShop.Web.Components.Catalog
@using ArtistShop.Web.Components.Forms.FileUpload.Images
@using ArtistShop.Web.Components.Pages.Admin.Catalog.Artworks
@using ArtistShop.Web.Components.Pages.Admin.Catalog.SeriesAdmin
@using ArtistShop.Web.Components.Tables
@using ArtistShop.Web.Database
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Dialogs
@using ArtistShop.Web.Utilities
@inject ArtworkRepository ArtworkRepository
@inject VocabularyRepository VocabularyRepository

@* Artworks of one type, each saved on its own as its fields change. Each input saves its row when it
   loses focus with a changed value: @bind updates on "change". The longer fields open dialogs *@

@code {
  [Parameter, EditorRequired]
  public IReadOnlyList<ArtworkTableRow> Rows { get; set; } = default!;
  // the type every row has, whose fields are the columns
  [Parameter, EditorRequired]
  public ArtworkTypeWithFields Type { get; set; } = default!;
  // in the artist's order
  [Parameter, EditorRequired]
  public IReadOnlyList<Series> AllSeries { get; set; } = default!;
  // a series is saved as soon as the series dialog adds it, so the caller lists it for every row
  [Parameter, EditorRequired]
  public EventCallback<Series> OnSeriesAdded { get; set; }
  // after each save of a row, which saved only if the row has no errors now; for a page that shows
  // whether everything is saved
  [Parameter]
  public EventCallback<ArtworkTableRow> OnSaveFinished { get; set; }
  // a vocabulary, term or series was added from a dialog that has now closed, for a page with lists of
  // its own, like filters, to read them again
  [Parameter]
  public EventCallback OnChoicesAdded { get; set; }
  // deleted from the bulk bar, for the caller to take out of Rows
  [Parameter, EditorRequired]
  public EventCallback<IReadOnlyList<ArtworkTableRow>> OnRowsDeleted { get; set; }

  private bool _choicesAdded;

  // the type's, sorted by name; the vocabulary dialog can add to them
  private List<VocabularyWithTerms> _vocabularies = [];
  private ArtworkTypeId? _vocabulariesTypeId;

  private ArtworkTableRow? _descriptionRow;
  private ArtworkTableRow? _seriesRow;
  private ArtworkTableRow? _vocabularyRow;
  private ArtworkTableRow? _imagesRow;

  private BulkChange? _bulkSeriesChange;
  private BulkChange? _bulkVocabularyChange;
  private bool _isConfirmingDelete;
  private bool _isDeleting;
  // saving each selected row after a bulk change
  private bool _isApplying;

  // the checkboxes, images and title stay in view as the other columns scroll sideways under them
  private const string SelectColumnClass = "sticky left-0 w-10 min-w-10 bg-white";
  private const string ImagesColumnClass = "sticky left-10 w-16 min-w-16 bg-white";
  private const string TitleColumnClass = "sticky left-26 bg-white";

  private const string CheckboxClass = "size-5 cursor-pointer";
  private const string PinnedCellClass = "z-10";

  private const string InputClass = "artist-shop-field-input";

  // room for a focused input's outline, which the pinned title column would otherwise paint over
  private const string FieldCellClass = "pl-1 align-top";

  private const string DialogButtonClass = $"{InputClass} w-48 cursor-pointer truncate text-left";

  private IReadOnlyCollection<ArtworkField> Fields => Type.Fields;

  protected override async Task OnParametersSetAsync()
  {
    if (_vocabulariesTypeId != Type.Id)
    {
      _vocabulariesTypeId = Type.Id;
      await ReloadVocabulariesAsync();
    }
  }

  private async Task ReloadVocabulariesAsync() =>
    _vocabularies = VocabularyOrder.SortedByName(await VocabularyRepository.GetAllWithTermsForArtworkTypeAsync(Type.Id));

  private async Task VocabulariesChangedAsync()
  {
    _choicesAdded = true;
    await ReloadVocabulariesAsync();
  }

  private async Task SeriesAddedAsync(Series series)
  {
    _choicesAdded = true;
    await OnSeriesAdded.InvokeAsync(series);
  }

  // once the dialog is gone, after any save, so the page's refresh doesn't land mid-dialog
  private async Task ChoiceDialogClosedAsync()
  {
    _seriesRow = null;
    _vocabularyRow = null;
    _bulkSeriesChange = null;
    _bulkVocabularyChange = null;

    if (_choicesAdded)
    {
      _choicesAdded = false;
      await OnChoicesAdded.InvokeAsync();
    }
  }

  private IReadOnlyList<DataTableHeading> Headings
  {
    get
    {
      List<DataTableHeading> headings =
      [
        new("", SelectColumnClass, Pinned: true, Content: SelectAllCheckbox),
        new("", ImagesColumnClass, Pinned: true),
        new("Title", TitleColumnClass, Pinned: true),
      ];

      if (Fields.Contains(ArtworkField.DateCreated))
      {
        headings.Add("Date created");
      }

      if (Fields.Contains(ArtworkField.HeightAndWidth))
      {
        headings.AddRange(["Height (cm)", "Width (cm)"]);
      }

      if (Fields.Contains(ArtworkField.Depth))
      {
        headings.Add("Depth (cm)");
      }

      if (Fields.Contains(ArtworkField.Duration))
      {
        headings.Add("Duration");
      }

      headings.AddRange(["Description", "Series", "Vocabularies"]);
      return headings;
    }
  }

  // A change made while a save is running waits for it, then saves again, so saves of one row never
  // overlap and the last one sent holds the latest values
  private async Task SaveAsync(ArtworkTableRow row)
  {
    if (row.IsSaving)
    {
      row.SaveAgain = true;
      return;
    }

    row.IsSaving = true;

    try
    {
      do
      {
        row.SaveAgain = false;

        if (!row.Validate())
        {
          continue;
        }

        row.SaveError = await SaveErrorOfAsync(row, () =>
ArtworkRepository.UpdateDetailsAsync(row.Form.ToDetailsUpdate(row.Id)));
      } while (row.SaveAgain);
    }
    finally
    {
      row.IsSaving = false;
    }

    await OnSaveFinished.InvokeAsync(row);
  }

  // null when it saved
  private static async Task<string?> SaveErrorOfAsync(ArtworkTableRow row, Func<Task> save)
  {
    try
    {
      await save();
      row.SaveCount++;
      return null;
    }
    catch (ArtworkDeletedException)
    {
      return "Deleted elsewhere";
    }
    catch (ChangedSincePageLoadException)
    {
      return "Changed elsewhere. Reload the page.";
    }
  }

  private async Task DescriptionOkAsync(string? description)
  {
    if (_descriptionRow is { } row)
    {
      row.Form.Description = string.IsNullOrWhiteSpace(description) ? null : description;
      _descriptionRow = null;
      await SaveAsync(row);
    }
  }

  private async Task SeriesOkAsync(List<int> seriesIds)
  {
    if (_seriesRow is { } row)
    {
      row.Form.SeriesIds = seriesIds;
      _seriesRow = null;
      await SaveAsync(row);
      await ChoiceDialogClosedAsync();
    }
  }

  private async Task VocabularyOkAsync(List<int> termIds)
  {
    if (_vocabularyRow is { } row)
    {
      row.Form.VocabularyTermIds = termIds;
      _vocabularyRow = null;
      await SaveAsync(row);
      await ChoiceDialogClosedAsync();
    }
  }

  // apart from the row's other fields, which update_artwork_details saves without touching images
  private async Task ImagesOkAsync(ImageListState state)
  {
    if (_imagesRow is not { } row)
    {
      return;
    }

    var mainImageIndex = state.Images.ToList().FindIndex(image => image.StorageKey == state.MainImageKey);

    row.ImagesSaveError = await SaveErrorOfAsync(row, async () =>
    {
      await ArtworkRepository.UpdateImagesAsync(row.Id, state.Images, Math.Max(mainImageIndex, 0));
      row.ReplaceSavedImages(state.Images, mainImageIndex < 0 ? null : state.MainImageKey);
    });

    _imagesRow = null;
    await OnSaveFinished.InvokeAsync(row);
  }

  private List<ArtworkTableRow> SelectedRows => [.. Rows.Where(row => row.IsSelected)];

  private bool IsAllSelected => Rows.All(row => row.IsSelected);

  private void SetAllSelected(bool selected)
  {
    foreach (var row in Rows)
    {
      row.IsSelected = selected;
    }
  }

  private RenderFragment SelectAllCheckbox =>
    @<div class="flex justify-center">
      <input type="checkbox" class="@CheckboxClass" aria-label="Select all" checked="@IsAllSelected"
             @onchange="() => SetAllSelected(!IsAllSelected)" />
    </div>;

  // for removing: only the series a selected row is in
  private List<Series> SeriesOfSelected =>
    [.. AllSeries.Where(series => SelectedRows.Any(row => row.Form.SeriesIds.Contains(series.Id.Value)))];

  // for removing: only the terms a selected row has, under their vocabularies
  private List<VocabularyWithTerms> VocabulariesOfSelected =>
    [
      .. _vocabularies
        .Select(vocabulary => vocabulary with
        {
          Terms = [.. vocabulary.Terms.Where(term => SelectedRows.Any(row => row.Form.VocabularyTermIds.Contains(term.Id.Value)))],
        })
        .Where(vocabulary => vocabulary.Terms.Count > 0),
    ];

  // each row is saved as if edited by hand, so a bulk change waits for any save the row is running
  // rather than racing it
  private async Task ApplyAsync(IReadOnlyList<ArtworkTableRow> rows, Action<ArtworkTableRow> change)
  {
    _isApplying = true;

    try
    {
      foreach (var row in rows)
      {
        change(row);
        await SaveAsync(row);
      }
    }
    finally
    {
      _isApplying = false;
    }
  }

  // in the order the series are listed, so each row reads the same as the list
  private async Task BulkSeriesOkAsync(IReadOnlySet<int> seriesIds)
  {
    if (_bulkSeriesChange is not { } change)
    {
      return;
    }

    var rows = SelectedRows;
    _bulkSeriesChange = null;

    await ApplyAsync(rows, row => row.Form.SeriesIds = change is BulkChange.Add
      ? [.. AllSeries.Select(series => series.Id.Value).Where(id => seriesIds.Contains(id) || row.Form.SeriesIds.Contains(id))]
      : [.. row.Form.SeriesIds.Where(id => !seriesIds.Contains(id))]);

    await ChoiceDialogClosedAsync();
  }

  private async Task BulkVocabularyOkAsync(IReadOnlySet<int> termIds)
  {
    if (_bulkVocabularyChange is not { } change)
    {
      return;
    }

    var rows = SelectedRows;
    _bulkVocabularyChange = null;

    await ApplyAsync(rows, row => row.Form.VocabularyTermIds = change is BulkChange.Add
      ? VocabularyOrder.TermIdsInListOrder(_vocabularies, termIds.Union(row.Form.VocabularyTermIds).ToHashSet())
      : [.. row.Form.VocabularyTermIds.Where(id => !termIds.Contains(id))]);

    await ChoiceDialogClosedAsync();
  }

  private async Task DeleteSelectedAsync()
  {
    var rows = SelectedRows;
    _isDeleting = true;

    try
    {
      await ArtworkRepository.DeleteManyAsync([.. rows.Select(row => row.Id)]);
    }
    finally
    {
      _isDeleting = false;
    }

    _isConfirmingDelete = false;
    await OnRowsDeleted.InvokeAsync(rows);
  }

  private string SeriesText(ArtworkTableRow row) =>
    string.Join(", ", AllSeries.Where(series => row.Form.SeriesIds.Contains(series.Id.Value)).Select(series =>
series.Name.Value));

  private string VocabularyText(ArtworkTableRow row) =>
    string.Join(", ", _vocabularies
      .SelectMany(vocabulary => vocabulary.Terms)
      .Where(term => row.Form.VocabularyTermIds.Contains(term.Id.Value))
      .Select(term => term.Name.Value));
}

@* the right padding keeps the last column's focus outline inside the scrolling box, which clips it.
   On a touch screen the box scrolls both ways: a sideways scroll still coasting inside a box that
   scrolls only sideways holds on to the next drag, so the page wouldn't scroll down until it stopped *@
@{
  var selectedCount = SelectedRows.Count;
  var isIdle = selectedCount > 0 && !_isApplying;
}

<div class="mb-2 flex flex-wrap items-center gap-2">
  <span class="mr-2 text-sm" role="status">@selectedCount selected</span>
  <ButtonBasic type="button" Variant="ButtonVariant.Outline" disabled="@(!isIdle)"
               @onclick="() => _bulkSeriesChange = BulkChange.Add">Add to series</ButtonBasic>
  <ButtonBasic type="button" Variant="ButtonVariant.Outline" disabled="@(!isIdle)"
               @onclick="() => _bulkSeriesChange = BulkChange.Remove">Remove from series</ButtonBasic>
  <ButtonBasic type="button" Variant="ButtonVariant.Outline" disabled="@(!isIdle)"
               @onclick="() => _bulkVocabularyChange = BulkChange.Add">Add terms</ButtonBasic>
  <ButtonBasic type="button" Variant="ButtonVariant.Outline" disabled="@(!isIdle)"
               @onclick="() => _bulkVocabularyChange = BulkChange.Remove">Remove terms</ButtonBasic>
  @* an artwork deleted mid-upload would leave its upload failing *@
  <ButtonBasic type="button" Variant="ButtonVariant.DangerOutline"
               disabled="@(!isIdle || SelectedRows.Any(row => row.HasImagesUploading))"
               @onclick="() => _isConfirmingDelete = true">Delete</ButtonBasic>
</div>

<div class="mb-4 overflow-auto pr-1 pointer-coarse:max-h-[75dvh]">
  <DataTable Items="Rows" Headings="Headings" Class="text-sm" FitsContent StickyHeadings>
    <Row Context="row">
      <DataTableCell Class="@($"align-top {SelectColumnClass} {PinnedCellClass}")">
        @* as tall as the inputs, so the box lines up with the title *@
        <div class="flex h-10 items-center justify-center">
          <input type="checkbox" class="@CheckboxClass" aria-label="@($"Select {row.Form.Name}")" @bind="row.IsSelected" />
        </div>
      </DataTableCell>

      <DataTableCell Class="@($"align-top {ImagesColumnClass} {PinnedCellClass}")">
        <RowImagesCell Row="row" OnEdit="() => _imagesRow = row" />
      </DataTableCell>

      <DataTableCell Class="@($"align-top {TitleColumnClass} {PinnedCellClass}")">
        <input class="@($"{InputClass} w-24 sm:w-32 md:w-48")" aria-label="Title" @bind="row.Form.Name"
               @bind:after="() => SaveAsync(row)" />
        <RowFieldError Message="@row.ErrorFor(nameof(ArtworkForm.Name))" />
        <RowFieldError Message="@row.SaveError" />
      </DataTableCell>

      @if (Fields.Contains(ArtworkField.DateCreated))
      {
        <DataTableCell Class="@FieldCellClass">
          <div class="flex gap-1">
            <input inputmode="numeric" class="@($"{InputClass} w-20")" placeholder="Year" aria-label="Year created"
                   @bind="row.YearText" @bind:after="() => SaveAsync(row)" />
            <select class="@($"{InputClass} w-20")" aria-label="Month created" @bind="row.Form.MonthCreated"
                    @bind:after="() => SaveAsync(row)">
              <option value="">Month</option>
              @for (var month = 1; month <= 12; month++)
              {
                <option value="@month">@(PartialDate.MonthName(month)[..3])</option>
              }
            </select>
            <select class="@($"{InputClass} w-16")" aria-label="Day created" @bind="row.Form.DayCreated"
                    @bind:after="() => SaveAsync(row)">
              <option value="">Day</option>
              @for (var day = 1; day <= 31; day++)
              {
                <option value="@day"
                        disabled="@(day > PartialDate.MaximumDayIn(row.Form.YearCreated, row.Form.MonthCreated))">@day</option>
              }
            </select>
          </div>
          <RowFieldError Message="@row.ErrorFor(nameof(ArtworkForm.YearCreated))" />
          <RowFieldError Message="@row.ErrorFor(nameof(ArtworkForm.MonthCreated))" />
          <RowFieldError Message="@row.ErrorFor(nameof(ArtworkForm.DayCreated))" />
        </DataTableCell>
      }

      @if (Fields.Contains(ArtworkField.HeightAndWidth))
      {
        <DataTableCell Class="@FieldCellClass">
          <input inputmode="decimal" class="@($"{InputClass} w-18")" aria-label="Height in centimetres"
                 @bind="row.HeightText" @bind:after="() => SaveAsync(row)" />
          <RowFieldError Message="@row.ErrorFor(nameof(ArtworkForm.HeightCm))" />
        </DataTableCell>
        <DataTableCell Class="@FieldCellClass">
          <input inputmode="decimal" class="@($"{InputClass} w-18")" aria-label="Width in centimetres"
                 @bind="row.WidthText" @bind:after="() => SaveAsync(row)" />
          <RowFieldError Message="@row.ErrorFor(nameof(ArtworkForm.WidthCm))" />
        </DataTableCell>
      }

      @if (Fields.Contains(ArtworkField.Depth))
      {
        <DataTableCell Class="@FieldCellClass">
          <input inputmode="decimal" class="@($"{InputClass} w-24")" aria-label="Depth in centimetres"
                 @bind="row.DepthText" @bind:after="() => SaveAsync(row)" />
          <RowFieldError Message="@row.ErrorFor(nameof(ArtworkForm.DepthCm))" />
        </DataTableCell>
      }

      @if (Fields.Contains(ArtworkField.Duration))
      {
        <DataTableCell Class="@FieldCellClass">
          <input class="@($"{InputClass} w-28")" placeholder="h:mm:ss" aria-label="Duration" @bind="row.Form.Duration"
                 @bind:after="() => SaveAsync(row)" />
          <RowFieldError Message="@row.ErrorFor(nameof(ArtworkForm.Duration))" />
        </DataTableCell>
      }

      <DataTableCell Class="@FieldCellClass">
        <button type="button" class="@DialogButtonClass" @onclick="() => _descriptionRow = row">
          @(string.IsNullOrWhiteSpace(row.Form.Description) ? "Edit…" : row.Form.Description)
        </button>
      </DataTableCell>

      <DataTableCell Class="@FieldCellClass">
        <button type="button" class="@DialogButtonClass" @onclick="() => _seriesRow = row">
          @(row.Form.SeriesIds.Count is 0 ? "Choose…" : SeriesText(row))
        </button>
      </DataTableCell>

      <DataTableCell Class="@FieldCellClass">
        <button type="button" class="@DialogButtonClass" @onclick="() => _vocabularyRow = row">
          @(VocabularyText(row) is { Length: > 0 } terms ? terms : "Choose…")
        </button>
      </DataTableCell>
    </Row>
  </DataTable>
</div>

@if (_descriptionRow is { } descriptionRow)
{
  <DescriptionDialog ArtworkName="@descriptionRow.Form.Name" Description="@descriptionRow.Form.Description"
                     OnOk="DescriptionOkAsync" OnClose="() => _descriptionRow = null" />
}

@if (_seriesRow is { } seriesRow)
{
  <SeriesChoiceDialog ArtworkName="@seriesRow.Form.Name" AllSeries="AllSeries"
                      SelectedSeriesIds="seriesRow.Form.SeriesIds" OnOk="SeriesOkAsync" OnClose="ChoiceDialogClosedAsync"
                      OnSeriesAdded="SeriesAddedAsync" />
}

@if (_vocabularyRow is { } vocabularyRow)
{
  <VocabularyChoiceDialog ArtworkName="@vocabularyRow.Form.Name" ArtworkTypeId="Type.Id" Vocabularies="_vocabularies"
                          SelectedTermIds="vocabularyRow.Form.VocabularyTermIds" OnOk="VocabularyOkAsync" OnClose="ChoiceDialogClosedAsync"
                          OnVocabulariesChanged="VocabulariesChangedAsync" />
}

@if (_imagesRow is { } imagesRow)
{
  <ArtworkImagesDialog ArtworkName="@imagesRow.Form.Name" Images="imagesRow.SavedImages"
                       MainImageKey="@imagesRow.MainImageKey" OnOk="ImagesOkAsync" OnClose="() => _imagesRow = null" />
}

@if (_bulkSeriesChange is { } seriesChange)
{
  <BulkSeriesDialog Change="seriesChange" ArtworkCount="SelectedRows.Count"
                    Series="@(seriesChange is BulkChange.Add ? AllSeries : SeriesOfSelected)" OnOk="BulkSeriesOkAsync"
                    OnClose="ChoiceDialogClosedAsync" OnSeriesAdded="SeriesAddedAsync" />
}

@if (_bulkVocabularyChange is { } vocabularyChange)
{
  <BulkVocabularyDialog Change="vocabularyChange" ArtworkCount="SelectedRows.Count" ArtworkTypeId="Type.Id"
                        Vocabularies="@(vocabularyChange is BulkChange.Add ? _vocabularies : VocabulariesOfSelected)"
                        OnOk="BulkVocabularyOkAsync" OnClose="ChoiceDialogClosedAsync"
                        OnVocabulariesChanged="VocabulariesChangedAsync" />
}

@{
  var selectedRows = SelectedRows;
}

<ConfirmDialog @bind-Open="_isConfirmingDelete" Title="@($"Delete {CountText.Of(selectedRows.Count, "artwork")}?")"
               ConfirmLabel="Delete" OnConfirm="DeleteSelectedAsync" IsWorking="_isDeleting">
  This removes them from the catalog for good, along with
  @CountText.Of(selectedRows.Sum(row => row.SavedImages.Count), "image"), their places in any series and anything
  listed for sale from them.
</ConfirmDialog>
