@rendermode InteractiveServer
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@inject ArtworkRepository ArtworkRepository
@inject ArtworkTypeRepository ArtworkTypeRepository
@inject SeriesRepository SeriesRepository
@inject NavigationManager NavigationManager

@* One page of the filtered artwork list as an editable table. The rows are read again only when the
   address changes, with a filter or the page, so a row edited out of the filter stays until then, even
   through the refresh that shows a newly added vocabulary in the filters *@

@code {
  [Parameter, EditorRequired]
  public int ArtworkTypeId { get; set; }
  // in the list's order. A List, not IReadOnlyList: an island parameter is rebuilt from its runtime
  // type, and a collection expression's type is one the compiler made, which JSON can't create
  [Parameter, EditorRequired]
  public List<int> ArtworkIds { get; set; } = default!;
  // the page's address, filters and all
  [Parameter, EditorRequired]
  public string Address { get; set; } = default!;

  private record LoadedRows(ArtworkTypeWithFields Type, List<ArtworkTableRow> Rows);

  // null while loading, and for a type deleted since the list was read
  private LoadedRows? _loaded;
  private bool _isLoading = true;
  private string? _loadedAddress;

  // in the artist's order; a series added from the series dialog joins the end, as it does in the database
  private List<Series> _series = [];

  protected override async Task OnParametersSetAsync()
  {
    // the rows wait for the circuit, rather than being read for the prerender and then again
    if (!RendererInfo.IsInteractive)
    {
      return;
    }

    if (_loadedAddress == Address)
    {
      return;
    }

    _loadedAddress = Address;
    _isLoading = true;
    _loaded = null;

    var type = await ArtworkTypeRepository.GetAsync(new ArtworkTypeId(ArtworkTypeId));
    _series = await SeriesRepository.GetAllAsync();
    var artworks = (await ArtworkRepository.GetManyAsync([.. ArtworkIds.Select(id => new ArtworkId(id))]))
      .ToDictionary(artwork => artwork.Id);

    // one deleted since the list was read is left out
    _loaded = type is null
      ? null
      : new LoadedRows(
        type,
        [.. ArtworkIds.Select(id => artworks.GetValueOrDefault(new ArtworkId(id))).OfType<Artwork>().Select(ArtworkTableRow.FromArtwork)]
      );
    _isLoading = false;
  }

  private void SeriesAdded(Series series) => _series.Add(series);

  // an enhanced refresh, so the filters list what was added; the address is unchanged, so the rows stay
  private void ChoicesAdded() => NavigationManager.Refresh();
}

@if (_isLoading)
{
  <p class="flex items-center gap-2" role="status">
    <span class="size-4 animate-spin rounded-full border-2 border-gray-300 border-t-gray-700" aria-hidden="true"></span>
    Loading artworks
  </p>
}
else if (_loaded is null)
{
  <p>This artwork type was deleted. Reload the page.</p>
}
@* the loaded rows rather than the ids, which a refresh can empty while the rows stay *@
else if (_loaded.Rows.Count is 0)
{
  <p>No artworks match these filters.</p>
}
else
{
  <p class="mb-2 text-sm text-gray-600">Each change saves when you leave its field.</p>

  <ArtworkTable Rows="_loaded.Rows" Type="_loaded.Type" AllSeries="_series" OnSeriesAdded="SeriesAdded" OnChoicesAdded="ChoicesAdded" />
}
