@using ArtistShop.Web.Components.Forms
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Domain.Sites
@using ArtistShop.Web.Sites

@* A static page's artwork type select, in a GET form. Each choice is saved as the type every artwork
   type select starts at. ArtworkTypeSelect is the islands' *@

@code {
  // the form field the select submits as
  [Parameter, EditorRequired]
  public string Name { get; set; } = default!;

  [Parameter, EditorRequired]
  public IReadOnlyList<ArtworkType> ArtworkTypes { get; set; } = default!;

  // the type the page shows, such as from its address; with none, the saved one
  [Parameter]
  public ArtworkTypeId? Value { get; set; }

  [Parameter]
  public string? Placeholder { get; set; }

  private List<(string Value, string Label)> Options =>
    [.. ArtworkTypes.Select(type => (RememberedArtworkType.ValueOf(type.Id), type.Name.Value))];
}

<RememberedSelect Name="@Name" InputName="@RememberedInputs.ArtworkType" Options="Options"
                  Value="@(Value is null ? null : RememberedArtworkType.ValueOf(Value))" Placeholder="@Placeholder"
                  Class="artist-shop-field-input" />
