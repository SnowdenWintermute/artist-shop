@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Utilities

@* For an island with no form. SelectField builds on InputSelect, which needs an EditContext *@

@code {
  [Parameter, EditorRequired]
  public IReadOnlyList<ArtworkType> ArtworkTypes { get; set; } = default!;
  [Parameter]
  public int? Value { get; set; }
  [Parameter]
  public EventCallback<int?> ValueChanged { get; set; }
  [Parameter]
  public bool Disabled { get; set; }
  [Parameter]
  public string? Class { get; set; }

  private Task ChangedAsync(ChangeEventArgs change) =>
    ValueChanged.InvokeAsync(int.TryParse(change.Value?.ToString(), out var typeId) ? typeId : null);
}

<label class="mb-1 block text-sm" for="artwork-type">Artwork type</label>
<select id="artwork-type" class="@ClassNames.Join("artist-shop-field-input", Class)" value="@Value"
        @onchange="ChangedAsync" disabled="@Disabled">
  <option value="">Choose a type</option>
  @foreach (var artworkType in ArtworkTypes)
  {
    <option value="@artworkType.Id.Value">@artworkType.Name.Value</option>
  }
</select>
