@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Sites
@using ArtistShop.Web.Utilities
@inject RememberedArtworkType RememberedArtworkType
@inject ILogger<ArtworkTypeSelect> Logger

@* For an island with no form. SelectField builds on InputSelect, which needs an EditContext. Each
   choice is saved for the other artwork type selects to start at; the island reads it back itself *@

@code {
  [Parameter, EditorRequired]
  public IReadOnlyList<ArtworkType> ArtworkTypes { get; set; } = default!;
  [Parameter]
  public int? Value { get; set; }
  [Parameter]
  public EventCallback<int?> ValueChanged { get; set; }
  [Parameter]
  public bool Disabled { get; set; }
  [Parameter]
  public string? Class { get; set; }

  private async Task ChangedAsync(ChangeEventArgs change)
  {
    int? value = int.TryParse(change.Value?.ToString(), out var typeId) ? typeId : null;

    await ValueChanged.InvokeAsync(value);

    if (value is not int chosen)
    {
      return;
    }

    // only a convenience, like RememberedSelect's save, so a failure costs the next page its
    // starting type and nothing more
    try
    {
      await RememberedArtworkType.SetAsync(new ArtworkTypeId(chosen));
    }
    catch (Exception exception)
    {
      Logger.LogWarning(exception, "Couldn't save the chosen artwork type");
    }
  }
}

<label class="mb-1 block text-sm" for="artwork-type">Artwork type</label>
<select id="artwork-type" class="@ClassNames.Join("artist-shop-field-input", Class)" value="@Value"
        @onchange="ChangedAsync" disabled="@Disabled">
  <option value="">Choose a type</option>
  @foreach (var artworkType in ArtworkTypes)
  {
    <option value="@artworkType.Id.Value">@artworkType.Name.Value</option>
  }
</select>
