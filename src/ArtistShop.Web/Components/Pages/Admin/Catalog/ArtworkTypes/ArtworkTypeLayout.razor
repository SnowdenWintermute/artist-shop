@inherits LayoutComponentBase
@layout MainLayout
@using ArtistShop.Web.Components.Catalog
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@inject ArtworkTypeRepository ArtworkTypeRepository

@code {
  private List<ArtworkType> _artworkTypes = [];

  protected override async Task OnInitializedAsync()
  {
    _artworkTypes = ArtworkTypeOrder.SortedByName(await ArtworkTypeRepository.GetAllAsync());
  }
}

<AdminPanel>
  <SectionNav>
    <NavLink href="@PageUrls.NewArtworkType" ActiveClass="underline">+ New artwork type</NavLink>
    <div aria-hidden="true" class="pointer-events-none">|</div>
    @foreach (var artworkType in _artworkTypes)
    {
      <SectionNavLink href="@PageUrls.EditArtworkType(artworkType.Id)"
                      ActivePath="@PageUrls.EditArtworkType(artworkType.Id)" ActiveClass="underline">
        @artworkType.Name.Value
      </SectionNavLink>
    }
  </SectionNav>
  <ChildContent>
    @Body
  </ChildContent>
</AdminPanel>
