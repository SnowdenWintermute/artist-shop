@using ArtistShop.Web.Components.Dialogs
@using ArtistShop.Web.Domain.Catalog

@code {
  [Parameter]
  public bool Open { get; set; }

  [Parameter]
  public EventCallback<bool> OpenChanged { get; set; }

  [Parameter, EditorRequired]
  public VocabularyName VocabularyName { get; set; } = default!;

  [Parameter, EditorRequired]
  public IReadOnlyList<ArtworkType> UnselectedArtworkTypes { get; set; } = default!;

  [Parameter, EditorRequired]
  public VocabularyUsage Usage { get; set; } = default!;

  [Parameter, EditorRequired]
  public EventCallback OnConfirm { get; set; }

  [Parameter]
  public bool IsWorking { get; set; }

  private string AffectedItems =>
    string.Join(", ", UnselectedArtworkTypes.Select(artworkType =>
      $"{Usage.ArtworkCountFor(artworkType.Id)} {artworkType.Name.Value} items"));
}

<ConfirmDialog Open="Open" OpenChanged="OpenChanged" Title="Remove terms from items?"
               ConfirmLabel="Save and remove" OnConfirm="OnConfirm" IsWorking="IsWorking">
  Unselecting removes @VocabularyName.Value terms from @AffectedItems (count as of page load).
</ConfirmDialog>
