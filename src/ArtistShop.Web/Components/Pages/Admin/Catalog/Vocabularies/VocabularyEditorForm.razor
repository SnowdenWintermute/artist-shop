@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Forms
@using ArtistShop.Web.Database
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@inject VocabularyRepository VocabularyRepository
@inject NavigationManager NavigationManager
@inject TimeProvider TimeProvider

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  [Parameter, EditorRequired]
  public IReadOnlyList<WorkType> WorkTypes { get; set; } = default!;

  // null when creating
  [Parameter]
  public LoadedVocabulary? Loaded { get; set; }

  private readonly VocabularyForm _form = new();
  private bool _isSaving;
  // only when Save or Create itself was clicked; a checkbox's save disables the checkboxes, and a
  // dialog's confirm button spins for the saves and deletes it starts
  private bool _isSavingName;
  private bool _removeTermsDialogOpen;
  private bool _deleteDialogOpen;

  // after a save, Refresh re-renders the page, which passes the saved values back in here. The
  // island is keyed by the vocabulary, so these are always the same vocabulary's
  protected override void OnParametersSet()
  {
    if (Loaded is not null)
    {
      _form.Load(Loaded.Vocabulary);
    }
  }

  private List<WorkType> UnselectedWorkTypesInUse =>
    Loaded is null
      ? []
      : [.. WorkTypes.Where(workType =>
          _form.WasUnselected(workType.Id) && Loaded.Usage.WorkCountFor(workType.Id) > 0)];

  private IReadOnlyList<WorkName> WorksLosingTermsToMutuallyExclusive =>
    Loaded is not null && _form.BecameMutuallyExclusive ? Loaded.WorksWithSeveralTerms : [];

  // on an existing vocabulary the checkboxes save as they change, so this saves only the name
  private async Task HandleValidSubmit()
  {
    _isSavingName = true;

    try
    {
      await SaveAsync(_form.ToVocabularyName());
    }
    finally
    {
      _isSavingName = false;
    }
  }

  private async Task ToggleWorkTypeAsync(WorkTypeId workTypeId)
  {
    _form.ToggleWorkType(workTypeId);
    await SaveCheckboxesAsync();
  }

  // with the saved name rather than the field's, which may be half typed
  private async Task SaveCheckboxesAsync()
  {
    if (Loaded is null)
    {
      return;
    }

    if (UnselectedWorkTypesInUse.Count > 0 || WorksLosingTermsToMutuallyExclusive.Count > 0)
    {
      _removeTermsDialogOpen = true;
      return;
    }

    await SaveAsync(Loaded.Vocabulary.Name);
  }

  // only on Cancel: a confirmed save closes the dialog itself
  private void RemoveTermsDialogOpenChanged(bool open)
  {
    _removeTermsDialogOpen = open;

    if (!open)
    {
      _form.RevertCheckboxes();
    }
  }

  private async Task SaveAsync(VocabularyName name)
  {
    _isSaving = true;

    try
    {
      if (Loaded is null)
      {
        var id = await VocabularyRepository.AddAsync(name, _form.IsMutuallyExclusive, _form.WorkTypeIds);
        NavigationManager.NavigateTo(PageUrls.NewVocabularyAdded(id));
        return;
      }

      await VocabularyRepository.UpdateAsync(Loaded.Vocabulary.Id, name, _form.IsMutuallyExclusive, _form.WorkTypeIds);
      // the page draws the saved notice beside its up link, which is outside this island
      NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
      { [SavedAtQuery.Key] = SavedAtQuery.Value(TimeProvider.GetUtcNow()) }));
    }
    catch (NameAlreadyInUseException exception)
    {
      _form.AddNameTakenError(exception.Name);
    }
    catch (ChangedSincePageLoadException)
    {
      // deleted in another tab; the reloaded page says so
      NavigationManager.Refresh();
    }
    finally
    {
      _isSaving = false;
      _removeTermsDialogOpen = false;
    }
  }

  private async Task DeleteAsync(LoadedVocabulary loaded)
  {
    _isSaving = true;

    try
    {
      await VocabularyRepository.DeleteAsync(loaded.Vocabulary.Id);
      NavigationManager.NavigateTo(PageUrls.NewVocabulary);
    }
    finally
    {
      _isSaving = false;
    }
  }
}

<DisabledUntilInteractive>
  <EditForm EditContext="_form.EditContext" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />

    @if (Loaded is null)
    {
      <TextField Label="Name" @bind-Value="_form.Name" UpdatesPerKeystroke />
    }
    else
    {
      <TextFieldWithButton Label="Name" @bind-Value="_form.Name" UpdatesPerKeystroke>
        <ButtonBasic type="submit" Variant="ButtonVariant.Primary" Busy="_isSavingName"
                     disabled="@(_isSaving || !_form.NameHasChanges)">
          Save
        </ButtonBasic>
      </TextFieldWithButton>
    }
    <WorkTypeCheckboxes WorkTypes="WorkTypes" Selected="_form.WorkTypeIds" OnToggle="ToggleWorkTypeAsync"
                        Disabled="_isSaving" />
    <CheckboxField Label="Mutually exclusive" @bind-Value="_form.IsMutuallyExclusive"
                   @bind-Value:after="SaveCheckboxesAsync" Disabled="_isSaving"
                   Hint="@($"Each {Wording.Work.SingularInSentence} may only have one of these terms.")" />

    @if (Loaded is null)
    {
      <ButtonBasic type="submit" Variant="ButtonVariant.Primary" Busy="_isSavingName" disabled="@_isSaving">
        Create vocabulary
      </ButtonBasic>
    }
    else
    {
      <ButtonBasic type="button" Variant="ButtonVariant.DangerOutline" disabled="@_isSaving"
                   @onclick="() => _deleteDialogOpen = true">
        Delete vocabulary
      </ButtonBasic>
    }
  </EditForm>

  @if (Loaded is { } loaded)
  {
    <RemoveWorkTermsDialog Open="_removeTermsDialogOpen" OpenChanged="RemoveTermsDialogOpenChanged" VocabularyName="loaded.Vocabulary.Name"
                              UnselectedWorkTypes="UnselectedWorkTypesInUse" Usage="loaded.Usage"
                              WorksWithSeveralTerms="WorksLosingTermsToMutuallyExclusive" OnConfirm="() => SaveAsync(loaded.Vocabulary.Name)" IsWorking="_isSaving" />

    <DeleteVocabularyDialog @bind-Open="_deleteDialogOpen" VocabularyName="loaded.Vocabulary.Name" Usage="loaded.Usage"
                            OnConfirm="() => DeleteAsync(loaded)" IsWorking="_isSaving" />
  }
</DisabledUntilInteractive>
