@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Forms
@using ArtistShop.Web.Database
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@inject VocabularyRepository VocabularyRepository
@inject NavigationManager NavigationManager

@code {
  [Parameter, EditorRequired]
  public IReadOnlyList<ShopItemType> ShopItemTypes { get; set; } = default!;

  // null when creating
  [Parameter]
  public LoadedVocabulary? Loaded { get; set; }

  private VocabularyForm _form = VocabularyForm.ForNew();
  private bool _isSaving;
  private bool _justSaved;
  private bool _unselectDialogOpen;
  private bool _deleteDialogOpen;

  // after a save, Refresh re-renders the page, which passes the saved values back in here
  protected override void OnParametersSet() =>
    _form = Loaded is null ? VocabularyForm.ForNew() : VocabularyForm.ForExisting(Loaded.Vocabulary);

  private List<ShopItemType> UnselectedShopItemTypesInUse =>
    Loaded is null
      ? []
      : [.. ShopItemTypes.Where(shopItemType =>
          _form.WasUnselected(shopItemType.Id) && Loaded.Usage.ShopItemCountFor(shopItemType.Id) > 0)];

  private async Task HandleValidSubmit()
  {
    if (UnselectedShopItemTypesInUse.Count > 0)
    {
      _unselectDialogOpen = true;
      return;
    }

    await SaveAsync();
  }

  private async Task SaveAsync()
  {
    _isSaving = true;

    try
    {
      var name = _form.ToVocabularyName();

      if (Loaded is null)
      {
        var id = await VocabularyRepository.AddAsync(name, _form.ShopItemTypeIds);
        NavigationManager.NavigateTo($"/admin/catalog/vocabularies/{id.Value}");
        return;
      }

      await VocabularyRepository.UpdateAsync(Loaded.Vocabulary.Id, name, _form.ShopItemTypeIds);
      _justSaved = true;
      NavigationManager.Refresh();
    }
    catch (NameAlreadyInUseException exception)
    {
      _form.AddNameTakenError(exception.Name);
    }
    finally
    {
      _isSaving = false;
      _unselectDialogOpen = false;
    }
  }

  private async Task DeleteAsync(LoadedVocabulary loaded)
  {
    _isSaving = true;

    try
    {
      await VocabularyRepository.DeleteAsync(loaded.Vocabulary.Id);
      NavigationManager.NavigateTo("/admin/catalog/vocabularies/new");
    }
    finally
    {
      _isSaving = false;
    }
  }
}

<EditForm EditContext="_form.EditContext" OnValidSubmit="HandleValidSubmit">
  <DataAnnotationsValidator />

  <TextField Label="Name" @bind-Value="_form.Name" />
  <ShopItemTypeCheckboxes ShopItemTypes="ShopItemTypes" Selected="_form.ShopItemTypeIds"
                          OnToggle="_form.ToggleShopItemType" />

  @if (_justSaved && !_form.HasChanges)
  {
    <p class="mb-4 text-green-600">Saved.</p>
  }

  <div class="flex justify-between">
    <ButtonBasic type="submit" Class="bg-blue-400 text-white" disabled="@_isSaving">
      @(Loaded is null ? "Create vocabulary" : "Save")
    </ButtonBasic>

    @if (Loaded is not null)
    {
      <ButtonBasic type="button" Class="border border-red-600 text-red-600" disabled="@_isSaving"
                   @onclick="() => _deleteDialogOpen = true">
        Delete vocabulary
      </ButtonBasic>
    }
  </div>
</EditForm>

@if (Loaded is { } loaded)
{
  <UnselectShopItemTypesDialog @bind-Open="_unselectDialogOpen" VocabularyName="loaded.Vocabulary.Name"
                               UnselectedShopItemTypes="UnselectedShopItemTypesInUse" Usage="loaded.Usage"
                               OnConfirm="SaveAsync" IsWorking="_isSaving" />

  <DeleteVocabularyDialog @bind-Open="_deleteDialogOpen" VocabularyName="loaded.Vocabulary.Name"
                          Usage="loaded.Usage" OnConfirm="() => DeleteAsync(loaded)" IsWorking="_isSaving" />
}
