@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Forms
@using ArtistShop.Web.Database
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@inject VocabularyRepository VocabularyRepository
@inject NavigationManager NavigationManager

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  [Parameter, EditorRequired]
  public IReadOnlyList<WorkType> WorkTypes { get; set; } = default!;

  // null when creating
  [Parameter]
  public LoadedVocabulary? Loaded { get; set; }

  private readonly VocabularyForm _form = new();
  private bool _isSaving;

  // only when Save itself was clicked; a dialog's confirm button spins for the saves and deletes
  // it starts
  private bool SaveButtonBusy => _isSaving && !_removeTermsDialogOpen && !_deleteDialogOpen;
  // keys the notice, so each save draws a new one, visible until the first edit hides it
  private int _saveCount;
  private bool _removeTermsDialogOpen;
  private bool _deleteDialogOpen;

  // after a save, Refresh re-renders the page, which passes the saved values back in here. The
  // island is keyed by the vocabulary, so these are always the same vocabulary's
  protected override void OnParametersSet()
  {
    if (Loaded is not null)
    {
      _form.Load(Loaded.Vocabulary);
    }
  }

  private List<WorkType> UnselectedWorkTypesInUse =>
    Loaded is null
      ? []
      : [.. WorkTypes.Where(workType =>
          _form.WasUnselected(workType.Id) && Loaded.Usage.WorkCountFor(workType.Id) > 0)];

  private IReadOnlyList<WorkName> WorksLosingTermsToMutuallyExclusive =>
    Loaded is not null && _form.BecameMutuallyExclusive ? Loaded.WorksWithSeveralTerms : [];

  private async Task HandleValidSubmit()
  {
    if (UnselectedWorkTypesInUse.Count > 0 || WorksLosingTermsToMutuallyExclusive.Count > 0)
    {
      _removeTermsDialogOpen = true;
      return;
    }

    await SaveAsync();
  }

  private async Task SaveAsync()
  {
    _isSaving = true;

    try
    {
      var name = _form.ToVocabularyName();

      if (Loaded is null)
      {
        var id = await VocabularyRepository.AddAsync(name, _form.IsMutuallyExclusive, _form.WorkTypeIds);
        NavigationManager.NavigateTo(PageUrls.EditVocabulary(id));
        return;
      }

      await VocabularyRepository.UpdateAsync(Loaded.Vocabulary.Id, name, _form.IsMutuallyExclusive, _form.WorkTypeIds);
      _saveCount++;
      NavigationManager.Refresh();
    }
    catch (NameAlreadyInUseException exception)
    {
      _form.AddNameTakenError(exception.Name);
    }
    catch (ChangedSincePageLoadException)
    {
      // deleted in another tab; the reloaded page says so
      NavigationManager.Refresh();
    }
    finally
    {
      _isSaving = false;
      _removeTermsDialogOpen = false;
    }
  }

  private async Task DeleteAsync(LoadedVocabulary loaded)
  {
    _isSaving = true;

    try
    {
      await VocabularyRepository.DeleteAsync(loaded.Vocabulary.Id);
      NavigationManager.NavigateTo(PageUrls.NewVocabulary);
    }
    finally
    {
      _isSaving = false;
    }
  }
}

<DisabledUntilInteractive>
  <EditForm EditContext="_form.EditContext" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />

    <TextField Label="Name" @bind-Value="_form.Name" UpdatesPerKeystroke />
    <WorkTypeCheckboxes WorkTypes="WorkTypes" Selected="_form.WorkTypeIds"
                           OnToggle="_form.ToggleWorkType" />
    <CheckboxField Label="Mutually exclusive" @bind-Value="_form.IsMutuallyExclusive"
                   Hint="@($"Each {Wording.Work.SingularInSentence} may only have one of these terms.")" />

    @if (_saveCount > 0)
    {
      <SavedNotice @key="_saveCount">Saved.</SavedNotice>
    }

    <div class="flex justify-between">
      <ButtonBasic type="submit" Variant="ButtonVariant.Primary" Busy="SaveButtonBusy"
                   disabled="@(_isSaving || (Loaded is not null && !_form.HasChanges))">
        @(Loaded is null ? "Create vocabulary" : "Save")
      </ButtonBasic>

      @if (Loaded is not null)
      {
        <ButtonBasic type="button" Variant="ButtonVariant.DangerOutline" disabled="@_isSaving"
                     @onclick="() => _deleteDialogOpen = true">
          Delete vocabulary
        </ButtonBasic>
      }
    </div>
  </EditForm>

  @if (Loaded is { } loaded)
  {
    <RemoveWorkTermsDialog @bind-Open="_removeTermsDialogOpen" VocabularyName="loaded.Vocabulary.Name"
                              UnselectedWorkTypes="UnselectedWorkTypesInUse" Usage="loaded.Usage"
                              WorksWithSeveralTerms="WorksLosingTermsToMutuallyExclusive" OnConfirm="SaveAsync" IsWorking="_isSaving" />

    <DeleteVocabularyDialog @bind-Open="_deleteDialogOpen" VocabularyName="loaded.Vocabulary.Name" Usage="loaded.Usage"
                            OnConfirm="() => DeleteAsync(loaded)" IsWorking="_isSaving" />
  }
</DisabledUntilInteractive>
