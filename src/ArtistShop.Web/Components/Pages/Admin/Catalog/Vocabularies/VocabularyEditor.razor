@page "/admin/catalog/vocabularies/new"
@page "/admin/catalog/vocabularies/{Id:int}/edit"
@layout VocabularyLayout
@using ArtistShop.Web.Components.Hints
@using ArtistShop.Web.Domain.Platform
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Catalog
@using ArtistShop.Web.Components.Pages.Admin.Catalog
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Sites
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = SitePolicies.Admin)]
@inject VocabularyRepository VocabularyRepository
@inject WorkTypeRepository WorkTypeRepository

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  [Parameter]
  public int? Id { get; set; }

  private List<WorkType> _workTypes = [];
  // null when creating, or when the id doesn't exist
  private LoadedVocabulary? _loaded;
  // on the new vocabulary page only, which is where the admin's Vocabularies link lands
  private List<Vocabulary> _unlinkedVocabularies = [];

  protected override async Task OnInitializedAsync()
  {
    _workTypes = await WorkTypeRepository.GetAllAsync();

    if (Id is null)
    {
      _unlinkedVocabularies = VocabularyOrder.SortedByName(await VocabularyRepository.GetAllWithoutWorkTypesAsync());
    }

    if (Id is int id)
    {
      var vocabularyId = new VocabularyId(id);
      var vocabulary = await VocabularyRepository.GetAsync(vocabularyId);

      if (vocabulary is not null)
      {
        _loaded = new LoadedVocabulary(
          vocabulary,
          await VocabularyRepository.CountUsageAsync(vocabularyId),
          vocabulary.IsMutuallyExclusive ? [] : await VocabularyRepository.GetWorksWithSeveralTermsAsync(vocabularyId)
        );
      }
    }
  }
}


@* only on the new vocabulary page, which is where the admin's Vocabularies links land *@
@if (Id is null)
{
  <Hint Type="HintType.Vocabularies">
    <p>Controlled
      vocabularies provide a way
      to associate
      your @Wording.Work.PluralInSentence with a defined list of terms. For example, a painting could have a vocabulary called "Support" whose
      terms could be "Canvas", "Paper" or "Stone Slab".</p>

    </Hint>
  }

  <PageTitle>@(_loaded is null ? "New vocabulary" : _loaded.Vocabulary.Name.Value)</PageTitle>

  @if (Id is not null && _loaded is null)
  {
    <p>This vocabulary doesn't exist. It may have been deleted.</p>
  }
  else
  {
    <div class="mb-4 flex items-baseline justify-between">
      <h1 class="text-xl">@(_loaded is null ? "New vocabulary" : $"Edit {_loaded.Vocabulary.Name.Value}")</h1>
      @if (_loaded is not null)
      {
        <a href="@PageUrls.VocabularyTerms(_loaded.Vocabulary.Id)">Edit associated terms</a>
      }
    </div>

    @if (_unlinkedVocabularies.Count > 0)
    {
      <Notice>
        <p class="mb-2">
          @(_unlinkedVocabularies.Count is 1 ? "This vocabulary isn't" : "These vocabularies aren't") linked to any
          @Wording.Work.SingularInSentence type yet, so @(_unlinkedVocabularies.Count is 1 ? "it doesn't" : "they don't") show on
          any @Wording.Work.SingularInSentence's form.
        </p>
        <ul class="list-disc pl-5">
          @foreach (var vocabulary in _unlinkedVocabularies)
          {
            <li @key="vocabulary.Id.Value">
              <a href="@PageUrls.EditVocabulary(vocabulary.Id)" class="underline">@vocabulary.Name.Value</a>
            </li>
          }
        </ul>
      </Notice>
    }

    @if (_loaded is { Vocabulary.WorkTypeIds.Count: 0 })
    {
      <UnlinkedVocabularyNotice Name="_loaded.Vocabulary.Name">
        Check the types it applies to below and save.
      </UnlinkedVocabularyNotice>
    }

    @* @key: a different vocabulary gets a fresh island rather than inheriting this one's state *@
    <VocabularyEditorForm @rendermode="InteractiveServer" @key="Id" WorkTypes="_workTypes" Loaded="_loaded" />
  }
