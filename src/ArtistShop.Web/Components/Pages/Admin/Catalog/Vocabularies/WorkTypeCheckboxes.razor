@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Domain.Catalog

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  [Parameter, EditorRequired]
  public IReadOnlyList<WorkType> WorkTypes { get; set; } = default!;

  [Parameter, EditorRequired]
  public IReadOnlySet<WorkTypeId> Selected { get; set; } = default!;

  [Parameter, EditorRequired]
  public EventCallback<WorkTypeId> OnToggle { get; set; }

  [Parameter]
  public bool Disabled { get; set; }
}

<fieldset class="mb-4">
  @* the legend stays the fieldset's first child, or it no longer names the group *@
  <legend class="mb-1 text-sm">Applies to</legend>
  <div class="mb-2">
    @foreach (var workType in WorkTypes)
    {
      <label class="mr-4 inline-flex items-center gap-2 cursor-pointer">
        <input type="checkbox" class="cursor-pointer" checked="@Selected.Contains(workType.Id)" disabled="@Disabled"
               @onchange="() => OnToggle.InvokeAsync(workType.Id)" />
        @workType.Name.Value
      </label>
    }
  </div>
  @* "another" rather than "a", which would be wrong before a word the artist chose that starts with a vowel *@
  <a class="@LinkStyles.InSentence leading-0" href="@PageUrls.NewWorkType">Add another @Wording.Work.SingularInSentence
    type</a>
  </fieldset>
