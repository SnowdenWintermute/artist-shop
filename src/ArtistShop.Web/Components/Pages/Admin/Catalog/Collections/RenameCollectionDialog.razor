@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Forms
@using ArtistShop.Web.Database
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Components.Dialogs
@inject CollectionRepository CollectionRepository
@inject NavigationManager NavigationManager

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  [Parameter]
  public bool Open { get; set; }
  [Parameter]
  public EventCallback<bool> OpenChanged { get; set; }
  [Parameter, EditorRequired]
  public CollectionId CollectionId { get; set; } = default!;
  [Parameter, EditorRequired]
  public CollectionName CollectionName { get; set; } = default!;

  private CollectionNameForm _form = new();
  private bool _wasOpen;
  private bool _isSaving;

  // a fresh form each time it opens, so text typed and then cancelled doesn't come back
  protected override void OnParametersSet()
  {
    if (Open && !_wasOpen)
    {
      _form = CollectionNameForm.WithName(CollectionName.Value);
    }

    _wasOpen = Open;
  }

  private Task CloseAsync() => _isSaving ? Task.CompletedTask : OpenChanged.InvokeAsync(false);

  private async Task RenameAsync()
  {
    _isSaving = true;

    try
    {
      await CollectionRepository.RenameAsync(CollectionId, _form.ToCollectionName(), _form.ToCollectionSlug());
      _isSaving = false;
      await OpenChanged.InvokeAsync(false);
      NavigationManager.Refresh();
    }
    catch (NameAlreadyInUseException)
    {
      _form.AddNameTakenError();
    }
    catch (ChangedSincePageLoadException)
    {
      // the collection was deleted elsewhere; the reloaded page says so
      NavigationManager.Refresh();
    }
    finally
    {
      _isSaving = false;
    }
  }
}

@if (Open)
{
  <ModalDialog Title="@($"Rename {CollectionName.Value}")" Width="ModalDialogWidth.Narrow" OnClose="CloseAsync"
               KeepOpen="_isSaving">
    <EditForm EditContext="_form.EditContext" OnValidSubmit="RenameAsync">
      <DataAnnotationsValidator />

      <TextField Label="Name" @bind-Value="_form.Name" UpdatesPerKeystroke />
      <p class="mb-4 text-sm text-ink-faded">Renaming changes the @Wording.Collection.SingularInSentence's web address, so old links stop
        working.</p>
      <ModalDialogActions>
        <ModalCloseButton Label="Cancel" Disabled="_isSaving" />
        <ButtonBasic type="submit" Variant="ButtonVariant.Primary" Busy="_isSaving"
                     disabled="@(_isSaving || _form.Name == CollectionName.Value)">
          Rename
        </ButtonBasic>
      </ModalDialogActions>
    </EditForm>
  </ModalDialog>
}
