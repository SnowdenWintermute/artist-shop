@page "/admin/catalog/collections"
@layout CollectionLayout
@using ArtistShop.Web.Components.Hints
@using ArtistShop.Web.Domain.Platform
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Sites
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = SitePolicies.Admin)]
@inject CollectionRepository CollectionRepository

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  // in the artist's order
  private List<CollectionWithCover> _collections = [];

  protected override async Task OnInitializedAsync() =>
    _collections = await CollectionRepository.GetAllWithCoversAsync();
}

<PageTitle>@Wording.Collection.PluralHeading</PageTitle>

<h1 class="mb-4 text-xl">@Wording.Collection.PluralHeading</h1>

<Hint Type="HintType.Collections">
  <p>@Wording.Work.PluralHeading which share a common thread may be grouped into @Wording.Collection.PluralInSentence.
    @Wording.Collection.PluralHeading function like folders, except that a single @Wording.Work.SingularInSentence may be
    in more than one.</p>

  </Hint>

  <AddCollectionForm />

  <CollectionOrderList @rendermode="InteractiveServer" Collections="_collections" />
