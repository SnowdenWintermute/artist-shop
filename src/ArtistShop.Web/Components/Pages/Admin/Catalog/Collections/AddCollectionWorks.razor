@page "/admin/catalog/collections/{Id:int}/add-works"
@layout CollectionLayout
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Pages.Admin.Catalog.Works
@using ArtistShop.Web.Database
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Sites
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = SitePolicies.Admin)]
@inject CollectionRepository CollectionRepository
@inject NavigationManager NavigationManager

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  private const string AddFormName = "add-collection-works";

  [Parameter]
  public int Id { get; set; }

  [SupplyParameterFromQuery(Name = PageUrls.AddCollectionWorksCheckedKey)]
  private int[]? CheckedIds { get; set; }

  private Collection? _collection;

  private CollectionId CollectionId => new(Id);

  // a work checked twice, in an address edited by hand, counts once
  private WorkListSelection Selection =>
    new(PageUrls.AddCollectionWorksCheckedKey, [.. (CheckedIds ?? []).Distinct().Select(id => new WorkId(id))]);

  protected override async Task OnInitializedAsync() =>
    _collection = await CollectionRepository.GetByIdAsync(CollectionId);

  // the form posts to this page's own address, so the checks arrive in it
  private async Task AddAsync()
  {
    try
    {
      await CollectionRepository.AddWorksAsync(CollectionId, Selection.Ids);
    }
    catch (ChangedSincePageLoadException)
    {
      // the collection was deleted elsewhere; its page says so
    }

    NavigationManager.NavigateTo(PageUrls.EditCollection(CollectionId));
  }
}

<PageTitle>Add @Wording.Work.PluralInSentence to @(_collection?.Name.Value ?? Wording.Collection.SingularInSentence)</PageTitle>

@if (_collection is null)
{
  <BackLink Href="@PageUrls.CollectionList" Label="@($"All {Wording.Collection.PluralInSentence}")" />

  <p>This @Wording.Collection.SingularInSentence doesn't exist. It may have been deleted.</p>
}
else
{
  <BackLink Href="@PageUrls.EditCollection(CollectionId)" Label="@_collection.Name.Value" />

  <div class="mb-4 flex items-baseline justify-between gap-4">
    <h1 class="text-xl">Add @Wording.Work.PluralInSentence to @_collection.Name.Value</h1>

    @* posts to the address, so a click while a check is still on its way waits for it *@
    <form method="post" @formname="@AddFormName" @onsubmit="AddAsync" data-enhance data-waits-for-pending>
      <AntiforgeryToken />
      <ButtonBasic type="submit" Variant="ButtonVariant.Primary" disabled="@(Selection.Ids.Count == 0)">
        Add selected (@Selection.Ids.Count)
      </ButtonBasic>
    </form>
  </div>

  @* only works not in the collection yet. A row's title is text, since this page is for checking
     works, not opening them *@
  <WorkListBrowser RowHref="_ => null" ClearFiltersHref="@PageUrls.AddCollectionWorks(CollectionId, Selection.Ids)"
                      ExcludedCollectionId="CollectionId" Selection="Selection" />
}
