@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Dialogs
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Utilities

@* rendered only while open, so each opening starts from the row's saved collections *@

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  // null while the row's title is cleared
  [Parameter, EditorRequired]
  public string? WorkName { get; set; }
  // in the artist's order
  [Parameter, EditorRequired]
  public IReadOnlyList<Collection> AllCollections { get; set; } = default!;
  [Parameter, EditorRequired]
  public IReadOnlyList<int> SelectedCollectionIds { get; set; } = default!;
  [Parameter, EditorRequired]
  public EventCallback<List<int>> OnOk { get; set; }
  [Parameter, EditorRequired]
  public EventCallback OnClose { get; set; }
  // a collection is saved as soon as it's added, so every row can choose it, even if this one is cancelled
  [Parameter, EditorRequired]
  public EventCallback<Collection> OnCollectionAdded { get; set; }

  private readonly HashSet<int> _checked = [];
  private bool _isAddingCollection;

  protected override void OnInitialized() => _checked.UnionWith(SelectedCollectionIds);

  private async Task CollectionAddedAsync(Collection collection)
  {
    _checked.Add(collection.Id.Value);
    await OnCollectionAdded.InvokeAsync(collection);
  }

  // in the order the collections are listed, so the row reads the same as this list
  private Task OkAsync() =>
    OnOk.InvokeAsync([.. AllCollections.Select(collection => collection.Id.Value).Where(_checked.Contains)]);
}

<ModalDialog Title="@(WorkName is null ? Wording.Collection.PluralHeading : $"{Wording.Collection.PluralHeading} of {WorkName}")" Width="ModalDialogWidth.Narrow" OnClose="OnClose" KeepOpen="_isAddingCollection">
  <CollectionChoices AllCollections="AllCollections" Checked="_checked" OnToggle="id => _checked.Toggle(id)" OnCollectionAdded="CollectionAddedAsync"
                 @bind-IsAdding="_isAddingCollection" />

  <ModalDialogActions>
    <ModalCloseButton Label="Cancel" Disabled="_isAddingCollection" />
    @* focused when the dialog opens, so Enter is OK; the browser would focus the first checkbox *@
    <ButtonBasic type="button" Variant="ButtonVariant.Primary" disabled="@_isAddingCollection" @onclick="OkAsync" autofocus>OK</ButtonBasic>
  </ModalDialogActions>
</ModalDialog>
