@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Dialogs
@using ArtistShop.Web.Components.Forms
@using ArtistShop.Web.Database
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@inject WorkTypeRepository WorkTypeRepository
@inject NavigationManager NavigationManager
@inject TimeProvider TimeProvider

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  [Parameter, EditorRequired]
  public IReadOnlyList<WorkFieldDefinition> FieldDefinitions { get; set; } = default!;

  // null when creating
  [Parameter]
  public LoadedWorkType? Loaded { get; set; }

  private readonly WorkTypeForm _form = new();
  private bool _isSaving;
  // only when Save or Create itself was clicked; a checkbox's save disables the checkboxes, and a
  // dialog's confirm button spins for the saves and deletes it starts
  private bool _isSavingName;
  private bool _switchOffDialogOpen;
  private bool _deleteDialogOpen;

  // after a save, Refresh re-renders the page, which passes the saved values back in here. The
  // island is keyed by the work type, so these are always the same type's
  protected override void OnParametersSet()
  {
    if (Loaded is not null)
    {
      _form.Load(Loaded.WorkType);
    }
  }

  private List<WorkFieldDefinition> SwitchedOffFieldsInUse =>
    Loaded is null
      ? []
      : [.. FieldDefinitions.Where(definition =>
          _form.WasSwitchedOff(definition.Field) && Loaded.WorkCounts.WithValueIn(definition.Field) > 0)];

  // on an existing type the checkboxes save as they change, so this saves only the name
  private async Task HandleValidSubmit()
  {
    _isSavingName = true;

    try
    {
      await SaveAsync(_form.ToWorkTypeName());
    }
    finally
    {
      _isSavingName = false;
    }
  }

  // saves with the saved name rather than the field's, which may be half typed
  private async Task ToggleFieldAsync(WorkFieldDefinition definition)
  {
    _form.ToggleField(definition, FieldDefinitions);

    if (Loaded is null)
    {
      return;
    }

    if (SwitchedOffFieldsInUse.Count > 0)
    {
      _switchOffDialogOpen = true;
      return;
    }

    await SaveAsync(Loaded.WorkType.Name);
  }

  // only on Cancel: a confirmed save closes the dialog itself
  private void SwitchOffDialogOpenChanged(bool open)
  {
    _switchOffDialogOpen = open;

    if (!open)
    {
      _form.RevertFields();
    }
  }

  private async Task SaveAsync(WorkTypeName name)
  {
    _isSaving = true;

    try
    {
      if (Loaded is null)
      {
        var id = await WorkTypeRepository.AddAsync(name, _form.Fields);
        NavigationManager.NavigateTo(PageUrls.NewWorkTypeAdded(id));
        return;
      }

      await WorkTypeRepository.UpdateAsync(Loaded.WorkType.Id, name, _form.Fields);
      // the page draws the saved notice beside its up link, which is outside this island
      NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
      { [SavedAtQuery.Key] = SavedAtQuery.Value(TimeProvider.GetUtcNow()) }));
    }
    catch (NameAlreadyInUseException exception)
    {
      _form.AddNameTakenError(exception.Name);
    }
    catch (ChangedSincePageLoadException)
    {
      // deleted in another tab; the reloaded page says so
      NavigationManager.Refresh();
    }
    finally
    {
      _isSaving = false;
      _switchOffDialogOpen = false;
    }
  }

  private async Task DeleteAsync(LoadedWorkType loaded)
  {
    _isSaving = true;

    try
    {
      await WorkTypeRepository.DeleteAsync(loaded.WorkType.Id);
      NavigationManager.NavigateTo(PageUrls.NewWorkType);
    }
    catch (ChangedSincePageLoadException)
    {
      // works were added in another tab; the reloaded page shows the count
      NavigationManager.Refresh();
    }
    finally
    {
      _isSaving = false;
      _deleteDialogOpen = false;
    }
  }
}

<DisabledUntilInteractive>
  <EditForm EditContext="_form.EditContext" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />

    @if (Loaded is null)
    {
      <TextField Label="Name" @bind-Value="_form.Name" UpdatesPerKeystroke />
    }
    else
    {
      <TextFieldWithButton Label="Name" @bind-Value="_form.Name" UpdatesPerKeystroke>
        <ButtonBasic type="submit" Variant="ButtonVariant.Primary" Busy="_isSavingName"
                     disabled="@(_isSaving || !_form.NameHasChanges)">
          Save
        </ButtonBasic>
      </TextFieldWithButton>
    }
    <WorkFieldCheckboxes FieldDefinitions="FieldDefinitions" Selected="_form.Fields" OnToggle="ToggleFieldAsync"
                         Disabled="_isSaving" />

    <div class="flex items-baseline justify-between">
      @if (Loaded is not { } loaded)
      {
        <ButtonBasic type="submit" Variant="ButtonVariant.Primary" Busy="_isSavingName" disabled="@_isSaving">
          Create @Wording.Work.SingularInSentence type
        </ButtonBasic>
      }
      else
      {
        if (loaded.WorkCounts.Total > 0)
        {
          <p class="text-sm text-ink-faded">
            Used by
            <a href="@PageUrls.WorkListOfType(loaded.WorkType.Id)" class="underline">
              @Wording.Work.CountOf(loaded.WorkCounts.Total)</a>, so it can't be deleted.
          </p>
        }
        else
        {
          <ButtonBasic type="button" Variant="ButtonVariant.DangerOutline" disabled="@_isSaving"
                       @onclick="() => _deleteDialogOpen = true">
            Delete @Wording.Work.SingularInSentence type
          </ButtonBasic>
        }
      }
    </div>
  </EditForm>

  @if (Loaded is { } loadedType)
  {
    <SwitchOffWorkFieldsDialog Open="_switchOffDialogOpen" OpenChanged="SwitchOffDialogOpenChanged" SwitchedOffFields="SwitchedOffFieldsInUse"
                                  WorkCounts="loadedType.WorkCounts" OnConfirm="() => SaveAsync(loadedType.WorkType.Name)"
                                  IsWorking="_isSaving" />

    <ConfirmDialog @bind-Open="_deleteDialogOpen" Title="@($"Delete {loadedType.WorkType.Name.Value}?")"
                   ConfirmLabel="Delete" OnConfirm="() => DeleteAsync(loadedType)" IsWorking="_isSaving">
      Vocabularies that apply to it stop applying to it.
    </ConfirmDialog>
  }
</DisabledUntilInteractive>
