@rendermode InteractiveServer
@using System.Globalization
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Forms.FileUpload
@using ArtistShop.Web.Components.Pages.Admin.Catalog.ArtworkTable
@using ArtistShop.Web.Components.Pages.Admin.Catalog.ArtworkTypes
@using ArtistShop.Web.Database
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Images
@using ArtistShop.Web.Imports
@using ArtistShop.Web.Utilities
@inject ArtworkRepository ArtworkRepository
@inject ArtworkImageRepository ArtworkImageRepository
@inject ArtworkTypeRepository ArtworkTypeRepository
@inject SeriesRepository SeriesRepository
@inject IJSRuntime JS
@inject TimeProvider TimeProvider
@implements IAsyncDisposable

@code {
  [Parameter]
  public int? InitialArtworkTypeId { get; set; }

  private ElementReference _zone;
  private InteropObject<ArtworksFromImagesEditor>? _uploader;

  private List<ArtworkType> _artworkTypes = [];
  private int? _artworkTypeId;
  // the chosen type with the fields that make the table's columns. Fixed once there are rows, which are all of it
  private ArtworkTypeWithFields? _type;

  // in the artist's order; a series added from the series dialog joins the end, as it does in the database
  private List<Series> _series = [];

  // a drop waiting for the artist to choose its series
  private PendingDrop? _pendingDrop;

  private readonly List<ArtworkTableRow> _rows = [];
  // for the script's callbacks; an entry the images dialog has since dropped from its row is ignored
  private readonly Dictionary<string, RowImage> _imagesByFileId = [];

  private IEnumerable<RowImage> RowImages => _rows.SelectMany(row => row.Images);

  private IReadOnlyList<SkippedImage> _skipped = [];
  private UnusableFileCounts _unusable = UnusableFileCounts.None;
  private bool _tooManyFiles;
  private string? _dropError;

  private bool _isCreating;
  private bool _isUploading;
  private int _percentComplete;

  // the last time anything was created or saved, and the browser's offset from UTC to show it in
  private DateTimeOffset? _lastSavedAt;
  private TimeSpan? _browserUtcOffset;

  private int UnsentCount =>
    RowImages.Count(image => image.State is RowImageState.Waiting or RowImageState.Failed);

  protected override async Task OnInitializedAsync()
  {
    _artworkTypes = await ArtworkTypeRepository.GetAllAsync();
    _series = await SeriesRepository.GetAllAsync();
    _artworkTypeId = InitialArtworkTypeId;
    await LoadTypeAsync();
  }

  // null for no choice, or a type deleted since the page loaded
  private async Task LoadTypeAsync()
  {
    _type = _artworkTypeId is int typeId ? await ArtworkTypeRepository.GetAsync(new ArtworkTypeId(typeId)) : null;
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender)
    {
      return;
    }

    // the page closed before the uploader started, so nothing will be dropped on it
    try
    {
      await using var clock = await JS.InvokeAsync<IJSObjectReference>(
        "import", "./Components/Pages/Admin/Catalog/ArtworksFromImages/ArtworksFromImagesEditor.razor.js");
      _browserUtcOffset = TimeSpan.FromMinutes(await clock.InvokeAsync<int>("utcOffsetMinutes"));
    }
    catch (JSDisconnectedException)
    {
      return;
    }

    _uploader = await InteropObject<ArtworksFromImagesEditor>.CreateAsync(
      JS, "./js/bulk-artwork-uploader.js", "createBulkUploader", this, self => [_zone, self, BulkImageDrop.MaximumFiles]);
  }

  [JSInvokable]
  public async Task OnFilesCollected()
  {
    // the drop zone is disabled until a type is chosen
    if (_type is not { } type)
    {
      return;
    }

    var collected = await ReadCollectedFilesAsync();

    // the script now holds only the new drop's files, so ones from before that weren't sent never will be
    foreach (var image in RowImages.Where(image => image.State is RowImageState.Waiting or RowImageState.Failed))
    {
      image.State = RowImageState.NotSent;
    }

    _tooManyFiles = false;
    _dropError = null;
    _unusable = UnusableFileCounts.Of(collected);

    List<BulkImageCandidate> candidates =
    [
      .. collected
        .Where(file => ImageUploadValidation.IsPermittedContentType(file.Type))
        .Select(file => new BulkImageCandidate(file.Id, file.Path)),
    ];

    _skipped = [];
    _pendingDrop = null;

    // a drop with no images has only the files it couldn't use to report, and one whose images would
    // all be skipped whatever series they joined has nothing to ask about
    if (candidates.Count > 0)
    {
      var plan = await PlanAsync(type.Id, candidates, new DropSeriesChoice([], []));

      if (plan.Artworks.Count is 0)
      {
        _skipped = plan.Skipped;
      }
      else
      {
        _pendingDrop = new PendingDrop(type.Id, candidates, ArtworksFromImagesPlanner.Folders(candidates, _series));
      }
    }

    await InvokeAsync(StateHasChanged);
  }

  // what a drop holds while the series dialog is open
  private record PendingDrop(ArtworkTypeId TypeId, IReadOnlyList<BulkImageCandidate> Candidates, IReadOnlyList<DroppedFolder> Folders);

  private async Task SeriesChosenAsync(DropSeriesChoice choice)
  {
    if (_pendingDrop is { } drop)
    {
      _pendingDrop = null;
      await AddAsync(drop.TypeId, drop.Candidates, choice);
    }
  }

  // A folder named like the new series is now that existing series, rather than one to create again
  private void DropSeriesAdded(Series series)
  {
    _series.Add(series);

    if (_pendingDrop is { } drop)
    {
      _pendingDrop = drop with { Folders = ArtworksFromImagesPlanner.Folders(drop.Candidates, _series) };
    }
  }

  private async Task AddAsync(ArtworkTypeId typeId, IReadOnlyList<BulkImageCandidate> candidates, DropSeriesChoice choice)
  {
    _isCreating = true;
    await InvokeAsync(StateHasChanged);

    try
    {
      var newRows = await CreateArtworksAsync(typeId, candidates, choice);
      _rows.AddRange(newRows);

      if (newRows.Count > 0)
      {
        _lastSavedAt = TimeProvider.GetUtcNow();
      }

      await UploadAsync(newRows, typeId);
    }
    catch (ChangedSincePageLoadException)
    {
      _dropError = "A series or this artwork type changed in another tab. Reload the page and drop the images again.";
    }
    finally
    {
      _isCreating = false;
    }

    await InvokeAsync(StateHasChanged);
  }

  // all or nothing, new series too, so a failure leaves no half-made drop behind
  private async Task<List<ArtworkTableRow>> CreateArtworksAsync(ArtworkTypeId typeId,
IReadOnlyList<BulkImageCandidate> candidates, DropSeriesChoice choice)
  {
    // checked again rather than kept from the drop, since artworks may have been added while the series dialog was open
    var plan = await PlanAsync(typeId, candidates, choice);
    _skipped = plan.Skipped;

    var identifiers = await ArtworkRepository.AddManyAsync([.. plan.Artworks.Select(artwork => ToAddition(typeId,
artwork))]);

    if (plan.Artworks.Any(artwork => artwork.NewSeriesName is not null))
    {
      _series = await SeriesRepository.GetAllAsync();
    }

    var rows = plan.Artworks
      .Zip(identifiers, (artwork, added) => ArtworkTableRow.FromDrop(added.Id, artwork, SeriesIdsFor(artwork)))
      .ToList();

    foreach (var image in rows.SelectMany(row => row.Images))
    {
      _imagesByFileId[image.FileId] = image;
    }

    return rows;
  }

  // titles the type already has are skipped
  private async Task<ArtworksFromImagesPlan> PlanAsync(ArtworkTypeId typeId, IReadOnlyList<BulkImageCandidate> candidates,
    DropSeriesChoice choice)
  {
    var plan = ArtworksFromImagesPlanner.Plan(candidates, choice.SeriesFolders, choice.LooseSeriesIds);
    var matches = await ArtworkImageRepository.GetArtworkNameMatchesAsync(typeId, ArtworksFromImagesPlanner.NamesToCheck(plan));
    return ArtworksFromImagesPlanner.WithoutExisting(plan, matches);
  }

  // a new series has its id only once added, so it's found again by its web address
  private IReadOnlyList<SeriesId> SeriesIdsFor(PlannedArtworkFromImages artwork) =>
    artwork.NewSeriesName is { } name
      ? [.. artwork.SeriesIds, _series.Single(series => series.Slug == SeriesSlug.FromName(name.Value)).Id]
      : artwork.SeriesIds;

  private static ArtworkCatalogAddition ToAddition(ArtworkTypeId typeId, PlannedArtworkFromImages artwork) =>
    new(
      typeId,
      artwork.Name,
      ArtworkSlug.FromName(artwork.Name.Value),
      Description: null,
      DateCreated: null,
      Dimensions: null,
      Duration: null,
      Images: [],
      MainImageIndex: 0,
      VocabularyTermIds: [],
      SeriesIds: artwork.SeriesIds,
      NewSeriesNames: artwork.NewSeriesName is { } newSeriesName ? [newSeriesName] : [],
      Products: []
    );

  [JSInvokable]
  public async Task OnTooManyFiles()
  {
    _tooManyFiles = true;
    await InvokeAsync(StateHasChanged);
  }

  // Each artwork's images go one after another, in the row's order, so its first file becomes its main image
  private async Task UploadAsync(IEnumerable<ArtworkTableRow> rows, ArtworkTypeId typeId)
  {
    var artworks = rows
      .Select(row => row.Images
        .Where(image => image.State is RowImageState.Waiting)
        .Select(image => new UploadItem(image.FileId, row.Id.Value))
        .ToList())
      .Where(items => items.Count > 0)
      .ToList();

    if (_uploader is null || artworks.Count is 0)
    {
      return;
    }

    _isUploading = true;
    _percentComplete = 0;

    // nothing happens once the page has closed, taking the files with it
    await _uploader.InvokeIfOpenAsync("upload", artworks, typeId.Value);
  }

  // what the script sends one file as; every one here names its artwork
  private record UploadItem(string Id, int ArtworkId);

  private async Task UploadUnsentAsync()
  {
    foreach (var image in RowImages.Where(image => image.State is RowImageState.Failed))
    {
      image.State = RowImageState.Waiting;
      image.Error = null;
    }

    // there are rows, so the type is chosen and can't change
    if (_type is { } type)
    {
      await UploadAsync(_rows, type.Id);
    }
  }

  [JSInvokable]
  public async Task OnUploadProgress(int percentComplete)
  {
    _percentComplete = percentComplete;
    await InvokeAsync(StateHasChanged);
  }

  // the image the artwork holds, even when a retry found it already there
  [JSInvokable]
  public async Task OnExtraAdded(string id, ArtworkImage added)
  {
    if (_imagesByFileId.GetValueOrDefault(id) is { } image)
    {
      image.State = RowImageState.Added;
      image.Image = added;
    }

    await InvokeAsync(StateHasChanged);
  }

  [JSInvokable]
  public async Task OnFileFailed(string id, string message)
  {
    if (_imagesByFileId.GetValueOrDefault(id) is { } image)
    {
      image.State = RowImageState.Failed;
      image.Error = message;
    }

    await InvokeAsync(StateHasChanged);
  }

  // An image the run ended without sending, as when the script stopped early, would otherwise spin
  // for good and keep its row's images dialog shut. As a failure, Upload sends it again
  [JSInvokable]
  public async Task OnUploadFinished()
  {
    _isUploading = false;

    foreach (var image in RowImages.Where(image => image.State is RowImageState.Waiting))
    {
      image.State = RowImageState.Failed;
      image.Error = "Not uploaded";
    }

    await InvokeAsync(StateHasChanged);
  }

  private void SaveFinished(ArtworkTableRow row)
  {
    if (row.IsSaved)
    {
      _lastSavedAt = TimeProvider.GetUtcNow();
    }
  }

  // nothing unsaved in a row, uploading or failed to upload, so closing the tab loses nothing
  private bool IsAllSaved => !_isUploading && UnsentCount is 0 && _rows.All(row => row.IsSaved);

  private void SeriesAdded(Series series) => _series.Add(series);

  // as the artist's clock reads it, once the browser has said where that is
  private string? LastSavedText =>
    _lastSavedAt is { } savedAt && _browserUtcOffset is { } offset
      ? savedAt.ToOffset(offset).ToString("h:mm:ss tt", CultureInfo.InvariantCulture)
      : null;

  private async Task<List<CollectedFile>> ReadCollectedFilesAsync()
  {
    if (_uploader is null)
    {
      return [];
    }

    // the page closed while the files were being read, so there is no one left to show them to
    try
    {
      return await CollectedFileStreams.ReadListAsync(_uploader.Reference, BulkImageDrop.MaximumMetadataBytes);
    }
    catch (JSDisconnectedException)
    {
      return [];
    }
  }

  public async ValueTask DisposeAsync()
  {
    if (_uploader is not null)
    {
      await _uploader.DisposeAsync();
    }
  }
}

<DisabledUntilInteractive>
  @* the script refuses new files while a run is going, as they would replace the ones it hasn't sent *@
  <fieldset class="contents" disabled="@(_type is null || _isUploading || _isCreating || _pendingDrop is not null)">
    <div class="mb-4">
      @* the rows are artworks of this type, under its fields' columns *@
      <ArtworkTypeSelect ArtworkTypes="_artworkTypes" @bind-Value="_artworkTypeId" @bind-Value:after="LoadTypeAsync"
                         Disabled="@(_rows.Count > 0 || _isCreating || _pendingDrop is not null)" Class="mb-1" />
      @if (_rows.Count > 0)
      {
        <p class="text-sm text-gray-600">Reload the page to add artworks of another type.</p>
      }
    </div>

    @* the events the script listens for bubble, so one element reference covers both pickers and the drop *@
    <div @ref="_zone" class="mb-4">
      <FileDropZoneFrame Prompt="Drop a folder of images here, or drop images on their own" ButtonLabel="Choose images"
                         DirectoryButtonLabel="Choose a folder">
        <input type="file" multiple accept="@ImageUploadValidation.FileInputAccept" class="hidden" />
        <input type="file" webkitdirectory class="hidden" />
      </FileDropZoneFrame>
    </div>
  </fieldset>
</DisabledUntilInteractive>



@if (_tooManyFiles)
{
  <p class="mb-4 text-red-600">That's more than @BulkImageDrop.MaximumFiles files. Drop one folder at a time.</p>
}

@if (_dropError is not null)
{
  <p class="mb-4 text-red-600">@_dropError</p>
}

@if (_isCreating)
{
  <p class="mb-4 text-sm" role="status">Adding artworks…</p>
}

<SkippedImagesReport Skipped="_skipped" Unusable="_unusable" />

@if (_isUploading)
{
  @* no Stop: the artworks are already added, so stopping would leave them without their images *@
  <UploadProgress PercentComplete="_percentComplete" />
}
else if (UnsentCount > 0)
{
  <div class="mb-4">
    <ButtonBasic type="button" Variant="ButtonVariant.Primary" @onclick="UploadUnsentAsync">
      Upload @CountText.Of(UnsentCount, "image")
    </ButtonBasic>
  </div>
}

@if (_rows.Count > 0 && _type is { } rowsType)
{
  <p class="mb-2 text-sm text-gray-600">
    @CountText.Of(_rows.Count, "artwork") added. Each change saves when you leave its field.
  </p>

  <ArtworkTable Rows="_rows" Type="rowsType" AllSeries="_series" OnSeriesAdded="SeriesAdded" OnSaveFinished="SaveFinished" />

  <p class="text-sm text-gray-600">
    @CountText.Of(_rows.Count, "artwork") added.
    @* no time before the first edit: the artworks and images were saved as they arrived *@
    @if (IsAllSaved)
    {
      <text>All changes saved@(LastSavedText is { } savedText ? $" at {savedText}" : ""), it is safe to close the tab.</text>
    }
    <a class="underline" href="@PageUrls.AdminDashboard">Back to the dashboard</a>
  </p>
}

@if (_pendingDrop is { } pendingDrop)
{
  <DropSeriesDialog Folders="pendingDrop.Folders" LooseImageCount="@ArtworksFromImagesPlanner.LooseImageCount(pendingDrop.Candidates)"
                    AllSeries="_series" OnOk="SeriesChosenAsync" OnClose="() => _pendingDrop = null"
                    OnSeriesAdded="DropSeriesAdded" />
}
