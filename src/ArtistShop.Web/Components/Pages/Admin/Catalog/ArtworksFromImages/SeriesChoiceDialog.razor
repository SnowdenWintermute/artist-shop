@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Dialogs
@using ArtistShop.Web.Components.Forms
@using ArtistShop.Web.Components.Pages.Admin.Catalog.SeriesAdmin
@using ArtistShop.Web.Database
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@inject SeriesRepository SeriesRepository

@* rendered only while open, so each opening starts from the row's saved series *@

@code {
  // null while the row's title is cleared
  [Parameter, EditorRequired]
  public string? ArtworkName { get; set; }
  // in the artist's order
  [Parameter, EditorRequired]
  public IReadOnlyList<Series> AllSeries { get; set; } = default!;
  [Parameter, EditorRequired]
  public IReadOnlyList<int> SelectedSeriesIds { get; set; } = default!;
  [Parameter, EditorRequired]
  public EventCallback<List<int>> OnOk { get; set; }
  [Parameter, EditorRequired]
  public EventCallback OnClose { get; set; }
  // a series is saved as soon as it's added, so every row can choose it, even if this one is cancelled
  [Parameter, EditorRequired]
  public EventCallback<Series> OnSeriesAdded { get; set; }

  private readonly HashSet<int> _ticked = [];
  private SeriesNameForm _newSeries = new();
  private bool _isAddingSeries;

  protected override void OnInitialized() => _ticked.UnionWith(SelectedSeriesIds);

  private void Toggle(int seriesId)
  {
    if (!_ticked.Remove(seriesId))
    {
      _ticked.Add(seriesId);
    }
  }

  private async Task AddSeriesAsync()
  {
    _isAddingSeries = true;

    try
    {
      var name = _newSeries.ToSeriesName();
      var slug = _newSeries.ToSeriesSlug();
      var id = await SeriesRepository.AddAsync(name, slug);

      _ticked.Add(id.Value);
      _newSeries = new();
      await OnSeriesAdded.InvokeAsync(new Series(id, name, slug));
    }
    catch (NameAlreadyInUseException)
    {
      _newSeries.AddNameTakenError();
    }
    finally
    {
      _isAddingSeries = false;
    }
  }

  // in the order the series are listed, so the row reads the same as this list
  private Task OkAsync() =>
    OnOk.InvokeAsync([.. AllSeries.Select(series => series.Id.Value).Where(_ticked.Contains)]);
}

<ModalDialog Title="@(ArtworkName is null ? "Series" : $"Series of {ArtworkName}")" Width="ModalDialogWidth.Narrow" OnClose="OnClose" KeepOpen="_isAddingSeries">
  @if (AllSeries.Count is 0)
  {
    <p class="mb-4 text-sm">No series yet. Add one below.</p>
  }
  else
  {
    @* the padding keeps a focused checkbox's outline inside the scrolling box, which clips it; the
       negative margin keeps the boxes lined up with the rest of the dialog *@
    <fieldset class="-mx-1 mb-4 min-h-0 overflow-y-auto px-1">
      <legend class="sr-only">Series</legend>
      @foreach (var series in AllSeries)
      {
        <label @key="series.Id.Value" class="flex cursor-pointer items-center gap-2 py-1">
          <input type="checkbox" class="cursor-pointer" checked="@_ticked.Contains(series.Id.Value)"
                 @onchange="() => Toggle(series.Id.Value)" />
          @series.Name.Value
        </label>
      }
    </fieldset>
  }

  <EditForm EditContext="_newSeries.EditContext" OnValidSubmit="AddSeriesAsync" class="mb-4 shrink-0">
    <DataAnnotationsValidator />

    <TextField Label="New series" @bind-Value="_newSeries.Name" UpdatesPerKeystroke />
    <ButtonBasic type="submit" Variant="ButtonVariant.Outline" Busy="_isAddingSeries"
                 disabled="@(_isAddingSeries || string.IsNullOrWhiteSpace(_newSeries.Name))">
      Add series
    </ButtonBasic>
  </EditForm>

  <ModalDialogActions>
    <ModalCloseButton Label="Cancel" Disabled="_isAddingSeries" />
    <ButtonBasic type="button" Variant="ButtonVariant.Primary" disabled="@_isAddingSeries" @onclick="OkAsync">OK</ButtonBasic>
  </ModalDialogActions>
</ModalDialog>
