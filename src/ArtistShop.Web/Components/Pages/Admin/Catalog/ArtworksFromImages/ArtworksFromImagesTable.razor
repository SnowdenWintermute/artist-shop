@using ArtistShop.Web.Components.Pages.Admin.Catalog.Artworks
@using ArtistShop.Web.Components.Tables
@using ArtistShop.Web.Domain.Catalog

@* Each input saves its row when it loses focus with a changed value: @bind updates on "change" *@

@code {
  [Parameter, EditorRequired]
  public IReadOnlyList<ArtworkFromImagesRow> Rows { get; set; } = default!;
  [Parameter, EditorRequired]
  public IReadOnlyList<ArtworkField> Fields { get; set; } = default!;
  [Parameter, EditorRequired]
  public IReadOnlyList<Series> AllSeries { get; set; } = default!;
  [Parameter, EditorRequired]
  public EventCallback<ArtworkFromImagesRow> OnChanged { get; set; }
  [Parameter, EditorRequired]
  public EventCallback<ArtworkFromImagesRow> OnEditDescription { get; set; }
  [Parameter, EditorRequired]
  public EventCallback<ArtworkFromImagesRow> OnEditSeries { get; set; }

  // the images and title stay in view as the other columns scroll sideways under them
  private const string ImagesColumnClass = "sticky left-0 z-10 w-16 min-w-16 bg-white";
  private const string TitleColumnClass = "sticky left-16 z-10 bg-white";

  private const string InputClass = "artist-shop-field-input";

  // room for a focused input's outline, which the pinned title column would otherwise paint over
  private const string FieldCellClass = "pl-1 align-top";

  private IReadOnlyList<DataTableHeading> Headings
  {
    get
    {
      List<DataTableHeading> headings = [new("", ImagesColumnClass), new("Title", TitleColumnClass)];

      if (Fields.Contains(ArtworkField.DateCreated))
      {
        headings.Add("Date created");
      }

      if (Fields.Contains(ArtworkField.HeightAndWidth))
      {
        headings.AddRange(["Height (cm)", "Width (cm)"]);
      }

      if (Fields.Contains(ArtworkField.Depth))
      {
        headings.Add("Depth (cm)");
      }

      if (Fields.Contains(ArtworkField.Duration))
      {
        headings.Add("Duration");
      }

      headings.AddRange(["Description", "Series"]);
      return headings;
    }
  }

  private Task ChangedAsync(ArtworkFromImagesRow row) => OnChanged.InvokeAsync(row);

  private string SeriesText(ArtworkFromImagesRow row) =>
    string.Join(", ", AllSeries.Where(series => row.Form.SeriesIds.Contains(series.Id.Value)).Select(series => series.Name.Value));
}

@* the right padding keeps the last column's focus outline inside the scrolling box, which clips it *@
<div class="mb-4 overflow-x-auto pr-1">
  <DataTable Items="Rows" Headings="Headings" Class="text-sm" FitsContent>
    <Row Context="row">
      <DataTableCell Class="@($"align-top {ImagesColumnClass}")">
        <RowImagesCell Row="row" />
      </DataTableCell>

      <DataTableCell Class="@($"align-top {TitleColumnClass}")">
        <input class="@($"{InputClass} w-64")" aria-label="Title" @bind="row.Form.Name" @bind:after="() => ChangedAsync(row)" />
        <RowFieldError Message="@row.ErrorFor(nameof(ArtworkForm.Name))" />
        <RowFieldError Message="@row.SaveError" />
      </DataTableCell>

      @if (Fields.Contains(ArtworkField.DateCreated))
      {
        <DataTableCell Class="@FieldCellClass">
          <div class="flex gap-1">
            <input inputmode="numeric" class="@($"{InputClass} w-20")" placeholder="Year" aria-label="Year created"
                   @bind="row.YearText" @bind:after="() => ChangedAsync(row)" />
            <select class="@($"{InputClass} w-20")" aria-label="Month created" @bind="row.Form.MonthCreated"
                    @bind:after="() => ChangedAsync(row)">
              <option value="">Month</option>
              @for (var month = 1; month <= 12; month++)
              {
                <option value="@month">@(PartialDate.MonthName(month)[..3])</option>
              }
            </select>
            <select class="@($"{InputClass} w-16")" aria-label="Day created" @bind="row.Form.DayCreated"
                    @bind:after="() => ChangedAsync(row)">
              <option value="">Day</option>
              @for (var day = 1; day <= 31; day++)
              {
                <option value="@day" disabled="@(day > PartialDate.MaximumDayIn(row.Form.YearCreated, row.Form.MonthCreated))">@day</option>
              }
            </select>
          </div>
          <RowFieldError Message="@row.ErrorFor(nameof(ArtworkForm.YearCreated))" />
          <RowFieldError Message="@row.ErrorFor(nameof(ArtworkForm.MonthCreated))" />
          <RowFieldError Message="@row.ErrorFor(nameof(ArtworkForm.DayCreated))" />
        </DataTableCell>
      }

      @if (Fields.Contains(ArtworkField.HeightAndWidth))
      {
        <DataTableCell Class="@FieldCellClass">
          <input inputmode="decimal" class="@($"{InputClass} w-24")" aria-label="Height in centimetres"
                 @bind="row.HeightText" @bind:after="() => ChangedAsync(row)" />
          <RowFieldError Message="@row.ErrorFor(nameof(ArtworkForm.HeightCm))" />
        </DataTableCell>
        <DataTableCell Class="@FieldCellClass">
          <input inputmode="decimal" class="@($"{InputClass} w-24")" aria-label="Width in centimetres"
                 @bind="row.WidthText" @bind:after="() => ChangedAsync(row)" />
          <RowFieldError Message="@row.ErrorFor(nameof(ArtworkForm.WidthCm))" />
        </DataTableCell>
      }

      @if (Fields.Contains(ArtworkField.Depth))
      {
        <DataTableCell Class="@FieldCellClass">
          <input inputmode="decimal" class="@($"{InputClass} w-24")" aria-label="Depth in centimetres"
                 @bind="row.DepthText" @bind:after="() => ChangedAsync(row)" />
          <RowFieldError Message="@row.ErrorFor(nameof(ArtworkForm.DepthCm))" />
        </DataTableCell>
      }

      @if (Fields.Contains(ArtworkField.Duration))
      {
        <DataTableCell Class="@FieldCellClass">
          <input class="@($"{InputClass} w-28")" placeholder="h:mm:ss" aria-label="Duration" @bind="row.Form.Duration"
                 @bind:after="() => ChangedAsync(row)" />
          <RowFieldError Message="@row.ErrorFor(nameof(ArtworkForm.Duration))" />
        </DataTableCell>
      }

      <DataTableCell Class="@FieldCellClass">
        <button type="button" class="@($"{InputClass} w-48 cursor-pointer truncate text-left")"
                @onclick="() => OnEditDescription.InvokeAsync(row)">
          @(string.IsNullOrWhiteSpace(row.Form.Description) ? "Edit…" : row.Form.Description)
        </button>
      </DataTableCell>

      <DataTableCell Class="@FieldCellClass">
        <button type="button" class="@($"{InputClass} w-48 cursor-pointer truncate text-left")"
                @onclick="() => OnEditSeries.InvokeAsync(row)">
          @(row.Form.SeriesIds.Count is 0 ? "Choose…" : SeriesText(row))
        </button>
      </DataTableCell>
    </Row>
  </DataTable>
</div>
