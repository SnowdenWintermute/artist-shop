@page "/admin/catalog/artworks/add-from-images"
@using ArtistShop.Web.Sites
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = SitePolicies.Admin)]

@code {
  // the type to start with, as the dashboard sends it; the page has its own select too
  [SupplyParameterFromQuery(Name = "type")]
  private int? TypeIdValue { get; set; }
}

<PageTitle>Add artworks from images</PageTitle>

<main>
  <AdminPanel Wide>
    <h1 class="mb-4 text-xl">Add artworks from images</h1>

    <p class="mb-4">
      Artworks are saved in the catalog under the name of each image uploaded. Edits made on this page are automatically
      saved.
    </p>

    <p class="mb-4 flex items-center">
      <span class="text-theme-base flex items-center justify-center mr-2">
        <SvgIcon Name="floppy-disc" Class="size-5" />
      </span>
      <span>Artworks are saved after each edit</span>
    </p>

    @* the island posts each image to an endpoint that checks the antiforgery token, and there is
       no form on this page to carry one *@
    <AntiforgeryToken />

    <ArtworksFromImagesEditor InitialArtworkTypeId="TypeIdValue" />
  </AdminPanel>
</main>
