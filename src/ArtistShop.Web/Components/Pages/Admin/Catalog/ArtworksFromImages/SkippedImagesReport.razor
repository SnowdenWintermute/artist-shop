@using ArtistShop.Web.Components.Forms.FileUpload
@using ArtistShop.Web.Imports
@using ArtistShop.Web.Utilities

@* what the last drop left out, grouped by why, with the files behind a toggle *@

@code {
  [Parameter, EditorRequired]
  public IReadOnlyList<SkippedImage> Skipped { get; set; } = default!;
  [Parameter, EditorRequired]
  public UnusableFileCounts Unusable { get; set; } = default!;

  private static string Why(ArtworkFromImagesSkipReason reason) =>
    reason switch
    {
      ArtworkFromImagesSkipReason.TooDeep => "in deeply nested folders",
      ArtworkFromImagesSkipReason.SameNameInUpload => "named the same as another file you dropped",
      ArtworkFromImagesSkipReason.TitleTooLong => "with a name too long for a title",
      ArtworkFromImagesSkipReason.NoWebAddress => "with no letters or numbers in their name",
      ArtworkFromImagesSkipReason.ArtworkExists => "named like an artwork of this type you already have",
    };
}

@if (Skipped.Count > 0 || Unusable.Any)
{
  <ul class="mb-4 text-sm">
    <UnusableFileItems Counts="Unusable" />
    @foreach (var reason in Skipped.GroupBy(skipped => skipped.Reason))
    {
      <li @key="reason.Key">
        <details>
          <summary class="cursor-pointer text-yellow-700">@CountText.Of(reason.Count(), "image") skipped, @Why(reason.Key)
          </summary>
          <ul class="ml-4 text-gray-600">
            @foreach (var skipped in reason)
            {
              <li>@skipped.Path</li>
            }
          </ul>
        </details>
      </li>
    }
  </ul>
}
