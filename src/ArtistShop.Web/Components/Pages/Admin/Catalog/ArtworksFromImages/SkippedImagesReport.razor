@using ArtistShop.Web.Imports
@using ArtistShop.Web.Images
@using ArtistShop.Web.Utilities

@* what the last drop left out, grouped by why, with the files behind a toggle *@

@code {
  [Parameter, EditorRequired]
  public IReadOnlyList<SkippedImage> Skipped { get; set; } = default!;
  [Parameter, EditorRequired]
  public int HeicCount { get; set; }
  [Parameter, EditorRequired]
  public int NotImageCount { get; set; }

  private static string Why(ArtworkFromImagesSkipReason reason) =>
    reason switch
    {
      ArtworkFromImagesSkipReason.TooDeep => "in a folder inside a series folder",
      ArtworkFromImagesSkipReason.UnknownSeriesFolder => "in a folder whose name isn't a series",
      ArtworkFromImagesSkipReason.SameNameInFolder => "named the same as another file in their folder",
      ArtworkFromImagesSkipReason.TitleTooLong => "with a name too long for a title",
      ArtworkFromImagesSkipReason.NoWebAddress => "with no letters or numbers in their name",
      ArtworkFromImagesSkipReason.ArtworkExists => "named like an artwork of this type you already have",
    };
}

@if (Skipped.Count > 0 || HeicCount > 0 || NotImageCount > 0)
{
  <ul class="mb-4 text-sm">
    @if (HeicCount > 0)
    {
      <li>@CountText.Of(HeicCount, "file") skipped. @ImageProcessor.UnsupportedHeicMessage</li>
    }
    @if (NotImageCount > 0)
    {
      <li>@CountText.Of(NotImageCount, "file") skipped: not an image format we accept</li>
    }
    @foreach (var reason in Skipped.GroupBy(skipped => skipped.Reason))
    {
      <li @key="reason.Key">
        <details>
          <summary class="cursor-pointer">@CountText.Of(reason.Count(), "image") skipped, @Why(reason.Key)</summary>
          <ul class="ml-4 text-gray-600">
            @foreach (var skipped in reason)
            {
              <li>@skipped.Path</li>
            }
          </ul>
        </details>
      </li>
    }
  </ul>
}
