@using System.Globalization
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Catalog
@using ArtistShop.Web.Components.Forms
@using ArtistShop.Web.Components.Lists
@using ArtistShop.Web.Components.Pages.Admin.Catalog.WorkTypes
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Search
@using ArtistShop.Web.Sites
@using Microsoft.AspNetCore.WebUtilities
@inject WorkRepository WorkRepository
@inject WorkSearch WorkSearch
@inject WorkTypeRepository WorkTypeRepository
@inject VocabularyRepository VocabularyRepository
@inject CollectionRepository CollectionRepository
@inject NavigationManager NavigationManager
@inject RememberedWorkType RememberedWorkType

@* The filterable work list, read from the address it's on, so it works the same on any page
   that places it: the admin work list, and the picker a post's editor opens in a frame *@

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  // where a work's row leads: its edit page in the admin, the next step in the post editor's
  // picker. Null leaves the row as text
  [Parameter, EditorRequired]
  public Func<WorkListItem, string?> RowHref { get; set; } = default!;

  // the list with no filters, wherever this one is
  [Parameter, EditorRequired]
  public string ClearFiltersHref { get; set; } = default!;

  // Query parameters of the page's own that the filter form keeps when it submits, which a GET
  // form otherwise drops, as it sends only its own fields. Paging keeps them by itself
  [Parameter]
  public IReadOnlyList<(string Name, string Value)>? KeptFields { get; set; }

  // leaves out the works already in this collection, for a page adding to it
  [Parameter]
  public CollectionId? ExcludedCollectionId { get; set; }

  // gives each row a checkbox; a check submits at once and lands in the address
  [Parameter]
  public WorkListSelection? Selection { get; set; }

  // One type at a time, picked by a select, for the work table: of the types in the address that
  // still exist, the first by name; with none, the type its admin last chose, else the first of all
  // by name. Vocabularies and term filters are that type's only
  [Parameter]
  public bool SingleType { get; set; }

  // drawn in place of the list's rows, such as the work table
  [Parameter]
  public RenderFragment<LoadedWorkList>? Rows { get; set; }

  [SupplyParameterFromQuery(Name = WorkListQuery.TypeKey)]
  private int[]? TypeIds { get; set; }
  [SupplyParameterFromQuery(Name = WorkListQuery.TermKey)]
  private int[]? TermIds { get; set; }
  // read as text and parsed in one place, so an empty or hand-edited value is a missing
  // filter rather than a failure
  [SupplyParameterFromQuery(Name = WorkListQuery.CollectionKey)]
  private string? CollectionValue { get; set; }
  [SupplyParameterFromQuery(Name = WorkListQuery.SearchKey)]
  private string? SearchValue { get; set; }
  [SupplyParameterFromQuery(Name = WorkListQuery.ImagesKey)]
  private string? ImagesValue { get; set; }
  [SupplyParameterFromQuery(Name = WorkListQuery.SaleKey)]
  private string? SaleValue { get; set; }
  [SupplyParameterFromQuery(Name = WorkListQuery.SortKey)]
  private string? SortValue { get; set; }
  [SupplyParameterFromQuery(Name = PageLinks.PageKey)]
  private string? PageValue { get; set; }

  private LoadedWorkList? _loaded;

  // a single-type list on a site with no types, so there is nothing to show
  private bool _hasNoTypes;

  // not OnInitializedAsync: a filter change is the same page with new query parameters
  protected override async Task OnParametersSetAsync()
  {
    var types = WorkTypeOrder.SortedByName(await WorkTypeRepository.GetAllAsync());

    var filter = WorkListQuery.Read(
      typeIds: TypeIds,
      termIds: TermIds,
      collection: CollectionValue,
      search: SearchValue,
      images: ImagesValue,
      sale: SaleValue,
      sort: SortValue,
      page: PageValue
    );

    List<VocabularyWithTerms> vocabularies;

    if (!SingleType)
    {
      vocabularies = await VocabularyRepository.GetAllWithTermsAsync();
    }
    else
    {
      var type = types.FirstOrDefault(candidate => filter.WorkTypeIds.Contains(candidate.Id))
                 ?? await RememberedWorkType.FindInAsync(types)
                 ?? types.FirstOrDefault();

      _hasNoTypes = type is null;

      if (type is null)
      {
        return;
      }

      vocabularies = await VocabularyRepository.GetAllWithTermsForWorkTypeAsync(type.Id);
      var termIds = vocabularies.SelectMany(vocabulary => vocabulary.Terms).Select(term => term.Id).ToHashSet();

      filter = filter with
      {
        WorkTypeIds = [type.Id],
        VocabularyTermIds = [.. filter.VocabularyTermIds.Where(termIds.Contains)],
      };
    }

    // null means nothing was searched for, which is not the same as a search that found nothing
    var searchMatches =
      filter.SearchText is null ? null : await WorkSearch.FindAsync(filter.SearchText);

    var works = await WorkRepository.GetListAsync(filter, searchMatches, ExcludedCollectionId);

    // a link to a page that has since emptied, because the filter narrowed or works were deleted
    if (works.Items.Count == 0 && filter.PageNumber > 1)
    {
      NavigationManager.NavigateTo(
        NavigationManager.GetUriWithQueryParameter(PageLinks.PageKey, (int?)null)
      );
      return;
    }

    _loaded = new LoadedWorkList(
      filter,
      works,
      types,
      VocabularyOrder.SortedByName(vocabularies),
      // filtering by the excluded collection could only ever show nothing
      [.. (await CollectionRepository.GetAllAsync()).Where(collection => collection.Id != ExcludedCollectionId)]
    );
  }

  // the cleared list keeps its one type
  private string ClearHref(WorkListFilter filter) =>
    SingleType && filter.WorkTypeIds is [var typeId]
      ? QueryHelpers.AddQueryString(ClearFiltersHref, WorkListQuery.TypeKey, typeId.Value.ToString(CultureInfo.InvariantCulture))
      : ClearFiltersHref;

  private static (string Name, string Value) SelectionField(WorkListSelection selection, WorkId id) =>
    (selection.FieldName, id.Value.ToString(CultureInfo.InvariantCulture));

  // the filter form carries the checks too, or changing a filter would drop them
  private IReadOnlyList<(string Name, string Value)>? FilterKeptFields =>
    Selection is { } selection
      ? [.. KeptFields ?? [], .. selection.Ids.Select(id => SelectionField(selection, id))]
      : KeptFields;

  // What the checkbox form sends besides this page's boxes: the rest of the address as it is, so the
  // filters and the page stay put, and the checks on other pages, which have no box here
  private IEnumerable<(string Name, string Value)> CheckboxFormFields(WorkListSelection selection, WorkListPage works)
  {
    var shownIds = works.Items.Select(item => item.Id).ToHashSet();

    var addressFields = QueryHelpers.ParseQuery(new Uri(NavigationManager.Uri).Query)
      .Where(parameter => parameter.Key != selection.FieldName)
      .SelectMany(parameter => parameter.Value.Select(value => (parameter.Key, value ?? "")));

    var otherPageCheckedFields = selection.Ids
      .Where(id => !shownIds.Contains(id))
      .Select(id => SelectionField(selection, id));

    return addressFields.Concat(otherPageCheckedFields);
  }
}

@if (_hasNoTypes)
{
  <NoWorkTypesNote />
}
else if (_loaded is { } loaded)
{
  <WorkListFilters Filter="loaded.Filter" Types="loaded.Types" Vocabularies="loaded.Vocabularies"
                      Collections="loaded.Collections" ClearFiltersHref="@ClearHref(loaded.Filter)" KeptFields="FilterKeptFields"
                      SingleType="SingleType" />

  <div class="flex justify-between items-center  mb-2">
    <span class="text-sm">@Wording.Work.CountOf(loaded.Works.TotalCount)</span>

    <PageLinks PageNumber="loaded.Works.PageNumber" PageCount="loaded.Works.PageCount" />
  </div>

  @if (Rows is not null)
  {
    @* the indicator is positioned against this wrapper *@
    <div class="relative">
      @Rows(loaded)
      <LoadingIndicator />
    </div>
  }
  else if (Selection is { } selection)
  {
    @* a GET form like the filter bar's, so a check changes the address and nothing else. A form
       submit, unlike a link, leaves the page where it was scrolled *@
    <form method="get" data-enhance>
      @foreach (var (name, value) in CheckboxFormFields(selection, loaded.Works))
      {
        <input type="hidden" name="@name" value="@value" />
      }

      <SubmitOnChange>
        <WorkListRows Items="loaded.Works.Items" RowHref="RowHref" Selection="selection" />

        <ButtonBasic type="submit" Variant="ButtonVariant.Outline" data-part="apply">Update checks</ButtonBasic>
      </SubmitOnChange>
    </form>
  }
  else
  {
    <WorkListRows Items="loaded.Works.Items" RowHref="RowHref" />
  }

  <div class="flex justify-end">
    <PageLinks PageNumber="loaded.Works.PageNumber" PageCount="loaded.Works.PageCount" />
  </div>
}
