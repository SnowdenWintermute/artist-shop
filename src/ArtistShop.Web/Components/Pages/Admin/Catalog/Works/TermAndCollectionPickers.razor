@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Catalog
@using ArtistShop.Web.Components.Forms
@using ArtistShop.Web.Components.Interop
@using ArtistShop.Web.Components.Pages.Admin.Catalog.WorkTable
@using ArtistShop.Web.Components.Pages.Admin.Catalog.Collections
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Utilities
@rendermode InteractiveServer
@inject VocabularyRepository VocabularyRepository
@inject CollectionRepository CollectionRepository

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  // Lists, not IReadOnlyList: an island parameter is rebuilt from its runtime type, and a declared List
  // can't be a compiler-generated collection type that JSON can't create
  [Parameter, EditorRequired]
  public WorkTypeId WorkTypeId { get; set; } = default!;
  [Parameter, EditorRequired]
  public List<VocabularyWithTerms> Vocabularies { get; set; } = default!;
  [Parameter, EditorRequired]
  public List<Collection> AllCollections { get; set; } = default!;
  [Parameter, EditorRequired]
  public List<int> SelectedVocabularyTermIds { get; set; } = default!;
  [Parameter, EditorRequired]
  public List<int> SelectedCollectionIds { get; set; } = default!;

  private List<VocabularyWithTerms> _vocabularies = [];
  private List<Collection> _collections = [];
  private readonly HashSet<int> _selectedTermIds = [];
  private readonly HashSet<int> _selectedCollectionIds = [];

  private bool _seeded;
  private bool _addCollectionDialogOpen;
  private bool _vocabularyDialogOpen;

  // The options come from the page every render, and the page reads them fresh on each request, so a
  // failed submit brings current ones: anything deleted meanwhile disappears here. What's checked stays
  // the island's own, seeded once, so reloading options doesn't undo the artist's choices.
  protected override void OnParametersSet()
  {
    _vocabularies = VocabularyOrder.SortedByName(Vocabularies);
    _collections = AllCollections;

    if (!_seeded)
    {
      _selectedTermIds.UnionWith(SelectedVocabularyTermIds);
      _selectedCollectionIds.UnionWith(SelectedCollectionIds);
      _seeded = true;
    }

    DropMissingSelections();
  }

  private void DropMissingSelections()
  {
    _selectedTermIds.IntersectWith(_vocabularies.SelectMany(vocabulary => vocabulary.Terms).Select(term => term.Id.Value));
    TermChoices.DropSeveralInMutuallyExclusive(_selectedTermIds, _vocabularies);
    _selectedCollectionIds.IntersectWith(_collections.Select(collection => collection.Id.Value));
  }

  private async Task ReloadVocabulariesAsync() =>
    _vocabularies = VocabularyOrder.SortedByName(await
VocabularyRepository.GetAllWithTermsForWorkTypeAsync(WorkTypeId));

  private async Task ReloadOptionsAsync()
  {
    await ReloadVocabulariesAsync();
    _collections = await CollectionRepository.GetAllAsync();

    // a checked term or collection deleted in the other tab can't be posted
    DropMissingSelections();
  }

  // made for this work, so it starts checked
  private async Task CollectionAddedAsync(CollectionId id)
  {
    _collections = await CollectionRepository.GetAllAsync();
    _selectedCollectionIds.Add(id.Value);
  }

  private void VocabularyOk(List<int> termIds)
  {
    _selectedTermIds.Clear();
    _selectedTermIds.UnionWith(termIds);
    _vocabularyDialogOpen = false;
  }

  private static List<(int Value, string Label)> TermOptions(VocabularyWithTerms vocabulary) =>
    [.. vocabulary.Terms.Select(term => (term.Id.Value, term.Name.Value))];

  private List<(int Value, string Label)> CollectionOptions => [.. _collections.Select(collection => (collection.Id.Value,
collection.Name.Value))];
}

<DisabledUntilInteractive>
  <TabReturnWatcher OnTabReturn="ReloadOptionsAsync" />

  <CheckboxGroupField Legend="@Wording.Collection.PluralHeading" Name="Input.CollectionIds" Options="CollectionOptions" SelectedValues="_selectedCollectionIds"
                      OnToggle="value => _selectedCollectionIds.Toggle(value)">
    <EmptyContent>No @Wording.Collection.PluralInSentence yet.</EmptyContent>
  </CheckboxGroupField>
  <ButtonBasic type="button" Variant="ButtonVariant.Outline" Class="mb-4" @onclick="() => _addCollectionDialogOpen = true">
    New @Wording.Collection.SingularInSentence
  </ButtonBasic>
  <AddCollectionDialog @bind-Open="_addCollectionDialogOpen" OnAdded="CollectionAddedAsync" />

  @if (_vocabularies.Count == 0)
  {
    <p class="mb-4 text-sm text-ink-faded">No vocabularies for this type yet.</p>
  }

  @foreach (var vocabulary in _vocabularies)
  {
    @if (vocabulary.IsMutuallyExclusive && vocabulary.Terms.Count > 0)
    {
      <div @key="vocabulary.Id" class="mb-4">
        <TermSelect Vocabulary="vocabulary" ChosenTermId="TermChoices.ChosenTermId(_selectedTermIds, vocabulary)"
                    OnChoose="choice => TermChoices.Choose(_selectedTermIds, choice)" LabelClass="mb-1 block"
                    Name="Input.VocabularyTermIds" />
      </div>
    }
    else
    {
      <CheckboxGroupField @key="vocabulary.Id" Legend="@vocabulary.Name.Value" Name="Input.VocabularyTermIds"
                          Options="TermOptions(vocabulary)" SelectedValues="_selectedTermIds"
                          OnToggle="value => _selectedTermIds.Toggle(value)">
        <EmptyContent>No terms yet.</EmptyContent>
      </CheckboxGroupField>
    }
  }

  <ButtonBasic type="button" Variant="ButtonVariant.Outline" Class="mb-4" @onclick="() => _vocabularyDialogOpen = true">
    Add vocabularies or terms
  </ButtonBasic>
  @if (_vocabularyDialogOpen)
  {
    <VocabularyChoiceDialog WorkName="@null" WorkTypeId="WorkTypeId" Vocabularies="_vocabularies"
                            SelectedTermIds="[.. _selectedTermIds]" OnOk="VocabularyOk" OnClose="() => _vocabularyDialogOpen = false"
                            OnVocabulariesChanged="ReloadVocabulariesAsync" />
  }
</DisabledUntilInteractive>
