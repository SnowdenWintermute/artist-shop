@page "/admin/catalog/works/{Id:int}/edit"
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Forms
@using ArtistShop.Web.Components.Forms.FileUpload.Images
@using ArtistShop.Web.Components.Pages.Catalog
@using ArtistShop.Web.Database
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Images
@using ArtistShop.Web.Sites
@using ArtistShop.Web.Utilities
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = SitePolicies.Admin)]
@inject WorkRepository WorkRepository
@inject WorkTypeRepository WorkTypeRepository
@inject VocabularyRepository VocabularyRepository
@inject CollectionRepository CollectionRepository
@inject NavigationManager NavigationManager
@inject ImageStorage ImageStorage

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  // by id, not slug: a rename changes the slug, and this page is what renames it
  [Parameter]
  public int Id { get; set; }

  [SupplyParameterFromForm]
  private WorkForm Input { get; set; } = default!;
  [SupplyParameterFromQuery(Name = "saved")]
  private bool Saved { get; set; }
  // A post keeps the address, ?saved=true from the last save included, and a successful save
  // redirects, so a page rendered from a post is always a save that didn't go through
  private bool _formWasPosted;

  private Work? _work;
  private IReadOnlyList<WorkField> _fields = [];
  private List<VocabularyWithTerms> _vocabularies = [];
  // in the artist's order
  private List<Collection> _collections = [];

  private bool _staleChoices;
  private bool _deletedElsewhere;

  // Keyed by the work, so enhanced navigation to another work's edit page can't patch one
  // island's state onto the next. The prefixes matter: sibling keys must differ even between
  // different components, and the id alone is what all three would use.
  private string PickersKey => $"pickers-{Id}";
  private string ImagesKey => $"images-{Id}";
  private string DeleteKey => $"delete-{Id}";

  protected override async Task OnInitializedAsync()
  {
    _formWasPosted = Input is not null;

    _work = await WorkRepository.GetByIdAsync(new WorkId(Id));

    if (_work is null)
    {
      NavigationManager.NotFound();
      return;
    }

    // on a post the binder has already filled this in, so only a fresh page seeds it from the work
    Input ??= WorkForm.FromWork(_work);

    // a work type can't be deleted while any work still has it, so this one is here
    var typeWithFields = Unwrap.Value(await WorkTypeRepository.GetAsync(_work.Type.Id));
    _fields = typeWithFields.Fields;
    Input.ClearFieldsOutside(_fields);
    _vocabularies = await VocabularyRepository.GetAllWithTermsForWorkTypeAsync(_work.Type.Id);
    _collections = await CollectionRepository.GetAllAsync();
  }

  private async Task SaveWork(EditContext editContext)
  {
    if (_work is null)
    {
      return;
    }

    // a work may have no images at all — the CSV import makes them that way — so the only image
    // rule here is that what's posted still exists on disk
    var missingImages = Input.ImagesMissingFrom(ImageStorage);

    if (missingImages.Count > 0)
    {
      // <ValidationMessage /> will show these
      var validationMessages = new ValidationMessageStore(editContext);

      foreach (var image in missingImages)
      {
        validationMessages.Add(() => Input.Images, WorkForm.MissingImageMessage(image));
      }

      // tells the ValidationMessage components to re-render with the new messages
      editContext.NotifyValidationStateChanged();
      return;
    }

    try
    {
      await WorkRepository.UpdateAsync(Input.ToCatalogUpdate(_work.Id));
    }
    catch (WorkDeletedException)
    {
      _deletedElsewhere = true;
      return;
    }
    catch (ChangedSincePageLoadException)
    {
      // nothing was saved, so the form still holds the artist's edits; the pickers below have
      // already dropped whatever no longer exists
      _staleChoices = true;
      return;
    }

    // reloading is what shows the saved values, including a slug the procedure may have numbered
    NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
    { ["saved"] = true }));
  }
}

@if (_work is not null)
{
  <PageTitle>Editing @_work.Name.Value</PageTitle>

  <main>
    <AdminPanel>
      <BackLink Href="@PageUrls.WorkList" Label="@Wording.Work.PluralHeading" />

      <div class="mb-4 flex items-baseline justify-between">
        <h1>Editing
          <a href="@WorkPageQuery.Url(_work.Slug.Value, collectionSlug: null, imageNumber: null)" class="underline">
            @_work.Name.Value
          </a>
        </h1>
        <span class="text-sm text-ink-faded">@_work.Type.Name.Value</span>
      </div>

      <div>

        @if (Saved && !_formWasPosted)
        {
          <SavedNotice>
            Updated.
          </SavedNotice>
        }
      </div>

      @if (_deletedElsewhere)
      {
        <p class="mb-4 text-error">
          This @Wording.Work.SingularInSentence was deleted somewhere else, so nothing was saved. Your edits
          are still on this page, but they can't be saved to something that no longer exists.
        </p>
      }

      <EnableSaveOnChange HoldsUnsavedChanges="_formWasPosted">
        <EditForm Model="Input" FormName="edit-work" OnValidSubmit="SaveWork" Enhance data-waits-for-pending
                  class="mb-8">
          <DataAnnotationsValidator />

          <TextField Label="Title" @bind-Value="Input.Name" />
          @if (_fields.Contains(WorkField.DateCreated))
          {
            <PartialDateField Label="Date created" @bind-Year="Input.YearCreated" @bind-Month="Input.MonthCreated"
                              @bind-Day="Input.DayCreated" />
          }
          <TextAreaField Label="Description" @bind-Value="Input.Description" />
          @if (_fields.Contains(WorkField.HeightAndWidth))
          {
            <NumberField Label="Height (cm)" @bind-Value="Input.HeightCm" />
            <NumberField Label="Width (cm)" @bind-Value="Input.WidthCm" />
          }
          @if (_fields.Contains(WorkField.Depth))
          {
            <NumberField Label="Depth (cm)" @bind-Value="Input.DepthCm" />
          }
          @if (_fields.Contains(WorkField.Duration))
          {
            <TextField Label="@($"Duration ({WorkDuration.ExpectedFormat})")" @bind-Value="Input.Duration" />
          }

          <TermAndCollectionPickers @key="PickersKey" WorkTypeId="_work.Type.Id" Vocabularies="_vocabularies"
                                AllCollections="_collections" SelectedVocabularyTermIds="Input.VocabularyTermIds" SelectedCollectionIds="Input.CollectionIds" />

          <ValidationMessage For="() => Input.Images" class="mb-4 block text-error" />
          @* the island starts from the images the form holds: the work's own on a fresh page, and
             whatever was posted when a submit comes back with an error *@
          <ImagesField @key="ImagesKey" FieldName="Input.Images" PrimaryFieldName="Input.PrimaryImageKey"
                       SelectedImages="Input.ToWorkImages()" SelectedPrimaryImageKey="@Input.PrimaryImageKey" />

          @if (_staleChoices)
          {
            <p class="mb-4 text-error">
              Something on this form was removed in another tab: one of its terms, fields or
              @Wording.Collection.PluralInSentence. The form has been updated to match. Check it and save again.
            </p>
          }

          <ButtonBasic type="submit" Variant="ButtonVariant.Primary" Class="text-lg" data-waits-for-change>
            Save changes
          </ButtonBasic>
        </EditForm>
      </EnableSaveOnChange>

      <div class="border-t pt-4">
        <DeleteWorkButton @rendermode="InteractiveServer" @key="DeleteKey" WorkId="_work.Id"
                             WorkName="_work.Name" ImageCount="_work.Images.Count" />
      </div>
    </AdminPanel>
  </main>
}
