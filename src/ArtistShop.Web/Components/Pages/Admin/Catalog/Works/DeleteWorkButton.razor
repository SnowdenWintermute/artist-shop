@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Dialogs
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@inject WorkRepository WorkRepository
@inject NavigationManager NavigationManager

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  [Parameter, EditorRequired]
  public WorkId WorkId { get; set; } = default!;
  [Parameter, EditorRequired]
  public WorkName WorkName { get; set; } = default!;
  [Parameter, EditorRequired]
  public int ImageCount { get; set; }

  private bool _dialogOpen;
  private bool _isDeleting;

  private async Task DeleteAsync()
  {
    _isDeleting = true;

    try
    {
      await WorkRepository.DeleteAsync(WorkId);
      NavigationManager.NavigateTo(PageUrls.WorkList);
    }
    finally
    {
      _isDeleting = false;
    }
  }
}

<DisabledUntilInteractive>
  <ButtonBasic type="button" Variant="ButtonVariant.DangerOutline" @onclick="() => _dialogOpen = true">
    Delete @Wording.Work.SingularInSentence
  </ButtonBasic>

  <ConfirmDialog @bind-Open="_dialogOpen" Title="@($"Delete {WorkName.Value}?")" ConfirmLabel="Delete"
                 OnConfirm="DeleteAsync" IsWorking="_isDeleting">
    <DeleteWorksWarning WorkCount="1" ImageCount="ImageCount" />
  </ConfirmDialog>
</DisabledUntilInteractive>
