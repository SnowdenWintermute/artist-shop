@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Domain.Publishing
@using ArtistShop.Web.Images
@inject ImageSizeQueue ImageSizeQueue

@code {
  [Parameter, EditorRequired]
  public WorkId WorkId { get; set; } = default!;
  [Parameter, EditorRequired]
  public WorkImage Image { get; set; } = default!;
  // changing an existing embed's image keeps its size and layout, so there's nothing more to ask
  [Parameter, EditorRequired]
  public WorkPickerMode Mode { get; set; }
}

@* The last step of the picker. <work-embed-choice>, defined in WorkEmbedChoice.razor.js, sends
   the choice to the page around the frame, which adds an embed, changes an embed's image, sets an image component's or a
   component's link; nothing
   here is posted *@
<work-embed-choice class="block" data-work-id="@WorkId.Value" data-storage-key="@Image.StorageKey">
  <img src="@ImageUrls.Variant(Image.StorageKey, ImageSizeQueue.ReadyWidths(Image.StorageKey, Image.Width), ImageVariants.EmbedWidth(EmbedImageSize.Medium), ImageVariantFormat.Avif)" alt=""
       class="mb-4 max-h-64 max-w-full" />

  @if (Mode is WorkPickerMode.Add)
  {
    <fieldset class="mb-4">
      <legend class="artist-shop-field-label">Size</legend>
      <label class="mr-4"><input type="radio" name="size" value="small" /> Small</label>
      <label><input type="radio" name="size" value="medium" checked /> Medium</label>
    </fieldset>

    <fieldset class="mb-4">
      <legend class="artist-shop-field-label">Position</legend>
      <label class="mr-4">
        <input type="radio" name="layout" value="@EmbedLayoutNames.Of(EmbedLayout.Center)" checked /> Centre
      </label>
      <label class="mr-4">
        <input type="radio" name="layout" value="@EmbedLayoutNames.Of(EmbedLayout.FloatLeft)" /> Wrap left
      </label>
      <label>
        <input type="radio" name="layout" value="@EmbedLayoutNames.Of(EmbedLayout.FloatRight)" /> Wrap right
      </label>
    </fieldset>
  }

  <ButtonBasic type="button" Variant="ButtonVariant.Primary" data-part="insert">
    @(Mode switch
    {
      WorkPickerMode.Add => "Add this image",
      WorkPickerMode.WorkOnly => "Link to it",
      _ => "Use this image",
    })
  </ButtonBasic>
</work-embed-choice>
