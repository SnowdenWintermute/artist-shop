@using ArtistShop.Web.Components.Dialogs

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  // stands in for the work's id in the change-image address, which the script fills in
  private const string WorkIdPlaceholder = "{workId}";

  private static readonly WorkPickerTrail AddTrail = new(WorkPickerMode.Add, ListQuery: null);
  private static readonly WorkPickerTrail ImageOnlyTrail = new(WorkPickerMode.ImageOnly, ListQuery: null);
  private static readonly WorkPickerTrail WorkOnlyTrail = new(WorkPickerMode.WorkOnly, ListQuery: null);
}

@* The dialog the toolbar's Work button, an embed's Change image, an image component's Choose and a link's
   Choose open.
   WorkPickerDialog.razor.js opens it and hears back from the frame. The frame is only given a page on opening, so editing that
   never adds a work never loads the list *@
<ModalDialog Title="@($"Choose {Wording.Work.SingularInSentence}")" Width="ModalDialogWidth.Wide" StartsClosed data-part="work-picker">
  <iframe title="@($"{Wording.Work.SingularHeading} picker")" class="mb-4 h-[65vh] w-full shrink-0 border border-rule"
          data-add-src="@PageUrls.WorkPickerList(AddTrail)"
          data-change-image-src="@PageUrls.WorkPickerImages(WorkIdPlaceholder, ImageOnlyTrail)"
          data-choose-image-src="@PageUrls.WorkPickerList(ImageOnlyTrail)"
          data-choose-work-src="@PageUrls.WorkPickerList(WorkOnlyTrail)"
          data-work-id-placeholder="@WorkIdPlaceholder"></iframe>

  <ModalDialogActions>
    <ModalCloseButton Label="Cancel" />
  </ModalDialogActions>
</ModalDialog>
