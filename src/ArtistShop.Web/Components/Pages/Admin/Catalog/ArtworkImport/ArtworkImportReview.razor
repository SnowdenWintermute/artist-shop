@using ArtistShop.Web.Components.Tables
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Imports
@using ArtistShop.Web.Utilities

@code {
  [Parameter, EditorRequired]
  public ArtworkImportPlan Plan { get; set; } = default!;
  [Parameter, EditorRequired]
  public ArtworkTypeName ArtworkTypeName { get; set; } = default!;

  // the type in brackets rather than a sentence, so an artist-defined name needs no article
  // and no plural
  private string Describe(ArtworkImportSkipReason reason) =>
    reason switch
    {
      ArtworkImportSkipReason.AlreadyInCatalog => $"Already in the catalog ({ArtworkTypeName.Value})",
      ArtworkImportSkipReason.TitleRepeatedInFile => "The title is on more than one row",
    };
}

@* shrink-0 keeps the summary whole; the tables below take what height is left and scroll *@
<p class="mb-4 shrink-0">
  @CountText.Of(Plan.Additions.Count, "artwork") to add, @Plan.NewSeries.Count new series,
  @CountText.Of(Plan.SkippedRows.Count, "row") skipped, @CountText.Of(Plan.Errors.Count, "problem").
</p>

@* min-h-0: a flex item won't shrink below its content's height without it, so it would never scroll *@
<div class="mb-4 min-h-0 overflow-y-auto">
  @if (Plan.Errors.Count > 0)
  {
    <div class="mb-6">
      <h3 class="mb-1 text-red-600">Problems</h3>
      <p class="mb-2 text-sm">Nothing is imported until these are fixed in the spreadsheet. Row 1 is the header row.</p>
      <DataTable Items="@(Plan.Errors.OrderBy(error => error.RowNumber).ToList())"
                 Headings="@(new[] { "Row", "Column", "Problem" })" Class="text-sm" RowClass="align-top" StickyHeadings>
        <Row Context="error">
          <DataTableCell>@error.RowNumber</DataTableCell>
          <DataTableCell Class="font-mono">@error.Column</DataTableCell>
          <DataTableCell>@error.Message</DataTableCell>
        </Row>
      </DataTable>
    </div>
  }

  @if (Plan.NewSeries.Count > 0)
  {
    <div class="mb-6">
      <h3 class="mb-1">New series</h3>
      <p class="mb-2 text-sm">
        These aren't series yet, so importing creates them. A name only one row uses, next to a
        similar one that many rows use, is usually a typo in the spreadsheet.
      </p>

      @if (Plan.SeriesNameWarnings.Count > 0)
      {
        <ul class="mb-2 text-sm text-amber-600">
          @foreach (var warning in Plan.SeriesNameWarnings)
          {
            <li>"@warning.Name" is nearly "@warning.MatchedName". Check the spelling of both.</li>
          }
        </ul>
      }

      <DataTable Items="Plan.NewSeries" Headings="@(new[] { "Name", "Rows" })" Class="text-sm" StickyHeadings>
        <Row Context="series">
          <DataTableCell>@series.Name</DataTableCell>
          <DataTableCell>@series.RowCount</DataTableCell>
        </Row>
      </DataTable>
    </div>
  }

  @if (Plan.SkippedRows.Count > 0)
  {
    <div class="mb-6">
      <h3 class="mb-1">Skipped</h3>
      <p class="mb-2 text-sm">
        These rows aren't imported and aren't checked. Add same-titled artworks one at a time instead.
      </p>
      <DataTable Items="Plan.SkippedRows" Headings="@(new[] { "Row", "Title", "Why" })" Class="text-sm" RowClass="align-top"
                 StickyHeadings>
        <Row Context="skipped">
          <DataTableCell>@skipped.RowNumber</DataTableCell>
          <DataTableCell>@skipped.Title</DataTableCell>
          <DataTableCell>@Describe(skipped.Reason)</DataTableCell>
        </Row>
      </DataTable>
    </div>
  }

  @if (Plan.Additions.Count > 0)
  {
    <div class="mb-6">
      <h3 class="mb-1">To add</h3>
      <DataTable Items="Plan.Additions" Headings="@(new[] { "Row", "Title" })" Class="text-sm" StickyHeadings>
        <Row Context="addition">
          <DataTableCell>@addition.RowNumber</DataTableCell>
          <DataTableCell>@addition.Addition.Name.Value</DataTableCell>
        </Row>
      </DataTable>
    </div>
  }
</div>
