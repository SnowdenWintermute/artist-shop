@using ArtistShop.Web.Components.Hints
@using ArtistShop.Web.Domain.Platform
@using ArtistShop.Web.Components.Pages.Admin.Catalog.CatalogImport
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Imports

@code {
  [Parameter, EditorRequired]
  public ArtworkTypeWithFields ArtworkType { get; set; } = default!;
  [Parameter, EditorRequired]
  public IReadOnlyList<VocabularyWithTerms> TypeVocabularies { get; set; } = default!;

  private bool Has(ArtworkField field) => ArtworkType.Fields.Contains(field);
}

<ImportColumnsHelp Hint="HintType.ArtworkImport" Collapsed>
  <Intro>
    Upload your existing spreadsheet of artworks and their associated data. If you don't have such a
    spreadsheet, <a class="underline" href="@PageUrls.AddArtworksFromImages">add artworks from images directly</a>
  </Intro>
  <Note>The first row names the columns, in any order and with any capitals. Only a title column is needed.</Note>
  <Columns>
    <ImportColumn Header="@ArtworkImportHeaders.Title">
      Every row needs one. A title already in the catalog, or on two rows of the file, is skipped,
      unless those rows each have their own slug.
    </ImportColumn>

    <ImportColumn Header="@ArtworkImportHeaders.Slug">
      The artwork's web address name, like "dawn-2": lower case letters, numbers and dashes. It tells
      apart artworks that share a title. Without one, the address comes from the title.
    </ImportColumn>

    <ImportColumn Header="@ArtworkImportHeaders.Description">Any text.</ImportColumn>

    @if (Has(ArtworkField.DateCreated))
    {
      <ImportColumn Header="@ArtworkImportHeaders.DateCreated">yyyy, yyyy-MM or yyyy-MM-dd. Blank or 0 when unknown.</ImportColumn>
    }

    @if (Has(ArtworkField.HeightAndWidth))
    {
      <ImportColumn Header="@($"{ArtworkImportHeaders.Height}, {ArtworkImportHeaders.Width}")">
        Both or neither, in the unit chosen below.
      </ImportColumn>
    }

    @if (Has(ArtworkField.Depth))
    {
      <ImportColumn Header="@ArtworkImportHeaders.Depth">Only with a height and width.</ImportColumn>
    }

    @if (Has(ArtworkField.Duration))
    {
      <ImportColumn Header="@ArtworkImportHeaders.Duration">h:mm:ss or m:ss.</ImportColumn>
    }

    <ImportColumn Header="@ArtworkImportHeaders.Series">
      Series names, separated by the list separator. A name that isn't a series yet is created, and the review
      lists the new ones before anything is imported.
    </ImportColumn>

    <ImportColumn Header="@ArtworkImportHeaders.Price">
      Digits and a decimal point, no currency sign. A row with no price isn't for sale.
    </ImportColumn>

    <ImportColumn Header="@ArtworkImportHeaders.Sold">
      One of a kind only: TRUE, FALSE or blank. A sold row may have no price.
    </ImportColumn>

    <ImportColumn Header="@ArtworkImportHeaders.EditionSize">
      Not one of a kind: how many were made. Blank for an edition that can always be restocked.
    </ImportColumn>

    <ImportColumn Header="@ArtworkImportHeaders.Stock">
      Not one of a kind: how many are left, no more than the edition size.
    </ImportColumn>

    @foreach (var vocabulary in TypeVocabularies)
    {
      var header = ArtworkImportHeaders.ForVocabulary(vocabulary.Name.Value);
      <ImportColumn Header="@header">
        Names of existing terms, separated by the list separator.
        @if (header != vocabulary.Name.Value)
        {
          <text>Starts with @ArtworkImportHeaders.VocabularyPrefix, since @vocabulary.Name.Value alone is one of the
            columns above.</text>
        }
      </ImportColumn>
    }
  </Columns>
</ImportColumnsHelp>
