@inherits LayoutComponentBase
@layout MainLayout
@using ArtistShop.Web.Components.Catalog
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@inject VocabularyRepository VocabularyRepository

@code {
  private List<Vocabulary> _vocabularies = [];

  protected override async Task OnInitializedAsync()
  {
    _vocabularies = VocabularyOrder.SortedByName(await VocabularyRepository.GetAllAsync());
  }
}

<AdminPanel>
  <SectionNav>
    <NavLink href="/admin/catalog/vocabularies/new" ActiveClass="underline">+ New vocabulary</NavLink>
    <div aria-hidden="true" class="pointer-events-none">|</div>
    @foreach (var vocabulary in _vocabularies)
    {
      <SectionNavLink href="@($"/admin/catalog/vocabularies/{vocabulary.Id.Value}/edit")"
                      ActivePath="@($"/admin/catalog/vocabularies/{vocabulary.Id.Value}")" ActiveClass="underline">
        @vocabulary.Name.Value
      </SectionNavLink>
    }
  </SectionNav>
  <ChildContent>
    @Body
  </ChildContent>
</AdminPanel>
