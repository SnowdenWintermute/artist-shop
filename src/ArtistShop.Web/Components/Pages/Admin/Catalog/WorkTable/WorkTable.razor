@using ArtistShop.Web.Components.Catalog
@using ArtistShop.Web.Components.Forms.FileUpload.Images
@using ArtistShop.Web.Components.Pages.Admin.Catalog.Works
@using ArtistShop.Web.Components.Pages.Admin.Catalog.Collections
@using ArtistShop.Web.Components.Tables
@using ArtistShop.Web.Database
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Dialogs
@inject WorkRepository WorkRepository
@inject VocabularyRepository VocabularyRepository

@* Works of one type, each saved on its own as its fields change. Each input saves its row when it
   loses focus with a changed value: @bind updates on "change". The longer fields open dialogs *@

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  [Parameter, EditorRequired]
  public IReadOnlyList<WorkTableRow> Rows { get; set; } = default!;
  // the type every row has, whose fields are the columns
  [Parameter, EditorRequired]
  public WorkTypeWithFields Type { get; set; } = default!;
  // in the artist's order
  [Parameter, EditorRequired]
  public IReadOnlyList<Collection> AllCollections { get; set; } = default!;
  // a collection is saved as soon as the collection dialog adds it, so the caller lists it for every row
  [Parameter, EditorRequired]
  public EventCallback<Collection> OnCollectionAdded { get; set; }
  // after each save of a row, which saved only if the row has no errors now; for a page that shows
  // whether everything is saved
  [Parameter]
  public EventCallback<WorkTableRow> OnSaveFinished { get; set; }
  // a vocabulary, term or collection was added from a dialog that has now closed, for a page with lists of
  // its own, like filters, to read them again
  [Parameter]
  public EventCallback OnChoicesAdded { get; set; }
  // deleted from the bulk bar, for the caller to take out of Rows
  [Parameter, EditorRequired]
  public EventCallback<IReadOnlyList<WorkTableRow>> OnRowsDeleted { get; set; }

  private bool _choicesAdded;

  // the type's, sorted by name; the vocabulary dialog can add to them
  private List<VocabularyWithTerms> _vocabularies = [];
  private WorkTypeId? _vocabulariesTypeId;

  private WorkTableRow? _descriptionRow;
  private WorkTableRow? _collectionRow;
  private WorkTableRow? _vocabularyRow;
  private WorkTableRow? _imagesRow;

  private BulkChange? _bulkCollectionChange;
  private BulkChange? _bulkVocabularyChange;
  private bool _isConfirmingDelete;
  private bool _isDeleting;
  // saving each selected row after a bulk change
  private bool _isApplying;

  // the checkboxes, images and title stay in view as the other columns scroll sideways under them
  private const string SelectColumnClass = "sticky left-0 w-10 min-w-10 bg-panel";
  private const string ImagesColumnClass = "sticky left-10 w-16 min-w-16 bg-panel";
  private const string TitleColumnClass = "sticky left-26 bg-panel";

  private const string CheckboxClass = "size-5 cursor-pointer";
  private const string PinnedCellClass = "z-10";

  private const string InputClass = "artist-shop-field-input";

  // room for a focused input's outline, which the pinned title column would otherwise paint over
  private const string FieldCellClass = "pl-1 align-top";

  private const string DialogButtonClass = $"{InputClass} w-48 cursor-pointer truncate text-left";

  private IReadOnlyCollection<WorkField> Fields => Type.Fields;

  protected override async Task OnParametersSetAsync()
  {
    if (_vocabulariesTypeId != Type.Id)
    {
      _vocabulariesTypeId = Type.Id;
      await ReloadVocabulariesAsync();
    }
  }

  private async Task ReloadVocabulariesAsync() =>
    _vocabularies = VocabularyOrder.SortedByName(await VocabularyRepository.GetAllWithTermsForWorkTypeAsync(Type.Id));

  private async Task VocabulariesChangedAsync()
  {
    _choicesAdded = true;
    await ReloadVocabulariesAsync();
  }

  private async Task CollectionAddedAsync(Collection collection)
  {
    _choicesAdded = true;
    await OnCollectionAdded.InvokeAsync(collection);
  }

  // once the dialog is gone, after any save, so the page's refresh doesn't land mid-dialog
  private async Task ChoiceDialogClosedAsync()
  {
    _collectionRow = null;
    _vocabularyRow = null;
    _bulkCollectionChange = null;
    _bulkVocabularyChange = null;

    if (_choicesAdded)
    {
      _choicesAdded = false;
      await OnChoicesAdded.InvokeAsync();
    }
  }

  private IReadOnlyList<DataTableHeading> Headings
  {
    get
    {
      List<DataTableHeading> headings =
      [
        new("", SelectColumnClass, Pinned: true, Content: SelectAllCheckbox),
        new("", ImagesColumnClass, Pinned: true),
        new("Title", TitleColumnClass, Pinned: true),
      ];

      if (Fields.Contains(WorkField.DateCreated))
      {
        headings.Add("Date created");
      }

      if (Fields.Contains(WorkField.HeightAndWidth))
      {
        headings.AddRange(["Height (cm)", "Width (cm)"]);
      }

      if (Fields.Contains(WorkField.Depth))
      {
        headings.Add("Depth (cm)");
      }

      if (Fields.Contains(WorkField.Duration))
      {
        headings.Add("Duration");
      }

      headings.AddRange(["Description", Wording.Collection.PluralHeading, "Vocabularies"]);
      return headings;
    }
  }

  // A change made while a save is running waits for it, then saves again, so saves of one row never
  // overlap and the last one sent holds the latest values
  private async Task SaveAsync(WorkTableRow row)
  {
    if (row.IsSaving)
    {
      row.SaveAgain = true;
      return;
    }

    row.IsSaving = true;

    try
    {
      do
      {
        row.SaveAgain = false;

        if (!row.Validate())
        {
          continue;
        }

        row.SaveError = await SaveErrorOfAsync(row, () =>
WorkRepository.UpdateDetailsAsync(row.Form.ToDetailsUpdate(row.Id)));
      } while (row.SaveAgain);
    }
    finally
    {
      row.IsSaving = false;
    }

    await OnSaveFinished.InvokeAsync(row);
  }

  // null when it saved
  private static async Task<string?> SaveErrorOfAsync(WorkTableRow row, Func<Task> save)
  {
    try
    {
      await save();
      row.SaveCount++;
      return null;
    }
    catch (WorkDeletedException)
    {
      return "Deleted elsewhere";
    }
    catch (ChangedSincePageLoadException)
    {
      return "Changed elsewhere. Reload the page.";
    }
  }

  private async Task DescriptionOkAsync(string? description)
  {
    if (_descriptionRow is { } row)
    {
      row.Form.Description = string.IsNullOrWhiteSpace(description) ? null : description;
      _descriptionRow = null;
      await SaveAsync(row);
    }
  }

  private async Task CollectionOkAsync(List<int> collectionIds)
  {
    if (_collectionRow is { } row)
    {
      row.Form.CollectionIds = collectionIds;
      _collectionRow = null;
      await SaveAsync(row);
      await ChoiceDialogClosedAsync();
    }
  }

  private async Task VocabularyOkAsync(List<int> termIds)
  {
    if (_vocabularyRow is { } row)
    {
      row.Form.VocabularyTermIds = termIds;
      _vocabularyRow = null;
      await SaveAsync(row);
      await ChoiceDialogClosedAsync();
    }
  }

  // apart from the row's other fields, which update_work_details saves without touching images
  private async Task ImagesOkAsync(ImageListState state)
  {
    if (_imagesRow is not { } row)
    {
      return;
    }

    var mainImageIndex = state.Images.ToList().FindIndex(image => image.StorageKey == state.MainImageKey);

    row.ImagesSaveError = await SaveErrorOfAsync(row, async () =>
    {
      await WorkRepository.UpdateImagesAsync(row.Id, state.Images, Math.Max(mainImageIndex, 0));
      row.ReplaceSavedImages(state.Images, mainImageIndex < 0 ? null : state.MainImageKey);
    });

    _imagesRow = null;
    await OnSaveFinished.InvokeAsync(row);
  }

  private List<WorkTableRow> SelectedRows => [.. Rows.Where(row => row.IsSelected)];

  private bool IsAllSelected => Rows.All(row => row.IsSelected);

  private void SetAllSelected(bool selected)
  {
    foreach (var row in Rows)
    {
      row.IsSelected = selected;
    }
  }

  private RenderFragment SelectAllCheckbox =>
    @<div class="flex justify-center">
      <input type="checkbox" class="@CheckboxClass" aria-label="Select all" checked="@IsAllSelected"
             @onchange="() => SetAllSelected(!IsAllSelected)" />
    </div>;

  // for removing: only the collections one of these rows is in
  private List<Collection> CollectionsOf(IReadOnlyList<WorkTableRow> rows)
  {
    var collectionIds = rows.SelectMany(row => row.Form.CollectionIds).ToHashSet();
    return [.. AllCollections.Where(collection => collectionIds.Contains(collection.Id.Value))];
  }

  // for removing: only the terms one of these rows has, under their vocabularies
  private List<VocabularyWithTerms> VocabulariesOf(IReadOnlyList<WorkTableRow> rows)
  {
    var termIds = rows.SelectMany(row => row.Form.VocabularyTermIds).ToHashSet();

    return
    [
      .. _vocabularies
        .Select(vocabulary => vocabulary with { Terms = [.. vocabulary.Terms.Where(term => termIds.Contains(term.Id.Value))] })
        .Where(vocabulary => vocabulary.Terms.Count > 0),
    ];
  }

  // Each row the change alters is saved as if edited by hand: a row already saving picks the change up
  // and saves again once that save ends, rather than a second save racing it. change says whether it
  // altered the row, and a row it left as it was isn't saved
  private async Task ApplyAsync(IReadOnlyList<WorkTableRow> rows, Func<WorkTableRow, bool> change)
  {
    _isApplying = true;

    try
    {
      foreach (var row in rows)
      {
        if (change(row))
        {
          await SaveAsync(row);
        }
      }
    }
    finally
    {
      _isApplying = false;
    }
  }

  private async Task BulkCollectionOkAsync(IReadOnlySet<int> collectionIds)
  {
    if (_bulkCollectionChange is not { } change)
    {
      return;
    }

    var rows = SelectedRows;
    _bulkCollectionChange = null;

    await ApplyAsync(rows, row =>
    {
      // added ones go in the order the collections are listed, so each row reads the same as the list
      List<int> updated = change is BulkChange.Add
        ? CollectionOrder.CollectionIdsInListOrder(AllCollections, collectionIds.Union(row.Form.CollectionIds).ToHashSet())
        : [.. row.Form.CollectionIds.Where(id => !collectionIds.Contains(id))];

      if (updated.SequenceEqual(row.Form.CollectionIds))
      {
        return false;
      }

      row.Form.CollectionIds = updated;
      return true;
    });

    await ChoiceDialogClosedAsync();
  }

  private async Task BulkVocabularyOkAsync(IReadOnlySet<int> termIds)
  {
    if (_bulkVocabularyChange is not { } change)
    {
      return;
    }

    var rows = SelectedRows;
    _bulkVocabularyChange = null;

    await ApplyAsync(rows, row =>
    {
      List<int> updated = change is BulkChange.Add
        ? VocabularyOrder.TermIdsInListOrder(_vocabularies, TermChoices.WithAdded(_vocabularies, row.Form.VocabularyTermIds, termIds))
        : [.. row.Form.VocabularyTermIds.Where(id => !termIds.Contains(id))];

      if (updated.SequenceEqual(row.Form.VocabularyTermIds))
      {
        return false;
      }

      row.Form.VocabularyTermIds = updated;
      return true;
    });

    await ChoiceDialogClosedAsync();
  }

  private async Task DeleteSelectedAsync()
  {
    var rows = SelectedRows;
    _isDeleting = true;

    try
    {
      await WorkRepository.DeleteManyAsync([.. rows.Select(row => row.Id)]);
    }
    finally
    {
      _isDeleting = false;
    }

    _isConfirmingDelete = false;
    await OnRowsDeleted.InvokeAsync(rows);
  }

  private string CollectionsText(WorkTableRow row) =>
    string.Join(", ", AllCollections.Where(collection => row.Form.CollectionIds.Contains(collection.Id.Value)).Select(collection =>
collection.Name.Value));

  private string VocabularyText(WorkTableRow row) =>
    string.Join(", ", _vocabularies
      .SelectMany(vocabulary => vocabulary.Terms)
      .Where(term => row.Form.VocabularyTermIds.Contains(term.Id.Value))
      .Select(term => term.Name.Value));
}

@* the right padding keeps the last column's focus outline inside the scrolling box, which clips it.
   On a touch screen the box scrolls both ways: a sideways scroll still coasting inside a box that
   scrolls only sideways holds on to the next drag, so the page wouldn't scroll down until it stopped *@
@{
  var selectedRows = SelectedRows;
  var canChangeSelected = selectedRows.Count > 0 && !_isApplying;
  var isUploadingSelected = selectedRows.Any(row => row.HasImagesUploading);
}

<div class="mb-2 flex flex-wrap items-center gap-2">
  <span class="mr-2 text-sm" role="status">@selectedRows.Count selected</span>
  <ButtonBasic type="button" Variant="ButtonVariant.Outline" disabled="@(!canChangeSelected)"
               @onclick="() => _bulkCollectionChange = BulkChange.Add">Add to @Wording.Collection.PluralInSentence</ButtonBasic>
  <ButtonBasic type="button" Variant="ButtonVariant.Outline" disabled="@(!canChangeSelected)"
               @onclick="() => _bulkCollectionChange = BulkChange.Remove">Remove from @Wording.Collection.PluralInSentence</ButtonBasic>
  <ButtonBasic type="button" Variant="ButtonVariant.Outline" disabled="@(!canChangeSelected)"
               @onclick="() => _bulkVocabularyChange = BulkChange.Add">Add terms</ButtonBasic>
  <ButtonBasic type="button" Variant="ButtonVariant.Outline" disabled="@(!canChangeSelected)"
               @onclick="() => _bulkVocabularyChange = BulkChange.Remove">Remove terms</ButtonBasic>
  @* a work deleted mid-upload would leave its upload failing *@
  <ButtonBasic type="button" Variant="ButtonVariant.DangerOutline"
               disabled="@(!canChangeSelected || isUploadingSelected)"
               title="@(isUploadingSelected ? "Waits for image uploads to finish" : null)"
               @onclick="() => _isConfirmingDelete = true">Delete</ButtonBasic>
</div>

<div class="mb-4 overflow-auto pr-1 pointer-coarse:max-h-[75dvh]">
  <DataTable Items="Rows" Headings="Headings" Class="text-sm" FitsContent StickyHeadings>
    <Row Context="row">
      <DataTableCell Class="@($"align-top {SelectColumnClass} {PinnedCellClass}")">
        @* as tall as the inputs, so the box lines up with the title *@
        <div class="flex h-10 items-center justify-center">
          <input type="checkbox" class="@CheckboxClass" aria-label="@($"Select {row.Form.Name}")" @bind="row.IsSelected" />
        </div>
      </DataTableCell>

      <DataTableCell Class="@($"align-top {ImagesColumnClass} {PinnedCellClass}")">
        <RowImagesCell Row="row" OnEdit="() => _imagesRow = row" />
      </DataTableCell>

      <DataTableCell Class="@($"align-top {TitleColumnClass} {PinnedCellClass}")">
        <input class="@($"{InputClass} w-24 sm:w-32 md:w-48")" aria-label="Title" @bind="row.Form.Name"
               @bind:after="() => SaveAsync(row)" />
        <RowFieldError Message="@row.ErrorFor(nameof(WorkForm.Name))" />
        <RowFieldError Message="@row.SaveError" />
      </DataTableCell>

      @if (Fields.Contains(WorkField.DateCreated))
      {
        <DataTableCell Class="@FieldCellClass">
          <div class="flex gap-1">
            <input inputmode="numeric" class="@($"{InputClass} w-20")" placeholder="Year" aria-label="Year created"
                   @bind="row.YearText" @bind:after="() => SaveAsync(row)" />
            <select class="@($"{InputClass} w-20")" aria-label="Month created" @bind="row.Form.MonthCreated"
                    @bind:after="() => SaveAsync(row)">
              <option value="">Month</option>
              @for (var month = 1; month <= 12; month++)
              {
                <option value="@month">@(PartialDate.MonthName(month)[..3])</option>
              }
            </select>
            <select class="@($"{InputClass} w-16")" aria-label="Day created" @bind="row.Form.DayCreated"
                    @bind:after="() => SaveAsync(row)">
              <option value="">Day</option>
              @for (var day = 1; day <= 31; day++)
              {
                <option value="@day"
                        disabled="@(day > PartialDate.MaximumDayIn(row.Form.YearCreated, row.Form.MonthCreated))">@day</option>
              }
            </select>
          </div>
          <RowFieldError Message="@row.ErrorFor(nameof(WorkForm.YearCreated))" />
          <RowFieldError Message="@row.ErrorFor(nameof(WorkForm.MonthCreated))" />
          <RowFieldError Message="@row.ErrorFor(nameof(WorkForm.DayCreated))" />
        </DataTableCell>
      }

      @if (Fields.Contains(WorkField.HeightAndWidth))
      {
        <DataTableCell Class="@FieldCellClass">
          <input inputmode="decimal" class="@($"{InputClass} w-18")" aria-label="Height in centimetres"
                 @bind="row.HeightText" @bind:after="() => SaveAsync(row)" />
          <RowFieldError Message="@row.ErrorFor(nameof(WorkForm.HeightCm))" />
        </DataTableCell>
        <DataTableCell Class="@FieldCellClass">
          <input inputmode="decimal" class="@($"{InputClass} w-18")" aria-label="Width in centimetres"
                 @bind="row.WidthText" @bind:after="() => SaveAsync(row)" />
          <RowFieldError Message="@row.ErrorFor(nameof(WorkForm.WidthCm))" />
        </DataTableCell>
      }

      @if (Fields.Contains(WorkField.Depth))
      {
        <DataTableCell Class="@FieldCellClass">
          <input inputmode="decimal" class="@($"{InputClass} w-24")" aria-label="Depth in centimetres"
                 @bind="row.DepthText" @bind:after="() => SaveAsync(row)" />
          <RowFieldError Message="@row.ErrorFor(nameof(WorkForm.DepthCm))" />
        </DataTableCell>
      }

      @if (Fields.Contains(WorkField.Duration))
      {
        <DataTableCell Class="@FieldCellClass">
          <input class="@($"{InputClass} w-28")" placeholder="h:mm:ss" aria-label="Duration" @bind="row.Form.Duration"
                 @bind:after="() => SaveAsync(row)" />
          <RowFieldError Message="@row.ErrorFor(nameof(WorkForm.Duration))" />
        </DataTableCell>
      }

      <DataTableCell Class="@FieldCellClass">
        <button type="button" class="@DialogButtonClass" @onclick="() => _descriptionRow = row">
          @(string.IsNullOrWhiteSpace(row.Form.Description) ? "Edit…" : row.Form.Description)
        </button>
      </DataTableCell>

      <DataTableCell Class="@FieldCellClass">
        <button type="button" class="@DialogButtonClass" @onclick="() => _collectionRow = row">
          @(row.Form.CollectionIds.Count is 0 ? "Choose…" : CollectionsText(row))
        </button>
      </DataTableCell>

      <DataTableCell Class="@FieldCellClass">
        <button type="button" class="@DialogButtonClass" @onclick="() => _vocabularyRow = row">
          @(VocabularyText(row) is { Length: > 0 } terms ? terms : "Choose…")
        </button>
      </DataTableCell>
    </Row>
  </DataTable>
</div>

@if (_descriptionRow is { } descriptionRow)
{
  <DescriptionDialog WorkName="@descriptionRow.Form.Name" Description="@descriptionRow.Form.Description"
                     OnOk="DescriptionOkAsync" OnClose="() => _descriptionRow = null" />
}

@if (_collectionRow is { } collectionRow)
{
  <CollectionChoiceDialog WorkName="@collectionRow.Form.Name" AllCollections="AllCollections"
                      SelectedCollectionIds="collectionRow.Form.CollectionIds" OnOk="CollectionOkAsync" OnClose="ChoiceDialogClosedAsync"
                      OnCollectionAdded="CollectionAddedAsync" />
}

@if (_vocabularyRow is { } vocabularyRow)
{
  <VocabularyChoiceDialog WorkName="@vocabularyRow.Form.Name" WorkTypeId="Type.Id" Vocabularies="_vocabularies"
                          SelectedTermIds="vocabularyRow.Form.VocabularyTermIds" OnOk="VocabularyOkAsync" OnClose="ChoiceDialogClosedAsync"
                          OnVocabulariesChanged="VocabulariesChangedAsync" />
}

@if (_imagesRow is { } imagesRow)
{
  <WorkImagesDialog WorkName="@imagesRow.Form.Name" Images="imagesRow.SavedImages"
                       MainImageKey="@imagesRow.MainImageKey" OnOk="ImagesOkAsync" OnClose="() => _imagesRow = null" />
}

@if (_bulkCollectionChange is { } collectionChange)
{
  <BulkCollectionDialog Change="collectionChange" WorkCount="selectedRows.Count"
                    Collections="@(collectionChange is BulkChange.Add ? AllCollections : CollectionsOf(selectedRows))" OnOk="BulkCollectionOkAsync"
                    OnClose="ChoiceDialogClosedAsync" OnCollectionAdded="CollectionAddedAsync" />
}

@if (_bulkVocabularyChange is { } vocabularyChange)
{
  <BulkVocabularyDialog Change="vocabularyChange" WorkCount="selectedRows.Count" WorkTypeId="Type.Id"
                        Vocabularies="@(vocabularyChange is BulkChange.Add ? _vocabularies : VocabulariesOf(selectedRows))"
                        OnOk="BulkVocabularyOkAsync" OnClose="ChoiceDialogClosedAsync"
                        OnVocabulariesChanged="VocabulariesChangedAsync" />
}

<ConfirmDialog @bind-Open="_isConfirmingDelete" Title="@($"Delete {Wording.Work.CountOf(selectedRows.Count)}?")"
               ConfirmLabel="Delete" OnConfirm="DeleteSelectedAsync" IsWorking="_isDeleting">
  <DeleteWorksWarning WorkCount="selectedRows.Count" ImageCount="selectedRows.Sum(row => row.SavedImages.Count)" />
</ConfirmDialog>
