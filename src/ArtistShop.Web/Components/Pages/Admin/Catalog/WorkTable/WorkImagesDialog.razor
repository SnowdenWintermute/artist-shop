@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Dialogs
@using ArtistShop.Web.Components.Forms.FileUpload.Images
@using ArtistShop.Web.Domain.Catalog

@* rendered only while open, so each opening starts from the row's saved images. Images uploaded
   and then cancelled are left for the orphaned image sweep *@

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  [Parameter, EditorRequired]
  public WorkId WorkId { get; set; } = default!;
  // null while the row's title is cleared
  [Parameter, EditorRequired]
  public string? WorkName { get; set; }
  [Parameter, EditorRequired]
  public IReadOnlyList<WorkImage> Images { get; set; } = default!;
  [Parameter, EditorRequired]
  public string? MainImageKey { get; set; }
  [Parameter, EditorRequired]
  public EventCallback<ImageListState> OnOk { get; set; }
  [Parameter, EditorRequired]
  public EventCallback OnClose { get; set; }

  private ImageListState _state = new([], MainImageKey: null, IsUploading: false);
  private bool _isSaving;

  protected override void OnInitialized() => _state = new ImageListState(Images, MainImageKey, IsUploading: false);

  private async Task OkAsync()
  {
    _isSaving = true;

    try
    {
      await OnOk.InvokeAsync(_state);
    }
    finally
    {
      _isSaving = false;
    }
  }
}

<ModalDialog Title="@(WorkName is null ? "Images" : $"Images of {WorkName}")" Width="ModalDialogWidth.Wide" OnClose="OnClose" IgnoresBackdropClick
             KeepOpen="_isSaving">
  <TitleEnd>
    @* no href while images upload, as leaving would cut them off *@
    <a class="@($"{LinkStyles.InSentence} [&:not([href])]:text-ink-unavailable")"
       href="@(_state.IsUploading ? null : PageUrls.EditWork(WorkId))"
       title="@(_state.IsUploading ? "Waits for image uploads to finish" : null)">Edit @Wording.Work.SingularInSentence</a>
  </TitleEnd>
  <ChildContent>
  <div class="-mx-1 mb-4 min-h-0 overflow-y-auto px-1">
    <ImageListEditor SavedImages="Images" SavedMainImageKey="@MainImageKey" StarName="main-image" OnChanged="state => _state = state" />
  </div>

  <ModalDialogActions>
    <ModalCloseButton Label="Cancel" Disabled="_isSaving" />
    <ButtonBasic type="button" Variant="ButtonVariant.Primary" Class="min-w-24" Busy="_isSaving"
                 disabled="@(_isSaving || _state.IsUploading)" @onclick="OkAsync">OK</ButtonBasic>
  </ModalDialogActions>
  </ChildContent>
</ModalDialog>
