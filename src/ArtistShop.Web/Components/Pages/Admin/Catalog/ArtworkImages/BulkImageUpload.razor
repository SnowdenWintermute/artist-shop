@rendermode InteractiveServer
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Catalog
@using ArtistShop.Web.Components.Forms.FileUpload
@using ArtistShop.Web.Components.Pages.Admin.Catalog.ArtworkTypes
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Images
@using ArtistShop.Web.Imports
@using ArtistShop.Web.Sites
@using ArtistShop.Web.Utilities
@inject ArtworkTypeRepository ArtworkTypeRepository
@inject RememberedArtworkType RememberedArtworkType
@inject ArtworkImageRepository ArtworkImageRepository
@inject IJSRuntime JS
@implements IAsyncDisposable

@code {
  [Parameter]
  public int? InitialArtworkTypeId { get; set; }

  private ElementReference _zone;
  private InteropObject<BulkImageUpload>? _uploader;

  private List<ArtworkType> _artworkTypes = [];
  private int? _artworkTypeId;

  // the images found, before they are matched to artworks
  private List<CollectedFile> _candidates = [];
  private UnusableFileCounts _unusable = UnusableFileCounts.None;
  private int _tooDeepCount;
  private bool _tooManyFiles;

  private List<BulkImageFile> _files = [];
  private bool _isUploading;
  private int _percentComplete;

  private int WillAttachCount => _files.Count(file => file.Outcome is BulkImageOutcome.WillAttach or BulkImageOutcome.WillAddExtra);

  protected override async Task OnInitializedAsync()
  {
    _artworkTypes = ArtworkTypeOrder.SortedByName(await ArtworkTypeRepository.GetAllAsync());
    _artworkTypeId = InitialArtworkTypeId ?? (await RememberedArtworkType.FindInAsync(_artworkTypes))?.Id.Value;
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender)
    {
      return;
    }

    // null when the page closed before the uploader started, so nothing will be dropped on it
    _uploader = await InteropObject<BulkImageUpload>.CreateAsync(
      JS, "./js/bulk-artwork-uploader.js", "createBulkUploader", this, self => [_zone, self, BulkImageDrop.MaximumFiles]);
  }

  [JSInvokable]
  public async Task OnFilesCollected()
  {
    var collected = await ReadCollectedFilesAsync();

    _tooManyFiles = false;
    _unusable = UnusableFileCounts.Of(collected);

    var images = collected.Where(file => ImageUploadValidation.IsPermittedContentType(file.Type)).ToList();
    _candidates = [.. images.Where(file => BulkImageDrop.FoldersOf(file.Path).Length <= BulkImageDrop.MaximumDirectoryDepth)];
    _tooDeepCount = images.Count - _candidates.Count;

    await MatchToArtworksAsync();

    // a method JS called doesn't re-render on its own; InvokeAsync puts it back on the renderer
    await InvokeAsync(StateHasChanged);
  }

  [JSInvokable]
  public async Task OnTooManyFiles()
  {
    _tooManyFiles = true;
    _unusable = UnusableFileCounts.None;
    _tooDeepCount = 0;
    _candidates = [];
    _files = [];

    await InvokeAsync(StateHasChanged);
  }

  // every name checked at once, so the artist sees the whole outcome before a byte is uploaded
  // and only the files that will be used are sent
  private async Task MatchToArtworksAsync()
  {
    if (_artworkTypeId is not int typeId)
    {
      _files = [];
      return;
    }

    List<BulkImageCandidate> candidates = [.. _candidates.Select(file => new BulkImageCandidate(file.Id, file.Path))];
    var target = await BulkImageTarget.LoadAsync(new ArtworkTypeId(typeId), candidates, ArtworkImageRepository);

    _files = [.. BulkImagePlanner.Plan(candidates, target).Select(item => new BulkImageFile(item))];
  }

  private async Task OnArtworkTypeChangedAsync()
  {
    await MatchToArtworksAsync();
  }

  private async Task StartUploadAsync()
  {
    if (_uploader is null || _artworkTypeId is not int typeId)
    {
      return;
    }

    _isUploading = true;
    _percentComplete = 0;

    // One artwork's files go one after another, its first image before the others and those by
    // number, so they keep that order and the first finds the artwork still without an image.
    // Different artworks go side by side. An extra image names its artwork; a first image is
    // matched by name again on the server
    var artworks = _files
      .Where(file => file.Outcome is BulkImageOutcome.WillAttach or BulkImageOutcome.WillAddExtra)
      .GroupBy(file => file.ArtworkIds[0])
      .Select(artwork =>
        artwork
          .OrderBy(file => file.ExtraNumber is not null)
          .ThenBy(file => file.ExtraNumber)
          .Select(file => new UploadItem(file.Id, file.Outcome is BulkImageOutcome.WillAddExtra ? file.ArtworkIds[0] : null))
      );

    // nothing happens once the page has closed, taking the files with it
    await _uploader.InvokeIfOpenAsync("upload", artworks, typeId);
  }

  // what the script sends one file as: an extra image names its artwork, and a first image has none
  private record UploadItem(string Id, int? ArtworkId);

  private async Task StopUploadAsync()
  {
    // closing the page stops the uploads anyway
    if (_uploader is not null)
    {
      await _uploader.InvokeIfOpenAsync("stop");
    }
  }

  [JSInvokable]
  public async Task OnUploadProgress(int percentComplete)
  {
    _percentComplete = percentComplete;
    await InvokeAsync(StateHasChanged);
  }

  [JSInvokable]
  public async Task OnFileFinished(string id, ArtworkImageMatchResult result)
  {
    if (FindFile(id) is { } file)
    {
      // the server's answer, not the pre-check's: another upload may have taken the artwork since
      file.Outcome = result.Outcome is ArtworkNameMatchType.OneImagelessArtwork
        ? BulkImageOutcome.Attached
        : BulkImagePlanner.OutcomeOf(result.Outcome);
      file.ArtworkIds = result.ArtworkIds;
    }


    await InvokeAsync(StateHasChanged);
  }

  // the script sends the artwork's image too, for pages that show it; this report needs only the outcome
  [JSInvokable]
  public async Task OnExtraAdded(string id, ArtworkImage _)
  {
    if (FindFile(id) is { } file)
    {
      file.Outcome = BulkImageOutcome.ExtraAdded;
    }

    await InvokeAsync(StateHasChanged);
  }

  [JSInvokable]
  public async Task OnFileFailed(string id, string message)
  {
    if (FindFile(id) is { } file)
    {
      file.Outcome = BulkImageOutcome.Failed;
      file.Error = message;
    }

    await InvokeAsync(StateHasChanged);
  }

  [JSInvokable]
  public async Task OnUploadFinished()
  {
    _isUploading = false;
    await InvokeAsync(StateHasChanged);
  }

  private BulkImageFile? FindFile(string id) => _files.FirstOrDefault(file => file.Id == id);

  private async Task<List<CollectedFile>> ReadCollectedFilesAsync()
  {
    if (_uploader is null)
    {
      return [];
    }

    // the page closed while the files were being read, so there is no one left to show them to
    try
    {
      return await CollectedFileStreams.ReadListAsync(_uploader.Reference, BulkImageDrop.MaximumMetadataBytes);
    }
    catch (JSDisconnectedException)
    {
      return [];
    }
  }

  public async ValueTask DisposeAsync()
  {
    if (_uploader is not null)
    {
      await _uploader.DisposeAsync();
    }
  }
}

<DisabledUntilInteractive>
  @* a run holds the files it hasn't started yet, so nothing new may be collected until it ends.
     FileDropZoneFrame already refuses a drop onto an input inside a disabled fieldset *@
  <fieldset class="contents" disabled="@_isUploading">
    <div class="mb-4">
      <ArtworkTypeSelect ArtworkTypes="_artworkTypes" @bind-Value="_artworkTypeId" @bind-Value:after="OnArtworkTypeChangedAsync" />
    </div>

    @* the events the script listens for bubble, so one element reference covers both pickers and the drop *@
    <div @ref="_zone">
      <FileDropZoneFrame Prompt="Drop a folder of images here, or drop images on their own" ButtonLabel="Choose images"
                         DirectoryButtonLabel="Choose a folder">
        <input type="file" multiple accept="@ImageUploadValidation.FileInputAccept" class="hidden" />
        <input type="file" webkitdirectory class="hidden" />
      </FileDropZoneFrame>
    </div>
  </fieldset>
</DisabledUntilInteractive>


@if (_tooManyFiles)
{
  <p class="mb-4 text-red-400">
    That's more than @BulkImageDrop.MaximumFiles files. Upload one folder at a time.
  </p>
}

@if (_candidates.Count > 0 || _unusable.Any || _tooDeepCount > 0)
{
  <ul class="mb-4 text-sm">
    <li>@CountText.Of(_candidates.Count, "image") found</li>
    <UnusableFileItems Counts="_unusable" />
    @if (_tooDeepCount > 0)
    {
      <li>@CountText.Of(_tooDeepCount, "file") skipped: images in deeply nested folders</li>
    }
  </ul>
}

@if (_candidates.Count > 0 && _artworkTypeId is null)
{
  <p class="mb-4 text-red-400">Choose an artwork type to match these against.</p>
}

@if (_isUploading)
{
  <UploadProgress PercentComplete="_percentComplete" OnStop="StopUploadAsync" />
}
else if (WillAttachCount > 0)
{
  <div class="mb-4">
    <ButtonBasic type="button" Variant="ButtonVariant.Primary" @onclick="StartUploadAsync">
      Upload @CountText.Of(WillAttachCount, "image")
    </ButtonBasic>
  </div>
}

<BulkImageReport Files="_files" />
