@page "/admin/catalog/artworks/images"
@layout ImportLayout
@using ArtistShop.Web.Components.Hints
@using ArtistShop.Web.Components.Pages.Admin.Import
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Sites
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = SitePolicies.Admin)]

@code {
  [SupplyParameterFromQuery(Name = "type")]
  private int? TypeIdValue { get; set; }
}

<PageTitle>Upload artwork images</PageTitle>

<h1 class="mb-4 text-xl">Upload images for artworks you have already added</h1>

<Hint Type="HintType.UploadArtworkImages" Variant="HintVariant.Collapses">
  <p class="mb-4">
    Use this feature if you have already <a class="underline" href="@PageUrls.ArtworkImport">uploaded
    artworks from a spreadsheet.</a>
    If you don't have such a
    spreadsheet, <a class="underline" href="@PageUrls.AddArtworksFromImages">add artworks from images
    directly</a>
  </p>
  <p class="mb-4">
    Each image is matched to an existing artwork with the same name as the image's file name. File extensions (like
    .jpg, .png) are not included.
  </p>
  <p class="mb-4">
    Images named like "My Artwork Name (2).png" will match an artwork named "My Artwork Name" and add a second (or
    third, etc)
    image to that artwork.
  </p>
  <p>
    You can upload a folder of folders of images, but images beyond two levels deep will be ignored.
  </p>
</Hint>

@* the island posts each image to an endpoint that checks the antiforgery token, and there is
       no form on this page to carry one *@
<AntiforgeryToken />

<BulkImageUpload InitialArtworkTypeId="TypeIdValue" />

<ImportStepButtons Step="ImportSteps.Images" />
