@using ArtistShop.Web.Components.Pages.Admin.Catalog.CatalogImport
@using ArtistShop.Web.Components.Tables
@using ArtistShop.Web.Domain
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Imports
@using ArtistShop.Web.Utilities

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  [Parameter, EditorRequired]
  public WorkImportPlan Plan { get; set; } = default!;
  [Parameter, EditorRequired]
  public WorkTypeName WorkTypeName { get; set; } = default!;

  // the type in brackets rather than a sentence, so an artist-defined name needs no article
  // and no plural
  private string Describe(WorkImportSkipReason reason) =>
    reason switch
    {
      WorkImportSkipReason.AlreadyInCatalog => $"Already in the catalog ({WorkTypeName.Value})",
      WorkImportSkipReason.TitleRepeatedInFile => "The title is on more than one row",
      WorkImportSkipReason.SlugTooLong => $"The slug is longer than {ArtistShopLimits.BaseSlugMaximumLength} characters",
    };
}

@* shrink-0 keeps the summary whole; the tables below take what height is left and scroll *@
<p class="mb-4 shrink-0">
  @Wording.Work.CountOf(Plan.Additions.Count) to add,
  @CountText.Of(Plan.NewCollections.Count, $"new {Wording.Collection.SingularInSentence}", $"new {Wording.Collection.PluralInSentence}"),
  @CountText.Of(Plan.SkippedRows.Count, "row") skipped, @CountText.Of(Plan.Errors.Count, "problem").
</p>

@* min-h-0: a flex item won't shrink below its content's height without it, so it would never scroll *@
<div class="mb-4 min-h-0 overflow-y-auto">
  <ImportProblems Errors="Plan.Errors" />

  @if (Plan.NewCollections.Count > 0)
  {
    <div class="mb-6">
      <h3 class="mb-1">New @Wording.Collection.PluralInSentence</h3>
      <p class="mb-2 text-sm">
        These aren't @Wording.Collection.PluralInSentence yet, so importing creates them. A name only one row uses, next to a
        similar one that many rows use, is usually a typo in the spreadsheet.
      </p>

      @if (Plan.CollectionNameWarnings.Count > 0)
      {
        <ul class="mb-2 text-sm text-amber-600">
          @foreach (var warning in Plan.CollectionNameWarnings)
          {
            <li>"@warning.Name" is nearly "@warning.MatchedName". Check the spelling of both.</li>
          }
        </ul>
      }

      <DataTable Items="Plan.NewCollections" Headings="@(["Name", "Rows"])" Class="text-sm" StickyHeadings>
        <Row Context="collection">
          <DataTableCell>@collection.Name</DataTableCell>
          <DataTableCell>@collection.RowCount</DataTableCell>
        </Row>
      </DataTable>
    </div>
  }

  @if (Plan.SkippedRows.Count > 0)
  {
    <div class="mb-6">
      <h3 class="mb-1">Skipped</h3>
      <p class="mb-2 text-sm">
        These rows aren't imported and aren't checked. Add same-titled @Wording.Work.PluralInSentence one at a time instead.
      </p>
      <DataTable Items="Plan.SkippedRows" Headings="@(["Row", "Title", "Why"])" Class="text-sm" RowClass="align-top"
                 StickyHeadings>
        <Row Context="skipped">
          <DataTableCell>@skipped.RowNumber</DataTableCell>
          <DataTableCell>@skipped.Title</DataTableCell>
          <DataTableCell>@Describe(skipped.Reason)</DataTableCell>
        </Row>
      </DataTable>
    </div>
  }

  @if (Plan.Additions.Count > 0)
  {
    <div class="mb-6">
      <h3 class="mb-1">To add</h3>
      <DataTable Items="Plan.Additions" Headings="@(["Row", "Title"])" Class="text-sm" StickyHeadings>
        <Row Context="addition">
          <DataTableCell>@addition.RowNumber</DataTableCell>
          <DataTableCell>@addition.Addition.Name.Value</DataTableCell>
        </Row>
      </DataTable>
    </div>
  }
</div>
