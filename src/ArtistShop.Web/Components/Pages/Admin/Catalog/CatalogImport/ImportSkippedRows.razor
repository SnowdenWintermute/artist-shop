@using ArtistShop.Web.Components.Tables
@using ArtistShop.Web.Imports

@code {
  [Parameter, EditorRequired]
  public IReadOnlyList<ImportSkippedRow> SkippedRows { get; set; } = default!;

  // what "already exists" means for this import
  [Parameter, EditorRequired]
  public string AlreadyExistsText { get; set; } = default!;

  private string Describe(ImportSkipReason reason) =>
    reason switch
    {
      ImportSkipReason.AlreadyExists => AlreadyExistsText,
      ImportSkipReason.RepeatedInFile => "The name is on more than one row",
    };
}

@if (SkippedRows.Count > 0)
{
  <div class="mb-6">
    <h3 class="mb-1">Skipped</h3>
    <p class="mb-2 text-sm">These rows aren't imported and aren't checked.</p>
    <DataTable Items="SkippedRows" Headings="@(new[] { "Row", "Name", "Why" })" Class="text-sm" RowClass="align-top"
               StickyHeadings>
      <Row Context="skipped">
        <DataTableCell>@skipped.RowNumber</DataTableCell>
        <DataTableCell>@skipped.Name</DataTableCell>
        <DataTableCell>@Describe(skipped.Reason)</DataTableCell>
      </Row>
    </DataTable>
  </div>
}
