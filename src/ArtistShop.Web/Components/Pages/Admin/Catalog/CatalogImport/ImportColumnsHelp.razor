@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Hints
@using ArtistShop.Web.Domain.Platform

@* an import page's help: what else the admin could do, then the columns the file can have, as ImportColumns *@

@code {
  // which import page's, as each is dismissed on its own
  [Parameter, EditorRequired]
  public HintType Hint { get; set; }

  [Parameter, EditorRequired]
  public RenderFragment Intro { get; set; } = default!;

  // what holds for every column, before the list
  [Parameter]
  public RenderFragment? Note { get; set; }

  [Parameter, EditorRequired]
  public RenderFragment Columns { get; set; } = default!;

  private const string Heading = "Columns the spreadsheet .csv file can have";

  private RenderFragment ColumnList => @<text>
    @if (Note is not null)
    {
      <p class="mb-2">@Note</p>
    }
    <dl class="grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1">@Columns</dl>
  </text>;
}

<Hint Type="Hint" Variant="HintVariant.Collapses">
  <div class="mb-2">@Intro</div>
  <p class="mb-2">@Heading:</p>
  @ColumnList
</Hint>
