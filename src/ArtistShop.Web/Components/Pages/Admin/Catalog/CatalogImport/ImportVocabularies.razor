@page "/admin/catalog/vocabularies/import"
@layout ImportLayout
@using ArtistShop.Web.Components.Hints
@using ArtistShop.Web.Domain.Platform
@using ArtistShop.Web.Components.Pages.Admin.Import
@using ArtistShop.Web.Components.Catalog
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Imports
@using ArtistShop.Web.Sites
@using ArtistShop.Web.Utilities
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = SitePolicies.Admin)]
@inject ArtworkFieldRepository ArtworkFieldRepository
@inject ArtworkTypeRepository ArtworkTypeRepository
@inject VocabularyRepository VocabularyRepository
@inject VocabularyTermRepository VocabularyTermRepository

@code {
  [SupplyParameterFromQuery(Name = "imported")]
  private int? ImportedCount { get; set; }

  // for the column help, sorted by name
  private List<ArtworkType> _artworkTypes = [];

  protected override async Task OnInitializedAsync() =>
    _artworkTypes = ArtworkTypeOrder.SortedByName(await ArtworkTypeRepository.GetAllAsync());

  private async Task<VocabularyImportPlan> PlanAsync(string csvText, char listSeparator) =>
    VocabularyImportPlanner.Plan(
      csvText,
      listSeparator,
      await CatalogSetupSnapshot.LoadAsync(ArtworkFieldRepository, ArtworkTypeRepository, VocabularyRepository)
    );

  private Task ApplyAsync(VocabularyImportPlan plan) =>
    VocabularyImportPlanner.ApplyAsync(plan, VocabularyRepository, VocabularyTermRepository);
}

<PageTitle>Import vocabularies</PageTitle>

    <h1 class="mb-4 text-xl">Import vocabularies from a spreadsheet</h1>

    <CatalogImportPanel TPlan="VocabularyImportPlan" ImportUrl="@PageUrls.VocabularyImport"
                        ImportedCount="ImportedCount" Singular="vocabulary" Plural="vocabularies" PlanAsync="PlanAsync"
                        ApplyAsync="ApplyAsync">
      <ColumnsHelp>
        <ImportColumnsHelp Hint="HintType.VocabularyImport">
          <Intro>
            To add one vocabulary at a time, <a class="underline" href="@PageUrls.NewVocabulary">create a vocabulary</a>
            instead.
          </Intro>
          <Columns>
            <ImportColumn Header="@VocabularyImportHeaders.Vocabulary">
              The vocabulary's name, at most @ArtistShopLimits.VocabularyNameMaximumLength characters.
            </ImportColumn>

            <ImportColumn Header="@VocabularyImportHeaders.ArtworkTypes">
              The artwork types it applies to, separated by the list separator.
              @if (_artworkTypes.Count == 0)
              {
                <text>There are none yet, so import or create the artwork types first.</text>
              }
              else
              {
                <text>They must exist already (@string.Join(", ", _artworkTypes.Select(type =>type.Name.Value))).</text>
              }
            </ImportColumn>

            <ImportColumn Header="@VocabularyImportHeaders.Terms">
              Separated by the list separator, each at most
              @ArtistShopLimits.VocabularyTermNameMaximumLength characters.
            </ImportColumn>

            <ImportColumn Header="@VocabularyImportHeaders.SingleChoice">
              @VocabularyImportHeaders.Yes if an artwork can have only one of its terms, otherwise
              @VocabularyImportHeaders.No or blank. A vocabulary that's already here must match its own setting.
            </ImportColumn>
          </Columns>
        </ImportColumnsHelp>
      </ColumnsHelp>
        <Review Context="plan">
          <VocabularyImportReview Plan="plan" />
        </Review>
      </CatalogImportPanel>

<ImportStepButtons Step="ImportSteps.Vocabularies" />
