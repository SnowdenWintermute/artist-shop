@* one entry in ImportColumnsHelp's list *@

@code {
  // the column's header, as the file names it
  [Parameter, EditorRequired]
  public string Header { get; set; } = default!;

  [Parameter, EditorRequired]
  public RenderFragment ChildContent { get; set; } = default!;
}

@* translate="no": a fixed name, which stays as it is even where the website calls its works
   something else *@
<dt class="font-mono" translate="no">@Header</dt>
<dd>@ChildContent</dd>
