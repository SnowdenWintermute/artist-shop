@page "/admin/catalog/types/import"
@layout ImportLayout
@using ArtistShop.Web.Components.Hints
@using ArtistShop.Web.Domain.Platform
@using ArtistShop.Web.Components.Pages.Admin.Import
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Imports
@using ArtistShop.Web.Sites
@using ArtistShop.Web.Utilities
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = SitePolicies.Admin)]
@inject WorkFieldRepository WorkFieldRepository
@inject WorkTypeRepository WorkTypeRepository
@inject VocabularyRepository VocabularyRepository

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  [SupplyParameterFromQuery(Name = "imported")]
  private int? ImportedCount { get; set; }

  // for the column help and the review
  private List<WorkFieldDefinition> _fields = [];

  protected override async Task OnInitializedAsync() => _fields = await WorkFieldRepository.GetAllAsync();

  private string FieldName(WorkField field) => _fields.First(definition => definition.Field == field).Name;

  private async Task<WorkTypeImportPlan> PlanAsync(string csvText, char listSeparator) =>
    WorkTypeImportPlanner.Plan(
      csvText,
      listSeparator,
      await CatalogSetupSnapshot.LoadAsync(WorkFieldRepository, WorkTypeRepository, VocabularyRepository)
    );

  private Task ApplyAsync(WorkTypeImportPlan plan) => WorkTypeImportPlanner.ApplyAsync(plan, WorkTypeRepository);
}

<PageTitle>Import @Wording.Work.SingularInSentence types</PageTitle>

    <h1 class="mb-4 text-xl">Import @Wording.Work.SingularInSentence types from a spreadsheet</h1>

    <CatalogImportPanel TPlan="WorkTypeImportPlan" ImportUrl="@PageUrls.WorkTypeImport"
                        ImportedCount="ImportedCount" Singular="@($"{Wording.Work.SingularInSentence} type")" Plural="@($"{Wording.Work.SingularInSentence} types")" PlanAsync="PlanAsync"
                        ApplyAsync="ApplyAsync">
      <ColumnsHelp>
        <ImportColumnsHelp Hint="HintType.WorkTypeImport">
          <Intro>
            To add one type at a time, <a class="underline" href="@PageUrls.NewWorkType">create each
              @Wording.Work.SingularInSentence type</a>
            instead.
          </Intro>
          <Columns>
            <ImportColumn Header="@WorkTypeImportHeaders.WorkType">
              The type's name, at most @ArtistShopLimits.WorkTypeNameMaximumLength characters.
            </ImportColumn>

            <ImportColumn Header="@WorkTypeImportHeaders.Fields">
              Which fields the type has, separated by the list separator. Options are
              <span class="font-bold"> @string.Join(", ", _fields.Select(field => field.Name))</span>.
              @foreach (var field in _fields.Where(field => field.HasRequirement))
              {
                <text> <span class="font-bold">@field.Name</span> requires <span
                  class="font-bold">@FieldName(field.RequiredField)</span>.</text>
              }
            </ImportColumn>
          </Columns>
        </ImportColumnsHelp>
      </ColumnsHelp>
          <Review Context="plan">
            <WorkTypeImportReview Plan="plan" Fields="_fields" />
          </Review>
        </CatalogImportPanel>

<ImportStepButtons Step="ImportSteps.WorkTypes" />
