@page "/admin/catalog/types/import"
@layout ImportLayout
@using ArtistShop.Web.Components.Hints
@using ArtistShop.Web.Components.Pages.Admin.Import
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Imports
@using ArtistShop.Web.Sites
@using ArtistShop.Web.Utilities
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = SitePolicies.Admin)]
@inject ArtworkFieldRepository ArtworkFieldRepository
@inject ArtworkTypeRepository ArtworkTypeRepository
@inject VocabularyRepository VocabularyRepository

@code {
  [SupplyParameterFromQuery(Name = "imported")]
  private int? ImportedCount { get; set; }

  // for the column help and the review
  private List<ArtworkFieldDefinition> _fields = [];

  protected override async Task OnInitializedAsync() => _fields = await ArtworkFieldRepository.GetAllAsync();

  private string FieldName(ArtworkField field) => _fields.First(definition => definition.Field == field).Name;

  private async Task<ArtworkTypeImportPlan> PlanAsync(string csvText, char listSeparator) =>
    ArtworkTypeImportPlanner.Plan(
      csvText,
      listSeparator,
      await CatalogSetupSnapshot.LoadAsync(ArtworkFieldRepository, ArtworkTypeRepository, VocabularyRepository)
    );

  private Task ApplyAsync(ArtworkTypeImportPlan plan) => ArtworkTypeImportPlanner.ApplyAsync(plan, ArtworkTypeRepository);
}

<PageTitle>Import artwork types</PageTitle>

    <h1 class="mb-4 text-xl">Import artwork types from a spreadsheet</h1>

    <CatalogImportPanel TPlan="ArtworkTypeImportPlan" ImportUrl="@PageUrls.ArtworkTypeImport"
                        ImportedCount="ImportedCount" Singular="artwork type" Plural="artwork types" PlanAsync="PlanAsync"
                        ApplyAsync="ApplyAsync">
      <ColumnsHelp>
        <ImportColumnsHelp Hint="HintType.ArtworkTypeImport">
          <Intro>
            To add one type at a time, <a class="underline" href="@PageUrls.NewArtworkType">create an artwork type</a>
            instead.
          </Intro>
          <Columns>
            <ImportColumn Header="@ArtworkTypeImportHeaders.ArtworkType">
              The type's name, at most @ArtistShopLimits.ArtworkTypeNameMaximumLength characters.
            </ImportColumn>

            <ImportColumn Header="@ArtworkTypeImportHeaders.Fields">
              Which fields the type has, separated by the list separator. Options are
              <span class="font-bold"> @string.Join(", ", _fields.Select(field => field.Name))</span>.
              @foreach (var field in _fields.Where(field => field.HasRequirement))
              {
                <text> <span class="font-bold">@field.Name</span> requires <span
                  class="font-bold">@FieldName(field.RequiredField)</span>.</text>
              }
            </ImportColumn>
          </Columns>
        </ImportColumnsHelp>
      </ColumnsHelp>
          <Review Context="plan">
            <ArtworkTypeImportReview Plan="plan" Fields="_fields" />
          </Review>
        </CatalogImportPanel>

<ImportStepButtons Step="ImportSteps.ArtworkTypes" />
