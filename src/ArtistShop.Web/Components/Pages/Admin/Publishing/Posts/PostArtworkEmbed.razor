@using System.Globalization
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Publishing
@using ArtistShop.Web.Domain.Publishing
@using ArtistShop.Web.Images

@code {
  // stands in for the storage key in the image addresses below, which the embed fills in
  private const string StorageKeyPlaceholder = "{storageKey}";
}

@* The artwork embed's toolbar. PostArtworkEmbed.razor.js defines the embed. The toolbar carries the
   image addresses and widths because the server is what knows them *@
<PostEmbedToolbar data-part="artwork-embed-toolbar"
                  data-storage-key-placeholder="@StorageKeyPlaceholder"
                  data-small-image-url="@ImageUrls.EmbedVariant(StorageKeyPlaceholder, EmbedImageSize.Small)"
                  data-medium-image-url="@ImageUrls.EmbedVariant(StorageKeyPlaceholder, EmbedImageSize.Medium)"
                  data-small-width="@ImageVariants.EmbedWidth(EmbedImageSize.Small).ToString(CultureInfo.InvariantCulture)"
                  data-medium-width="@ImageVariants.EmbedWidth(EmbedImageSize.Medium).ToString(CultureInfo.InvariantCulture)"
                  data-layout-classes="@PostEmbedToolbar.LayoutClasses"
                  data-caption-class="@ArtworkEmbedView.CaptionClass">
  @* applied as it's typed. No name, so the form never posts it; the script keeps Enter from
     submitting the post *@
  <label class="flex w-full items-center gap-2">
    <span class="shrink-0">Caption</span>
    <input type="text" autocomplete="off" placeholder="Optional" class="artist-shop-field-input min-w-0 flex-1"
           data-part="caption" />
  </label>
  <div class="flex gap-1" role="group" aria-label="Size">
    <ButtonBasic type="button" Variant="ButtonVariant.Outline" Class="@PostEmbedToolbar.PressedClass" data-size="small" aria-pressed="false">Small</ButtonBasic>
    <ButtonBasic type="button" Variant="ButtonVariant.Outline" Class="@PostEmbedToolbar.PressedClass" data-size="medium" aria-pressed="false">Medium</ButtonBasic>
  </div>
  @* An alignment button names its layout on a line of its own, and the one with text wrapped
     around it, if it has one. Wrap text switches between the two *@
  <div class="flex gap-1" role="group" aria-label="Layout">
    <ButtonBasic type="button" Variant="ButtonVariant.Outline" Class="@PostEmbedToolbar.PressedClass" aria-pressed="false"
                 data-layout="@EmbedLayoutNames.Of(EmbedLayout.Left)"
                 data-wrapped-layout="@EmbedLayoutNames.Of(EmbedLayout.FloatLeft)">Left</ButtonBasic>
    <ButtonBasic type="button" Variant="ButtonVariant.Outline" Class="@PostEmbedToolbar.PressedClass" aria-pressed="false"
                 data-layout="@EmbedLayoutNames.Of(EmbedLayout.Center)">Centre</ButtonBasic>
    <ButtonBasic type="button" Variant="ButtonVariant.Outline" Class="@PostEmbedToolbar.PressedClass" aria-pressed="false"
                 data-layout="@EmbedLayoutNames.Of(EmbedLayout.Right)"
                 data-wrapped-layout="@EmbedLayoutNames.Of(EmbedLayout.FloatRight)">Right</ButtonBasic>
  </div>
  <ButtonBasic type="button" Variant="ButtonVariant.Outline" Class="@PostEmbedToolbar.PressedClass" aria-pressed="false"
               data-action="wrap">Wrap text</ButtonBasic>
  <ButtonBasic type="button" Variant="ButtonVariant.Outline" data-action="change-image">Change image</ButtonBasic>
</PostEmbedToolbar>
