@page "/admin/posts/new"
@page "/admin/posts/{Id:int}/edit"
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Forms
@using ArtistShop.Web.Database
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Publishing
@using ArtistShop.Web.Images
@using ArtistShop.Web.Sites
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = SitePolicies.Admin)]
@inject PostRepository PostRepository
@inject NavigationManager NavigationManager
@inject ImageStorage ImageStorage

@code {
  // by id, not slug: a new title changes the slug, and this page is what changes it
  [Parameter]
  public int? Id { get; set; }

  [SupplyParameterFromForm(FormName = "edit-post")]
  private PostForm Input { get; set; } = default!;
  [SupplyParameterFromQuery(Name = "saved")]
  private bool Saved { get; set; }
  [SupplyParameterFromQuery(Name = "copied")]
  private bool Copied { get; set; }
  // A post keeps the address, ?saved=true from the last save included, and a successful save
  // redirects, so a page rendered from a post is always a save that didn't go through
  private bool _formWasPosted;

  // null when creating, and when the post was deleted while the artist was editing it
  private Post? _post;
  private bool _deletedElsewhere;

  private string Heading =>
    _post is not null ? $"Edit {_post.Title.Value}"
    : Id is null ? "New post"
    : "Deleted post";

  // markup held in a property, shown wherever @PostAddress appears; null shows nothing.
  // It shows what was last saved, drafts included, since the artist is an admin. Edits not saved
  // yet are kept by PostBackup and offered back on return
  private RenderFragment? PostAddress =>
    _post is { } post
      ? @<p class="mb-4 text-sm text-gray-500">
        Address: <a class="underline" href="@PageUrls.Post(post.Slug)">@PageUrls.Post(post.Slug)</a>
      </p>
  : null;

  // keyed by the post, so enhanced navigation to another post's page can't patch this island onto it
  private string DeleteKey => $"delete-{Id}";

  private string BodyEditorKey => $"post-body-{Id}";

  private const string CopyFormName = "copy-post";

  protected override async Task OnInitializedAsync()
  {
    _formWasPosted = Input is not null;

    if (Id is int id)
    {
      _post = await PostRepository.GetAsync(new PostId(id));

      // A save from a post deleted in another tab still renders the form, holding what was posted.
      // Blazor only runs a form's handler once the page has rendered that form, so a 404 here would
      // throw the artist's writing away without saying why
      if (_post is null && !_formWasPosted)
      {
        NavigationManager.NotFound();
        return;
      }

      _deletedElsewhere = _post is null;
    }

    // on a post the binder has already filled this in, so only a fresh page seeds it
    Input ??= _post is null ? PostForm.ForNew() : PostForm.FromPost(_post);
  }

  private async Task SaveAsync()
  {
    var missingImages = Input.ImagesMissingFrom(ImageStorage);

    var droppedLinks = Input.LinksDropped();

    if (missingImages.Count > 0 || droppedLinks.Count > 0)
    {
      Input.AddMissingImageErrors(missingImages);
      Input.AddDroppedLinkErrors(droppedLinks);
      return;
    }

    try
    {
      // by Id, not _post: a save from a deleted post has no _post either, and must not add a new one
      if (Id is null)
      {
        var id = await PostRepository.AddAsync(
          Input.ToPostTitle(), Input.ToPostSlug(), Input.ToPostBody(), Input.Status);
        NavigationManager.NavigateTo($"{PageUrls.EditPost(id)}?saved=true");
        return;
      }

      if (_post is null)
      {
        return;
      }

      await PostRepository.UpdateAsync(
        _post.Id, Input.ToPostTitle(), Input.ToPostSlug(), Input.ToPostBody(), Input.Status);
    }
    catch (NameAlreadyInUseException)
    {
      Input.AddTitleTakenError();
      return;
    }
    catch (ChangedSincePageLoadException)
    {
      _deletedElsewhere = true;
      return;
    }

    // reloading is what shows the saved values, including the new status. A copy's "Copied." goes,
    // so it isn't shown with "Saved."
    NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
    { ["saved"] = true, ["copied"] = null }));
  }

  // A draft holding the post as last saved, opened for editing. Edits not saved yet stay with this
  // post, kept by PostBackup
  private async Task CopyAsync()
  {
    if (_post is null)
    {
      return;
    }

    var id = await AddCopyAsync(_post);
    NavigationManager.NavigateTo($"{PageUrls.EditPost(id)}?copied=true");
  }

  // each title tried and taken belongs to another post, so a free one comes before the posts run out
  private async Task<PostId> AddCopyAsync(Post post)
  {
    for (var number = 1; ; number++)
    {
      var title = post.Title.ForCopy(number);

      try
      {
        return await PostRepository.AddAsync(title, PostSlug.FromTitle(title.Value), post.Body, PostStatus.Draft);
      }
      catch (NameAlreadyInUseException)
      {
      }
    }
  }
}

<PageTitle>@Heading</PageTitle>

@if (Id is null || _post is not null || _deletedElsewhere)
{
  <main>
    <AdminPanel>
      <BackLink Href="@PageUrls.PostList" Label="Posts" />

      <div class="mb-4 flex items-baseline justify-between">
        <h1 class="text-xl">@Heading</h1>
        @if (_post is not null)
        {
          <span class="text-sm text-gray-500">
            <PostStatusLabel PublishedAt="_post.PublishedAt" />
          </span>
        }
      </div>

      @PostAddress

      @if (Saved && !_formWasPosted)
      {
        <SavedNotice>Saved.</SavedNotice>
      }

      @if (Copied && !_formWasPosted)
      {
        <SavedNotice>Copied. This is the new draft; the original is unchanged.</SavedNotice>
      }

      @if (_deletedElsewhere)
      {
        <p class="mb-4 text-red-400">
          This post was deleted somewhere else, so nothing was saved. Your edits are still on this
          page, but they can't be saved to a post that no longer exists.
        </p>
      }

      <PostBackup Post="_post" HoldsUnsavedChanges="_formWasPosted">
        <EnableSaveOnChange HoldsUnsavedChanges="_formWasPosted">
          <EditForm EditContext="Input.EditContext" FormName="edit-post" OnValidSubmit="SaveAsync" Enhance class="mb-8">
            <DataAnnotationsValidator />

            <div class="flex justify-between items-end">
              <TextField Label="Title" @bind-Value="Input.Title" />
              @if (_post is not null)
              {
                @* submits the copy form below, as forms can't nest *@
                <ButtonBasic type="submit" form="@CopyFormName" class="mb-4" Variant="@ButtonVariant.Outline">
                  Make a copy
                </ButtonBasic>
              }
            </div>
            <PostBodyEditor Label="Text" DocumentKey="@BodyEditorKey" @bind-Value="Input.Body" />

            @* Each button posts the status it asks for. The first one is what Enter in the title
               presses, so it's the one that keeps the post as it is. On an existing post it waits for a
               change; Publish and Unpublish are actions in their own right, so they never wait *@
            <div class="flex gap-2">
              @if (_post?.PublishedAt is null)
              {
                <ButtonBasic type="submit" name="Input.Status" value="@nameof(PostStatus.Draft)"
                             Variant="ButtonVariant.PrimaryOutline" data-waits-for-change="@(_post is not null)">
                  Save draft
                </ButtonBasic>
                <ButtonBasic type="submit" name="Input.Status" value="@nameof(PostStatus.Published)"
                             Variant="ButtonVariant.Primary">
                  Publish
                </ButtonBasic>
              }
              else
              {
                <ButtonBasic type="submit" name="Input.Status" value="@nameof(PostStatus.Published)"
                             Variant="ButtonVariant.Primary" data-waits-for-change>
                  Save
                </ButtonBasic>
                <ButtonBasic type="submit" name="Input.Status" value="@nameof(PostStatus.Draft)"
                             Variant="ButtonVariant.PrimaryOutline">
                  Unpublish
                </ButtonBasic>
              }
            </div>
          </EditForm>
        </EnableSaveOnChange>
      </PostBackup>

      @* Rendered whenever there's a post, as a post is matched to its form by rendering the page before
         the handler runs. Outside PostBackup, whose submit handler is the edit form's. Not enhanced, so
         leaving the page runs PostBackup's pagehide, which writes edits typed a moment before *@
      @if (_post is not null)
      {
        <form method="post" @formname="@CopyFormName" @onsubmit="CopyAsync" id="@CopyFormName">
          <AntiforgeryToken />
        </form>
      }

      @* the editor's Video button opens this. Outside the post's form, since it has a form of its own *@
      <VideoAddressDialog />

      @if (_post is not null)
      {
        <div class="border-t pt-4 mb-4">
          <DeletePostButton @rendermode="InteractiveServer" @key="DeleteKey" PostId="_post.Id" PostTitle="_post.Title" />
        </div>
      }

      @PostAddress
    </AdminPanel>
  </main>
}
