@using System.Text.Json
@using ArtistShop.Web.Components.Icons
@using ArtistShop.Web.Components.Publishing
@using ArtistShop.Web.Domain.Publishing

@code {
  // stand in for a video's parts in the addresses below, which the embed fills in
  private const string VideoIdPlaceholder = "{videoId}";
  private const string HashPlaceholder = "{hash}";

  // each layout's name in the Delta, mapped to the classes the post page gives the player
  private static readonly string PlayerClasses = JsonSerializer.Serialize(
    Enum.GetValues<EmbedLayout>().ToDictionary(EmbedLayoutNames.Of, EmbedLayoutClasses.VideoFor));
}

@* The video embed's toolbar. PostVideoEmbed.razor.js defines the embed, and fills in the link to the
   video's page. A video fills the column unless text wraps beside it, so it has no left or right of
   its own, only these three layouts *@
<PostEmbedToolbar data-part="video-embed-toolbar"
                  data-video-id-placeholder="@VideoIdPlaceholder"
                  data-hash-placeholder="@HashPlaceholder"
                  data-youtube-player-url="@VideoUrls.YouTubePlayer(VideoIdPlaceholder)"
                  data-vimeo-player-url="@VideoUrls.VimeoPlayer(VideoIdPlaceholder, null)"
                  data-unlisted-vimeo-player-url="@VideoUrls.VimeoPlayer(VideoIdPlaceholder, HashPlaceholder)"
                  data-youtube-page-url="@VideoUrls.YouTubePage(VideoIdPlaceholder)"
                  data-vimeo-page-url="@VideoUrls.VimeoPage(VideoIdPlaceholder, null)"
                  data-unlisted-vimeo-page-url="@VideoUrls.VimeoPage(VideoIdPlaceholder, HashPlaceholder)"
                  data-layout-classes="@PostEmbedToolbar.LayoutClasses"
                  data-player-classes="@PlayerClasses"
                  data-player-style="@EmbedLayoutClasses.VideoStyle"
                  data-new-layout="@EmbedLayoutNames.Of(EmbedLayout.Center)">
  <Lines>
    @* the video it is, on a line of its own above the buttons, after the button that changes it.
       Opens in a new tab, so checking the video never leaves the editor *@
    <div class="flex items-center gap-2">
      <EmbedToolbarButton Class="shrink-0" aria-label="Change video" title="Change video" data-quill-icon="video"
                          data-action="change-video" />
      <a data-part="video-link" target="_blank" rel="noopener noreferrer" class="max-w-sm min-w-0 truncate underline"></a>
    </div>
  </Lines>
  <ChildContent>
    <div class="flex" role="group" aria-label="Layout">
      <EmbedToolbarButton aria-label="Full width" title="Full width" aria-pressed="false"
                          data-quill-icon="align" data-quill-icon-value="justify"
                          data-layout="@EmbedLayoutNames.Of(EmbedLayout.Center)" />
      @* the image toolbar's Wrap text icon, padded as it is there, and mirrored for the right *@
      <EmbedToolbarButton aria-label="Wrap left" title="Wrap left" aria-pressed="false"
                          data-layout="@EmbedLayoutNames.Of(EmbedLayout.FloatLeft)">
        <SvgIcon Name="text-wrap" Class="p-0.5" />
      </EmbedToolbarButton>
      <EmbedToolbarButton aria-label="Wrap right" title="Wrap right" aria-pressed="false"
                          data-layout="@EmbedLayoutNames.Of(EmbedLayout.FloatRight)">
        <SvgIcon Name="text-wrap" Class="-scale-x-100 p-0.5" />
      </EmbedToolbarButton>
    </div>
  </ChildContent>
</PostEmbedToolbar>
