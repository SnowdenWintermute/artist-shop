@code {
  [Parameter, EditorRequired]
  public string Heading { get; set; } = default!;
  [Parameter, EditorRequired]
  public RenderFragment ChildContent { get; set; } = default!;
  // the step before this one, if there is one
  [Parameter]
  public string? BackHref { get; set; }
  [Parameter]
  public string? BackLabel { get; set; }
}

<PageTitle>@Heading</PageTitle>

@* <artwork-picker-page>, defined in ArtworkPickerPage.razor.js, passes Escape on to the editor
   around the frame, which never hears a key pressed inside it *@
<artwork-picker-page class="block">
  @if (BackHref is not null)
  {
    <a href="@BackHref" class="mb-4 inline-block">← @BackLabel</a>
  }

  <h1 class="mb-4 text-lg">@Heading</h1>

  @ChildContent
</artwork-picker-page>
