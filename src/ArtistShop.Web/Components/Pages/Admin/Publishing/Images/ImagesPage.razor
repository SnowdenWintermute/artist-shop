@page "/admin/images"
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Hints
@using ArtistShop.Web.Components.Layout
@using ArtistShop.Web.Components.Lists
@using ArtistShop.Web.Components.Tables
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Platform
@using ArtistShop.Web.Domain.Publishing
@using ArtistShop.Web.Sites
@using ArtistShop.Web.Utilities
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = SitePolicies.Admin)]
@inject UploadedImageRepository UploadedImageRepository
@inject NavigationManager NavigationManager

@* The image library: the images uploaded into posts and text components, and here. The search and the
   page are in the address, as the work list's are *@

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  [SupplyParameterFromQuery(Name = ImageSearchForm.SearchKey)]
  private string? SearchValue { get; set; }
  [SupplyParameterFromQuery(Name = PageLinks.PageKey)]
  private string? PageValue { get; set; }

  private string? _search;
  private UploadedImageListPage? _images;

  // not OnInitializedAsync: a search or another page is the same page with new query parameters
  protected override async Task OnParametersSetAsync()
  {
    _search = ImageSearchForm.Read(SearchValue);
    var pageNumber = PageLinks.ReadPageNumber(PageValue);
    var images = await UploadedImageRepository.GetPageAsync(_search, pageNumber);

    if (PageLinks.LeaveEmptiedPage(NavigationManager, PageLinks.PageKey, pageNumber, images.Items.Count))
    {
      return;
    }

    _images = images;
  }

}

<PageTitle>Images</PageTitle>

<main>
  <AdminPanel Wide>
    <AdminUpLink />
    <h1 class="mb-4 text-xl">Images</h1>

    <Hint Type="HintType.Images">
      <p>These are images used in blog posts and custom page components. @Wording.Work.PluralHeading
        get their own images. Add @Wording.Work.PluralInSentence <a href="@PageUrls.AddWorksFromImages"
                                                                    class="@LinkStyles.InSentence">here</a>.</p>
      </Hint>

      <SavedAfterEachEditNote What="Images" />

      @* the drop zone posts each upload to an endpoint that checks the antiforgery token, and the search
       form is a GET, which carries none *@
      <AntiforgeryToken />

      <ImageUploader />

      <ImageSearchForm Search="@_search" ClearHref="@PageUrls.Images" />

      @if (_images is { } images)
      {
        @if (images.TotalCount == 0)
        {
          <p>@(_search is null ? "No images yet." : "No images match this search.")</p>
        }
        else
        {
          <div class="mb-2 flex items-center justify-between">
            <span class="text-sm">@CountText.Of(images.TotalCount, "image")</span>
            <PageLinks PageNumber="images.PageNumber" PageCount="images.PageCount" />
          </div>

          @* the indicator is positioned against this wrapper *@
          <div class="relative mb-2">
            <ImageTable Rows="[.. images.Items.Select(ImageTableRow.From)]" />
            <LoadingIndicator />
          </div>

          <div class="flex justify-end">
            <PageLinks PageNumber="images.PageNumber" PageCount="images.PageCount" />
          </div>
        }
      }
    </AdminPanel>
  </main>
