@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Forms
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Sites
@using ArtistShop.Web.Email
@using ArtistShop.Web.Identity
@using ArtistShop.Web.Sites
@using ArtistShop.Web.Utilities
@using Microsoft.AspNetCore.Identity
@inject SiteInviteRepository SiteInviteRepository
@inject SiteEmails SiteEmails
@inject CurrentSite CurrentSite
@inject PlatformSettings PlatformSettings
@inject TimeProvider TimeProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager

@code {
  [CascadingParameter]
  private HttpContext HttpContext { get; set; } = default!;

  [Parameter, EditorRequired]
  public IReadOnlyList<SiteMemberAccount> Members { get; set; } = default!;

  [SupplyParameterFromForm(FormName = "invite-admin")]
  private InviteForm Input { get; set; } = default!;

  protected override void OnInitialized() => Input ??= new();

  private async Task InviteAsync()
  {
    var email = Input.ToEmail();

    if (Members.Any(member => member.Email == email))
    {
      Input.AddAlreadyMemberError();
      return;
    }

    await SiteInviteRepository.AddAsync(CurrentSite.Id, email, TimeProvider.GetUtcNow().AddDays(SiteInvite.DaysValid));

    // from the account rather than the sign-in cookie, which can hold an email since changed
    var inviter =
      await UserManager.GetUserAsync(HttpContext.User)
      ?? throw new InvalidOperationException("A signed-in account wasn't found.");
    await SiteEmails.SendInviteAsync(
      email,
      Unwrap.Value(inviter.Email),
      CurrentSite.MainHost,
      PageUrls.PlatformMySites(NavigationManager.BaseUri, PlatformSettings.Host)
    );

    // redirect to this same page: the list reloads, and refreshing the browser won't post again
    NavigationManager.NavigateTo(NavigationManager.Uri);
  }
}

<EditForm EditContext="Input.EditContext" FormName="invite-admin" OnValidSubmit="InviteAsync" Enhance>
  <DataAnnotationsValidator />

  <TextField Label="Email" @bind-Value="Input.Email" type="email" autocomplete="off" />
  <ButtonBasic type="submit" Variant="ButtonVariant.Primary">Invite</ButtonBasic>
</EditForm>
