@page "/admin/admins"
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Sites
@using ArtistShop.Web.Sites
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = SitePolicies.Owner)]
@inject SiteMemberAccounts SiteMemberAccounts
@inject SiteInviteRepository SiteInviteRepository
@inject CurrentSite CurrentSite
@inject PlatformSettings PlatformSettings
@inject NavigationManager NavigationManager

@code {
  private List<SiteMemberAccount> _members = [];
  private List<SiteInvite> _invites = [];
  private string _mySitesLink = "";

  protected override async Task OnInitializedAsync()
  {
    // the owner first, then admins by email
    _members =
    [
      .. (await SiteMemberAccounts.GetAsync(CurrentSite.Id))
        .OrderBy(member => member.Role)
        .ThenBy(member => member.Email.Value),
    ];

    _mySitesLink = PageUrls.PlatformMySites(NavigationManager.BaseUri, PlatformSettings.Host);
    _invites = [.. (await SiteInviteRepository.GetForSiteAsync(CurrentSite.Id)).OrderBy(invite => invite.Email.Value)];
  }
}

<PageTitle>Admins</PageTitle>

<AdminPanel>
  <h1 class="mb-4 text-xl">Admins</h1>
  <p class="mb-4">Admins can edit this website's artworks and posts. Only you, its owner, can invite or remove them.</p>

  <AdminTable Members="_members" />

  <h2 class="mb-2 text-lg">Invitations</h2>
  <InviteTable Invites="_invites" />

  <h2 class="mb-2 text-lg">Invite an admin</h2>
  <p class="mb-4">
    They'll get an email. They accept at <a class="underline" href="@_mySitesLink">@_mySitesLink</a>, signed in with
    that email, within @SiteInvite.DaysValid days.
  </p>
  <InviteAdminForm Members="_members" />
</AdminPanel>
