@rendermode InteractiveServer
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Forms.FileUpload
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Exports
@using ArtistShop.Web.Images
@using ArtistShop.Web.Imports
@using ArtistShop.Web.Utilities
@inject PostRepository PostRepository
@inject CollectionRepository CollectionRepository
@inject WorkRepository WorkRepository
@inject WorkImageRepository WorkImageRepository
@inject ImageStorage ImageStorage
@inject IJSRuntime JS
@inject ILogger<PostImportUpload> Logger
@implements IAsyncDisposable

@code {
  // well past a post download: a post's folder holds its page, its post.json and its images
  private const int MaximumFiles = 5_000;

  // a backstop only, as for the bulk image upload
  private const long MaximumMetadataBytes = MaximumFiles * 400L;

  private ElementReference _zone;
  private InteropObject<PostImportUpload>? _importer;

  private bool _tooManyFiles;
  private bool _noPostFiles;
  private bool _isReading;
  private bool _isImporting;
  private int _percentComplete;
  private PostImportRun _run = new([]);

  private int WillAddCount => _run.Items.Count(item => item.Outcome is PostImportOutcome.WillAdd);

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender)
    {
      return;
    }

    // null when the page closed before the importer started, so nothing will be dropped on it
    _importer = await InteropObject<PostImportUpload>.CreateAsync(
      JS, "./Components/Pages/Admin/Import/PostImportUpload.razor.js", "createPostImporter", this, self => [_zone, self, MaximumFiles]);
  }

  [JSInvokable]
  public async Task OnFilesCollected()
  {
    _tooManyFiles = false;
    _noPostFiles = false;
    _run = new([]);
    _isReading = true;
    await InvokeAsync(StateHasChanged);

    // the page closed while the folder was being read, so there is no one left to show it to
    try
    {
      var folders = await ReadFoldersAsync();
      _noPostFiles = folders.Count == 0;

      if (folders.Count > 0)
      {
        _run = new(PostImportPlanner.Plan(folders, await PostImportTarget.LoadAsync(folders, PostRepository, CollectionRepository, WorkRepository, WorkImageRepository, ImageStorage)));
      }
    }
    catch (JSDisconnectedException)
    {
    }
    finally
    {
      _isReading = false;
    }

    await InvokeAsync(StateHasChanged);
  }

  [JSInvokable]
  public async Task OnTooManyFiles()
  {
    _tooManyFiles = true;
    _noPostFiles = false;
    _run = new([]);

    await InvokeAsync(StateHasChanged);
  }

  // Only OnFilesCollected calls this, inside its catch of JSDisconnectedException; the analyzer
  // checks each method on its own
#pragma warning disable BL0016
  // each post.json with the files in its own folder
  private async Task<List<PostImportFolder>> ReadFoldersAsync()
  {
    if (_importer?.Reference is not { } importer)
    {
      return [];
    }

    var files = await CollectedFileStreams.ReadListAsync(importer, MaximumMetadataBytes);

    return await CollectedImportFolders.PostsAsync(
      [.. files.Select(file => (file.Path, file))],
      _ => true,
      (file, maximumBytes) => CollectedFileStreams.ReadTextAsync(importer, file, maximumBytes)
    );
  }
#pragma warning restore BL0016

  private async Task StartImportAsync()
  {
    if (_importer is null)
    {
      return;
    }

    _isImporting = true;
    _percentComplete = 0;

    // nothing happens once the page has closed, taking the files with it
    await _importer.InvokeIfOpenAsync("importPosts", _run.Start());
  }

  private async Task StopImportAsync()
  {
    // closing the page stops the import anyway
    if (_importer is not null)
    {
      await _importer.InvokeIfOpenAsync("stop");
    }
  }

  [JSInvokable]
  public async Task OnUploadProgress(int percentComplete)
  {
    _percentComplete = percentComplete;
    await InvokeAsync(StateHasChanged);
  }

  [JSInvokable]
  public void OnFileUploaded(string fileId, ImageUploadResult result) => _run.FileUploaded(fileId, result);

  [JSInvokable]
  public async Task OnPostFailed(int index, string message)
  {
    _run.PostFailed(index, message);
    await InvokeAsync(StateHasChanged);
  }

  // saved before the script goes on to the next post, since it waits for this to return
  [JSInvokable]
  public async Task OnPostUploaded(int index)
  {
    await _run.PostUploadedAsync(index, PostRepository, ImageStorage, Logger);
    await InvokeAsync(StateHasChanged);
  }

  [JSInvokable]
  public async Task OnImportFinished()
  {
    _isImporting = false;
    await InvokeAsync(StateHasChanged);
  }

  public async ValueTask DisposeAsync()
  {
    if (_importer is not null)
    {
      await _importer.DisposeAsync();
    }
  }
}

<DisabledUntilInteractive>
  @* a run holds the files it hasn't sent yet, so nothing new may be collected until it ends *@
  <fieldset class="contents" disabled="@_isImporting">
    <div @ref="_zone">
      <FileDropZoneFrame Prompt="Drop the unzipped post download here" ButtonLabel="@null" DirectoryButtonLabel="Choose a folder">
        <input type="file" webkitdirectory class="hidden" />
      </FileDropZoneFrame>
    </div>
  </fieldset>
</DisabledUntilInteractive>

@if (_tooManyFiles)
{
  <p class="mb-4 text-red-400">That's more than @MaximumFiles files. Choose the post download's folder itself.</p>
}

@if (_noPostFiles)
{
  <p class="mb-4 text-red-400">
    That folder has no @PostExportJson.FileName files. Choose the unzipped post download, which has a folder for each post.
  </p>
}

@if (_isReading)
{
  <p class="mb-4 text-sm">Reading the posts…</p>
}

@if (_isImporting)
{
  <UploadProgress PercentComplete="_percentComplete" OnStop="StopImportAsync"
                  Detail="@($"({_run.Results.Count} of {WillAddCount} posts)")" />
}
else if (_run.IndexesToImport() is { Count: > 0 } toImport)
{
  <div class="mb-4">
    <ButtonBasic type="button" Variant="ButtonVariant.Primary" @onclick="StartImportAsync">
      Import @CountText.Of(toImport.Count, "post")
    </ButtonBasic>
  </div>
}

<PostImportReport Items="_run.Items" Results="_run.Results" />
