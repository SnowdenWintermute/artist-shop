@page "/admin/import/posts"
@layout ImportLayout
@using ArtistShop.Web.Components.Hints
@using ArtistShop.Web.Domain.Platform
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Sites
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = SitePolicies.Admin)]

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;
}

<PageTitle>Import posts</PageTitle>

<h1 class="mb-4 text-xl">Import posts from another website</h1>

<Hint Type="HintType.PostImport" Variant="HintVariant.Collapses">
  <p class="mb-4">
    Use the posts folder download from another PictureCord website's Export page. It must be unzipped first.
    Each @Wording.Work.SingularInSentence linked in a post re-links to the one on this website with the same image,
    otherwise it shows as a standalone picture.
  </p>
  <p>Posts keep their publish dates. Drafts stay drafts.</p>
</Hint>

@* the island posts each image to an endpoint that checks the antiforgery token, and there is
       no form on this page to carry one *@
<AntiforgeryToken />

<PostImportUpload />

<ImportStepButtons Step="ImportSteps.Posts" />
