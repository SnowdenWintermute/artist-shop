@inherits LayoutComponentBase
@layout MainLayout

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;
}

<main>
  <AdminPanel>
    <SectionNav>
      <NavLink href="@PageUrls.Import" Match="NavLinkMatch.All" ActiveClass="underline">All steps</NavLink>
      <div aria-hidden="true" class="pointer-events-none">|</div>
      @foreach (var step in ImportSteps.All)
      {
        @* ActivePath: the images and works pages may add the type to the address *@
        <SectionNavLink href="@step.Href" ActivePath="@step.Href" ActiveClass="underline">@step.Title(Wording)</SectionNavLink>
      }
    </SectionNav>
    <ChildContent>
      @Body
    </ChildContent>
  </AdminPanel>
</main>
