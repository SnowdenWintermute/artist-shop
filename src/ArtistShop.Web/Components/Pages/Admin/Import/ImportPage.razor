@page "/admin/import"
@layout ImportLayout
@using ArtistShop.Web.Components.Hints
@using ArtistShop.Web.Domain.Platform
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Exports
@using ArtistShop.Web.Sites
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = SitePolicies.Admin)]

<PageTitle>Import into your website</PageTitle>

  <h1 class="mb-4 text-xl">Import into your website</h1>
  <div class="mb-6">
    <h2 class="mb-1 text-lg">All at once:</h2>
    <p class="mb-2">
      Upload the full site folder exported from another PictureCord website. It must be unzipped.
    </p>
    <LinkButton href="@PageUrls.WebsiteImport" Variant="ButtonVariant.Primary">
      <IconLabel Icon="folder-open">Import</IconLabel>
    </LinkButton>
  </div>

  <Divider Class="mb-6" />

  <h2 class="mb-1 text-lg">Step by step:</h2>


  <Hint Type="HintType.StepByStepImport">
    <p class="mb-4">If you need finer control over imports you can do them one step at a time. If you are starting a new
      site and you already have a structured spreadsheet of artwork data and images that match the names of those
      artworks you may wish to use
      steps 3 and 4.</p>
      <p class="">
        Some steps depend on previous steps.
        Imports are only additive. Existing entries are skipped.
      </p>
    </Hint>

    <div class="flex flex-col gap-6">
      <ImportStep Title="@ImportSteps.ArtworkTypes.Title" Href="@ImportSteps.ArtworkTypes.Href" Icon="csv" ButtonLabel="Import">
        Each artwork type and its fields, from <span class="font-bold">@CatalogExportArchive.ArtworkTypesFileName</span>
        in the catalog
        download.
      </ImportStep>

      <ImportStep Title="@ImportSteps.Vocabularies.Title" Href="@ImportSteps.Vocabularies.Href" Icon="csv" ButtonLabel="Import">
        Each vocabulary and its terms, from <span class="font-bold">@CatalogExportArchive.VocabulariesFileName</span>, and
        the artwork
        types they apply to.
      </ImportStep>

      <ImportStep Title="@ImportSteps.Artworks.Title" Href="@ImportSteps.Artworks.Href" Icon="csv" ButtonLabel="Import">
        Bring your own artwork data in a spreadsheet. If using data exported from another PictureCord site, this is each
        file in the catalog download's <span class="font-bold">@CatalogExportArchive.ArtworksFolder</span> folder.
        Every artwork type gets its own .csv file.
      </ImportStep>

      <ImportStep Title="@ImportSteps.Images.Title" Href="@ImportSteps.Images.Href" Icon="folder-open"
                  ButtonLabel="Upload">
        Image files whose names match existing artworks in the catalog.
      </ImportStep>

      <ImportStep Title="@ImportSteps.Posts.Title" Href="@ImportSteps.Posts.Href" Icon="folder-open" ButtonLabel="Import">
        Upload the blog posts last because they may link to artworks uploaded in previous steps.
      </ImportStep>
    </div>
