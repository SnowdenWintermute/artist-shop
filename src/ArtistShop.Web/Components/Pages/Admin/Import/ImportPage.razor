@page "/admin/import"
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Exports
@using ArtistShop.Web.Sites
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = SitePolicies.Admin)]

<PageTitle>Import into your website</PageTitle>

<AdminPanel>
  <h1 class="mb-4 text-xl">Import into your website</h1>
  <div class="mb-6">
    <h2 class="mb-1 text-lg">All at once:</h2>
    <p class="mb-2">
      Upload the full site folder exported from another PictureCord website. It must be unzipped.
    </p>
    <LinkButton href="@PageUrls.WebsiteImport" Variant="ButtonVariant.Primary">
      <IconLabel Icon="folder-open">Import</IconLabel>
    </LinkButton>
  </div>

  <Divider Class="mb-6" />

  <h2 class="mb-1 text-lg">Step by step:</h2>
  <p class="mb-6">
    If you need finer control over imports you can do them one step at a time. Some steps depend on previous steps.
    Imports are only additive. Entries already existing are skipped.
  </p>

  <div class="flex flex-col gap-6">
    <ImportStep Title="1. Artwork types" Href="@PageUrls.ArtworkTypeImport" Icon="csv" ButtonLabel="Import">
      Each artwork type and its fields, from <span class="font-bold">@CatalogExportArchive.ArtworkTypesFileName</span> in the catalog
      download.
    </ImportStep>

    <ImportStep Title="2. Vocabularies" Href="@PageUrls.VocabularyImport" Icon="csv" ButtonLabel="Import">
      Each vocabulary and its terms, from <span class="font-bold">@CatalogExportArchive.VocabulariesFileName</span>, and the artwork
      types they apply to.
    </ImportStep>

    <ImportStep Title="3. Artworks" Href="@PageUrls.ArtworkImport" Icon="csv" ButtonLabel="Import">
      Each file in the catalog download's <span class="font-bold">@CatalogExportArchive.ArtworksFolder</span> folder. Every artwork type
      gets its own .csv file.
    </ImportStep>

    <ImportStep Title="4. Images" Href="@PageUrls.ArtworkBulkImageUpload(typeId: null)" Icon="folder-open"
                ButtonLabel="Upload">
      Image files whose names match existing artworks in the catalog.
    </ImportStep>

    <ImportStep Title="5. Posts" Href="@PageUrls.PostImport" Icon="folder-open" ButtonLabel="Import">
      Upload the blog posts last because they may link to artworks uploaded in previous steps.
    </ImportStep>
  </div>
</AdminPanel>
