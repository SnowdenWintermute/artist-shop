@using ArtistShop.Web.Components.Lists
@using ArtistShop.Web.Components.Pages.Admin.Catalog.CatalogImport
@using ArtistShop.Web.Components.Tables
@using ArtistShop.Web.Imports
@using ArtistShop.Web.Utilities

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  [Parameter, EditorRequired]
  public WebsiteImportImagesPlan Images { get; set; } = default!;

  private int AlreadyThereCount => Images.Works.Sum(work => work.AlreadyThereCount);
}

<p class="mb-4">
  @CountText.Of(Images.ToAddCount, "image") to add, @AlreadyThereCount already here,
  @CountText.Of(Images.WithoutWork.Count + Images.MissingFiles.Count + Images.UnlistedFiles.Count, "file") left out.
</p>

<ImportProblems Errors="Images.Errors" />

@if (Images.Works.Any(work => work.ToAdd.Count > 0))
{
  <div class="mb-6">
    <DataTable Items="@(Images.Works.Where(work => work.ToAdd.Count > 0).ToList())"
               Headings="@([$"{Wording.Work.SingularHeading} type", Wording.Work.SingularHeading, "Images to add"])" Class="text-sm" StickyHeadings>
      <Row Context="work">
        <DataTableCell>@work.TypeName.Value</DataTableCell>
        <DataTableCell>@work.Title.Value</DataTableCell>
        <DataTableCell>@work.ToAdd.Count</DataTableCell>
      </Row>
    </DataTable>
  </div>
}

<ReportGroup Heading="@($"Left out, their {Wording.Work.PluralInSentence} won't be on this website")" Items="Images.WithoutWork" Context="path">
  <ItemContent>@path</ItemContent>
</ReportGroup>
<ReportGroup Heading="Left out, listed in images.csv but not in the folder" Items="Images.MissingFiles" Context="path">
  <ItemContent>@path</ItemContent>
</ReportGroup>
<ReportGroup Heading="Left out, in the folder but not in images.csv" Items="Images.UnlistedFiles" Context="path">
  <ItemContent>@path</ItemContent>
</ReportGroup>
