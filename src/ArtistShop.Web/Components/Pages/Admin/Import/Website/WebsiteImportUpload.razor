@rendermode InteractiveServer
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Lists
@using ArtistShop.Web.Components.Forms.FileUpload
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Exports
@using ArtistShop.Web.Images
@using ArtistShop.Web.Imports
@using ArtistShop.Web.Utilities
@inject ArtworkFieldRepository ArtworkFieldRepository
@inject ArtworkTypeRepository ArtworkTypeRepository
@inject VocabularyRepository VocabularyRepository
@inject VocabularyTermRepository VocabularyTermRepository
@inject SeriesRepository SeriesRepository
@inject ProductTypeRepository ProductTypeRepository
@inject ArtworkRepository ArtworkRepository
@inject ArtworkImageRepository ArtworkImageRepository
@inject PostRepository PostRepository
@inject ImageStorage ImageStorage
@inject IJSRuntime JS
@inject ILogger<WebsiteImportUpload> Logger
@implements IAsyncDisposable

@code {
  // a website's images, its posts' folders and the catalog files, with room to spare
  private const int MaximumFiles = 50_000;

  // a backstop only, as for the bulk image upload
  private const long MaximumMetadataBytes = MaximumFiles * 400L;

  private ElementReference _zone;
  private IJSObjectReference? _module;
  private IJSObjectReference? _importer;
  private DotNetObjectReference<WebsiteImportUpload>? _selfReference;

  private bool _tooManyFiles;
  private bool _isReading;
  private bool _isImporting;
  private string? _readProblem;
  private WebsiteImportFolder? _folder;
  private WebsiteImportReview? _review;

  // the stages the last import finished, and why it stopped if it did
  private List<WebsiteImportStageDone> _stagesDone = [];
  private string? _importProblem;

  // the images stage while the script sends them: how many there are, how many are in, and each
  // that didn't go in, by its path in images/
  private bool _isSendingImages;
  private int _percentComplete;
  private int _imageCount;
  private int _imagesAdded;
  private Dictionary<string, string> _imagePathsByFileId = [];
  private List<(string Path, string Problem)> _imageFailures = [];

  // the posts stage, run as the post import page runs one, once the images are in
  private bool _isSendingPosts;
  private PostImportRun _postRun = new([]);

  private List<(string Title, string Problem)> PostFailures()
  {
    var failures = new List<(string Title, string Problem)>();

    foreach (var (index, problem) in _postRun.Results)
    {
      if (problem is not null)
      {
        var item = _postRun.Items[index];
        failures.Add((item.Title?.Value ?? item.FolderName, problem));
      }
    }

    return failures;
  }

  // every field there is, for the artwork type review
  private IReadOnlyList<ArtworkFieldDefinition> _fields = [];

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender)
    {
      return;
    }

    // the page closed before the importer started, so nothing will be dropped on it
    try
    {
      _module = await JS.InvokeAsync<IJSObjectReference>("import",
"./Components/Pages/Admin/Import/Website/WebsiteImportUpload.razor.js");
      _selfReference = DotNetObjectReference.Create(this);
      _importer = await _module.InvokeAsync<IJSObjectReference>("createWebsiteImporter", _zone, _selfReference, MaximumFiles);
    }
    catch (JSDisconnectedException)
    {
    }
  }

  [JSInvokable]
  public async Task OnFilesCollected()
  {
    _tooManyFiles = false;
    _folder = null;
    _review = null;
    _stagesDone = [];
    _importProblem = null;
    _readProblem = null;
    _isReading = true;
    await InvokeAsync(StateHasChanged);

    try
    {
      var importer = Unwrap.Value(_importer);
      var files = await CollectedFileStreams.ReadListAsync(importer, MaximumMetadataBytes);
      _folder = await CollectedImportFolders.WebsiteAsync(files, (file, maximumBytes) => CollectedFileStreams.ReadTextAsync(importer, file, maximumBytes));
      await ReviewAsync(_folder);
    }
    // the page closed while the folder was being read, so there is no one left to show it to
    catch (JSDisconnectedException)
    {
    }
    catch (Exception exception)
    {
      Logger.LogError(exception, "Reading the whole-website folder failed.");
      _folder = null;
      _review = null;
      _readProblem = "Something went wrong reading the folder. Choose it again to try again.";
    }
    finally
    {
      _isReading = false;
    }

    await InvokeAsync(StateHasChanged);
  }

  private async Task ReviewAsync(WebsiteImportFolder folder)
  {
    var target = await WebsiteImportTarget.LoadAsync(
      folder,
      ArtworkFieldRepository,
      ArtworkTypeRepository,
      VocabularyRepository,
      SeriesRepository,
      ProductTypeRepository,
      ArtworkRepository,
      ArtworkImageRepository,
      PostRepository,
      ImageStorage
    );
    _fields = target.Setup.Fields;
    _review = WebsiteImportPlanner.Plan(folder, target);
  }

  // The catalog runs here; the images are then handed to the script, which reports each one and
  // then OnImagesFinished. The review shows what's on the website afterwards, so it says what a
  // second run would add
  private async Task ImportAsync()
  {
    if (_folder is not { } folder)
    {
      return;
    }

    _isImporting = true;
    _stagesDone = [];
    _importProblem = null;
    _imageFailures = [];
    _postRun = new([]);

    var repositories = new CatalogRepositories(
      ArtworkFieldRepository,
      ArtworkTypeRepository,
      VocabularyRepository,
      VocabularyTermRepository,
      SeriesRepository,
      ProductTypeRepository,
      ArtworkRepository
    );

    try
    {
      _importProblem = await WebsiteCatalogImporter.ImportAsync(
        folder,
        repositories,
        async stage =>
        {
          _stagesDone.Add(stage);
          await InvokeAsync(StateHasChanged);
        }
      );
    }
    catch (Exception exception)
    {
      Logger.LogError(exception, "The whole-website import failed.");
      _importProblem = SomethingWentWrongProblem;
    }

    if (_importProblem is not null)
    {
      await FinishAsync(folder);
      return;
    }

    await GuardAsync(folder, () => StartImagesAsync(folder));
  }

  private const string SomethingWentWrongProblem = "Something went wrong importing. What was imported stays; import again to add the rest.";

  // A step after the catalog. Whatever it throws ends the run with a message, rather than leaving
  // the page importing with nothing running
  private async Task GuardAsync(WebsiteImportFolder folder, Func<Task> step)
  {
    try
    {
      await step();
    }
    // the page closed, which ends the import anyway
    catch (JSDisconnectedException)
    {
    }
    catch (Exception exception)
    {
      Logger.LogError(exception, "The whole-website import failed.");
      _importProblem = SomethingWentWrongProblem;
      await FinishAsync(folder);
    }
  }

  // GuardAsync catches JSDisconnectedException around these two; the analyzer checks each method
  // on its own
#pragma warning disable BL0016
  // Planned again now the artworks are here, for their real ids and the images they have. The
  // script reports each image, then OnImagesFinished
  private async Task StartImagesAsync(WebsiteImportFolder folder)
  {
    await ReviewAsync(folder);
    var artworks = Unwrap.Value(_review).Images.Artworks.Where(artwork => artwork.ToAdd.Count > 0).ToList();

    if (artworks.Count == 0)
    {
      _stagesDone.Add(new WebsiteImportStageDone("Images", 0));
      await StartPostsAsync(folder);
      return;
    }

    _imageCount = artworks.Sum(artwork => artwork.ToAdd.Count);
    _imagesAdded = 0;
    _percentComplete = 0;
    _imagePathsByFileId = artworks.SelectMany(artwork => artwork.ToAdd).ToDictionary(image => image.FileId, image => image.Path);
    _isSendingImages = true;

    await Unwrap.Value(_importer).InvokeVoidAsync(
      "importImages",
      artworks.Select(artwork => new { artworkId = artwork.ArtworkId.Value, fileIds = artwork.ToAdd.Select(image => image.FileId) })
    );
  }

  // Planned against the website as the images left it, as the post import page plans them, so a
  // picture links only to an artwork that really has its image here
  private async Task StartPostsAsync(WebsiteImportFolder folder)
  {
    _isSendingImages = false;

    var target = await PostImportTarget.LoadAsync(folder.Posts, PostRepository, SeriesRepository, ArtworkRepository, ArtworkImageRepository, ImageStorage);
    _postRun = new PostImportRun(PostImportPlanner.Plan(folder.Posts, target));
    var batches = _postRun.Start();

    if (batches.Count == 0)
    {
      _stagesDone.Add(new WebsiteImportStageDone("Posts", 0));
      await FinishAsync(folder);
      return;
    }

    _isSendingPosts = true;
    _percentComplete = 0;
    await InvokeAsync(StateHasChanged);

    await Unwrap.Value(_importer).InvokeVoidAsync("importPosts", batches);
  }
#pragma warning restore BL0016

  [JSInvokable]
  public void OnFileUploaded(string fileId, ImageUploadResult result) => _postRun.FileUploaded(fileId, result);

  [JSInvokable]
  public async Task OnPostFailed(int index, string message)
  {
    _postRun.PostFailed(index, message);
    await InvokeAsync(StateHasChanged);
  }

  // saved before the script goes on to the next post, since it waits for this to return
  [JSInvokable]
  public async Task OnPostUploaded(int index)
  {
    await _postRun.PostUploadedAsync(index, PostRepository, ImageStorage, Logger);
    await InvokeAsync(StateHasChanged);
  }

  [JSInvokable]
  public async Task OnPostsFinished(bool wasStopped)
  {
    _stagesDone.Add(new WebsiteImportStageDone("Posts", _postRun.ImportedCount));

    if (wasStopped)
    {
      _importProblem = StoppedProblem;
    }

    if (_folder is { } folder)
    {
      await FinishAsync(folder);
    }
  }

  // Never throws, so the page always leaves the run
  private async Task FinishAsync(WebsiteImportFolder folder)
  {
    try
    {
      await ReviewAsync(folder);
    }
    catch (Exception exception)
    {
      Logger.LogError(exception, "Reviewing the folder after the whole-website import failed.");
      _review = null;
      _importProblem ??= "The import finished, but the folder couldn't be checked again. Choose it again to see what's left.";
    }

    _isSendingImages = false;
    _isSendingPosts = false;
    _isImporting = false;
    await InvokeAsync(StateHasChanged);
  }

  [JSInvokable]
  public async Task OnUploadProgress(int percentComplete)
  {
    _percentComplete = percentComplete;
    await InvokeAsync(StateHasChanged);
  }

  [JSInvokable]
  public async Task OnImageAdded(string fileId)
  {
    _imagesAdded++;
    await InvokeAsync(StateHasChanged);
  }

  [JSInvokable]
  public async Task OnImageFailed(string fileId, string problem)
  {
    _imageFailures.Add((_imagePathsByFileId.GetValueOrDefault(fileId, fileId), problem));
    await InvokeAsync(StateHasChanged);
  }

  [JSInvokable]
  public async Task OnImagesFinished(bool wasStopped)
  {
    _stagesDone.Add(new WebsiteImportStageDone("Images", _imagesAdded));

    if (_folder is not { } folder)
    {
      return;
    }

    if (wasStopped)
    {
      _importProblem = StoppedProblem;
      await FinishAsync(folder);
      return;
    }

    await GuardAsync(folder, () => StartPostsAsync(folder));
  }

  private const string StoppedProblem = "Stopped. What was imported stays; import again to add the rest.";

  private async Task StopAsync()
  {
    // the page closed, which stopped the import anyway
    try
    {
      if (_importer is not null)
      {
        await _importer.InvokeVoidAsync("stop");
      }
    }
    catch (JSDisconnectedException)
    {
    }
  }

  [JSInvokable]
  public async Task OnTooManyFiles()
  {
    _tooManyFiles = true;
    _review = null;

    await InvokeAsync(StateHasChanged);
  }

  public async ValueTask DisposeAsync()
  {
    try
    {
      if (_importer is not null)
      {
        await _importer.InvokeVoidAsync("dispose");
        await _importer.DisposeAsync();
      }

      if (_module is not null)
      {
        await _module.DisposeAsync();
      }
    }
    catch (JSDisconnectedException)
    {
    }

    _selfReference?.Dispose();
  }
}

<DisabledUntilInteractive>
  @* a run reads the folder it was given, so nothing new may be chosen until it ends *@
  <fieldset class="contents" disabled="@_isImporting">
    <div @ref="_zone" class="mb-4">
      <FileDropZoneFrame Prompt="Drop the unzipped Download everything folder here" ButtonLabel="@null"
                         DirectoryButtonLabel="Choose a folder">
        <input type="file" webkitdirectory class="hidden" />
      </FileDropZoneFrame>
    </div>
  </fieldset>
</DisabledUntilInteractive>

@if (_tooManyFiles)
{
  <p class="mb-4 text-red-400">That's more than @MaximumFiles files. Choose the Download everything folder itself.</p>
}

@if (_readProblem is not null)
{
  <p class="mb-4 text-red-400">@_readProblem</p>
}

@if (_isReading)
{
  <p class="mb-4 text-sm">Reading the folder…</p>
}

@if (_isSendingImages)
{
  <UploadProgress PercentComplete="_percentComplete" OnStop="StopAsync"
                  Detail="@($"({_imagesAdded + _imageFailures.Count} of {_imageCount} images)")" />
}
else if (_isSendingPosts)
{
  <UploadProgress PercentComplete="_percentComplete" OnStop="StopAsync"
                  Detail="@($"({_postRun.Results.Count} of {_postRun.Items.Count(item => item.Outcome is PostImportOutcome.WillAdd)} posts)")" />
}
else if (_isImporting)
{
  <p class="mb-4 text-sm">Importing…</p>
}

@if (_stagesDone.Count > 0 || _importProblem is not null)
{
  <div class="mb-4">
    <h2 class="mb-1 text-lg">Imported</h2>
    <ul class="text-sm">
      @foreach (var stage in _stagesDone)
      {
        <li>@stage.Stage: @stage.AddedCount added</li>
      }
    </ul>
    @if (_importProblem is not null)
    {
      <p class="text-sm text-red-400">@_importProblem</p>
    }
  </div>
}

<ReportGroup Heading="Images that didn't upload" Items="_imageFailures" Context="failure">
  <ItemContent>
    @failure.Path <span class="text-red-400"> — @failure.Problem</span>
  </ItemContent>
</ReportGroup>

<ReportGroup Heading="Posts that didn't import" Items="PostFailures()" Context="failure">
  <ItemContent>
    @failure.Title <span class="text-red-400"> — @failure.Problem</span>
  </ItemContent>
</ReportGroup>

@if (_review is { } review)
{
  @if (review.CanImport && !_isImporting)
  {
    <div class="mb-4">
      <ButtonBasic type="button" Variant="ButtonVariant.Primary" @onclick="ImportAsync">Import</ButtonBasic>
    </div>
  }
  <WebsiteImportReport Review="review" Fields="_fields" />

}
