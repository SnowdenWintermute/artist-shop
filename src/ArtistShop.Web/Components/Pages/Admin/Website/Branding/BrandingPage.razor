@page "/admin/website/branding"
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Images
@using ArtistShop.Web.Sites
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = SitePolicies.Admin)]
@inject BrandImageStore BrandImageStore

@code {
  private Dictionary<BrandImageType, BrandImage>? _images;

  protected override async Task OnInitializedAsync() => _images = await BrandImageStore.GetAllAsync();
}

<PageTitle>Branding</PageTitle>

<main>
  <AdminPanel>
    <BackLink Href="@PageUrls.AdminDashboard" Label="Admin" />
    <h1 class="mb-4 text-xl">Branding</h1>

    @if (_images is not null)
    {
      @foreach (var type in Enum.GetValues<BrandImageType>())
      {
        @* each section's Remove form is named "remove"; the scope keeps the three apart *@
        <FormMappingScope Name="@type.ToString()">
          <BrandImageSection Type="type" Image="_images.GetValueOrDefault(type)" />
        </FormMappingScope>
      }
    }
  </AdminPanel>
</main>
