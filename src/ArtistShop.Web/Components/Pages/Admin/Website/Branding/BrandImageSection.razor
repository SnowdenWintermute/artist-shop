@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Forms.FileUpload
@using ArtistShop.Web.Images
@inject BrandImageStore BrandImageStore
@inject NavigationManager NavigationManager

@* one brand image: what's shown now, an upload that replaces it at once, and Remove *@

@code {
  [Parameter, EditorRequired]
  public BrandImageType Type { get; set; }

  // null while the website has none of this type
  [Parameter, EditorRequired]
  public BrandImage? Image { get; set; }

  private readonly BrandImageUploadForm _upload = new();

  private string Heading => HeadingFor(Type);

  // also what the look import calls each one
  public static string HeadingFor(BrandImageType type) =>
    type switch
    {
      BrandImageType.Logo => "Logo",
      BrandImageType.LogoOnDark => "Logo for dark backgrounds",
      BrandImageType.Favicon => "Icon",
    };

  private string? Description =>
    Type switch
    {
      BrandImageType.Logo => null,
      BrandImageType.LogoOnDark => "Shown instead of the logo when your theme's top bar is dark.",
      BrandImageType.Favicon => "Shown in browser tabs, and on a phone's home screen when someone adds your website to it.",
    };

  private async Task RemoveAsync()
  {
    await BrandImageStore.RemoveAsync(Type);
    NavigationManager.NavigateTo(PageUrls.Branding);
  }
}

<section class="mb-8">
  <h2 class="mb-2 text-lg">@Heading</h2>
  @if (Description is not null)
  {
    <p class="mb-4 text-sm text-ink-faded">@Description</p>
  }

  @if (Image is not null)
  {
    <BrandImagePreview Image="Image" />
    <div class="mb-4 flex items-center gap-4">
      <p class="min-w-0 truncate text-sm">@Image.OriginalFileName</p>
      <form method="post" @formname="remove" @onsubmit="RemoveAsync" data-enhance>
        <AntiforgeryToken />
        <ButtonBasic type="submit" Variant="ButtonVariant.DangerText">Remove</ButtonBasic>
      </form>
    </div>
  }

  @* <brand-image-upload> is defined in BrandImageSection.razor.js: it sends the file to the upload endpoint
     and shows why one was refused *@
  <brand-image-upload class="block">
    <EditForm Model="_upload" action="@ImageUploadEndpoints.BrandImageUpload(Type)" enctype="multipart/form-data">
      @* "file" is the name the endpoint binds *@
      <FileDropField Label="@(Image is null ? "Upload" : "Replace")" Name="file" ValueExpression="() => _upload.File"
                     Prompt="Drop an image or SVG here" Accept="@BrandImageUploadValidation.FileInputAccept" />
      <p class="mb-4 text-error empty:hidden" role="alert" data-part="error"></p>
      <ButtonBasic type="submit" Variant="ButtonVariant.Primary">Upload</ButtonBasic>
    </EditForm>
  </brand-image-upload>
</section>
