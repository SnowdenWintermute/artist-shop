@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Forms.FileUpload
@using ArtistShop.Web.Images
@using NetVips
@inject BrandImageStore BrandImageStore
@inject NavigationManager NavigationManager
@inject ILogger<BrandImageSection> Logger

@* one brand image: what's shown now, an upload that replaces it at once, and Remove *@

@code {
  [Parameter, EditorRequired]
  public BrandImageType Type { get; set; }

  // null while the website has none of this type
  [Parameter, EditorRequired]
  public BrandImage? Image { get; set; }

  // named within the page's FormMappingScope for this type
  [SupplyParameterFromForm(FormName = "upload")]
  private BrandImageUploadForm Upload { get; set; } = default!;

  [CascadingParameter]
  private HttpContext HttpContext { get; set; } = default!;

  protected override void OnInitialized() => Upload ??= new();

  private string Heading =>
    Type switch
    {
      BrandImageType.Logo => "Logo",
      BrandImageType.LogoOnDark => "Logo for dark backgrounds",
      BrandImageType.Favicon => "Icon",
    };

  private string? Description =>
    Type switch
    {
      BrandImageType.Logo => null,
      BrandImageType.LogoOnDark => "Shown instead of the logo when your theme's top bar is dark.",
      BrandImageType.Favicon => "Shown in browser tabs, and on a phone's home screen when someone adds your website to it.",
    };

  private async Task UploadAsync()
  {
    // a form posted with no file chosen still sends an empty, unnamed file
    if (Upload.File is not { FileName.Length: > 0 } file)
    {
      Upload.AddFileError("Choose an image.");
      return;
    }

    if (BrandImageUploadValidation.FindProblem(file) is string problem)
    {
      Upload.AddFileError(problem);
      return;
    }

    try
    {
      await using var content = file.OpenReadStream();
      await BrandImageStore.ReplaceAsync(
        Type, content, ImageUploadValidation.OriginalFileName(file), HttpContext.RequestAborted);
    }
    catch (VipsException exception)
    {
      Logger.LogWarning(exception, "libvips could not read an uploaded brand image.");
      Upload.AddFileError(ImageUploadEndpoints.UnreadableImageMessage);
      return;
    }
    catch (Exception exception) when (exception is UnusableImageException or UnsupportedImageFormatException
                                        or ImageTooLargeException or ImageProcessingBusyException)
    {
      Upload.AddFileError(exception.Message);
      return;
    }

    NavigationManager.NavigateTo(PageUrls.Branding);
  }

  private async Task RemoveAsync()
  {
    await BrandImageStore.RemoveAsync(Type);
    NavigationManager.NavigateTo(PageUrls.Branding);
  }
}

<section class="mb-8">
  <h2 class="mb-2 text-lg">@Heading</h2>
  @if (Description is not null)
  {
    <p class="mb-4 text-sm text-ink-faded">@Description</p>
  }

  @if (Image is not null)
  {
    <BrandImagePreview Image="Image" />
    <div class="mb-4 flex items-center gap-4">
      <p class="min-w-0 truncate text-sm">@Image.OriginalFileName</p>
      <form method="post" @formname="remove" @onsubmit="RemoveAsync" data-enhance>
        <AntiforgeryToken />
        <ButtonBasic type="submit" Variant="ButtonVariant.DangerText">Remove</ButtonBasic>
      </form>
    </div>
  }

  <EditForm EditContext="Upload.EditContext" FormName="upload" OnSubmit="UploadAsync" enctype="multipart/form-data"
            Enhance>
    <FileDropField Label="@(Image is null ? "Upload" : "Replace")" Name="@($"{nameof(Upload)}.{nameof(Upload.File)}")"
                   ValueExpression="() => Upload.File" Prompt="Drop an image or SVG here"
                   Accept="@BrandImageUploadValidation.FileInputAccept" />
    <ButtonBasic type="submit" Variant="ButtonVariant.Primary">Upload</ButtonBasic>
  </EditForm>
</section>
