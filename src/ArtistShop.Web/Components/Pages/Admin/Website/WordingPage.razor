@page "/admin/website/wording"
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Forms
@using ArtistShop.Web.Components.Hints
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Platform
@using ArtistShop.Web.Sites
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = SitePolicies.Admin)]
@inject WordingRepository WordingRepository
@inject NavigationManager NavigationManager
@inject TimeProvider TimeProvider

@code {
  // the saved wording, which the previews show rather than what's typed but not yet saved: a
  // successful save redirects, so this request saved nothing
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;
  [SupplyParameterFromForm]
  private WordingForm Input { get; set; } = default!;
  // a successful save redirects, so a page rendered from a post is one that didn't go through
  private bool _formWasPosted;

  protected override void OnInitialized()
  {
    _formWasPosted = Input is not null;
    Input ??= WordingForm.From(Wording);
  }

  private async Task SaveAsync()
  {
    await WordingRepository.UpdateAsync(Input.ToWording());
    NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
    { [SavedAtQuery.Key] = SavedAtQuery.Value(TimeProvider.GetUtcNow()) }));
  }

  private static IReadOnlyList<string> CollectionExamples(DisplayNoun collection) =>
    [collection.PluralHeading, $"All {collection.PluralInSentence}"];

  private static IReadOnlyList<string> WorkExamples(DisplayNoun work) =>
    [work.CountOf(1), work.CountOf(12)];

  private static IReadOnlyList<string> DescriptionExamples(DisplayLabel description) =>
    [description.Heading, $"The {description.InSentence}"];
}

<PageTitle>Wording</PageTitle>

<main>
    <AdminPanel>
      <FormTopBar>
        <AdminUpLink Class="" />
      </FormTopBar>
      <SavedAtNotice HoldsUnsavedChanges="_formWasPosted" />
      <h1 class="mb-4 text-xl">Wording</h1>
      <p class="mb-4">
        Choose what your website calls <Bold>works</Bold>, <Bold>collections</Bold> and a work's <Bold>description</Bold>. Leave
        a word blank to use the default.
      </p>

      <EnableSaveOnChange HoldsUnsavedChanges="_formWasPosted">
        <EditForm Model="Input" FormName="wording" OnValidSubmit="SaveAsync" Enhance data-waits-for-pending class="mb-8">
          <DataAnnotationsValidator />

          <section class="mb-6">
            <h2 class="mb-2 text-lg">Works</h2>
            <Hint Type="HintType.WordingWorks">
              <p>
                A <Bold>work</Bold> is one piece in your catalog, with its own page, images and details.
                Example work types are "Painting", "Photograph" or "Sculpture".</p>
              </Hint>
              <TextField Label="Singular" @bind-Value="Input.WorkSingular" placeholder="@SiteWording.DefaultWorkSingular" />
              <TextField Label="Plural" @bind-Value="Input.WorkPlural" placeholder="@SiteWording.DefaultWorkPlural" />
              <CheckboxField Label="Keep capitals as typed" @bind-Value="Input.WorkKeepsCase"
                             Hint="Otherwise the word is capitalised in headings and lowercase inside sentences." />
              <WordingPreview Examples="WorkExamples(Wording.Work)" />
            </section>

            <section class="mb-6">
              <h2 class="mb-2 text-lg">Collections</h2>
              <Hint Type="HintType.WordingCollections">
                <p>
                  A <Bold>collection</Bold> is a group of <Bold>works</Bold>. A single
                  work may be in more than one collection.
                </p>
              </Hint>
              <TextField Label="Singular" @bind-Value="Input.CollectionSingular"
                         placeholder="@SiteWording.DefaultCollectionSingular" />
              <TextField Label="Plural" @bind-Value="Input.CollectionPlural"
                         placeholder="@SiteWording.DefaultCollectionPlural" />
              <CheckboxField Label="Keep capitals as typed" @bind-Value="Input.CollectionKeepsCase"
                             Hint="Otherwise the word is capitalised in headings and lowercase inside sentences." />
              <WordingPreview Examples="CollectionExamples(Wording.Collection)" />
            </section>

            <section class="mb-6">
              <h2 class="mb-2 text-lg">Description</h2>
              <Hint Type="HintType.WordingDescription">
                <p>
                  A <Bold>description</Bold> is any text that goes with a work. In the art world
                  it's commonly called an <Bold>artist statement</Bold>.
                </p>
              </Hint>
              <TextField Label="Name" @bind-Value="Input.DescriptionLabel"
                         placeholder="@SiteWording.DefaultDescriptionLabel" />
              <CheckboxField Label="Keep capitals as typed" @bind-Value="Input.DescriptionKeepsCase"
                             Hint="Otherwise the name is capitalised in headings and lowercase inside sentences." />
              <WordingPreview Examples="DescriptionExamples(Wording.Description)" />
            </section>
            <ButtonBasic type="submit" Variant="ButtonVariant.Primary" data-waits-for-change>Save</ButtonBasic>
          </EditForm>
        </EnableSaveOnChange>
      </AdminPanel>
    </main>
