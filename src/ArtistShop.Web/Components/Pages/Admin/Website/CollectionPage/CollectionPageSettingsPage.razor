@page "/admin/website/collection-page"
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Catalog
@using ArtistShop.Web.Components.Forms
@using ArtistShop.Web.Components.Pages.Admin.Website.CustomPages
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Sites
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = SitePolicies.Admin)]
@inject CollectionPageRepository CollectionPageRepository
@inject CollectionRepository CollectionRepository
@inject NavigationManager NavigationManager
@inject TimeProvider TimeProvider

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  [SupplyParameterFromForm(FormName = "collection-page")]
  private CollectionPageForm? Input { get; set; }
  // the collection whose page's Edit page link opened this, or the one chosen to preview since. In the address, so
  // a save, which posts to it, keeps it
  // read as text, so a value that isn't a number is a missing page rather than an error
  [SupplyParameterFromQuery(Name = PageUrls.PreviewCollectionKey)]
  private string? PreviewCollectionId { get; set; }
  // a successful save redirects, so a page rendered from a post is one that didn't go through
  private bool _formWasPosted;
  // what the preview shows, rather than a post that didn't go through
  private CollectionPageSettings? _saved;
  // every one, since an empty collection still has a page, which an Edit page link can open this from
  private IReadOnlyList<CollectionWithCover> _collections = [];
  // the one asked for, else the first
  private CollectionWithCover? _previewed;

  private string Title => $"{Wording.Collection.SingularHeading} page";

  protected override async Task OnInitializedAsync()
  {
    _formWasPosted = Input is not null;
    _saved = await CollectionPageRepository.GetAsync();
    Input ??= CollectionPageForm.From(_saved);
    _collections = await CollectionRepository.GetAllWithCoversAsync();

    if (PreviewCollectionId is null)
    {
      _previewed = _collections.FirstOrDefault();
      return;
    }

    _previewed = int.TryParse(PreviewCollectionId, out var id)
      ? _collections.FirstOrDefault(collection => collection.Id.Value == id)
      : null;

    if (_previewed is null)
    {
      NavigationManager.NotFound();
    }
  }

  // no cover means no work with an image, so a visitor sees an empty page
  private string OptionLabel(CollectionWithCover collection) =>
    collection.Cover is null
      ? $"{collection.Name.Value} (no {Wording.Work.PluralInSentence} with images yet)"
      : collection.Name.Value;

  private async Task SaveAsync()
  {
    if (Input is null || !Input.Check())
    {
      return;
    }

    await CollectionPageRepository.UpdateAsync(Input.ToSettings());
    NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
    { [SavedAtQuery.Key] = SavedAtQuery.Value(TimeProvider.GetUtcNow()) }));
  }
}

<PageTitle>@Title</PageTitle>

<main>
  <AdminPanel>
    <FormTopBar>
      <UpLink Href="@PageUrls.CustomPageList" Label="Pages" />
    </FormTopBar>
    <SavedAtNotice HoldsUnsavedChanges="_formWasPosted" />
    <h1 class="mb-4 text-xl">@Title</h1>

    @if (Input is not null)
    {
      <EditForm EditContext="Input.EditContext" FormName="collection-page" OnValidSubmit="SaveAsync" Enhance
                data-waits-for-pending class="mb-8">
        <DataAnnotationsValidator />
        <SubmitOnChange>
          <NumberField Label="Cards per page" @bind-Value="Input.CardsPerPage" />
          <CardGridLayoutField @bind-Value="Input.Layout" />
          @* app.css hides this unless the browser runs no scripts *@
          <ButtonBasic type="submit" Variant="ButtonVariant.Outline" data-part="apply">Save</ButtonBasic>
        </SubmitOnChange>
      </EditForm>
    }

    <h2 class="mb-2 text-lg">Preview</h2>
    @if (_saved is { } saved && _previewed is { } previewed)
    {
      @* a form of its own, since forms can't be nested: choosing loads the page again with the collection *@
      <form method="get" action="@PageUrls.CollectionPageSettings" data-enhance class="mb-4">
        <SubmitOnChange>
          <label class="artist-shop-field-label" for="preview-collection">@Wording.Collection.SingularHeading to preview</label>
          <select id="preview-collection" name="@PageUrls.PreviewCollectionKey" class="artist-shop-field-input mb-2">
            @foreach (var collection in _collections)
            {
              <option @key="collection.Id" value="@collection.Id.Value" selected="@(collection == previewed)">@OptionLabel(collection)</option>
            }
          </select>
          @* app.css hides this unless the browser runs no scripts *@
          <ButtonBasic type="submit" Variant="ButtonVariant.Outline" data-part="apply">Preview</ButtonBasic>
        </SubmitOnChange>
      </form>

      <ThemedPreview>
        <div class="p-4">
          <CollectionPageContent Id="previewed.Id" Name="previewed.Name" Settings="saved" />
        </div>
      </ThemedPreview>
    }
    else
    {
      <p class="mb-4">Nothing to preview: there are no @Wording.Collection.PluralInSentence yet.</p>
    }
  </AdminPanel>
</main>
