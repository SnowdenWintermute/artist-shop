@code {
  // each as the website prints it, from the saved wording
  [Parameter, EditorRequired]
  public IReadOnlyList<string> Examples { get; set; } = default!;
}

<p class="mb-4 text-sm text-ink-faded">
  Your website shows:
  @for (var index = 0; index < Examples.Count; index++)
  {
    @(index > 0 ? ", " : "")
    <span class="text-ink">“@Examples[index]”</span>
  }
</p>
