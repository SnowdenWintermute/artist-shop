@page "/admin/website/theme"
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Forms
@using ArtistShop.Web.Database
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Sites
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = SitePolicies.Admin)]
@inject ThemeRepository ThemeRepository
@inject NavigationManager NavigationManager
@inject ILogger<ThemePage> Logger
@inject IHostEnvironment Environment

@code {
  // what the switch dialog's Save changes and switch posts, from outside the form
  private const string FormId = "theme-form";

  [SupplyParameterFromForm(FormName = "theme")]
  private ThemeForm Input { get; set; } = default!;
  // the theme open, as ThemeKey.QueryValue; with none, the one in use
  [SupplyParameterFromQuery(Name = "theme")]
  private string? ThemeQuery { get; set; }
  [SupplyParameterFromQuery(Name = "saved")]
  private bool Saved { get; set; }
  // a save redirects, so a page rendered from a post is a preview, or a save that didn't go through
  private bool _formWasPosted;

  private List<SavedTheme> _themes = [];
  // null when it's a preset that no longer exists, so the public pages show Paper
  private NamedTheme? _inUse;
  private NamedTheme? _open;
  // what the page shows: the open theme's colours as saved, or the ones being previewed
  private ThemeColors? _shown;

  protected override async Task OnInitializedAsync()
  {
    _themes = [.. (await ThemeRepository.GetAllAsync()).OrderBy(theme => theme.Name,
StringComparer.CurrentCultureIgnoreCase)];
    _inUse = await ThemeRepository.GetInUseAsync();

    if (_inUse is null)
    {
      MissingThemeInUse.Report(Logger, Environment);
    }

    var key = ThemeKey.FromQueryValue(ThemeQuery) ?? _inUse?.Key ?? new ThemeKey.Preset(ThemePreset.Paper);

    if (Open(key) is not { } open)
    {
      NavigationManager.NotFound();
      return;
    }

    _open = open;
    _formWasPosted = Input is not null;

    if (Input is null)
    {
      _shown = open.Theme.Colors;
      // a copy is the website's own, so it starts with a name of its own
      Input = ThemeForm.From(open.Name, $"{open.Name} copy", _shown);
    }
    else
    {
      _shown = Input.ToColors(open.Theme.Colors);
    }
  }

  private NamedTheme? Open(ThemeKey key) =>
    key switch
    {
      ThemeKey.Preset preset => ThemePresets.Find(preset.Value)?.Named,
      ThemeKey.Saved saved => _themes.FirstOrDefault(theme => theme.Id == saved.Id)?.Named,
      _ => throw new InvalidOperationException($"{key.GetType().Name} isn't a theme key."),
    };

  private static bool IsSaved(NamedTheme theme) => theme.Key is ThemeKey.Saved;

  private async Task SubmitAsync()
  {
    if (_open is not { } open)
    {
      return;
    }

    var colors = Input.ToColors(open.Theme.Colors);

    try
    {
      if (Input.IsSavingAsNew)
      {
        var key = new ThemeKey.Saved(await ThemeRepository.AddAsync(Input.ToNewName(), new Theme(colors)));

        if (Input.SaveAsNewAndUse)
        {
          await ThemeRepository.UseAsync(key);
        }

        NavigateToSaved(key);
        return;
      }

      if (Input.IsSaving && open.Key is ThemeKey.Saved saved)
      {
        await ThemeRepository.UpdateAsync(saved.Id, Input.ToName(), new Theme(colors));

        if (ThemeKey.FromQueryValue(Input.SwitchTo) is { } next)
        {
          NavigationManager.NavigateTo(PageUrls.ThemeEditing(next));
        }
        else
        {
          NavigateToSaved(open.Key);
        }

        return;
      }
    }
    catch (NameAlreadyInUseException exception)
    {
      // the post's own inputs still describe what's shown, so the page stays as it was posted
      Input.AddNameTakenError(exception.Name);
      return;
    }
    catch (ChangedSincePageLoadException)
    {
      // deleted elsewhere: the page opens on the theme in use instead
      NavigationManager.NavigateTo(PageUrls.Theme);
      return;
    }

    // derived colours follow the ones just picked
    _shown = colors;
    Input = ThemeForm.From(Input.Name ?? "", Input.NewName ?? "", colors);
  }

  private void NavigateToSaved(ThemeKey key) =>
    NavigationManager.NavigateTo(
      NavigationManager.GetUriWithQueryParameters(PageUrls.ThemeEditing(key), new Dictionary<string, object?>
      {
        ["saved"] =
true
      })
    );

  private async Task UseAsync()
  {
    if (_open is not { } open)
    {
      return;
    }

    try
    {
      await ThemeRepository.UseAsync(open.Key);
      NavigationManager.NavigateTo(PageUrls.ThemeEditing(open.Key));
    }
    catch (ChangedSincePageLoadException)
    {
      NavigationManager.NavigateTo(PageUrls.Theme);
    }
  }

  private async Task DeleteAsync()
  {
    if (_open?.Key is ThemeKey.Saved saved)
    {
      await ThemeRepository.DeleteAsync(saved.Id);
    }

    NavigationManager.NavigateTo(PageUrls.Theme);
  }

  // a role differs from the open theme as saved, which its Reset puts back
  private static bool IsChanged(ThemeColors shown, NamedTheme open, ColorRole role) =>
    shown.ChosenFor(role) != open.Theme.Colors.ChosenFor(role);

  // each with its place in Input.Roles, which names its inputs
  private IEnumerable<(int Index, ColorChoiceInput Choice)> NumberedRoles =>
    Input.Roles.Select((choice, index) => (index, choice)).Where(entry => Enum.IsDefined(entry.choice.Role));

  private IEnumerable<(int Index, ColorChoiceInput Choice)> BaseRoles =>
    NumberedRoles.Where(entry => ColorRoles.For(entry.Choice.Role).IsBase);

  private IEnumerable<(int Index, ColorChoiceInput Choice)> OtherRoles =>
    NumberedRoles.Where(entry => !ColorRoles.For(entry.Choice.Role).IsBase);
}

<PageTitle>Theme</PageTitle>

@if (_open is { } open && _shown is { } shown)
{
  var isInUse = open.Key == _inUse?.Key;
  @* each listed under the role in front *@
  var problems = shown.ContrastProblems().ToLookup(problem => problem.Foreground);

  <main>
    <AdminPanel>
      <BackLink Href="@PageUrls.AdminDashboard" Label="Admin" />
      <h1 class="mb-4 text-xl">Theme</h1>
      <p class="mb-4">
        Admin pages keep the default theme. Public pages' theme can be customized.
      </p>
      @if (_inUse is { } inUse)
      {
        <p class="mb-4">Currently set theme: <strong>@inUse.Name</strong>.</p>
      }
      else
      {
        <p class="mb-4">Your website's theme no longer exists, so its public pages show @ThemePresets.Paper.Name.</p>
      }

      @if (Saved && !_formWasPosted)
      {
        <SavedNotice>Saved.</SavedNotice>
      }

      <ThemePicker Open="open.Key" Themes="_themes" ThemeFormId="@FormId" />
      <ThemeActions Open="open" IsInUse="isInUse" CanUse="!_formWasPosted" OnUse="UseAsync" OnDelete="DeleteAsync" />

      <EnableSaveOnChange HoldsUnsavedChanges="_formWasPosted">
        <EditForm id="@FormId" EditContext="Input.EditContext" FormName="theme" OnValidSubmit="SubmitAsync" Enhance
                  data-waits-for-pending>
          <DataAnnotationsValidator />
          <ValidationSummary class="mb-4 text-error" />

          @if (IsSaved(open))
          {
            @* Enter in a text field presses its form's first submit button, so this one comes first: Enter
               in the name saves, where the first otherwise would be a Reset. Hidden, as Save shows below *@
            <button type="submit" name="Input.Save" value="true" class="sr-only" tabindex="-1" aria-hidden="true"
                    data-waits-for-change>Save</button>
            <TextField Label="Theme name" @bind-Value="Input.Name" autocomplete="off" />
          }

          <div class="mb-6 grid gap-6 md:grid-cols-[1fr_16rem]">
            <SubmitOnChange>
              <section class="mb-6">
                <h2 class="mb-2 text-lg">Base colors</h2>
                <p class="mb-4 text-sm text-ink-faded">You may derive most of the colors from the chosen base colors.</p>
                @foreach (var (index, choice) in BaseRoles)
                {
                  <ColorRoleField Index="index" Choice="choice" Problems="problems[choice.Role]"
                                  IsChanged="IsChanged(shown, open, choice.Role)" />
                }
              </section>

              <section class="mb-4">
                <h2 class="mb-2 text-lg">Everything else</h2>
                <p class="mb-4 text-sm text-ink-faded">Derived from the base colors unless you pick one.</p>

                @if (shown.ChoosesADerivableRole)
                {
                  @* previews too, like a pick *@
                  <div class="mb-6">
                    <ButtonBasic type="submit" name="Input.DeriveAll" value="true" Variant="ButtonVariant.Outline">
                      Derive all from base colors
                    </ButtonBasic>
                  </div>
                }
                @foreach (var (index, choice) in OtherRoles)
                {
                  <ColorRoleField Index="index" Choice="choice" Problems="problems[choice.Role]"
                                  IsChanged="IsChanged(shown, open, choice.Role)" />
                }
              </section>

              @* for a browser that runs no scripts, where picking a color can't preview by itself *@
              <ButtonBasic type="submit" Variant="ButtonVariant.Outline" data-part="apply">Preview</ButtonBasic>
            </SubmitOnChange>

            <div class="md:sticky md:top-4 md:self-start">
              <div class="mb-2">
                <ThemePreview Colors="shown" />
              </div>
              @if (_formWasPosted)
              {
                <p class="text-sm text-ink-faded">Not saved yet.</p>
              }
            </div>
          </div>

          @if (IsSaved(open) && isInUse)
          {
            <p class="mb-2 text-sm text-ink-faded">Your website uses this theme, so saving changes it too.</p>
          }
          <div class="mb-2 flex flex-wrap gap-3">
            @if (IsSaved(open))
            {
              <ButtonBasic type="submit" name="Input.Save" value="true" Variant="ButtonVariant.Primary"
                           data-waits-for-change>Save</ButtonBasic>
            }
            <ButtonBasic type="button" data-opens-dialog="@SaveThemeDialog.DialogId"
                         Variant="@(IsSaved(open) ? ButtonVariant.Outline : ButtonVariant.Primary)">Save as new theme</ButtonBasic>
            @if (_formWasPosted)
            {
              <LinkButton href="@PageUrls.ThemeEditing(open.Key)" Variant="ButtonVariant.Outline">Discard changes
              </LinkButton>
            }
          </div>
          @* the dialog closes as it posts, so a name it was refused shows here too *@
          <ValidationMessage For="() => Input.NewName" class="text-sm text-error" />

          <SaveThemeDialog Input="Input" />
        </EditForm>
      </EnableSaveOnChange>

      <SwitchThemeDialog OpenIsSaved="IsSaved(open)" ThemeFormId="@FormId" />
    </AdminPanel>
  </main>
}
