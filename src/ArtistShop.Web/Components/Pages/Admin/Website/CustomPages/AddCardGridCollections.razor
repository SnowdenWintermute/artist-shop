@page "/admin/website/components/{Id:int}/add-collections"
@inherits AddToCardGridPage
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Forms
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Sites
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = SitePolicies.Admin)]
@inject CardGridChosenCardRepository CardGridChosenCardRepository
@inject CollectionRepository CollectionRepository

@code {
  private const string AddFormName = "add-card-grid-collections";

  private bool _hasCollections;
  // in the artist's order, leaving out the ones on the list already
  private List<CollectionWithCover> _collections = [];

  private IReadOnlyList<CollectionId> Checked => [.. CheckedIdValues.Select(id => new CollectionId(id))];

  protected override async Task OnGridFoundAsync()
  {
    var onList = (await CardGridChosenCardRepository.GetAsync(ComponentId))
      .Select(card => card.Card)
      .OfType<GridCard.OfCollection>()
      .Select(card => card.Collection.Id)
      .ToHashSet();
    var all = await CollectionRepository.GetAllWithCoversAsync();

    _hasCollections = all.Count > 0;
    _collections = [.. all.Where(collection => !onList.Contains(collection.Id))];
  }

  protected override Task AddCheckedAsync() => CardGridChosenCardRepository.AddCollectionsAsync(ComponentId, Checked);
}

<main>
  <AdminPanel>
    @if (Grid is null)
    {
      <AddMissingTarget Title="@($"Add {Wording.Collection.PluralInSentence}")" UpHref="@PageUrls.CustomPageList" UpLabel="Pages"
                        Message="@MissingMessage" FormName="@AddFormName" OnAdd="AddAsync" />
    }
    else
    {
      <AddCheckedShell Title="@($"Add {Wording.Collection.PluralInSentence} to {Grid.Name}")"
                       UpHref="@PageUrls.EditCustomComponent(ComponentId, Origin)" UpLabel="@Grid.Name" FormName="@AddFormName"
                       CheckedCount="Checked.Count" OnAdd="AddAsync">
        @if (!_hasCollections)
        {
          <p>There are no @Wording.Collection.PluralInSentence yet.</p>
        }
        else if (_collections.Count == 0)
        {
          <p>Every @Wording.Collection.SingularInSentence is on the list already.</p>
        }
        else
        {
          @* a GET form, so a check changes the address and nothing else, as on the page adding works *@
          <form method="get" data-enhance>
            @foreach (var (name, value) in PageUrls.OriginFields(Origin))
            {
              <input type="hidden" name="@name" value="@value" />
            }

            <SubmitOnChange>
              <fieldset class="mb-4">
                <legend class="sr-only">@Wording.Collection.PluralHeading</legend>
                @foreach (var collection in _collections)
                {
                  <label @key="collection.Id" class="flex cursor-pointer items-center gap-2 border-b p-2 has-checked:bg-selected">
                    <input type="checkbox" class="cursor-pointer" name="@PageUrls.AddCheckedKey" value="@collection.Id.Value"
                           checked="@Checked.Contains(collection.Id)" />
                    <WorkThumbnail Image="collection.Cover" />
                    <span class="grow">
                      @collection.Name.Value
                      <span class="block text-xs text-ink-faded">@Wording.Work.CountOf(collection.WorkCount)</span>
                      @if (collection.Cover is null)
                      {
                        <span class="block text-xs text-error">
                          Not shown: none of its @Wording.Work.PluralInSentence has an image.
                        </span>
                      }
                    </span>
                  </label>
                }
              </fieldset>

              <ButtonBasic type="submit" Variant="ButtonVariant.Outline" data-part="apply">Update checks</ButtonBasic>
            </SubmitOnChange>
          </form>
        }
      </AddCheckedShell>
    }
  </AdminPanel>
</main>
