@* a page's name, linking to its editor, its address, and whether it's the home, blog or collections page *@
@using ArtistShop.Web.Components.Atoms

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  [Parameter, EditorRequired]
  public required CustomPage Page { get; set; }
}

<span class="flex grow flex-wrap items-baseline gap-x-4">
  <a href="@PageUrls.EditCustomPage(Page.Id)" class="@LinkStyles.Standalone">@Page.Name</a>
  <span class="text-ink-faded">@PageUrls.CustomPage(Page)</span>
  @if (Page.IsHome)
  {
    <Bold>Site home</Bold>
  }
  @if (Page.IsBlog)
  {
    <Bold>Blog home</Bold>
  }
  @if (Page.IsCollections)
  {
    <Bold>@Wording.Collection.PluralHeading home</Bold>
  }
</span>
