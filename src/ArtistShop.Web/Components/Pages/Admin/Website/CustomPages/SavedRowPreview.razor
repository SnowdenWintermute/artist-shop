@* RowPreview for a static page that has the row's id but hasn't read the row *@
@using ArtistShop.Web.Database.Repositories
@inject CustomPageRepository CustomPageRepository

@code {
  [Parameter, EditorRequired]
  public required CustomPage Page { get; set; }
  [Parameter, EditorRequired]
  public required PageRowId RowId { get; set; }

  private PageRow? _row;

  protected override async Task OnParametersSetAsync() =>
    _row = (await CustomPageRepository.GetLayoutAsync(Page.Id)).Row(RowId);
}

@if (_row is { } row)
{
  <RowPreview Page="Page" Row="row" />
}
