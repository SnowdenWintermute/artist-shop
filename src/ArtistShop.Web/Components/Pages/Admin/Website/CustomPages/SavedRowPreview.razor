@* RowPreview for a static page that has the row's id but hasn't read the row *@
@using ArtistShop.Web.Database.Repositories
@inject CustomPageRepository CustomPageRepository

@code {
  [Parameter, EditorRequired]
  public required CustomPage Page { get; set; }
  [Parameter, EditorRequired]
  public required PageRowId RowId { get; set; }

  private CustomPageLayout? _layout;

  protected override async Task OnParametersSetAsync() =>
    _layout = await CustomPageRepository.GetLayoutAsync(Page.Id);
}

@if (_layout is { } layout && layout.Row(RowId) is { } row)
{
  <RowPreview Page="Page" Row="row" Position="layout.PositionOf(row)" />
}
