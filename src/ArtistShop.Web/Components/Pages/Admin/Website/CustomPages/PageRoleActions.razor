@* making a page the home page, the blog page that posts link up to, which needs a post list on it, or the
   collections page that collections link up to, which needs a card grid of all collections *@
@using ArtistShop.Web.Components.Atoms

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  [Parameter, EditorRequired]
  public required CustomPage Page { get; set; }
  [Parameter, EditorRequired]
  public bool CanBeBlog { get; set; }
  [Parameter, EditorRequired]
  public bool CanBeCollections { get; set; }
  [Parameter, EditorRequired]
  public EventCallback<CustomPage> OnMakeHome { get; set; }
  [Parameter, EditorRequired]
  public EventCallback<CustomPage> OnMakeBlog { get; set; }
  [Parameter, EditorRequired]
  public EventCallback<CustomPage> OnMakeCollections { get; set; }
}

@if (!Page.IsHome)
{
  <ButtonBasic type="button" Variant="ButtonVariant.Outline" @onclick="() => OnMakeHome.InvokeAsync(Page)">
    Make site home
  </ButtonBasic>
}
@if (CanBeBlog && !Page.IsBlog)
{
  <ButtonBasic type="button" Variant="ButtonVariant.Outline" @onclick="() => OnMakeBlog.InvokeAsync(Page)">
    Make blog home
  </ButtonBasic>
}
@if (CanBeCollections && !Page.IsCollections)
{
  <ButtonBasic type="button" Variant="ButtonVariant.Outline" @onclick="() => OnMakeCollections.InvokeAsync(Page)">
    Make @Wording.Collection.PluralInSentence home
  </ButtonBasic>
}
