@page "/admin/website/pages/{PageId:int}/rows/{RowId:int}"
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.CustomPages
@using ArtistShop.Web.Components.Forms
@using ArtistShop.Web.Database
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Sites
@using ArtistShop.Web.Utilities
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = SitePolicies.Admin)]
@inject CustomPageRepository CustomPageRepository
@inject PageRowRepository PageRowRepository
@inject ThemeRepository ThemeRepository
@inject UploadedImageRepository UploadedImageRepository
@inject CollectionRepository CollectionRepository
@inject SlideRepository SlideRepository
@inject WorkRepository WorkRepository
@inject NavigationManager NavigationManager
@inject TimeProvider TimeProvider

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  [Parameter]
  public int PageId { get; set; }
  [Parameter]
  public int RowId { get; set; }

  // a new row's editor opens on adding a component to its slot
  [SupplyParameterFromQuery(Name = PageUrls.NewRowKey)]
  private bool IsNew { get; set; }

  [SupplyParameterFromForm(FormName = "row-settings")]
  private RowSettingsForm? Input { get; set; }

  private CustomPage? _page;
  private PageRow? _row;
  private IReadOnlyList<NamedTheme> _themes = [];
  // what the public pages show
  private NamedTheme? _themeShown;
  // why a save didn't go through: the row removed, or its theme or background image deleted, elsewhere
  private string? _saveError;
  // a saved background image as it is now, null when there's none
  private ImageComponentPicture? _picture;
  // what a slideshow can show the works of, and the ones a visitor would see anything in, read only while it shows one
  private IReadOnlyList<Collection> _collections = [];
  private IReadOnlySet<CollectionId> _visibleCollectionIds = new HashSet<CollectionId>();
  // a slideshow's chosen slides, read only while it shows them
  private List<SlideListItem>? _slides;

  protected override async Task OnInitializedAsync()
  {
    _page = await CustomPageRepository.GetAsync(new CustomPageId(PageId));

    if (_page is null)
    {
      return;
    }

    _row = (await CustomPageRepository.GetLayoutAsync(_page.Id)).Row(new PageRowId(RowId));
    _themes = NamedTheme.ListOf(await ThemeRepository.GetAllAsync());
    _themeShown = await ThemeRepository.GetShownAsync();

    if (_row is not null)
    {
      Input ??= RowSettingsForm.From(_row.Settings);
    }

    if (_row?.Background is RowBackground.Image image)
    {
      _picture = await ImageComponentPicture.ReadAsync(image.Source, UploadedImageRepository, WorkRepository);
    }

    // for the collection's field and its check, both only while the form's slideshow shows one
    if (Input is { BackgroundType: RowBackgroundType.Slideshow, SlideSource: SlideSourceType.WorksInCollection })
    {
      _collections = await CollectionRepository.GetAllAsync();
      _visibleCollectionIds = (await CollectionRepository.GetVisibleWithCoversAsync()).Select(collection => collection.Id).ToHashSet();
    }

    if (_row?.Background is RowBackground.Slideshow { Source: SlideSource.ChosenSlides })
    {
      // a List built by ToList, as an island parameter is rebuilt from its runtime type
      _slides = (await SlideRepository.GetAsync(new SlideOwner.Row(_row.Id))).Select(slide => SlideListItem.From(slide, Wording)).ToList();
    }
  }

  private IReadOnlyList<string> ThemeChoices =>
    [RowSettingsForm.WebsiteTheme, .. _themes.Select(theme => theme.Key.QueryValue)];

  private string ThemeLabel(string? choice) =>
    _themes.SingleOrDefault(theme => theme.Key.QueryValue == choice)?.Name ?? "Website's theme";

  // the page colour of the theme the row is on, where a background colour starts
  private RgbColor PageColorOf(ThemeKey? key) =>
    ((key is null ? null : _themes.SingleOrDefault(theme => theme.Key == key)) ?? Unwrap.Value(_themeShown)).Theme.Colors.Resolve(ColorRole.Page);

  // the picker posts the form when it closes, as change fires
  private RenderFragment BackgroundColorInput(RowSettingsForm input) =>
    @<div class="mb-4">
      <InputText type="color" aria-label="Background colour" @bind-Value="input.BackgroundColor"
                 class="block h-10 w-14 cursor-pointer border border-rule bg-panel" />
      <ValidationMessage class="text-error" For="() => input.BackgroundColor" />
    </div>;

  private async Task SaveAsync()
  {
    if (_row is null || Input is null || !await Input.CheckAsync(UploadedImageRepository, WorkRepository, Wording, _collections))
    {
      return;
    }

    try
    {
      await PageRowRepository.SetSettingsAsync(_row.Id, Input.ToSettings(PageColorOf(Input.ThemeKey)));
    }
    catch (ChangedSincePageLoadException exception)
    {
      _saveError = exception.Message;
      return;
    }

    NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
    {
      [SavedAtQuery.Key] = SavedAtQuery.Value(TimeProvider.GetUtcNow()),
      [PageUrls.NewRowKey] = null,
    }));
  }
}

<PageTitle>Row</PageTitle>

<main>
  <AdminPanel>
    @if (_page is null)
    {
      <UpLink Class="mb-4" Href="@PageUrls.CustomPageList" Label="Pages" />
      <p>This page doesn't exist. It may have been deleted.</p>
    }
    else
    {
      <UpLink Class="mb-4" Href="@PageUrls.EditCustomPage(_page.Id)" Label="@_page.Name" />
      <h1 class="mb-4 text-xl">Row on @_page.Name</h1>

      @if (_row is not null && Input is not null)
      {
        @* every choice saves the moment it's made; the row's slots, below, are an island *@
        <EditForm EditContext="Input.EditContext" FormName="row-settings" OnValidSubmit="SaveAsync" Enhance class="mb-6">
          @if (_saveError is { } saveError)
          {
            <p class="mb-4 text-error">@saveError Reload the page.</p>
          }
          <SubmitOnChange>
            <RadioField Label="Height" @bind-Value="Input.Height" Values="Enum.GetValues<RowHeight>()" LabelOf="RowChoiceLabels.Of" />
            <RadioField Label="Width" @bind-Value="Input.ContentWidth" Values="Enum.GetValues<RowContentWidth>()" LabelOf="RowChoiceLabels.Of" />
            <RadioField Label="Top padding" @bind-Value="Input.TopPadding" Values="Enum.GetValues<RowVerticalPadding>()"
                        LabelOf="RowChoiceLabels.Of" />
            <RadioField Label="Bottom padding" @bind-Value="Input.BottomPadding" Values="Enum.GetValues<RowVerticalPadding>()"
                        LabelOf="RowChoiceLabels.Of" />
            <RadioField Label="Side padding" @bind-Value="Input.SidePadding" Values="Enum.GetValues<RowSidePadding>()"
                        LabelOf="RowChoiceLabels.Of" />
            <RadioField Label="Gap" @bind-Value="Input.Gap" Values="Enum.GetValues<RowGap>()" LabelOf="RowChoiceLabels.Of" />
            <RadioField Label="Theme" @bind-Value="Input.Theme" Values="ThemeChoices" LabelOf="ThemeLabel" />
            <RadioField Label="Background" @bind-Value="Input.BackgroundType" Values="Enum.GetValues<RowBackgroundType>()"
                        LabelOf="RowChoiceLabels.Of" />
            @if (Input.BackgroundType is RowBackgroundType.Color)
            {
              @BackgroundColorInput(Input)
            }
          </SubmitOnChange>
          @* outside SubmitOnChange: its file input's change starts an upload, which posts the form itself *@
          @if (Input.BackgroundType is RowBackgroundType.Image)
          {
            <ImageSourceField StorageKey="@Input.ImageStorageKey" WorkId="Input.ImageWorkId"
                              StorageKeyExpression="() => Input.ImageStorageKey" Picture="_picture"
                              IsFullBleed />
          }
          @if (Input.BackgroundType is RowBackgroundType.Slideshow)
          {
            <SubmitOnChange>
              <RadioField Label="Shows" @bind-Value="Input.SlideSource" Values="Enum.GetValues<SlideSourceType>()"
                          LabelOf="source => SlideChoiceLabels.Of(source, Wording)" />
            </SubmitOnChange>
            @if (Input.SlideSource is SlideSourceType.WorksInCollection)
            {
              <CollectionChoiceField @bind-Value="Input.CollectionId" Collections="_collections"
                                     VisibleCollectionIds="_visibleCollectionIds" ShownIn="the slideshow" />
            }
          }
          <SubmitOnChange>
            @if (Input.BackgroundType is RowBackgroundType.Slideshow)
            {
              <RadioField Label="Each image shows" @bind-Value="Input.SlideInterval" Values="Enum.GetValues<SlideshowInterval>()"
                          LabelOf="SlideChoiceLabels.Of" />
            }
            @if (Input.BackgroundType is RowBackgroundType.Image or RowBackgroundType.Slideshow)
            {
              <RadioField Label="Fit" @bind-Value="Input.BackgroundFit" Values="Enum.GetValues<ImageFit>()" LabelOf="fit => fit.ToString()" />
              <RadioField TValue="bool?" Label="@(Input.BackgroundType is RowBackgroundType.Slideshow ? "Behind the images" : "Behind the image")"
                          @bind-Value="Input.HasColorBehindImage" Values="[false, true]"
                          LabelOf="@(hasColor => hasColor is true ? "A colour" : "Page colour")" />
              @if (Input.HasColorBehindImage is true)
              {
                @BackgroundColorInput(Input)
              }
            }
            @* app.css hides this unless the browser runs no scripts *@
            <ButtonBasic type="submit" Variant="ButtonVariant.Outline" data-part="apply">Save</ButtonBasic>
          </SubmitOnChange>
        </EditForm>

        @if (_slides is not null)
        {
          <ChosenSlidesField Owner="new SlideOwner.Row(_row.Id)" Items="_slides" />
        }
      }

      @* SettingsStamp tells the island, whose preview draws the settings, to read the row again after a save *@
      <RowEditor @rendermode="InteractiveServer" @key="RowId" Page="_page" RowId="new PageRowId(RowId)" IsNew="IsNew"
                 SettingsStamp="@(_row?.Settings.ToString() ?? "")" />
    }
  </AdminPanel>
</main>
