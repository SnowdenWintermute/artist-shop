@* An image component's picture on its settings page, or a row background's: the chosen one, or why it shows
   nothing, and the buttons choosing another, which post the form at once, as a select there saves on change *@
@using System.Globalization
@using System.Linq.Expressions
@using ArtistShop.Web.Components.Catalog
@using ArtistShop.Web.Components.CustomPages
@using ArtistShop.Web.Components.Hints
@using ArtistShop.Web.Domain.Platform
@using ArtistShop.Web.Images

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  [Parameter, EditorRequired]
  public string? StorageKey { get; set; }

  [Parameter, EditorRequired]
  public int? WorkId { get; set; }

  [Parameter, EditorRequired]
  public Expression<Func<string?>> StorageKeyExpression { get; set; } = default!;

  // the saved source as it is now, null when none is chosen
  [Parameter, EditorRequired]
  public ImageComponentPicture? Picture { get; set; }

  // whether the picture is shown edge to edge, where it loads a larger size than a work's page shows
  [Parameter, EditorRequired]
  public bool IsFullBleed { get; set; }

  // only a work's image has a page
  private bool IsWorkImageShownWider =>
    IsFullBleed && Picture is ImageComponentPicture.Shown { ArtworkPageUrl: not null, Image: var image }
    && ImageVariants.FullBleedWidthFor(image.Width) is not null;
}

<div class="mb-4">
  <span class="artist-shop-field-label">Image</span>
  @switch (Picture)
  {
    case ImageComponentPicture.Shown shown:
      <div class="mb-2 flex items-center gap-3">
        <TileImage Image="shown.Image" BoxClass="size-20" MaximumWidth="ImageVariants.AdminThumbnailWidth" Sizes="5rem" />
        <span class="truncate">@shown.Name</span>
      </div>
      @if (IsWorkImageShownWider)
      {
        <Hint Type="HintType.FullBleedWorkImages" Class="mb-2">
          <p>Shown up to @ImageVariants.FullBleedWidth.ToString(CultureInfo.InvariantCulture) pixels wide here, larger than its
            @Wording.Work.SingularInSentence page shows it.</p>
        </Hint>
      }
      break;
    case ImageComponentPicture.Missing missing:
      <p class="mb-2 text-error">@MissingImageText.Of(missing.Reason, Wording)</p>
      break;
    default:
      <p class="mb-2">No image chosen yet.</p>
      break;
  }
  <ImagePickerButtons StorageKeyName="Input.ImageStorageKey" WorkIdName="Input.ImageWorkId" StorageKey="@StorageKey"
                      WorkId="WorkId" />
  <ValidationMessage class="text-error" For="StorageKeyExpression" />
</div>
