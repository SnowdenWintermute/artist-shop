@* An image component's picture on its settings page: the chosen one, or why it shows nothing, and the
   buttons opening the image library's picker and the work picker. <image-source-field>, defined in
   ImageSourceField.razor.js, puts the picked or uploaded image in the hidden fields and posts the form,
   as a select there saves on change *@
@using System.Globalization
@using System.Linq.Expressions
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Catalog
@using ArtistShop.Web.Components.CustomPages
@using ArtistShop.Web.Components.Hints
@using ArtistShop.Web.Domain.Platform
@using ArtistShop.Web.Components.Pages.Admin.Publishing.Images.ImagePicker
@using ArtistShop.Web.Components.Pages.Admin.Catalog.WorkPicker
@using ArtistShop.Web.Images

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  [Parameter, EditorRequired]
  public string? StorageKey { get; set; }

  [Parameter, EditorRequired]
  public int? WorkId { get; set; }

  [Parameter, EditorRequired]
  public Expression<Func<string?>> StorageKeyExpression { get; set; } = default!;

  // the saved source as it is now, null when none is chosen
  [Parameter, EditorRequired]
  public ImageComponentPicture? Picture { get; set; }

  // whether the picture is shown edge to edge, where it loads a larger size than a work's page shows
  [Parameter, EditorRequired]
  public bool IsFullBleed { get; set; }

  // only a work's image has a page
  private bool IsWorkImageShownWider =>
    IsFullBleed && Picture is ImageComponentPicture.Shown { ArtworkPageUrl: not null, Image: var image }
    && ImageVariants.FullBleedWidthFor(image.Width) is not null;
}

<image-source-field class="mb-4 block" data-upload-url="@ImageUploadEndpoints.LibraryImageUploadPath">
  <span class="artist-shop-field-label">Image</span>
  @switch (Picture)
  {
    case ImageComponentPicture.Shown shown:
      <div class="mb-2 flex items-center gap-3">
        <TileImage Image="shown.Image" BoxClass="size-20" MaximumWidth="ImageVariants.AdminThumbnailWidth" Sizes="5rem" />
        <span class="truncate">@shown.Name</span>
      </div>
      @if (IsWorkImageShownWider)
      {
        <Hint Type="HintType.FullBleedWorkImages" Class="mb-2">
          <p>Shown up to @ImageVariants.FullBleedWidth.ToString(CultureInfo.InvariantCulture) pixels wide here, larger than its
            @Wording.Work.SingularInSentence page shows it.</p>
        </Hint>
      }
      break;
    case ImageComponentPicture.Missing missing:
      <p class="mb-2 text-error">@MissingImageText.Of(missing.Reason, Wording)</p>
      break;
    default:
      <p class="mb-2">No image chosen yet.</p>
      break;
  }
  <input type="hidden" name="Input.ImageStorageKey" value="@StorageKey" data-part="storage-key" />
  <input type="hidden" name="Input.ImageWorkId" value="@WorkId?.ToString(CultureInfo.InvariantCulture)" data-part="work-id" />
  <input type="file" accept="@ImageUploadValidation.FileInputAccept" hidden data-part="image-file" />
  <div class="flex flex-wrap gap-2">
    <ButtonBasic type="button" Variant="ButtonVariant.Outline" data-action="choose-library-image">
      Choose from the image library
    </ButtonBasic>
    <ButtonBasic type="button" Variant="ButtonVariant.Outline" data-action="choose-work-image">
      Choose @Wording.Work.SingularInSentence
    </ButtonBasic>
  </div>
  <p class="text-sm" role="status" data-part="upload-status"></p>
  <ValidationMessage class="text-error" For="StorageKeyExpression" />
  <ImagePickerDialog />
  <WorkPickerDialog />
</image-source-field>
