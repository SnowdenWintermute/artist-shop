@* A chosen list of slides: drag to reorder, ✕ to take one off. Both save at once *@
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Lists
@using ArtistShop.Web.Components.Pages.Admin.Website.CustomPages.Workspace
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Utilities
@inject SlideRepository SlideRepository

@code {
  // the owner, one of the two, as an island's parameters can't be SlideOwner's abstract type
  [Parameter, EditorRequired]
  public required CustomComponentId? ComponentId { get; set; }
  [Parameter, EditorRequired]
  public required PageRowId? RowId { get; set; }

  [Parameter, EditorRequired]
  public required IReadOnlyList<SlideListItem> Items { get; set; }

  private SlideOwner Owner =>
    ComponentId is { } componentId ? new SlideOwner.Component(componentId) : new SlideOwner.Row(Unwrap.Value(RowId));

  // each save reloads the page preview
  private int _saveCount;

  private Task ReorderAsync(IReadOnlyList<SlideListItem> items) => SavedAsync(SlideRepository.ReorderAsync(Owner, [.. items.Select(item => item.Id)]));

  private Task RemoveAsync(SlideListItem item) => SavedAsync(SlideRepository.RemoveAsync(Owner, item.Id));

  private async Task SavedAsync(Task save)
  {
    await save;
    _saveCount++;
    StateHasChanged();
  }
}

<PreviewReload Stamp="_saveCount" />
<SavingSortableList TItem="SlideListItem" Items="Items" AriaLabel="Slide order" Reorder="ReorderAsync" Remove="RemoveAsync"
                    NameOf="item => item.Name">
  <Header Context="count">
    <p class="mb-2 text-sm">@(count == 0 ? "No slides yet." : CountText.Of(count, "slide"))</p>
  </Header>
  <RowContent Context="item">
    <WorkThumbnail Image="item.Image" />
    <div class="@(item.IsMissing ? "grow text-sm text-error" : "grow")">@item.Name</div>
  </RowContent>
</SavingSortableList>
