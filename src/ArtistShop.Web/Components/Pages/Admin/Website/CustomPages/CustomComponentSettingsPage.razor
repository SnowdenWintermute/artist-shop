@page "/admin/website/components/{Id:int}"
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.CustomPages
@using ArtistShop.Web.Components.Dialogs
@using ArtistShop.Web.Components.Forms
@using ArtistShop.Web.Components.Pages.Admin.TextEditor
@using ArtistShop.Web.Database
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Images
@using ArtistShop.Web.Sites
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = SitePolicies.Admin)]
@inject CustomComponentRepository CustomComponentRepository
@inject CustomPageRepository CustomPageRepository
@inject CollectionRepository CollectionRepository
@inject CardGridChosenCardRepository CardGridChosenCardRepository
@inject ImageStorage ImageStorage
@inject NavigationManager NavigationManager
@inject TimeProvider TimeProvider

@code {
  private const string DeleteDialogId = "delete-custom-component";

  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  [Parameter]
  public int Id { get; set; }

  // the row editor this was opened from, which Up goes back to and the preview shows
  [SupplyParameterFromQuery(Name = PageUrls.ComponentPageKey)]
  private int? FromPageId { get; set; }
  [SupplyParameterFromQuery(Name = PageUrls.ComponentRowKey)]
  private int? FromRowId { get; set; }

  [SupplyParameterFromForm(FormName = "custom-component")]
  private CustomComponentForm? Input { get; set; }

  private CustomComponentInUse? _component;
  private CustomPage? _fromPage;
  // a successful save redirects, so a page rendered from a post is one that didn't go through
  private bool _formWasPosted;
  private bool _deletedElsewhere;
  private bool _isBlogPagesOnlyPostList;
  // a card grid's to choose from, and the ones a visitor would see anything in
  private IReadOnlyList<Collection> _collections = [];
  private IReadOnlySet<CollectionId> _visibleCollectionIds = new HashSet<CollectionId>();
  // a card grid's custom list, read only while it shows it
  private List<ChosenCardListItem>? _chosenCards;

  private CustomComponentId ComponentId => new(Id);

  private string DocumentKey => $"component-{Id}";

  protected override async Task OnInitializedAsync()
  {
    _formWasPosted = Input is not null;
    _component = await CustomComponentRepository.GetAsync(ComponentId);

    if (FromPageId is int pageId)
    {
      _fromPage = await CustomPageRepository.GetAsync(new CustomPageId(pageId));
    }

    if (_component is not null)
    {
      Input ??= CustomComponentForm.From(_component.Component);
      _isBlogPagesOnlyPostList = await CustomComponentRepository.IsBlogPagesOnlyPostListAsync(ComponentId);
    }

    if (_component?.Component.Settings is CardGridSettings)
    {
      _collections = await CollectionRepository.GetAllAsync();
      _visibleCollectionIds = (await CollectionRepository.GetVisibleWithCoversAsync()).Select(collection =>
collection.Id).ToHashSet();
    }

    if (_component?.Component.Settings is CardGridSettings { Source: CardGridSource.ChosenCards })
    {
      // a List built by ToList, not a collection expression's generated type, as an island parameter is rebuilt
      // from its runtime type
      _chosenCards = (await CardGridChosenCardRepository.GetAsync(ComponentId)).Select(ChosenCardListItem.From).ToList();
    }
  }

  private async Task SaveAsync()
  {
    if (_component is null || Input is null || !Input.CheckBody(ImageStorage, _component.Component.Settings)
        || !Input.CheckCardGrid(_component.Component.Settings, _collections))
    {
      return;
    }

    try
    {
      await CustomComponentRepository.UpdateAsync(ComponentId, Input.ToName(),
Input.ToSettings(_component.Component.Settings));
    }
    catch (NameAlreadyInUseException)
    {
      Input.AddNameTakenError();
      return;
    }
    catch (ChangedSincePageLoadException)
    {
      _deletedElsewhere = true;
      return;
    }

    NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
    { [SavedAtQuery.Key] = SavedAtQuery.Value(TimeProvider.GetUtcNow()) }));
  }

  private async Task DeleteAsync()
  {
    try
    {
      await CustomComponentRepository.DeleteAsync(ComponentId);
    }
    catch (BlogPageNeedsPostListException)
    {
      // the other post list was taken off the blog page meanwhile
      _isBlogPagesOnlyPostList = true;
      return;
    }

    NavigationManager.NavigateTo(UpHref);
  }

  // the row editor this was opened from, or the Pages list
  private string UpHref =>
    _fromPage is not null && FromRowId is int rowId ? PageUrls.EditPageRow(_fromPage.Id, new PageRowId(rowId)) :
PageUrls.CustomPageList;

  // what Automatic would say, so the choice shows it
  private string AutomaticLabel(CardGridSourceType source) =>
    source switch
    {
      CardGridSourceType.AllCollections => $"Automatic ({Wording.Collection.PluralHeading})",
      CardGridSourceType.WorksInCollection => $"Automatic (the {Wording.Collection.SingularInSentence}'s name)",
      CardGridSourceType.CollectionsAndLooseWorks => $"Automatic ({Wording.Work.PluralHeading})",
      // a source a post left out, which the form refuses; a custom list doesn't offer it
      _ => "Automatic",
    };

  // a chosen collection that's gone, or that a visitor would find empty
  private string? ChosenCollectionProblem(CustomComponentForm input) =>
    input.Source is not CardGridSourceType.WorksInCollection || input.CollectionId is not int id ? null
      : _collections.All(collection => collection.Id.Value != id) ? $"The {Wording.Collection.SingularInSentence} it showed was deleted."
      : !_visibleCollectionIds.Contains(new CollectionId(id)) ? "None of its works has an image, so the grid is empty."
      : null;

  private static string DeleteWarning(CustomComponentInUse component) =>
    component.PageNames.Count == 0
      ? "It isn't on any page."
      : $"It will be taken off {string.Join(", ", component.PageNames.Order(StringComparer.CurrentCultureIgnoreCase))}.";

  // the pages besides the one this was opened from, which share every change
  private IReadOnlyList<string> AlsoOn(CustomComponentInUse component) =>
    [.. component.PageNames.Where(name => name != _fromPage?.Name).Order(StringComparer.CurrentCultureIgnoreCase)];
}

<PageTitle>@(_component?.Component.Name ?? "Component")</PageTitle>

<main>
  <AdminPanel>
    <FormTopBar>
      @if (_fromPage is not null && FromRowId is int rowId)
      {
        <UpLink Href="@PageUrls.EditPageRow(_fromPage.Id, new PageRowId(rowId))" Label="@($"Row on {_fromPage.Name}")" />
      }
      else
      {
        <UpLink Href="@PageUrls.CustomPageList" Label="Pages" />
      }
    </FormTopBar>
    <SavedAtNotice HoldsUnsavedChanges="_formWasPosted" />

    @if (_component is null || Input is null)
    {
      <p>This component doesn't exist. It may have been deleted.</p>
    }
    else
    {
      var component = _component;

      <div class="mb-1 flex flex-wrap items-baseline justify-between gap-4">
        <h1 class="text-xl">@component.Component.Name</h1>
        @if (!_isBlogPagesOnlyPostList)
        {
          <ButtonBasic type="button" Variant="ButtonVariant.DangerOutline" data-opens-dialog="@DeleteDialogId">
            Delete component
          </ButtonBasic>
        }
      </div>
      <p class="mb-4 text-sm text-ink-faded">@CustomComponentNames.Of(component.Component.Settings.Type, Wording)</p>

      @if (_isBlogPagesOnlyPostList)
      {
        <p class="mb-4">This is the blog page's post list, so it can't be deleted. Make another page the blog page first.
        </p>
      }

      @if (AlsoOn(component) is { Count: > 0 } alsoOn)
      {
        <p class="mb-4">Also used in: @string.Join(", ", alsoOn)</p>
      }

      @if (_deletedElsewhere)
      {
        <p class="mb-4 text-error">This component was deleted somewhere else, so nothing was saved.</p>
      }

      @if (component.Component.Settings is TextSettings)
      {
        <RichTextBackup BackupKey="@DocumentKey" SavedAt="component.UpdatedAt" Noun="component" TitleField="Input.Name"
                        BodyField="Input.Body" HoldsUnsavedChanges="_formWasPosted">
          <ComponentSettingsForm Input="Input" OnSave="SaveAsync" HoldsUnsavedChanges="_formWasPosted">
            @* the post's column whatever the width, since rebuilding the editor at a new width jumps the page *@
            <RichTextEditor Label="Text" DocumentKey="@DocumentKey" @bind-Value="Input.Body" />
            @* saves as soon as it changes, with the rest of the form *@
            <SubmitOnChange>
              <SelectField Label="Width" @bind-Value="Input.Width">
                <option value="@TextWidth.Narrow">Narrow</option>
                <option value="@TextWidth.Full">Full width</option>
              </SelectField>
            </SubmitOnChange>
          </ComponentSettingsForm>
        </RichTextBackup>
      }
      else if (component.Component.Settings is CardGridSettings)
      {
        <ComponentSettingsForm Input="Input" OnSave="SaveAsync" HoldsUnsavedChanges="_formWasPosted">
          @* each select saves as soon as it changes, so the fields it brings in appear *@
          <SubmitOnChange>
            <SelectField Label="Shows" @bind-Value="Input.Source">
              <option value="@CardGridSourceType.AllCollections">All @Wording.Collection.PluralInSentence</option>
              <option value="@CardGridSourceType.WorksInCollection">
                @Wording.Work.PluralHeading in one @Wording.Collection.SingularInSentence
              </option>
              <option value="@CardGridSourceType.CollectionsAndLooseWorks">
                All @Wording.Collection.PluralInSentence, then @Wording.Work.PluralInSentence in none
              </option>
              <option value="@CardGridSourceType.ChosenCards">Custom list</option>
            </SelectField>
          </SubmitOnChange>

          @if (Input.Source is CardGridSourceType.WorksInCollection)
          {
            @if (ChosenCollectionProblem(Input) is { } problem)
            {
              <p class="mb-2 text-sm text-error">@problem</p>
            }
            <SubmitOnChange>
              <SelectField Label="@Wording.Collection.SingularHeading" @bind-Value="Input.CollectionId">
                <option value="">Choose…</option>
                @foreach (var collection in _collections)
                {
                  <option @key="collection.Id" value="@collection.Id.Value">@collection.Name.Value</option>
                }
              </SelectField>
            </SubmitOnChange>
          }

          <SubmitOnChange>
            <SelectField Label="Heading" @bind-Value="Input.HeadingType">
              <option value="@CardGridHeadingType.None">None</option>
              @if (Input.Source is not CardGridSourceType.ChosenCards)
              {
                <option value="@CardGridHeadingType.Automatic">@AutomaticLabel(Input.Source)</option>
              }
              <option value="@CardGridHeadingType.Custom">Custom</option>
            </SelectField>
          </SubmitOnChange>

          @if (Input.HeadingType is CardGridHeadingType.Custom)
          {
            <TextField Label="Heading text" @bind-Value="Input.HeadingText" />
          }

          <NumberField Label="Cards per page" @bind-Value="Input.CardsPerPage" />
          <SubmitOnChange>
            <CheckboxField Label="Page links" Hint="Show buttons for next/previous page in the grid."
                           @bind-Value="Input.HasPageLinks" />
          </SubmitOnChange>
          <SubmitOnChange>
            <CardGridLayoutField @bind-Value="Input.Layout" />
          </SubmitOnChange>
        </ComponentSettingsForm>

        @if (_chosenCards is not null)
        {
          <h2 class="mb-2 text-lg">Custom list</h2>
          <div class="mb-8">
            <ChosenCardList @rendermode="InteractiveServer" @key="Id" ComponentId="ComponentId"
                            Origin="CustomComponentOrigin.Of(FromPageId, FromRowId)" Items="_chosenCards" />
          </div>
        }
      }
      else
      {
        <ComponentSettingsForm Input="Input" OnSave="SaveAsync" HoldsUnsavedChanges="_formWasPosted" />
      }

      @if (_fromPage is not null && FromRowId is int previewRowId)
      {
        <h2 class="mb-2 text-lg">Preview</h2>
        <SavedRowPreview Page="_fromPage" RowId="new PageRowId(previewRowId)" />
      }

      @if (!_isBlogPagesOnlyPostList)
      {
        <ConfirmFormDialog Id="@DeleteDialogId" Title="@($"Delete {component.Component.Name}?")" ConfirmLabel="Delete"
                           OnConfirm="DeleteAsync">
          @DeleteWarning(component)
        </ConfirmFormDialog>
      }
    }
  </AdminPanel>
</main>
