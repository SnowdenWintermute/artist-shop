@* Adding a component to a slot: a new one from a starter, or one already made. Rendered only while open,
   so each opening reads the library afresh *@
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.CustomPages
@using ArtistShop.Web.Components.Dialogs
@using ArtistShop.Web.Database.Repositories
@inject CustomComponentRepository CustomComponentRepository

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  // what the slot holds already
  [Parameter, EditorRequired]
  public required IReadOnlyList<CustomComponentId> InSlot { get; set; }
  [Parameter, EditorRequired]
  public bool IsSaving { get; set; }
  [Parameter, EditorRequired]
  public EventCallback<CustomComponentStarter> OnNew { get; set; }
  [Parameter, EditorRequired]
  public EventCallback<CustomComponent> OnExisting { get; set; }
  [Parameter, EditorRequired]
  public EventCallback OnClose { get; set; }

  // the ones not in this slot already, by type then name
  private List<CustomComponentInUse>? _made;

  protected override async Task OnInitializedAsync() =>
    _made =
    [
      .. (await CustomComponentRepository.GetAllAsync())
        .Where(made => !InSlot.Contains(made.Component.Id))
        .OrderBy(made => CustomComponentNames.Of(made.Component.Settings.Type, Wording), StringComparer.CurrentCultureIgnoreCase)
        .ThenBy(made => made.Component.Name, StringComparer.CurrentCultureIgnoreCase),
    ];
}

<ModalDialog Title="Add a component" Width="ModalDialogWidth.Narrow" OnClose="OnClose" KeepOpen="IsSaving">
  <h3 class="mb-2 shrink-0 font-bold">New</h3>
  <div class="mb-6 flex shrink-0 flex-wrap gap-2">
    @foreach (var starter in Enum.GetValues<CustomComponentStarter>())
    {
      <ButtonBasic type="button" Variant="ButtonVariant.Outline" disabled="@IsSaving" @onclick="() => OnNew.InvokeAsync(starter)">
        @CustomComponentNames.Of(starter, Wording)
      </ButtonBasic>
    }
  </div>

  @if (_made is { Count: > 0 } made)
  {
    <h3 class="mb-2 shrink-0 font-bold">One you've made</h3>
    @* a long library scrolls, so Cancel stays on screen. The padding keeps a focused button's outline
       inside the scrolling box, which clips it; the negative margin keeps the list lined up *@
    <ul class="-mx-1 mb-6 min-h-0 overflow-y-auto px-1">
      @foreach (var component in made)
      {
        <li @key="component.Component.Id" class="mb-2">
          <button type="button" class="w-full cursor-pointer border p-2 text-left" disabled="@IsSaving"
                  @onclick="() => OnExisting.InvokeAsync(component.Component)">
            <span class="block">@component.Component.Name</span>
            <span class="block text-sm text-ink-faded">
              @CustomComponentNames.Of(component.Component.Settings.Type, Wording). @CustomComponentPagesText.WhereItIs(component)
            </span>
          </button>
        </li>
      }
    </ul>
  }

  <ModalDialogActions>
    <ModalCloseButton Label="Cancel" Disabled="IsSaving" />
  </ModalDialogActions>
</ModalDialog>
