@* A link's work: the one chosen, and the button choosing another in the work picker. <link-work-picker>, defined in
   LinkWorkPicker.razor.js, puts the chosen work in the hidden field and posts the form it's in *@
@using System.Globalization
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Pages.Admin.Catalog.WorkPicker

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  // the hidden field's name, and what it holds now
  [Parameter, EditorRequired]
  public required string WorkIdName { get; set; }
  [Parameter, EditorRequired]
  public required int? WorkId { get; set; }

  // the chosen work's, null for none, or one deleted meanwhile
  [Parameter, EditorRequired]
  public required string? WorkName { get; set; }
}

<link-work-picker class="mb-4 block">
  <input type="hidden" name="@WorkIdName" value="@WorkId?.ToString(CultureInfo.InvariantCulture)" data-part="work-id" />
  <p class="mb-2">@(WorkName ?? $"No {Wording.Work.SingularInSentence} chosen yet.")</p>
  <ButtonBasic type="button" Variant="ButtonVariant.Outline" data-action="choose-work">
    Choose @Wording.Work.SingularInSentence
  </ButtonBasic>
  <WorkPickerDialog />
</link-work-picker>
