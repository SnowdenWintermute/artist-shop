@page "/admin/website/pages"
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Hints
@using ArtistShop.Web.Domain.Platform
@using ArtistShop.Web.Sites
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = SitePolicies.Admin)]

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;
}

<PageTitle>Pages</PageTitle>

<main>
  <AdminPanel>
    <AdminUpLink />
    <h1 class="mb-4 text-xl">Pages</h1>

    <Hint Type="HintType.CustomPages">
      <p class="mb-4">A page is a stack of rows. A row has up to three slots side by side, and each slot holds
        components, one
        above the other.</p>
        <p>Setting a page as <span class="font-bold">site home</span> means the site's brand text/logo links to it.
          Setting
          a page as
          <span class="font-bold">blog home</span> means the blog posts link back to it, and
          <span class="font-bold">@Wording.Collection.PluralInSentence home</span> means each
          @Wording.Collection.SingularInSentence links back to it.
        </p>
      </Hint>

      <AddCustomPageForm />

      <CustomPageNavLists @rendermode="InteractiveServer" />
      <FixedPageList />
    </AdminPanel>
  </main>
