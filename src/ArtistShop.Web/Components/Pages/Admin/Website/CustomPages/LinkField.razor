@* Where a component links: one of the website's pages, works, collections or posts, or an address. Choosing a
   page, collection or post saves at once, as the types' choices do, starting at the first one
   (CustomComponentForm.ChooseDefaultLink). Choosing Work opens the work picker, and the type changes only once
   a work is picked; choosing Address shows its field, saved with Save. <link-field>, defined in
   LinkField.razor.js, does both. Collection and Post are offered only when there's one to link to *@
@using System.Globalization
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Forms
@using ArtistShop.Web.Components.Pages.Admin.Catalog.WorkPicker
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Domain.Publishing

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  [Parameter, EditorRequired]
  public required CustomComponentForm Input { get; set; }

  // a heading may link nowhere; a button, or an image set to link here, must link somewhere
  [Parameter, EditorRequired]
  public required bool IsOptional { get; set; }

  [Parameter, EditorRequired]
  public required IReadOnlyList<CustomPage> Pages { get; set; }
  [Parameter, EditorRequired]
  public required IReadOnlyList<Collection> Collections { get; set; }
  [Parameter, EditorRequired]
  public required IReadOnlyList<PostSummary> Posts { get; set; }

  // the chosen work's name, null for none, or one deleted meanwhile
  [Parameter, EditorRequired]
  public required string? WorkName { get; set; }

  private LinkTargetInput LinkTo => Input.LinkTo;

  private IReadOnlyList<(string Value, string Label)> Choices =>
    [
      .. IsOptional ? [("", "No link")] : Array.Empty<(string, string)>(),
      .. Enum.GetValues<LinkTargetType>().Where(IsOffered).Select(type => (type.ToString(), Label(type))),
    ];

  private bool IsOffered(LinkTargetType type) =>
    type switch
    {
      LinkTargetType.Collection => Collections.Count > 0,
      LinkTargetType.Post => Posts.Count > 0,
      _ => true,
    };

  private string Label(LinkTargetType type) =>
    type switch
    {
      LinkTargetType.Page => "Page",
      LinkTargetType.Work => Wording.Work.SingularHeading,
      LinkTargetType.Collection => Wording.Collection.SingularHeading,
      LinkTargetType.Post => "Post",
      LinkTargetType.Address => "Address",
      _ => throw new InvalidOperationException($"{type} has no label."),
    };

  private static string PostLabel(PostSummary post) => post.PublishedAt is null ? $"{post.Title.Value} (draft)" : post.Title.Value;
}

<link-field class="group/link block">
  <SubmitOnChange>
    <NativeRadioField Label="@(IsOptional ? "Link" : "Link to")" Name="Input.LinkTo.Type" Choices="Choices"
                      Chosen="@(LinkTo.Type?.ToString() ?? "")" />

    @switch (LinkTo.Type)
    {
      case LinkTargetType.Page:
        <SelectField Label="Links to" @bind-Value="Input.LinkTo.PageId">
          @foreach (var customPage in Pages)
          {
            <option value="@customPage.Id.Value.ToString(CultureInfo.InvariantCulture)">@customPage.Name</option>
          }
        </SelectField>
        break;
      case LinkTargetType.Collection:
        <SelectField Label="Links to" @bind-Value="Input.LinkTo.CollectionId">
          @foreach (var collection in Collections)
          {
            <option value="@collection.Id.Value.ToString(CultureInfo.InvariantCulture)">@collection.Name.Value</option>
          }
        </SelectField>
        break;
      case LinkTargetType.Post:
        <SelectField Label="Links to" @bind-Value="Input.LinkTo.PostId">
          @foreach (var post in Posts)
          {
            <option value="@post.Id.Value.ToString(CultureInfo.InvariantCulture)">@PostLabel(post)</option>
          }
        </SelectField>
        break;
    }
  </SubmitOnChange>

  @* drawn whatever the type, for the picker to fill when Work is chosen *@
  <input type="hidden" name="Input.LinkTo.WorkId" value="@LinkTo.WorkId?.ToString(CultureInfo.InvariantCulture)"
         data-part="work-id" />
  @if (LinkTo.Type is LinkTargetType.Work)
  {
    <div class="mb-4">
      <p class="mb-2">@(WorkName ?? $"No {Wording.Work.SingularInSentence} chosen yet.")</p>
      <ButtonBasic type="button" Variant="ButtonVariant.Outline" data-action="choose-work">
        Choose @Wording.Work.SingularInSentence
      </ButtonBasic>
    </div>
  }
  <WorkPickerDialog />

  @* drawn whatever the type and shown while Address is checked, so choosing it needs no save first *@
  <div class="hidden group-has-[input[value=Address]:checked]/link:block">
    <TextFieldWithButton Label="Address" @bind-Value="Input.LinkTo.Address" placeholder="https://example.com" autocomplete="off">
      <ButtonBasic type="submit" Variant="ButtonVariant.Primary" data-waits-for-change>Save</ButtonBasic>
    </TextFieldWithButton>
  </div>
  <ValidationMessage For="() => Input.LinkTo" class="mb-4 block text-error" />
</link-field>
