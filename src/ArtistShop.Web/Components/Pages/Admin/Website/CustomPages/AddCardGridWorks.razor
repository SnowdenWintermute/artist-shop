@page "/admin/website/components/{Id:int}/add-works"
@inherits AddToCardGridPage
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Pages.Admin.Catalog.Works
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Sites
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = SitePolicies.Admin)]
@inject CardGridChosenCardRepository CardGridChosenCardRepository

@code {
  private const string AddFormName = "add-card-grid-works";

  private WorkListSelection Selection => new(PageUrls.AddCheckedKey, [.. CheckedIdValues.Select(id => new WorkId(id))]);

  protected override Task AddCheckedAsync() => CardGridChosenCardRepository.AddWorksAsync(ComponentId, Selection.Ids);
}

<main>
  <AdminPanel>
    @if (Grid is null)
    {
      <AddMissingTarget Title="@($"Add {Wording.Work.PluralInSentence}")" UpHref="@PageUrls.CustomPageList" UpLabel="Pages"
                        Message="@MissingMessage" FormName="@AddFormName" OnAdd="AddAsync" />
    }
    else
    {
      <AddCheckedShell Title="@($"Add {Wording.Work.PluralInSentence} to {Grid.Name}")"
                       UpHref="@PageUrls.EditCustomComponent(ComponentId, Origin)" UpLabel="@Grid.Name" FormName="@AddFormName"
                       CheckedCount="Selection.Ids.Count" OnAdd="AddAsync">
        @* only works not on the list yet. A row's title is text, since this page is for checking works, not
           opening them *@
        <WorkListBrowser RowHref="_ => null" ClearFiltersHref="@PageUrls.AddCardGridWorks(ComponentId, Origin, Selection.Ids)"
                         KeptFields="PageUrls.OriginFields(Origin)" Exclusion="new WorkListExclusion.OnCardGrid(ComponentId)"
                         Selection="Selection" />
      </AddCheckedShell>
    }
  </AdminPanel>
</main>
