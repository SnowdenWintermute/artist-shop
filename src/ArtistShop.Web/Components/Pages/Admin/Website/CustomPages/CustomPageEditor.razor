@page "/admin/website/pages/{Id:int}"
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Dialogs
@using ArtistShop.Web.Components.Forms
@using ArtistShop.Web.Components.Pages.Admin.Website.CustomPages.Workspace
@using ArtistShop.Web.Database
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Sites
@using ArtistShop.Web.Utilities
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = SitePolicies.Admin)]
@inject CustomPageRepository CustomPageRepository
@inject OwnAddresses OwnAddresses
@inject NavigationManager NavigationManager
@inject TimeProvider TimeProvider

@code {
  private const string DeleteDialogId = "delete-custom-page";

  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  [Parameter]
  public int Id { get; set; }

  [SupplyParameterFromForm(FormName = "custom-page-details")]
  private CustomPageDetailsForm? Input { get; set; }

  private CustomPage? _page;
  // a successful save redirects, so a page rendered from a post is one that didn't go through
  private bool _formWasPosted;
  private bool _changedElsewhere;

  private CustomPageId PageId => new(Id);

  protected override async Task OnInitializedAsync()
  {
    _page = await CustomPageRepository.GetAsync(PageId);
    _formWasPosted = Input is not null;

    if (_page is not null)
    {
      Input ??= CustomPageDetailsForm.From(_page);
    }
  }

  private async Task SaveAsync()
  {
    try
    {
      if (await Unwrap.Value(Input).SaveAsync(PageId, CustomPageRepository, OwnAddresses))
      {
        NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
        { [SavedAtQuery.Key] = SavedAtQuery.Value(TimeProvider.GetUtcNow()) }));
      }
    }
    catch (ChangedSincePageLoadException)
    {
      _page = null;
    }
  }

  private async Task DeleteAsync()
  {
    try
    {
      await CustomPageRepository.DeleteAsync(PageId);
      NavigationManager.NavigateTo(PageUrls.CustomPageList);
    }
    catch (ChangedSincePageLoadException)
    {
      _changedElsewhere = true;
      _page = await CustomPageRepository.GetAsync(PageId);
    }
  }
}

<PageTitle>@(_page?.Name ?? "Page")</PageTitle>

<EditorWorkspace Page="_page">
  <Up>
    <UpLink Href="@PageUrls.CustomPageList" Label="Pages" data-test="up-link" />
  </Up>
  <Outline>
    @if (_page is not null)
    {
      @* The key is the id's int: Blazor keeps an island across an enhanced load only when its key formats to text,
         and otherwise starts a new one whenever a parameter changes, which drew it empty until its rows were read *@
      <PageOutline @rendermode="InteractiveServer" @key="_page.Id.Value" Page="_page" />
    }
  </Outline>
  <ChildContent>
    <SavedAtNotice HoldsUnsavedChanges="_formWasPosted" />

    @if (_page is null || Input is null)
    {
      <p>This page doesn't exist. It may have been deleted.</p>
    }
    else
    {
      <div class="mb-4 flex flex-wrap items-baseline justify-between gap-4">
        <h1 class="text-xl">@_page.Name</h1>
        <div class="flex gap-2">
          <LinkButton Variant="ButtonVariant.Outline" href="@PageUrls.CustomPage(_page)">View page</LinkButton>
          @if (!_page.IsHome && !_page.IsBlog && !_page.IsCollections)
          {
            <ButtonBasic type="button" Variant="ButtonVariant.DangerText" data-opens-dialog="@DeleteDialogId">
              Delete page
            </ButtonBasic>
          }
        </div>
      </div>

      @if (_changedElsewhere)
      {
        <p class="mb-4 text-error">This page became the home, blog or @Wording.Collection.PluralInSentence page somewhere
          else, so it can't be deleted.</p>
      }

      <EnableSaveOnChange HoldsUnsavedChanges="_formWasPosted">
        <EditForm EditContext="Input.EditContext" FormName="custom-page-details" OnValidSubmit="SaveAsync" Enhance
                  data-waits-for-pending class="mb-8">
          <DataAnnotationsValidator />

          <TextField Label="Name" @bind-Value="Input.Name" />
          @if (_page.IsHome)
          {
            <p class="mb-2 text-sm text-ink-faded">As the home page, it's shown at /.</p>
          }
          <TextField Label="Address" @bind-Value="Input.Address" />
          <ButtonBasic type="submit" Variant="ButtonVariant.Primary">Save</ButtonBasic>
        </EditForm>
      </EnableSaveOnChange>

      @if (!_page.IsHome && !_page.IsBlog && !_page.IsCollections)
      {
        <ConfirmFormDialog Id="@DeleteDialogId" Title="@($"Delete {_page.Name}?")" ConfirmLabel="Delete"
                           OnConfirm="DeleteAsync">
          Its components can still be added to other pages.
        </ConfirmFormDialog>
      }
    }
  </ChildContent>
</EditorWorkspace>
