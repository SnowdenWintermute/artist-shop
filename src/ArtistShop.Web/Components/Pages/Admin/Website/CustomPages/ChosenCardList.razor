@* a card grid's custom list on its settings page: drag to reorder, ✕ to take a card off. Both save at once *@
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Lists
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Utilities
@inject CardGridChosenCardRepository CardGridChosenCardRepository

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  [Parameter, EditorRequired]
  public required CustomComponentId ComponentId { get; set; }

  // kept by the pages adding to the list, so they come back to the settings page as it was
  [Parameter, EditorRequired]
  public required CustomComponentOrigin? Origin { get; set; }

  [Parameter, EditorRequired]
  public required IReadOnlyList<ChosenCardListItem> Items { get; set; }

  private Task ReorderAsync(IReadOnlyList<ChosenCardListItem> items) =>
    CardGridChosenCardRepository.ReorderAsync(ComponentId, [.. items.Select(item => item.Id)]);

  private Task RemoveAsync(ChosenCardListItem item) => CardGridChosenCardRepository.RemoveAsync(ComponentId, item.Id);

  private string NotShownReason(ChosenCardListItem item) =>
    item.IsCollection ? $"Not shown: none of its {Wording.Work.PluralInSentence} has an image." : "Not shown: no image.";
}

<SavingSortableList TItem="ChosenCardListItem" Items="Items" AriaLabel="Card order" Reorder="ReorderAsync" Remove="RemoveAsync"
                    NameOf="item => item.Name">
  <Header Context="count">
    <div class="mb-2 flex flex-wrap items-center justify-between gap-2 text-sm">
      <span>@(count == 0 ? "Nothing on the list yet." : CountText.Of(count, "card"))</span>

      <div class="flex gap-2">
        <LinkButton href="@PageUrls.AddCardGridWorks(ComponentId, Origin, [])" Variant="ButtonVariant.Outline">
          Add @Wording.Work.PluralInSentence
        </LinkButton>
        <LinkButton href="@PageUrls.AddCardGridCollections(ComponentId, Origin, [])" Variant="ButtonVariant.Outline">
          Add @Wording.Collection.PluralInSentence
        </LinkButton>
      </div>
    </div>
  </Header>
  <RowContent Context="item">
    <WorkThumbnail Image="item.Image" />

    <div class="grow">
      <div>
        <a href="@item.EditHref" class="underline">@item.Name</a>
      </div>
      <div class="text-xs text-ink-faded">
        @(item.IsCollection ? Wording.Collection.SingularHeading : Wording.Work.SingularHeading)
      </div>
      @if (!item.IsVisible)
      {
        <div class="text-xs text-error">@NotShownReason(item)</div>
      }
    </div>
  </RowContent>
</SavingSortableList>
