@* A component's frame: none, the theme's, or the theme's with some parts chosen here, labelled as the Theme
   page's Frame section is. Native inputs, so a part left to the theme posts "". Each change saves, as the
   types' choices do *@
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Forms

@code {
  [Parameter, EditorRequired]
  public required CustomComponentForm Input { get; set; }

  private ComponentFrameInput Frame => Input.Frame;

  private static string NameOf(string property) => $"Input.Frame.{property}";

  private static readonly IReadOnlyList<(string Value, string Label)> TypeChoices =
    [.. Enum.GetValues<ComponentFrameType>().Select(type => (type.ToString(), type.ToString()))];

  private static readonly IReadOnlyList<(string Value, string Label)> ColorChoices = [("false", "Theme"), ("true", "Own colour")];

  private static string ValueOf(bool value) => value ? "true" : "false";
}

<SubmitOnChange>
  <NativeRadioField Label="Frame" Name="@NameOf(nameof(ComponentFrameInput.Type))" Choices="TypeChoices"
                    Chosen="@Frame.Type.ToString()" />
  @if (Frame.Type is ComponentFrameType.Custom)
  {
    <NativeRadioField Label="Background" Name="@NameOf(nameof(ComponentFrameInput.HasOwnBackground))" Choices="ColorChoices"
                      Chosen="@ValueOf(Frame.HasOwnBackground)" />
    @if (Frame.HasOwnBackground)
    {
      <div class="mb-4">
        <ColorPicker aria-label="Background colour" name="@NameOf(nameof(ComponentFrameInput.Background))"
                     value="@Frame.Background" Class="mb-2 block" />
        <RangeField Label="Background opacity" Name="@NameOf(nameof(ComponentFrameInput.BackgroundOpacityPercent))"
                    Minimum="0" Maximum="100" Value="Frame.BackgroundOpacityPercent" Unit="%" />
      </div>
    }
    <NativeRadioField Label="Border colour" Name="@NameOf(nameof(ComponentFrameInput.HasOwnBorder))" Choices="ColorChoices"
                      Chosen="@ValueOf(Frame.HasOwnBorder)" />
    @if (Frame.HasOwnBorder)
    {
      <ColorPicker aria-label="Border colour" name="@NameOf(nameof(ComponentFrameInput.Border))" value="@Frame.Border"
                   Class="mb-4 block" />
    }
    <ThemePartChoices TEnum="FrameBorderWidth" Label="Border width" Name="@NameOf(nameof(ComponentFrameInput.BorderWidth))" Chosen="Frame.BorderWidth" />
    <ThemePartChoices TEnum="FrameCorners" Label="Corners" Name="@NameOf(nameof(ComponentFrameInput.Corners))" Chosen="Frame.Corners" />
    <ThemePartChoices TEnum="FramePadding" Label="Padding" Name="@NameOf(nameof(ComponentFrameInput.Padding))" Chosen="Frame.Padding" />
  }
  <ValidationMessage For="() => Input.Frame" class="mb-4 block text-error" />
</SubmitOnChange>
