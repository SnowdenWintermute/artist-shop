@* A row as a visitor sees it. Inside an island, which ThemedPreview needs *@
@using ArtistShop.Web.Components.CustomPages

@code {
  [Parameter, EditorRequired]
  public required CustomPage Page { get; set; }
  [Parameter, EditorRequired]
  public required PageRow Row { get; set; }
}

<ThemedPreview>
  <div class="@CustomPageWidths.PaddingClass">
    <CascadingValue Value="Page" IsFixed>
      <PageRowView Row="Row" />
    </CascadingValue>
  </div>
</ThemedPreview>
