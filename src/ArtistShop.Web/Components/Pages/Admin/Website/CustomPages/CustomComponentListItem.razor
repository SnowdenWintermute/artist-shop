@* one component on the components list: its name, linking to its settings, its type and pages, then delete and edit *@
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.CustomPages
@using ArtistShop.Web.Components.Dialogs
@using ArtistShop.Web.Database
@using ArtistShop.Web.Database.Repositories
@inject CustomComponentRepository CustomComponentRepository
@inject NavigationManager NavigationManager

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  [Parameter, EditorRequired]
  public required CustomComponentInUse Item { get; set; }

  private CustomComponent Component => Item.Component;

  private string DeleteDialogId => $"delete-component-{Component.Id.Value}";

  private string EditHref => PageUrls.EditCustomComponent(Component.Id, origin: null);

  // why a delete was refused, shown in place of the redirect
  private string? _refusal;

  // Refused when the blog or collections page came to need it since the list was read. The dialog is drawn even
  // then, as the post needs its form on the page
  private async Task DeleteAsync()
  {
    try
    {
      await CustomComponentRepository.DeleteAsync(Component.Id);
    }
    catch (BlogPageNeedsPostListException)
    {
      _refusal = "It's now the blog page's post list, so it can't be deleted.";
      return;
    }
    catch (CollectionsPageNeedsGridException)
    {
      _refusal = $"It's now the {Wording.Collection.PluralInSentence} page's grid of all "
        + $"{Wording.Collection.PluralInSentence}, so it can't be deleted.";
      return;
    }

    NavigationManager.NavigateTo(PageUrls.CustomComponentList);
  }
}

<li class="mb-2 flex flex-col gap-1 border p-2 text-sm" data-test="component-@Component.Id.Value">
  <div class="flex items-center gap-2">
    <span class="flex grow flex-wrap items-baseline gap-x-4">
      <a href="@EditHref" class="@LinkStyles.Standalone">@Component.Name</a>
      <span class="text-ink-faded">@CustomComponentNames.Of(Component.Settings.Type, Wording)</span>
      @if (Item.PageNames.Count == 0)
      {
        <Bold data-test="not-on-any-page">@CustomComponentPagesText.WhereItIs(Item)</Bold>
      }
      else
      {
        <span>@CustomComponentPagesText.WhereItIs(Item)</span>
      }
    </span>
    @if (Item.CanBeDeleted && _refusal is null)
    {
      <IconButton Icon="trash" Title="Delete" Label="@($"Delete {Component.Name}")" data-opens-dialog="@DeleteDialogId" />
    }
    <EditIconLink Href="@EditHref" Label="@Component.Name" />
  </div>

  @if (_refusal is not null)
  {
    <p class="text-error" data-test="delete-refused">@_refusal</p>
  }

  <ConfirmFormDialog Id="@DeleteDialogId" Title="@($"Delete {Component.Name}?")" ConfirmLabel="Delete" OnConfirm="DeleteAsync">
    @CustomComponentPagesText.DeleteWarning(Item)
  </ConfirmFormDialog>
</li>
