@* The page's layout on the page editor: its rows, their slots and the components in them, each dragged to another
   place (PageOutline.razor.js; slots and components into other rows and slots too), taken out, or opened in its
   editor. Every change saves at once, the layout is read again so it's
   always as saved, and the page preview reloads. OutlineRow and OutlineSlot draw the parts and call back here
   through the cascade *@
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.CustomPages
@using ArtistShop.Web.Components.Dialogs
@using ArtistShop.Web.Components.Interop
@using ArtistShop.Web.Database
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Utilities
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject CustomPageRepository CustomPageRepository
@inject PageRowRepository PageRowRepository
@inject RowSlotRepository RowSlotRepository
@inject CustomComponentRepository CustomComponentRepository

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  [Parameter, EditorRequired]
  public required CustomPage Page { get; set; }

  // read while prerendering and handed to the interactive render, which would otherwise start empty
  [PersistentState]
  public List<RowSketch>? Rows { get; set; }

  public bool IsSaving { get; private set; }

  private bool _hasLoaded;
  private bool _changedElsewhere;
  private bool _blogPageNeedsPostList;
  private bool _collectionsPageNeedsGrid;
  // each save reloads the page preview
  private int _saveCount;
  private RowSketch? _removingRow;
  private (RowSketch Row, SlotSketch Slot)? _removingSlot;
  private (RowSketch Row, SlotSketch Slot)? _addingTo;
  private ElementReference _root;
  private InteropObject<PageOutline>? _drag;

  // An enhanced load after a save in the page's form gives this its parameters again, and the layout is read again
  // with them
  protected override async Task OnParametersSetAsync()
  {
    // the first time in the interactive render, the prerender's rows have come across already
    if (_hasLoaded || Rows is null)
    {
      await LoadAsync();
    }

    _hasLoaded = true;
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      // null when the page closed first, so there is nothing to drag
      _drag = await InteropObject<PageOutline>.CreateAsync(
        JS, "./Components/Pages/Admin/Website/CustomPages/Workspace/PageOutline.razor.js", "startOutlineDrag", this, self =>
[self, _root]);
    }
  }

  public async ValueTask DisposeAsync()
  {
    if (_drag is not null)
    {
      await _drag.DisposeAsync();
    }
  }

  private async Task LoadAsync() =>
    Rows = [.. (await CustomPageRepository.GetLayoutAsync(Page.Id)).Rows.Select(RowSketch.Of)];

  public string RowEditHref(RowSketch row) => PageUrls.EditPageRow(Page.Id, row.Id);

  public string ComponentEditHref(RowSketch row, ComponentSketch component) =>
    PageUrls.EditCustomComponent(component.Id, Page.Id, row.Id);

  // A drop's index counts the dragged part where it still is when dropped back into its own list, so one after
  // it is one place further on; null when it lands where it was
  private static (int OldIndex, int NewIndex)? MoveWithin(int oldIndex, int index)
  {
    var newIndex = index > oldIndex ? index - 1 : index;
    return newIndex == oldIndex ? null : (oldIndex, newIndex);
  }

  [JSInvokable]
  public Task DropRowAsync(int rowId, int index) =>
    Rows?.FindIndex(row => row.Id.Value == rowId) is int oldIndex and >= 0 && MoveWithin(oldIndex, index) is { } move
      ? MoveRowAsync(move)
      : Task.CompletedTask;

  [JSInvokable]
  public Task DropSlotAsync(int slotId, int fromRowId, int toRowId, int index)
  {
    var from = Rows?.SingleOrDefault(row => row.Id.Value == fromRowId);
    var to = Rows?.SingleOrDefault(row => row.Id.Value == toRowId);
    var oldIndex = from?.Slots.FindIndex(slot => slot.Id.Value == slotId) ?? -1;

    if (from is null || to is null || oldIndex < 0)
    {
      return Task.CompletedTask;
    }

    if (from == to)
    {
      return MoveWithin(oldIndex, index) is { } move ? MoveSlotAsync(from, move) : Task.CompletedTask;
    }

    return SaveAsync(() => RowSlotRepository.MoveAsync(from.Slots[oldIndex].Id, from.Id, from.Slots.Count, to.Id,
to.Slots.Count, index));
  }

  [JSInvokable]
  public Task DropComponentAsync(int componentId, int fromSlotId, int toSlotId, int index)
  {
    var slots = Rows?.SelectMany(row => row.Slots).ToList() ?? [];
    var from = slots.SingleOrDefault(slot => slot.Id.Value == fromSlotId);
    var to = slots.SingleOrDefault(slot => slot.Id.Value == toSlotId);
    var oldIndex = from?.Components.FindIndex(component => component.Id.Value == componentId) ?? -1;

    if (from is null || to is null || oldIndex < 0)
    {
      return Task.CompletedTask;
    }

    if (from == to)
    {
      return MoveWithin(oldIndex, index) is { } move ? MoveComponentAsync(from, move) : Task.CompletedTask;
    }

    return SaveAsync(() => RowSlotRepository.MovePlacementAsync(from.Id, from.Components[oldIndex].Id, to.Id, index));
  }

  private Task MoveRowAsync((int OldIndex, int NewIndex) move) =>
    SaveAsync(() => PageRowRepository.ReorderAsync(Page.Id, [.. Unwrap.Value(Rows).Moved(move).Select(row => row.Id)]));

  public void AskToRemove(RowSketch row)
  {
    _removingRow = row;
    StateHasChanged();
  }

  private async Task RemoveRowAsync()
  {
    var row = Unwrap.Value(_removingRow);
    await SaveAsync(() => PageRowRepository.DeleteAsync(row.Id));
    _removingRow = null;
  }

  // A width chosen or a move made from the keyboard while something else saves waits, then applies to the layout
  // as saved, found again by id, so the buttons needn't be disabled meanwhile and each press counts
  private readonly Queue<Func<Task>> _waiting = new();

  private Task WhenSavedAsync(Func<Task> change)
  {
    _waiting.Enqueue(change);

    return IsSaving ? Task.CompletedTask : SaveNextWaitingAsync();
  }

  private Task SaveNextWaitingAsync() => _waiting.TryDequeue(out var change) ? change() : Task.CompletedTask;

  private RowSketch? RowOf(PageRowId id) => Rows?.SingleOrDefault(row => row.Id == id);

  private (RowSketch Row, SlotSketch Slot)? SlotOf(RowSlotId id) =>
    Rows?.SelectMany(row => row.Slots.Select(slot => (row, slot))).SingleOrDefault(found => found.slot.Id == id) is ({ }
row, { } slot)
      ? (row, slot)
      : null;

  // one place on, within the list, or nothing when that's past its end
  private static (int OldIndex, int NewIndex)? MoveBy(int oldIndex, int offset, int count) =>
    oldIndex >= 0 && oldIndex + offset >= 0 && oldIndex + offset < count ? (oldIndex, oldIndex + offset) : null;

  public Task ChooseWidthsAsync(RowSketch row, RowWidths widths) =>
    WhenSavedAsync(() =>
      RowOf(row.Id) is { } saved ? SaveAsync(() => PageRowRepository.SetLayoutAsync(saved.Id, saved.Slots.Count, widths)) :
Task.CompletedTask);

  public Task MoveRowByAsync(RowSketch row, int offset) =>
    WhenSavedAsync(() =>
      Rows is { } rows && MoveBy(rows.FindIndex(saved => saved.Id == row.Id), offset, rows.Count) is { } move
        ? MoveRowAsync(move)
        : Task.CompletedTask);

  public Task MoveSlotByAsync(SlotSketch slot, int offset) =>
    WhenSavedAsync(() =>
      SlotOf(slot.Id) is (var row, var saved) && MoveBy(row.Slots.IndexOf(saved), offset, row.Slots.Count) is { } move
        ? MoveSlotAsync(row, move)
        : Task.CompletedTask);

  public Task MoveComponentByAsync(SlotSketch slot, ComponentSketch component, int offset) =>
    WhenSavedAsync(() =>
      SlotOf(slot.Id) is (_, var saved)
      && MoveBy(saved.Components.FindIndex(placed => placed.Id == component.Id), offset, saved.Components.Count) is { } move
        ? MoveComponentAsync(saved, move)
        : Task.CompletedTask);

  public Task AddSlotAsync(RowSketch row) => SaveAsync(() => RowSlotRepository.AddAsync(row.Id, row.Slots.Count));

  private Task MoveSlotAsync(RowSketch row, (int OldIndex, int NewIndex) move) =>
    SaveAsync(() => RowSlotRepository.ReorderAsync(row.Id, [.. row.Slots.Moved(move).Select(slot => slot.Id)]));

  public void AskToRemove(RowSketch row, SlotSketch slot)
  {
    _removingSlot = (row, slot);
    StateHasChanged();
  }

  private async Task RemoveSlotAsync()
  {
    var (row, slot) = Unwrap.Value(_removingSlot);
    await SaveAsync(() => RowSlotRepository.DeleteAsync(row.Id, slot.Id, row.Slots.Count));
    _removingSlot = null;
  }

  private Task MoveComponentAsync(SlotSketch slot, (int OldIndex, int NewIndex) move) =>
    SaveAsync(() => RowSlotRepository.ReorderPlacementsAsync(slot.Id, [.. slot.Components.Moved(move).Select(component =>
component.Id)]));

  public Task TakeOutAsync(SlotSketch slot, ComponentSketch component) =>
    SaveAsync(() => RowSlotRepository.RemovePlacementAsync(slot.Id, component.Id));

  public void AddTo(RowSketch row, SlotSketch slot)
  {
    _addingTo = (row, slot);
    StateHasChanged();
  }

  // a new component opens in its editor, as its Edit link would; one that couldn't be added leaves the outline as is
  private async Task AddNewAsync(CustomComponentStarter starter)
  {
    var (row, slot) = Unwrap.Value(_addingTo);
    CustomComponentId? added = null;
    await SaveAsync(async () => added = await AddNamedAsync(slot.Id, starter));
    _addingTo = null;

    if (added is { } id)
    {
      NavigationManager.NavigateTo(PageUrls.EditCustomComponent(id, Page.Id, row.Id));
    }
  }

  // the first free name; one taken meanwhile by another tab is skipped for the next
  private async Task<CustomComponentId?> AddNamedAsync(RowSlotId slotId, CustomComponentStarter starter)
  {
    var taken = (await CustomComponentRepository.GetAllAsync())
      .Select(made => made.Component.Name)
      .ToHashSet(StringComparer.OrdinalIgnoreCase);

    foreach (var name in CustomComponentNames.NewNames(starter, Wording, taken))
    {
      try
      {
        return await CustomComponentRepository.AddToSlotAsync(slotId, name, NewCustomComponentSettings.For(starter));
      }
      catch (NameAlreadyInUseException)
      {
      }
    }

    return null;
  }

  private async Task AddExistingAsync(CustomComponent component)
  {
    var (_, slot) = Unwrap.Value(_addingTo);
    await SaveAsync(() => RowSlotRepository.PlaceAsync(slot.Id, component.Id));
    _addingTo = null;
  }

  private Task AddRowAsync() => SaveAsync(() => PageRowRepository.AddAsync(Page.Id));

  private async Task SaveAsync(Func<Task> save)
  {
    // a second change while the first is saving would be built from the old layout
    if (IsSaving)
    {
      return;
    }

    IsSaving = true;
    _changedElsewhere = false;
    _blogPageNeedsPostList = false;
    _collectionsPageNeedsGrid = false;
    StateHasChanged();

    try
    {
      await save();
    }
    catch (ChangedSincePageLoadException)
    {
      _changedElsewhere = true;
    }
    catch (BlogPageNeedsPostListException)
    {
      _blogPageNeedsPostList = true;
    }
    catch (CollectionsPageNeedsGridException)
    {
      _collectionsPageNeedsGrid = true;
    }

    // the guard holds until the layout is read again
    await LoadAsync();
    _saveCount++;
    IsSaving = false;
    StateHasChanged();

    await SaveNextWaitingAsync();
  }
}

<DisabledUntilInteractive>
  <PreviewReload Stamp="_saveCount" />

  @if (_changedElsewhere)
  {
    <p class="mb-2 text-error">The page was changed somewhere else, so it has been reloaded.</p>
  }

  @if (_blogPageNeedsPostList)
  {
    <p class="mb-2 text-error">The blog page needs its post list.</p>
  }

  @if (_collectionsPageNeedsGrid)
  {
    <p class="mb-2 text-error">The @Wording.Collection.PluralInSentence page needs its grid of all
      @Wording.Collection.PluralInSentence.</p>
  }

  @* what the drag script works within, Add row included, which is where a row lands at the end; data-saving: no
     drag starts until the layout is read again *@
  <div @ref="_root" data-saving="@IsSaving">
    <CascadingValue Value="this" IsFixed>
      @if (Rows is { Count: 0 })
      {
        <p class="mb-2">No rows yet.</p>
      }
      else if (Rows is { } rows)
      {
        <div role="list" aria-label="Rows">
          @for (var index = 0; index < rows.Count; index++)
          {
            var place = index;
            <OutlineRow @key="rows[place].Id" Row="rows[place]" Index="place" IsLast="place == rows.Count - 1" />
          }
        </div>
        @* the gap above it, the same as between rows *@
        <div class="h-3"></div>
      }
    </CascadingValue>

    <button type="button" data-drop="row" data-index="@(Rows?.Count ?? 0)"
            class="@($"cursor-pointer {LinkStyles.InSentence} {OutlineClasses.End}")" disabled="@IsSaving"
            @onclick="AddRowAsync">
      Add row
    </button>
  </div>

  @if (_addingTo is (_, var addingTo))
  {
    <AddComponentDialog InSlot="[.. addingTo.Components.Select(component => component.Id)]" IsSaving="IsSaving"
                        OnNew="AddNewAsync" OnExisting="AddExistingAsync" OnClose="() => _addingTo = null" />
  }

  <ConfirmDialog Open="_removingRow is not null" OpenChanged="open => _removingRow = open ? _removingRow : null"
                 Title="Remove this row?" ConfirmLabel="Remove" OnConfirm="RemoveRowAsync" IsWorking="IsSaving">
    Its components can still be added to other rows.
  </ConfirmDialog>

  <ConfirmDialog Open="_removingSlot is not null" OpenChanged="open => _removingSlot = open ? _removingSlot : null"
                 Title="Remove this slot?" ConfirmLabel="Remove" OnConfirm="RemoveSlotAsync" IsWorking="IsSaving">
    Its components can still be added to other slots.
  </ConfirmDialog>
</DisabledUntilInteractive>
