@* What drags a part of the outline (PageOutline.razor.js), and for the keyboard, buttons moving it one place, shown
   once focused. touch-none: a finger on it drags rather than scrolls *@

@code {
  [Parameter]
  public string? Class { get; set; }
  // what's moved, for the buttons' labels
  [Parameter, EditorRequired]
  public required string Label { get; set; }
  [Parameter, EditorRequired]
  public bool IsFirst { get; set; }
  [Parameter, EditorRequired]
  public bool IsLast { get; set; }
  // slots lie side by side, so they move left and right
  [Parameter]
  public bool IsSideways { get; set; }
  [Parameter, EditorRequired]
  public EventCallback<int> OnMove { get; set; }

  private const string MoveButtonClass = "sr-only cursor-pointer px-1.25 focus:not-sr-only";
}

<span data-drag-handle class="@($"{Class} cursor-grab touch-none px-1 text-lg leading-none text-ink-unavailable select-none active:cursor-grabbing")"
      title="Drag to move" aria-hidden="true">⠿</span>
@if (!IsFirst)
{
  <button type="button" class="@MoveButtonClass" aria-label="@($"Move {Label} {(IsSideways ? "left" : "up")}")"
          @onclick="() => OnMove.InvokeAsync(-1)">
    @(IsSideways ? "←" : "↑")
  </button>
}
@if (!IsLast)
{
  <button type="button" class="@MoveButtonClass" aria-label="@($"Move {Label} {(IsSideways ? "right" : "down")}")"
          @onclick="() => OnMove.InvokeAsync(1)">
    @(IsSideways ? "→" : "↓")
  </button>
}
