@* Public content as a visitor sees it, in the website's theme, at a desktop's or a phone's width. <themed-preview>,
   defined in ThemedPreview.razor.js, switches the width in the browser, so the preview needs no island *@
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.CustomPages
@using ArtistShop.Web.Database.Repositories
@inject ThemeRepository ThemeRepository

@code {
  [Parameter, EditorRequired]
  public RenderFragment ChildContent { get; set; } = default!;

  // the theme visitors see; null leaves the preview in the platform's
  private NamedTheme? _theme;

  protected override async Task OnInitializedAsync() => _theme = await ThemeRepository.GetInUseAsync();
}

<themed-preview class="group/preview block">
  <div role="group" aria-label="Width" class="mb-2 flex flex-wrap items-center gap-2">
    <span class="mr-2">Width</span>
    <PreviewWidthButtons />
  </div>
  @* ThemeStyle sets the theme on this box alone, as on the Theme page's preview. inert: a link in the
     preview would leave the editor. w-fit for the phone, so the box is the phone's width rather than the editor's.
     --screen-height is the screen a row that fills it is drawn on: a 1440×900 laptop, a 390×844 phone *@
  @if (_theme is { } theme)
  {
    <ThemeStyle Selector="[data-themed-preview]" Theme="theme.Theme" />
  }
  <div data-themed-preview
       class="mb-4 max-w-full border border-rule bg-page font-text text-ink [--screen-height:900px]
         group-data-shows-phone/preview:w-fit group-data-shows-phone/preview:[--screen-height:844px]" inert>
    <RowPreviewFrame Pixels="CustomPageWidths.DesktopPixels">
      @ChildContent
    </RowPreviewFrame>
  </div>
</themed-preview>
