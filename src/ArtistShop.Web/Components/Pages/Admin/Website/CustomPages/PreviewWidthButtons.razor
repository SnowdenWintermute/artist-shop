@* A preview's Desktop and Phone buttons, Desktop pressed until the preview's script presses the width remembered
   (preview-width.js). data-phone: ThemedPreview narrows its box to the phone *@
@using ArtistShop.Web.Components.CustomPages
@using ArtistShop.Web.Components.Icons

@code {
  private const string WidthButtonClass = "flex size-8 cursor-pointer items-center justify-center " + ChoiceClasses.Pressable;
}

<button type="button" class="@WidthButtonClass" title="Desktop" aria-label="Desktop" aria-pressed="true"
        data-preview-width="@CustomPageWidths.DesktopPixels">
  <SvgIcon Name="desktop" Class="size-5" />
</button>
<button type="button" class="@WidthButtonClass" title="Phone" aria-label="Phone" aria-pressed="false"
        data-preview-width="@CustomPageWidths.PhonePixels" data-phone>
  <SvgIcon Name="phone" Class="size-5" />
</button>
