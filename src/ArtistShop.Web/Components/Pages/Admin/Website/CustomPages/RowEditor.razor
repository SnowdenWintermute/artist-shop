@* One row: its split and alignment, its slots with their stacks, and a preview. Every change saves at
   once and the row is read again, so it's always as saved *@
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.CustomPages
@using ArtistShop.Web.Components.Dialogs
@using ArtistShop.Web.Components.Lists
@using ArtistShop.Web.Database
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Utilities
@inject CustomPageRepository CustomPageRepository
@inject PageRowRepository PageRowRepository
@inject RowSlotRepository RowSlotRepository
@inject CustomComponentRepository CustomComponentRepository

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  [Parameter, EditorRequired]
  public required CustomPage Page { get; set; }
  [Parameter, EditorRequired]
  public required PageRowId RowId { get; set; }
  [Parameter, EditorRequired]
  public bool IsNew { get; set; }
  // the row's settings as the page saved them, which the static form above changes; a new one means
  // the preview must be read again
  [Parameter, EditorRequired]
  public required string SettingsStamp { get; set; }

  private CustomPageLayout? _layout;
  private PageRow? _row;
  private string? _loadedStamp;
  private RowSlot? _addingTo;
  private RowSlot? _removingSlot;
  private bool _isSaving;
  private bool _changedElsewhere;
  private bool _blogPageNeedsPostList;

  protected override async Task OnInitializedAsync()
  {
    await LoadAsync();

    if (IsNew && _row?.Slots is [{ Stack.Count: 0 } slot])
    {
      _addingTo = slot;
    }
  }

  protected override async Task OnParametersSetAsync()
  {
    if (_loadedStamp is not null && _loadedStamp != SettingsStamp)
    {
      await LoadAsync();
    }

    _loadedStamp = SettingsStamp;
  }

  private async Task LoadAsync()
  {
    _layout = await CustomPageRepository.GetLayoutAsync(Page.Id);
    _row = _layout.Row(RowId);
  }

  // A choice made while something else saves waits, then applies to the row as saved, so the radios
  // needn't be disabled meanwhile and the one last clicked is what's saved
  private readonly Queue<Func<PageRow, Task>> _waitingChoices = new();

  private Task ChooseAsync(Func<PageRow, Task> save)
  {
    _waitingChoices.Enqueue(save);

    return _isSaving ? Task.CompletedTask : SaveNextChoiceAsync();
  }

  private Task SaveNextChoiceAsync() =>
    _row is { } row && _waitingChoices.TryDequeue(out var save) ? SaveAsync(() => save(row)) : Task.CompletedTask;

  private Task SetWidthsAsync(RowWidths widths) =>
    ChooseAsync(row => PageRowRepository.SetLayoutAsync(row.Id, row.Slots.Count, widths, row.Alignment));

  private Task SetAlignmentAsync(RowAlignment alignment) =>
    ChooseAsync(row => PageRowRepository.SetLayoutAsync(row.Id, row.Slots.Count, row.Widths, alignment));

  private Task AddSlotAsync(PageRow row) => SaveAsync(() => RowSlotRepository.AddAsync(row.Id, row.Slots.Count));

  private async Task RemoveSlotAsync()
  {
    var row = Unwrap.Value(_row);
    var slot = Unwrap.Value(_removingSlot);
    await SaveAsync(() => RowSlotRepository.DeleteAsync(row.Id, slot.Id, row.Slots.Count));
    _removingSlot = null;
  }

  private Task MoveAsync(RowSlot slot, (int OldIndex, int NewIndex) move) =>
    SaveAsync(() => RowSlotRepository.ReorderPlacementsAsync(slot.Id, [.. slot.Stack.Moved(move).Select(component => component.Id)]));

  private Task TakeOutAsync(RowSlot slot, CustomComponent component) =>
    SaveAsync(() => RowSlotRepository.RemovePlacementAsync(slot.Id, component.Id));

  private async Task AddNewAsync(CustomComponentStarter starter)
  {
    var slot = Unwrap.Value(_addingTo);
    await SaveAsync(() => AddNamedAsync(slot, starter));
    _addingTo = null;
  }

  // the first free name; one taken meanwhile by another tab is skipped for the next
  private async Task AddNamedAsync(RowSlot slot, CustomComponentStarter starter)
  {
    var taken = (await CustomComponentRepository.GetAllAsync())
      .Select(made => made.Component.Name)
      .ToHashSet(StringComparer.OrdinalIgnoreCase);

    foreach (var name in CustomComponentNames.NewNames(starter, Wording, taken))
    {
      try
      {
        await CustomComponentRepository.AddToSlotAsync(slot.Id, name, NewCustomComponentSettings.For(starter));
        return;
      }
      catch (NameAlreadyInUseException)
      {
      }
    }
  }

  private async Task AddExistingAsync(CustomComponent component)
  {
    var slot = Unwrap.Value(_addingTo);
    await SaveAsync(() => RowSlotRepository.PlaceAsync(slot.Id, component.Id));
    _addingTo = null;
  }

  private async Task SaveAsync(Func<Task> save)
  {
    // a second change while the first is saving would be built from the old row
    if (_isSaving)
    {
      return;
    }

    _isSaving = true;
    _changedElsewhere = false;
    _blogPageNeedsPostList = false;

    try
    {
      await save();
    }
    catch (ChangedSincePageLoadException)
    {
      _changedElsewhere = true;
    }
    catch (BlogPageNeedsPostListException)
    {
      _blogPageNeedsPostList = true;
    }

    // the guard holds until the row is read again
    await LoadAsync();
    _isSaving = false;
    await SaveNextChoiceAsync();
  }
}

<DisabledUntilInteractive>
  @if (_changedElsewhere)
  {
    <p class="mb-4 text-error">The row was changed somewhere else, so it has been reloaded.</p>
  }

  @if (_blogPageNeedsPostList)
  {
    <p class="mb-4 text-error">The blog page needs its post list. Make another page the blog page first.</p>
  }

  @if (_row is null)
  {
    <p>This row doesn't exist. It may have been removed.</p>
  }
  else
  {
    var row = _row;

    @if (row.Slots.Count > 1)
    {
      <div class="mb-6 flex flex-col gap-4">
        <RadioChoices TValue="RowWidths" Label="Slot widths" Values="RowWidthChoices.For(row.Slots.Count)" Chosen="row.Widths"
                      LabelOf="RowChoiceLabels.Of" OnChoose="SetWidthsAsync" />
        <RadioChoices TValue="RowAlignment" Label="Line up" Values="Enum.GetValues<RowAlignment>()" Chosen="row.Alignment"
                      LabelOf="RowChoiceLabels.Of" OnChoose="SetAlignmentAsync" />
      </div>
    }

    <div class="mb-4 flex flex-wrap items-start gap-4">
      @foreach (var (slot, growth) in row.Slots.Zip(RowClasses.SlotGrowth(row.Widths)))
      {
        <section @key="slot.Id" class="@($"min-w-[min(100%,16rem)] basis-0 border p-2 {growth}")" aria-label="Slot">
          @if (slot.Stack.Count == 0)
          {
            <p class="mb-2 text-ink-faded">Empty</p>
          }
          else
          {
            <SortableList TItem="CustomComponent" Items="[.. slot.Stack]" AriaLabel="Component order" OnMove="move => MoveAsync(slot, move)">
              <RowContent Context="component">
                <span class="grow">@component.Name</span>
              </RowContent>
              <RowActions Context="component">
                <LinkButton Variant="ButtonVariant.Outline" href="@PageUrls.EditCustomComponent(component.Id, Page.Id, row.Id)">Edit</LinkButton>
                <button type="button" class="cursor-pointer px-1" title="Take out of this slot" aria-label="Take out of this slot"
                        disabled="@_isSaving" @onclick="() => TakeOutAsync(slot, component)">
                  ✕
                </button>
              </RowActions>
            </SortableList>
          }

          <div class="flex flex-wrap gap-2">
            <ButtonBasic type="button" Variant="ButtonVariant.Outline" disabled="@_isSaving" @onclick="() => _addingTo = slot">
              Add component
            </ButtonBasic>
            @if (row.Slots.Count > 1)
            {
              <ButtonBasic type="button" Variant="ButtonVariant.DangerText" disabled="@_isSaving" @onclick="() => _removingSlot = slot">
                Remove slot
              </ButtonBasic>
            }
          </div>
        </section>
      }
    </div>

    @if (row.Slots.Count < RowWidthChoices.MaximumSlotCount)
    {
      <ButtonBasic type="button" Variant="ButtonVariant.Outline" Class="mb-8" Busy="_isSaving" @onclick="() => AddSlotAsync(row)">
        Add slot
      </ButtonBasic>
    }

    <h2 class="mb-2 text-lg">Preview</h2>
    <RowPreview Page="Page" Row="row" Position="Unwrap.Value(_layout).PositionOf(row)" />
  }

  @if (_addingTo is { } addingTo)
  {
    <AddComponentDialog Slot="addingTo" IsSaving="_isSaving" OnNew="AddNewAsync" OnExisting="AddExistingAsync"
                        OnClose="() => _addingTo = null" />
  }

  <ConfirmDialog Open="_removingSlot is not null" OpenChanged="open => _removingSlot = open ? _removingSlot : null"
                 Title="Remove this slot?" ConfirmLabel="Remove" OnConfirm="RemoveSlotAsync" IsWorking="_isSaving">
    Its components can still be added to other slots.
  </ConfirmDialog>
</DisabledUntilInteractive>
