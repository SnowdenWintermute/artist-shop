@* the name every component has, then its type's own fields and its frame if its type has one. Each
   typed field has Save beside it, which saves the whole form; choices save as they change *@
@using ArtistShop.Web.Components.Forms

@code {
  [Parameter, EditorRequired]
  public required CustomComponentForm Input { get; set; }
  [Parameter, EditorRequired]
  public EventCallback OnSave { get; set; }
  [Parameter, EditorRequired]
  public bool HoldsUnsavedChanges { get; set; }
  // CustomComponentSettings.HasFrame
  [Parameter, EditorRequired]
  public bool HasFrame { get; set; }
  // a rich text body is too long to put Save beside, so it gets one under it
  [Parameter]
  public bool HasRichText { get; set; }
  // the type's fields, if it has any
  [Parameter]
  public RenderFragment? ChildContent { get; set; }
}

<EnableSaveOnChange HoldsUnsavedChanges="HoldsUnsavedChanges">
  <EditForm EditContext="Input.EditContext" FormName="custom-component" OnValidSubmit="OnSave" Enhance class="mb-8">
    <DataAnnotationsValidator />

    <TextFieldWithButton Label="Name" @bind-Value="Input.Name">
      <SaveButton />
    </TextFieldWithButton>
    @ChildContent
    @if (HasFrame)
    {
      <ComponentFrameFields Input="Input" />
    }
    @if (HasRichText)
    {
      <SaveButton />
    }
  </EditForm>
</EnableSaveOnChange>
