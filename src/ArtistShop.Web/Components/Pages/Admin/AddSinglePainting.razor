@page "/admin/catalog/paintings/add-single"
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Forms
@using ArtistShop.Web.Components.Forms.FileUpload.Images
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Identity
@using ArtistShop.Web.Images
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = RoleNames.Admin)]
@inject PaintingRepository PaintingRepository
@inject VocabularyRepository VocabularyRepository
@inject SeriesRepository SeriesRepository
@inject NavigationManager NavigationManager
@inject ImageStorage ImageStorage

@code {
  [SupplyParameterFromForm]
  private PaintingCatalogAdditionForm Input { get; set; } = default!;
  [SupplyParameterFromQuery(Name = "added")]
  private string? AddedSlug { get; set; }

  private List<VocabularyWithTerms> _vocabularies = [];
  private List<Vocabulary> _vocabulariesWithoutShopItemTypes = [];
  // in the artist's order
  private List<Series> _series = [];

  protected override async Task OnInitializedAsync()
  {
    Input ??= new();
    _vocabularies = await VocabularyRepository.GetAllWithTermsForShopItemTypeAsync(ShopItemTypeId.Painting);
    _vocabulariesWithoutShopItemTypes = await VocabularyRepository.GetAllWithoutShopItemTypesAsync();
    _series = await SeriesRepository.GetAllAsync();
  }

  private async Task AddPainting(EditContext editContext)
  {
    // if the form sat open longer than the grace period, the sweep may have deleted uploads
    var missingImages = Input.Images
      .Where(image => !ImageStorage.OriginalExists(image.StorageKey))
      .ToList();

    if (missingImages.Count > 0)
    {
      // <ValidationMessage /> will show these
      var validationMessages = new ValidationMessageStore(editContext);

      foreach (var image in missingImages)
      {
        var staleImageMessage = $"{image.OriginalFileName ?? "An image"} is no longer on the server because the form was open too long. Remove it and upload it again.";
        validationMessages.Add(() => Input.Images, staleImageMessage);
      }

      // tells the ValidationMessage components to re-render with the new messages
      editContext.NotifyValidationStateChanged();
      return;
    }

    var identifiers = await PaintingRepository.AddAsync(Input.ToCatalogAddition());
 
    NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
    { ["added"] = identifiers.Slug.Value }));

  }
}

<PageTitle>Add a painting</PageTitle>

<main class="pt-10">
  <div class="border max-w-[600px] mx-auto p-4 bg-white">
    <h1>Add a painting</h1>


    @if (AddedSlug is not null)
    {
      <p class="text-green-600">
        Painting added.
        <a href="@($"/paintings/{AddedSlug}")">
          View it
        </a>
      </p>
    }

    @* at the top, so the artist sets these up before filling in the form, not after *@
    <CatalogSetupNotice PaintingVocabularies="_vocabularies" VocabulariesWithoutShopItemTypes="_vocabulariesWithoutShopItemTypes"
                        SeriesCount="_series.Count" />

    <EditForm Model="Input" FormName="new-painting" OnValidSubmit="AddPainting" Enhance>
      <DataAnnotationsValidator />

      <TextField Label="Title" @bind-Value="Input.Name" />
      <NumberField Label="Price" @bind-Value="Input.Price" />
      <PartialDateField Label="Date painted" @bind-Year="Input.YearPainted" @bind-Month="Input.MonthPainted"
                        @bind-Day="Input.DayPainted" />
      <TextAreaField Label="Description" @bind-Value="Input.Description" />
      <NumberField Label="Width (cm)" @bind-Value="Input.WidthCm" />
      <NumberField Label="Height (cm)" @bind-Value="Input.HeightCm" />

      @* @key: a fresh island after each painting is added, like ImagesField *@
      <TermAndSeriesPickers @key="AddedSlug" Vocabularies="_vocabularies" AllSeries="_series"
                            SelectedVocabularyTermIds="Input.VocabularyTermIds" SelectedSeriesIds="Input.SeriesIds" />

      <ValidationMessage For="() => Input.Images" class="mb-4 block text-red-400" />
      <ImagesField @key="AddedSlug" FieldName="Input.Images" PrimaryFieldName="Input.PrimaryImageKey"
                   SuggestNameInto="Input.Name" />

      <ButtonBasic type="submit" Class="bg-blue-400 text-white text-lg">
        Add painting
      </ButtonBasic>
    </EditForm>
  </div>
</main>

