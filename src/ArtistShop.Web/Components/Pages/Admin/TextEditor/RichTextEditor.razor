@using ArtistShop.Web.Components.Pages.Admin.TextEditor.ImagePicker
@using ArtistShop.Web.Components.Forms
@using ArtistShop.Web.Components.Icons
@using ArtistShop.Web.Components.Publishing
@using System.Linq.Expressions

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  [Parameter, EditorRequired]
  public string Label { get; set; } = default!;

  // the Delta JSON, which the editor starts from and writes back as the artist types
  [Parameter]
  public string? Value { get; set; }

  [Parameter]
  public EventCallback<string?> ValueChanged { get; set; }

  [Parameter]
  public Expression<Func<string?>> ValueExpression { get; set; } = default!;

  // Names what's being edited. The editor survives enhanced navigation to a page with the same
  // key, and is replaced on one with another, so it never shows another one's text
  [Parameter, EditorRequired]
  public string DocumentKey { get; set; } = default!;
}

<HeadContent>
  <link rel="stylesheet" href="@Assets["lib/quill/quill.snow.css"]" />
</HeadContent>

<FieldLayout Label="@Label" ValueExpression="ValueExpression" Context="elementId">
  @* <rich-text-editor> is defined in RichTextEditor.razor.js, and loads Quill itself from
     data-quill-src. data-permanent stops enhanced navigation from patching its children, which
     would remove Quill's toolbar and editing area, since the server never renders them *@
  <rich-text-editor class="block bg-panel" data-permanent="@DocumentKey" data-quill-src="@Assets["lib/quill/quill.js"]"
                    data-column-class="@RichTextColumn.WidthClass" data-video-address-dialog="@VideoAddressDialog.ElementId"
                    data-work-button-text="@Wording.Work.SingularHeading"
                    data-work-button-label="@($"Add {Wording.Work.SingularInSentence}")">
    <InputText type="hidden" id="@elementId" Value="@Value" ValueChanged="ValueChanged"
               ValueExpression="ValueExpression" />
    <EditorWorkEmbed />
    <EditorUploadedImageEmbed />
    <EditorVideoEmbed />
    <WorkPickerDialog />
    <ImagePickerDialog />
    @* Quill draws its own toolbar, so the script copies this into Undo and Redo. ql-stroke gives it
       Quill's colours, as on its own icons *@
    <template data-part="undo-icon"><SvgIcon Name="undo" Class="ql-stroke" /></template>
  </rich-text-editor>
</FieldLayout>
