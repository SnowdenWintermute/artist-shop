@using System.Globalization
@using ArtistShop.Web.Components.Atoms

@code {
  // must contain the form
  [Parameter, EditorRequired]
  public RenderFragment ChildContent { get; set; } = default!;

  // Names what's being edited, among everything this browser keeps copies of. New posts share "new":
  // there's only ever one being written, and an edit page clears it once the post it became is saved
  [Parameter, EditorRequired]
  public string BackupKey { get; set; } = default!;

  // when what's being edited was last saved; null for a new post
  [Parameter, EditorRequired]
  public DateTimeOffset? SavedAt { get; set; }

  // what the notice calls it, such as "post"
  [Parameter, EditorRequired]
  public string Noun { get; set; } = default!;

  // the form's field backed up with the text, such as a post's title
  [Parameter, EditorRequired]
  public string TitleField { get; set; } = default!;

  // the form's field RichTextEditor writes the text to
  [Parameter, EditorRequired]
  public string BodyField { get; set; } = default!;

  // true when the page came back from a save that didn't go through: the form already holds the
  // latest edits, so there is nothing to offer back, and a copy that matches it isn't saved yet
  [Parameter]
  public bool HoldsUnsavedChanges { get; set; }

  // only compared, never read as a date: it tells whether it was saved since the copy was made
  private string? SavedVersion => SavedAt?.UtcDateTime.ToString("O", CultureInfo.InvariantCulture);
}

@* <rich-text-backup>, defined in RichTextBackup.razor.js, keeps a copy of the title and text in the browser
   as the artist types, and offers it back here when the page opens without it. The post editor's,
   and a text component's on its settings page *@
<rich-text-backup class="block" data-backup-key="@BackupKey" data-saved-version="@SavedVersion" data-title-field="@TitleField"
             data-body-field="@BodyField" data-holds-unsaved-changes="@HoldsUnsavedChanges">
  <div class="mb-4 border border-rule bg-page p-3" data-part="notice" role="status" hidden>
    <p class="mb-2">
      You have unsaved changes to this @Noun from <span data-part="backed-up-at"></span>, kept in this
      browser.
    </p>
    <p class="mb-2" data-part="saved-since" hidden>
      The @Noun has been saved since then, so restoring them replaces that save.
    </p>
    <div class="flex gap-2">
      <ButtonBasic type="button" Variant="ButtonVariant.Primary" data-part="restore">Restore</ButtonBasic>
      <ButtonBasic type="button" Variant="ButtonVariant.Outline" data-part="discard">Discard</ButtonBasic>
    </div>
  </div>

  @ChildContent

  @* the editor's Video button opens this. After the form, since it has a form of its own *@
  <VideoAddressDialog />
</rich-text-backup>
