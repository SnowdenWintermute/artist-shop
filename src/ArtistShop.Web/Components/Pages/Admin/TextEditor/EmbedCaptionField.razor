@* An image embed's caption, whether the image is a work's or uploaded into the text.
   ImageEmbedControls.razor.js handles it. Applied as it's typed. No name, so the form never posts
   it; the toolbar's script keeps Enter from submitting the form *@
<label class="@EmbedToolbar.FieldLineClass">
  <span class="@EmbedToolbar.FieldNameClass">Caption</span>
  <input type="text" autocomplete="off" placeholder="Optional" class="@EmbedToolbar.FieldClass min-w-0 flex-1"
         data-part="caption" />
</label>
