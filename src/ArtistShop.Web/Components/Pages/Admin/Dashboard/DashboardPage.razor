@using ArtistShop.Web.Components.Hints
@using ArtistShop.Web.Domain.Platform
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Pages.Admin.Catalog.WorkTypes
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Sites
@using Microsoft.AspNetCore.Authorization
@page "/admin"
@inject WorkTypeRepository WorkTypeRepository
@inject PlatformSettings PlatformSettings
@inject NavigationManager NavigationManager
@inject CurrentSite CurrentSite

@attribute [Authorize(Policy = SitePolicies.Admin)]

@code {
  [CascadingParameter]
  public SiteWording Wording { get; set; } = default!;

  private List<WorkType> _workTypes = [];

  protected override async Task OnInitializedAsync()
  {
    _workTypes = await WorkTypeRepository.GetAllAsync();
  }
}

<PageTitle>Admin</PageTitle>

<main class="@AdminPanel.WidthClass">
  <div class="grid gap-4 sm:grid-cols-2">
    <Panel Class="col-span-full">
      <h1 class="mb-2 text-lg font-bold">Admin Dashboard</h1>
      <Hint Type="HintType.AdminDashboard">
        <p class="mb-4">Welcome to your PictureCord website!</p>
        <p class="mb-4">
          Your catalog consists of <span class="font-bold">@Wording.Work.PluralInSentence</span> which can be described
          by <span class="font-bold">vocabularies</span> and grouped as <span
          class="font-bold">@Wording.Collection.PluralInSentence</span>. You may customize these terms <a
          class="@LinkStyles.InSentence" href="@PageUrls.Wording">here</a>.
        </p>
        <h3 class="font-bold">@Wording.Work.PluralHeading</h3>
        <p class="mb-4">
          <WorkTypeExamples /> You can
          define your own types <a class="@LinkStyles.InSentence" href="@PageUrls.NewWorkType">here</a>.
        </p>
        <h3 class="font-bold">Vocabularies and Terms</h3>
        <p class="mb-4">
          Vocabularies are facts about a certain type of @Wording.Work.SingularInSentence. A vocabulary such as "medium"
          might have terms like "acrylic", "oil" or "watercolor" and would describe a painting.
        </p>
        <h3 class="font-bold">@Wording.Collection.PluralHeading</h3>
        <p class="mb-4">
          Your defined groupings of @Wording.Work.PluralInSentence. A single @Wording.Work.SingularInSentence may belong
          to one or many @Wording.Collection.PluralInSentence.
        </p>
        <Divider class="mb-4" />
        If you are starting from scratch,
        <a class="underline" href="@PageUrls.AddWorksFromImages">start with "Add many".</a>
      </Hint>
      <Divider Class="my-2"></Divider>
      <ul class="list-none">
        <DashboardLink Href="@PageUrls.Hints">Toggle hints</DashboardLink>
      </ul>
    </Panel>
    <DashboardBox Title="Catalog">
      <ul>
        <DashboardLink Href="@PageUrls.NewWorkType">@Wording.Work.SingularHeading types</DashboardLink>
        <DashboardLink Href="@PageUrls.NewVocabulary">Vocabularies</DashboardLink>
        <DashboardLink Href="@PageUrls.CollectionList">@Wording.Collection.PluralHeading</DashboardLink>
        <DashboardLink Href="@PageUrls.CustomPageList">Pages</DashboardLink>
        <DashboardLink Href="@PageUrls.Wording">Wording</DashboardLink>
        <DashboardLink Href="@PageUrls.Theme">Theme</DashboardLink>
        <DashboardLink Href="@PageUrls.Branding">Branding</DashboardLink>
      </ul>
    </DashboardBox>

    <DashboardBox Title="@Wording.Work.PluralHeading">
      <ul class="mb-4">
        @if (_workTypes.Count == 0)
        {
          <li>
            <NoWorkTypesNote Class="text-sm" />
          </li>
        }
        else
        {
          <DashboardLink Href="@PageUrls.AddWork">Add one</DashboardLink>
          <DashboardLink Href="@PageUrls.AddWorksFromImages">Add many</DashboardLink>
        }
        <DashboardLink Href="@PageUrls.WorkList">Edit single</DashboardLink>
        <DashboardLink Href="@PageUrls.WorkTable">Edit many</DashboardLink>
      </ul>
    </DashboardBox>

    <DashboardBox Title="Publishing">
      <ul>
        <DashboardLink Href="@PageUrls.PostList">Posts</DashboardLink>
      </ul>
    </DashboardBox>

    <DashboardBox Title="Website">
      <ul>
        <AuthorizeView Policy="@SitePolicies.Owner">
          <Authorized>
            <DashboardLink Href="@PageUrls.SiteAdmins">Admins</DashboardLink>
          </Authorized>
        </AuthorizeView>
        <DashboardLink Href="@PageUrls.Import">Import</DashboardLink>
        <DashboardLink Href="@PageUrls.Export">Export</DashboardLink>
        @* deleting is on the platform, where My websites keeps it during the grace period *@
        <AuthorizeView Policy="@SitePolicies.Owner">
          <Authorized>
            <DashboardLink
              Href="@PageUrls.PlatformDeleteSite(NavigationManager.BaseUri, PlatformSettings.Host, CurrentSite.Id)">
              Delete website
            </DashboardLink>
          </Authorized>
        </AuthorizeView>
      </ul>
    </DashboardBox>
  </div>
</main>
