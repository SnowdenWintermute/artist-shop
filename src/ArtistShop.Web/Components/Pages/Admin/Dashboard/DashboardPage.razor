@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Pages.Admin.Catalog.ArtworkTypes
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Sites
@using Microsoft.AspNetCore.Authorization
@page "/admin"
@inject ArtworkTypeRepository ArtworkTypeRepository
@inject PlatformSettings PlatformSettings
@inject NavigationManager NavigationManager
@inject CurrentSite CurrentSite

@attribute [Authorize(Policy = SitePolicies.Admin)]

@code {
  private List<ArtworkType> _artworkTypes = [];

  protected override async Task OnInitializedAsync()
  {
    _artworkTypes = await ArtworkTypeRepository.GetAllAsync();
  }
}

<PageTitle>Admin</PageTitle>

<main class="@AdminPanel.WidthClass">
  <div class="grid gap-4 sm:grid-cols-2">
    <DashboardBox Title="Catalog">
      <ul>
        <DashboardLink Href="@PageUrls.SeriesList">Series</DashboardLink>
        <DashboardLink Href="@PageUrls.NewVocabulary">Vocabularies</DashboardLink>
        <DashboardLink Href="@PageUrls.NewArtworkType">Artwork types</DashboardLink>
      </ul>
    </DashboardBox>

    <DashboardBox Title="Artworks">
      <ul class="mb-4">
        <DashboardLink Href="@PageUrls.ArtworkList">Search and edit</DashboardLink>
        @if (_artworkTypes.Count == 0)
        {
          <li>
            <NoArtworkTypesNote Class="text-sm" />
          </li>
        }
        else
        {
          <AddArtworkLinks />
        }
      </ul>
    </DashboardBox>

    <DashboardBox Title="Publishing">
      <ul>
        <DashboardLink Href="@PageUrls.PostList">Posts</DashboardLink>
      </ul>
    </DashboardBox>

    <DashboardBox Title="Website">
      <ul>
        <AuthorizeView Policy="@SitePolicies.Owner">
          <Authorized>
            <DashboardLink Href="@PageUrls.SiteAdmins">Admins</DashboardLink>
          </Authorized>
        </AuthorizeView>
        <DashboardLink Href="@PageUrls.Import">Import</DashboardLink>
        <DashboardLink Href="@PageUrls.Export">Export</DashboardLink>
        @* deleting is on the platform, where My websites keeps it during the grace period *@
        <AuthorizeView Policy="@SitePolicies.Owner">
          <Authorized>
            <DashboardLink
              Href="@PageUrls.PlatformDeleteSite(NavigationManager.BaseUri, PlatformSettings.Host, CurrentSite.Id)">
              Delete website
            </DashboardLink>
          </Authorized>
        </AuthorizeView>
      </ul>
    </DashboardBox>
  </div>
</main>
