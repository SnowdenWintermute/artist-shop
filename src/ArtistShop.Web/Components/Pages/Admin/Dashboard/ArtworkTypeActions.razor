@using System.Globalization
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Forms
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Domain.Sites

@code {
  [Parameter, EditorRequired]
  public IReadOnlyList<ArtworkType> ArtworkTypes { get; set; } = default!;

  private List<(string Value, string Label)> TypeOptions =>
    [.. ArtworkTypes.Select(type => (type.Id.Value.ToString(CultureInfo.InvariantCulture), type.Name.Value))];
}

@* A GET form, so each button goes to its own page with the chosen type in the address, as
   ?type=3: formaction is the address a button submits to, in place of the form's own *@
<form method="get" data-enhance>
  <label class="mb-4 block">
    <span class="artist-shop-field-label">Artwork type</span>
    <RememberedSelect Name="type" InputName="@RememberedInputs.DashboardArtworkType" Options="TypeOptions"
                      Class="artist-shop-field-input w-full" />
  </label>

  <div class="flex flex-wrap gap-2">
    <ButtonBasic type="submit" formaction="/admin/catalog/artworks/add" Variant="ButtonVariant.Outline">
      Add one
    </ButtonBasic>
    <ButtonBasic type="submit" formaction="@PageUrls.ArtworkImport" Variant="ButtonVariant.Outline">
      <IconLabel Icon="csv">Import</IconLabel>
    </ButtonBasic>
    <ButtonBasic type="submit" formaction="/admin/catalog/artworks/images" Variant="ButtonVariant.Outline">
      <IconLabel Icon="folder-open">Upload images</IconLabel>
    </ButtonBasic>
  </div>
</form>
