@page "/posts"
@using ArtistShop.Web.Components.Lists
@using ArtistShop.Web.Components.Publishing
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Publishing
@inject PostRepository PostRepository
@inject NavigationManager NavigationManager

@code {
  [SupplyParameterFromQuery(Name = PageLinks.PageKey)]
  private string? PageValue { get; set; }

  private PostListPage? _page;

  // not OnInitializedAsync: turning a page is the same page with a new query parameter
  protected override async Task OnParametersSetAsync()
  {
    var pageNumber = PageLinks.ReadPageNumber(PageValue);
    var page = await PostRepository.GetPublishedPageAsync(pageNumber);

    // a link to a page that has since emptied, because posts were unpublished or deleted
    if (page.Items.Count == 0 && pageNumber > 1)
    {
      NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameter(PageLinks.PageKey, (int?)null));
      return;
    }

    _page = page;
  }
}

<PageTitle>Blog</PageTitle>
<LinkPreview Title="Blog" />

@* published posts only, admins included: drafts are on the admin post list *@
<main class="@($"mx-auto p-4 {PostColumn.WidthClass}")">
  <h1 class="mb-4">Blog</h1>

  @if (_page is { } page)
  {
    @if (page.Items.Count == 0)
    {
      <p>No posts yet.</p>
    }
    else
    {
      <ul>
        @foreach (var post in page.Items)
        {
          <BlogEntry @key="post.Id" Post="post" />
        }
      </ul>
    }

    <PageLinks PageNumber="page.PageNumber" PageCount="page.PageCount" PreviousText="← Newer" NextText="Older →" />
  }
</main>
