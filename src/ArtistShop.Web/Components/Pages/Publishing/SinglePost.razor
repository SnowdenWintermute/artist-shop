@page "/posts/{slug}"
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Catalog
@using ArtistShop.Web.Components.Publishing
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Publishing
@using ArtistShop.Web.Images
@using ArtistShop.Web.Publishing
@using ArtistShop.Web.Sites
@using Microsoft.AspNetCore.Authorization
@inject PostRepository PostRepository
@inject CustomPageRepository CustomPageRepository
@inject ImageStorage ImageStorage
@inject WorkRepository WorkRepository
@inject NavigationManager NavigationManager
@inject IAuthorizationService AuthorizationService

@code {
  [Parameter]
  public string Slug { get; set; } = default!;

  [CascadingParameter]
  private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

  private LoadedPost? _loaded;

  private record LoadedPost(Post Post, LoadedPostDocument Document, CustomPage BlogPage);

  protected override async Task OnParametersSetAsync()
  {
    var slug = new PostSlug(Slug);
    var user = (await AuthenticationState).User;

    // an admin reads a draft here before publishing it. To a visitor, a draft is the same
    // "not found" as a slug nobody has
    var isAdmin = (await AuthorizationService.AuthorizeAsync(user, SitePolicies.Admin)).Succeeded;
    var post = isAdmin
      ? await PostRepository.GetBySlugAsync(slug)
      : await PostRepository.GetPublishedBySlugAsync(slug);

    if (post is null)
    {
      NavigationManager.NotFound();
      return;
    }

    _loaded = new LoadedPost(
      post,
      await LoadedPostDocument.LoadAsync(post.Body, ImageStorage, WorkRepository),
      await CustomPageRepository.GetBlogAsync()
    );
  }
}

@if (_loaded is { } loaded)
{
  <PageTitle>@loaded.Post.Title.Value</PageTitle>
  <LinkPreview Title="@loaded.Post.Title.Value" />

  <main class="@($"mx-auto p-4 {PostColumn.WidthClass}")">
    <UpLink Class="mb-4" Href="@PageUrls.CustomPage(loaded.BlogPage)" Label="@loaded.BlogPage.Name" />

    @if (loaded.Post.PublishedAt is null)
    {
      <p class="mb-4 border border-rule bg-page px-3 py-2">
        Draft. Only admins can see this page until it's published.
      </p>
    }

    <div class="mb-6">
      <PageHeading Class="flex items-center justify-between text-3xl">
        @* min-w-0, since a flex item otherwise won't shrink below its longest word *@
        <span class="min-w-0 break-words">@loaded.Post.Title.Value</span>
        <AuthorizeView Policy="@SitePolicies.Admin">
          <Authorized>
            <a class="@($"font-text text-base {LinkStyles.InSentence}")" href="@PageUrls.EditPost(loaded.Post.Id)">Edit</a>
          </Authorized>
        </AuthorizeView>
      </PageHeading>

      @if (loaded.Post.PublishedAt is { } publishedAt)
      {
        <p class="text-ink-faded">
          <LocalDate Moment="publishedAt" />
        </p>
      }
    </div>

    <PostDocumentView Loaded="loaded.Document" />

  </main>
}
