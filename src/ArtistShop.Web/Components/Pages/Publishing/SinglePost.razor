@page "/posts/{slug}"
@using ArtistShop.Web.Components.Atoms
@using ArtistShop.Web.Components.Catalog
@using ArtistShop.Web.Components.Publishing
@using ArtistShop.Web.Database.Repositories
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Domain.Publishing
@using ArtistShop.Web.Identity
@using ArtistShop.Web.Images
@inject PostRepository PostRepository
@inject ImageStorage ImageStorage
@inject ArtworkRepository ArtworkRepository
@inject NavigationManager NavigationManager

@code {
  [Parameter]
  public string Slug { get; set; } = default!;

  [CascadingParameter]
  private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

  private LoadedPost? _loaded;

  private record LoadedPost(
    Post Post,
    PostDocument Document,
    IReadOnlyDictionary<string, ArtworkImageWithArtwork> ArtworkImages
  );

  protected override async Task OnParametersSetAsync()
  {
    var slug = new PostSlug(Slug);
    var user = (await AuthenticationState).User;

    // an admin reads a draft here before publishing it. To a visitor, a draft is the same
    // "not found" as a slug nobody has
    var post = user.IsInRole(RoleNames.Admin)
      ? await PostRepository.GetBySlugAsync(slug)
      : await PostRepository.GetPublishedBySlugAsync(slug);

    if (post is null)
    {
      NavigationManager.NotFound();
      return;
    }

    // The post's save refuses an uploaded image whose file is gone, but a post saved before that
    // check could still name one
    var document = PostImageFiles.WithoutMissing(PostDocumentParser.Parse(post.Body), ImageStorage);

    // every artwork embed's image in one query, however many the post has
    var artworkImages = await ArtworkRepository.GetImagesByStorageKeyAsync(
      [.. document.Blocks.OfType<ArtworkEmbedBlock>().Select(embed => embed.StorageKey).Distinct()]
    );

    _loaded = new LoadedPost(post, document, artworkImages);
  }
}

@if (_loaded is { } loaded)
{
  <PageTitle>@loaded.Post.Title.Value</PageTitle>
  <LinkPreview Title="@loaded.Post.Title.Value" />

  <main class="@($"mx-auto p-4 {PostColumn.WidthClass}")">
    @if (loaded.Post.PublishedAt is null)
    {
      <p class="mb-4 border border-theme-base bg-theme-recessed px-3 py-2">
        Draft. Only admins can see this page until it's published.
      </p>
    }

    <div class="mb-6">
      <h1 class="flex items-center justify-between text-3xl">
        @* min-w-0, since a flex item otherwise won't shrink below its longest word *@
        <span class="min-w-0 break-words">@loaded.Post.Title.Value</span>
        <AuthorizeView Roles="@RoleNames.Admin">
          <Authorized>
            <a class="text-base underline" href="@PageUrls.EditPost(loaded.Post.Id)">Edit</a>
          </Authorized>
        </AuthorizeView>
      </h1>

      @if (loaded.Post.PublishedAt is { } publishedAt)
      {
        <p class="text-gray-500"><LocalDate Moment="publishedAt" /></p>
      }
    </div>

    <PostDocumentView Document="loaded.Document" ArtworkImages="loaded.ArtworkImages" />
  </main>
}
