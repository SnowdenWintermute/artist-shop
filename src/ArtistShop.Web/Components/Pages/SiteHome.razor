@* a site's home page, which Home shows at / on a site's host: whichever custom page the artist made home *@
@using ArtistShop.Web.Components.CustomPages
@using ArtistShop.Web.Database.Repositories
@inject CustomPageRepository CustomPageRepository

@code {
  private CustomPage? _page;

  protected override async Task OnInitializedAsync() =>
    _page = await CustomPageRepository.GetHomeAsync();
}

@if (_page is { } page)
{
  <CustomPageView Page="page" />
}
