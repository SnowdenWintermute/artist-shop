@using ArtistShop.Web.Components.Atoms
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Google
@using Microsoft.AspNetCore.Identity
@using ArtistShop.Web.Identity
@using ArtistShop.Web.Sites

@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject CurrentHost CurrentHost

@* Only on the platform: Google returns only to the platform's /signin-google, the one address
   registered with it *@
@if (externalLogins.Length > 0)
{
  <section class="border-t pt-4">
    <form action="Account/PerformExternalLogin" method="post" class="flex flex-wrap gap-2">
      <AntiforgeryToken />
      <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
      @foreach (var provider in externalLogins)
      {
        <ButtonBasic type="submit" Variant="ButtonVariant.Outline" name="provider" value="@provider.Name">
          <span class="flex items-center gap-2">
            @* Google's own logo and wording, as its branding rules ask *@
            @if (provider.Name == GoogleDefaults.AuthenticationScheme)
            {
              <img src="@Assets["icons/google-logo.svg"]" alt="" class="size-5" />
            }
            Sign in with @provider.DisplayName
          </span>
        </ButtonBasic>
      }
    </form>
  </section>
}

@code {
    private AuthenticationScheme[] externalLogins = [];

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (CurrentHost is CurrentHost.Platform)
        {
            externalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).ToArray();
        }
    }
}
