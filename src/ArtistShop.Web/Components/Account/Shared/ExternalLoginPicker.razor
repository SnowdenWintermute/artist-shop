@using ArtistShop.Web.Components.Atoms
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using ArtistShop.Web.Identity

@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

@* nothing when no other service is set up, which is so far always *@
@if (externalLogins.Length > 0)
{
  <section class="border-t pt-4">
    <h2 class="mb-2 text-sm">Or log in with</h2>
    <form action="Account/PerformExternalLogin" method="post" class="flex flex-wrap gap-2">
      <AntiforgeryToken />
      <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
      @foreach (var provider in externalLogins)
      {
        <ButtonBasic type="submit" Variant="ButtonVariant.Outline" name="provider" value="@provider.Name"
                     title="@($"Log in using your {provider.DisplayName} account")">@provider.DisplayName</ButtonBasic>
      }
    </form>
  </section>
}

@code {
    private AuthenticationScheme[] externalLogins = [];

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        externalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).ToArray();
    }
}
