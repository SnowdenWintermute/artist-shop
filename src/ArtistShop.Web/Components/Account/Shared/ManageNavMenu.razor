@using Microsoft.AspNetCore.Identity
@using ArtistShop.Web.Identity

@inject SignInManager<ApplicationUser> SignInManager

<ul class="">
    <li class="">
        <NavLink class="" href="Account/Manage" Match="NavLinkMatch.All">Profile</NavLink>
    </li>
    <li class="">
        <NavLink class="" href="Account/Manage/Email">Email</NavLink>
    </li>
    <li class="">
        <NavLink class="" href="Account/Manage/ChangePassword">Password</NavLink>
    </li>
    @if (hasExternalLogins)
    {
        <li class="">
            <NavLink class="" href="Account/Manage/ExternalLogins">External logins</NavLink>
        </li>
    }
    <li class="">
        <NavLink class="" href="Account/Manage/TwoFactorAuthentication">Two-factor authentication</NavLink>
    </li>
    <li class="">
        <NavLink class="" href="Account/Manage/Passkeys">Passkeys</NavLink>
    </li>
    <li class="">
        <NavLink class="" href="Account/Manage/PersonalData">Personal data</NavLink>
    </li>
</ul>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}
