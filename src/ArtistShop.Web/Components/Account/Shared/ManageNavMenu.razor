@using Microsoft.AspNetCore.Identity
@using ArtistShop.Web.Identity

@inject SignInManager<ApplicationUser> SignInManager

@* links for AdminPanel's section nav, which lays them out *@
<NavLink href="Account/Manage" Match="NavLinkMatch.All" ActiveClass="underline">Profile</NavLink>
<NavLink href="Account/Manage/Email" ActiveClass="underline">Email</NavLink>
<NavLink href="Account/Manage/ChangePassword" ActiveClass="underline">Password</NavLink>
@if (hasExternalLogins)
{
    <NavLink href="Account/Manage/ExternalLogins" ActiveClass="underline">External logins</NavLink>
}
<NavLink href="Account/Manage/PersonalData" ActiveClass="underline">Personal data</NavLink>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}
