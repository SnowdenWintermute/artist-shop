@using ArtistShop.Web.Identity
@using ArtistShop.Web.Utilities

@inject PasswordResetLinks PasswordResetLinks
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

@* No form here takes a new password: the emailed link's page does, so someone at a signed-in browser
   can't change it without the inbox too. Also how an account with no password gets one *@

@code {
  [Parameter, EditorRequired]
  public ApplicationUser Account { get; set; } = default!;

  [CascadingParameter]
  private HttpContext HttpContext { get; set; } = default!;

  private async Task SendLinkAsync()
  {
    var sent = await PasswordResetLinks.SendAsync(Account, new Uri(NavigationManager.BaseUri), Requester.Of(HttpContext));

    // a redirect, so refreshing the browser doesn't send another email
    RedirectManager.RedirectToCurrentPageWithStatus(
      sent ? $"We've sent a link to {Account.Email}." : "Error: we can't send another link right now. Try again in a while.",
      HttpContext
    );
  }
}

<DashboardBox Title="Password">
  <p class="mb-4 text-sm">We'll email you a link to change it. Changing it signs you out everywhere.</p>

  <form method="post" @formname="email-password-link" @onsubmit="SendLinkAsync">
    <AntiforgeryToken />
    <ButtonBasic type="submit" Variant="ButtonVariant.Outline">Email me a link</ButtonBasic>
  </form>
</DashboardBox>
