@page "/Account/ExternalLogin"

@using ArtistShop.Web.Identity
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity

@inject SignInManager<ApplicationUser> SignInManager
@inject ExternalAccounts ExternalAccounts
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ExternalLogin> Logger

@* Where a provider such as Google sends someone back, by way of its handler's /signin-google. Always
   redirects: signed in, with the login put on the account with the provider's verified email (or a
   new one) the first time, or back to sign-in with why not *@

@code {
    public const string LoginCallbackAction = "LoginCallback";

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? RemoteError { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private string? Action { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (RemoteError is not null)
        {
            RedirectManager.RedirectToWithStatus("Account/Login", $"Error from the sign-in service: {RemoteError}", HttpContext);
            return;
        }

        var login = await SignInManager.GetExternalLoginInfoAsync();

        // only reached from the provider, which leaves its login in the external cookie
        if (login is null || Action != LoginCallbackAction)
        {
            RedirectManager.RedirectToWithStatus("Account/Login", "Error: the sign-in service's answer was lost. Try again.", HttpContext);
            return;
        }

        var result = await SignInAsync(login);

        // Failed with no other reason: no account has this login yet. Two-factor is bypassed, and an
        // account with a login is always confirmed, so it's never RequiresTwoFactor or IsNotAllowed
        if (!result.Succeeded && !result.IsLockedOut)
        {
            var added = await ExternalAccounts.AddLoginAsync(login);

            if (added is ExternalAccountResult.NoVerifiedEmail)
            {
                await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
                RedirectManager.RedirectToWithStatus(
                    "Account/Login",
                    $"Error: {login.ProviderDisplayName} didn't give a verified email address, so it can't sign you in.",
                    HttpContext
                );
                return;
            }

            Logger.LogInformation("Added a {LoginProvider} login to an account.", login.LoginProvider);
            result = await SignInAsync(login);
        }

        if (result.IsLockedOut)
        {
            RedirectManager.RedirectTo("Account/Lockout");
            return;
        }

        if (!result.Succeeded)
        {
            throw new InvalidOperationException($"Signing in with the {login.LoginProvider} login just added failed: {result}.");
        }

        RedirectManager.RedirectTo(ReturnUrl);
    }

    // also signs out the external cookie once it succeeds
    private Task<SignInResult> SignInAsync(ExternalLoginInfo login) =>
        SignInManager.ExternalLoginSignInAsync(login.LoginProvider, login.ProviderKey, isPersistent: false, bypassTwoFactor: true);
}
