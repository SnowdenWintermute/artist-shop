@using ArtistShop.Web.Components.Pages.Catalog
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Domain.Publishing

@code {
  [Parameter, EditorRequired]
  public WorkEmbedBlock Embed { get; set; } = default!;

  // the image the embed names, read now, so the title and picture are the work's current ones
  [Parameter, EditorRequired]
  public WorkImageWithWork Source { get; set; } = default!;
}

@* The link opens the work's page at this very image *@
<EmbedFigure Layout="Embed.Layout" Size="Embed.Size" StorageKey="@Source.Image.StorageKey"
             Alt="@Source.Work.Name.Value" ImageWidth="Source.Image.Width" ImageHeight="Source.Image.Height"
             BlurDataUri="@Source.Image.BlurDataUri" Caption="@Embed.Caption"
             Href="@WorkPageQuery.Url(Source.Work.Slug.Value, collectionSlug: null, Source.ImageNumber)"
             OpensLightbox="false" />
