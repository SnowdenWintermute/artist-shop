@using ArtistShop.Web.Components.Dialogs
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Domain.Publishing

@code {
  [Parameter, EditorRequired]
  public PostDocument Document { get; set; } = default!;

  // the images the work embeds name, by storage key, loaded together by the page
  [Parameter, EditorRequired]
  public IReadOnlyDictionary<string, WorkImageWithWork> WorkImages { get; set; } = default!;

  private bool HasLightboxImages =>
    Document.Blocks.OfType<PostImageEmbedBlock>().Any(PostImageEmbedView.OpensLightbox);
}

@* Spacing follows the editor, where every line sits directly below the last and a gap is an
   empty line the artist left. whitespace-pre-wrap keeps runs of spaces, as the editor does.
   flow-root keeps a floated embed inside the post, rather than hanging below its end.
   break-words is the editor's own word-wrap, so a word too long for the line breaks here too.
   <post-document>, from PostDocumentView.razor.js, opens the lightbox on the images that do,
   stepping through all of them *@
<post-document class="mb-4 block">
<div class="flow-root break-words whitespace-pre-wrap">
  @foreach (var block in Document.Blocks)
  {
    @switch (block)
    {
      case ParagraphBlock paragraph:
        <p><PostInlineText Text="paragraph.Text" /></p>
        break;

      case HeadingBlock { Level: HeadingLevel.Two } heading:
        <h2 class="text-2xl font-bold"><PostInlineText Text="heading.Text" /></h2>
        break;

      case HeadingBlock heading:
        <h3 class="text-lg font-bold"><PostInlineText Text="heading.Text" /></h3>
        break;

      case BlockquoteBlock quote:
        <blockquote class="border-l-4 border-gray-300 pl-4"><PostInlineText Text="quote.Text" /></blockquote>
        break;

      case ListBlock { Style: ListStyle.Bullet } list:
        <ul class="list-disc pl-6">
          @foreach (var item in list.Items)
          {
            <li><PostInlineText Text="item" /></li>
          }
        </ul>
        break;

      case ListBlock list:
        <ol class="list-decimal pl-6">
          @foreach (var item in list.Items)
          {
            <li><PostInlineText Text="item" /></li>
          }
        </ol>
        break;

      case WorkEmbedBlock embed when WorkEmbeds.SourceOf(embed, WorkImages) is { } source:
        <WorkEmbedView Embed="embed" Source="source" />
        break;

      case PostImageEmbedBlock image:
        <PostImageEmbedView Embed="image" />
        break;

      case VideoEmbedBlock video:
        <VideoEmbedView Embed="video" />
        break;
    }
  }
</div>

@if (HasLightboxImages)
{
  <ImageLightbox />
}
</post-document>
