@using System.Globalization
@using ArtistShop.Web.Components.Dialogs
@using ArtistShop.Web.Domain.Publishing
@using ArtistShop.Web.Images

@code {
  // the editor's toolbars hand this to the editor, so a caption looks the same while writing
  public const string CaptionClass = "pt-1 text-sm text-gray-500";

  [Parameter, EditorRequired]
  public EmbedLayout Layout { get; set; }

  [Parameter, EditorRequired]
  public EmbedImageSize Size { get; set; }

  [Parameter, EditorRequired]
  public string StorageKey { get; set; } = default!;

  [Parameter, EditorRequired]
  public string Alt { get; set; } = default!;

  // the image's own size, for its shape
  [Parameter, EditorRequired]
  public int ImageWidth { get; set; }

  [Parameter, EditorRequired]
  public int ImageHeight { get; set; }

  [Parameter, EditorRequired]
  public string? BlurDataUri { get; set; }

  [Parameter, EditorRequired]
  public string? Caption { get; set; }

  // null for an image that goes nowhere when clicked
  [Parameter, EditorRequired]
  public string? Href { get; set; }

  // a click opens the lightbox, which copies the image's srcset to pick a wider file from
  [Parameter, EditorRequired]
  public bool OpensLightbox { get; set; }

  // sharp on a 2x screen, without a 3x phone fetching more still
  private const int MaximumPixelRatio = 2;

  private int Width => ImageVariants.EmbedWidth(Size);

  // written on the img so the page keeps the image's room while it loads, rather than jumping
  private int Height => (int)Math.Round((double)Width * ImageHeight / ImageWidth);

  // the size's own file, or the image's when it's narrower, for a browser that ignores srcset
  private string Src => ImageUrls.Variant(StorageKey, ImageWidth, Width, ImageVariantFormat.Avif);

  // Every file the browser may pick from for the screen it's on: up to the first as wide as a 2x
  // screen needs, since there may be no variant at exactly that width. A lightbox needs them all,
  // up to the widest it shows
  private string SourceSet =>
    ImageUrls.SourceSet(
      StorageKey,
      ImageWidth,
      OpensLightbox
        ? ImageVariants.MainImageWidth
        : ImageVariants.Widths.First(width => width >= Width * MaximumPixelRatio),
      ImageVariantFormat.Avif
    );

  // the tiny blurred copy saved with the image, shown behind it until it arrives
  private string BlurStyle => BlurDataUri is { } blurDataUri ? $"background-image: url({blurDataUri});" : "";
}

@* An image embed in a post, placed as it was in the editor, from the same EmbedLayoutClasses. The
   figure is the size's width, so a caption wraps under the image rather than widening it, and the
   image fills it, stretched if the file is narrower *@
<div class="@EmbedLayoutClasses.For(Layout)">
  <figure class="max-w-full" style="@($"width: {Width.ToString(CultureInfo.InvariantCulture)}px;")">
    @if (Href is not null)
    {
      <a href="@Href" class="block">@Image</a>
    }
    else if (OpensLightbox)
    {
      <LightboxTrigger>@Image</LightboxTrigger>
    }
    else
    {
      @Image
    }
    @if (Caption is not null)
    {
      <figcaption class="@CaptionClass">@Caption</figcaption>
    }
  </figure>
</div>

@code {
  private RenderFragment Image =>
    @<img src="@Src" srcset="@SourceSet" sizes="@($"{Width.ToString(CultureInfo.InvariantCulture)}px")"
          alt="@Alt" width="@Width.ToString(CultureInfo.InvariantCulture)"
          height="@Height.ToString(CultureInfo.InvariantCulture)" loading="lazy"
          class="block h-auto w-full bg-cover bg-center" style="@BlurStyle" />;
}
