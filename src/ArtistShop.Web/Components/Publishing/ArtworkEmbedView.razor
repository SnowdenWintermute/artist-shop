@using ArtistShop.Web.Components.Pages.Catalog
@using ArtistShop.Web.Domain.Catalog
@using ArtistShop.Web.Domain.Publishing

@code {
  [Parameter, EditorRequired]
  public ArtworkEmbedBlock Embed { get; set; } = default!;

  // the image the embed names, read now, so the title and picture are the artwork's current ones
  [Parameter, EditorRequired]
  public ArtworkImageWithArtwork Source { get; set; } = default!;
}

@* The link opens the artwork's page at this very image *@
<EmbedFigure Layout="Embed.Layout" Size="Embed.Size" StorageKey="@Source.Image.StorageKey"
             Alt="@Source.Artwork.Name.Value" ImageWidth="Source.Image.Width" ImageHeight="Source.Image.Height"
             BlurDataUri="@Source.Image.BlurDataUri" Caption="@Embed.Caption"
             Href="@ArtworkPageQuery.Url(Source.Artwork.Slug.Value, seriesSlug: null, Source.ImageNumber)"
             OpensLightbox="false" />
