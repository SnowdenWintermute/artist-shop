@using ArtistShop.Web.Domain.Publishing
@using ArtistShop.Web.Images

@code {
  [Parameter, EditorRequired]
  public UploadedImageEmbedBlock Embed { get; set; } = default!;

  [Parameter, EditorRequired]
  public UploadedImage Image { get; set; } = default!;

  // as the artist checked it, and only when there's a wider version than the size shows: a
  // lightbox would otherwise just blow up the same file
  public static bool OpensLightbox(UploadedImageEmbedBlock embed, UploadedImage image) =>
    embed.OpensLightbox && ImageVariants.LargestWidthFor(image.Width) > ImageVariants.EmbedWidth(embed.Size);
}

<EmbedFigure Layout="Embed.Layout" Size="Embed.Size" StorageKey="@Embed.StorageKey" Alt="@Image.AltText"
             ImageWidth="Image.Width" ImageHeight="Image.Height" BlurDataUri="@Image.BlurDataUri"
             Caption="@Embed.Caption" Href="@null" OpensLightbox="OpensLightbox(Embed, Image)" />
