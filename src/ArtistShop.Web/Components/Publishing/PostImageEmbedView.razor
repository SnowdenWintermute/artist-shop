@using ArtistShop.Web.Domain.Publishing
@using ArtistShop.Web.Images

@code {
  [Parameter, EditorRequired]
  public PostImageEmbedBlock Embed { get; set; } = default!;

  // as the artist ticked it, and only when there's a wider version than the size shows: a
  // lightbox would otherwise just blow up the same file
  public static bool OpensLightbox(PostImageEmbedBlock embed) =>
    embed.OpensLightbox && ImageVariants.LargestWidthFor(embed.Width) > ImageVariants.EmbedWidth(embed.Size);
}

<EmbedFigure Layout="Embed.Layout" Size="Embed.Size" StorageKey="@Embed.StorageKey" Alt="@Embed.Alt"
             ImageWidth="Embed.Width" ImageHeight="Embed.Height" BlurDataUri="@Embed.BlurDataUri"
             Caption="@Embed.Caption" Href="@null" OpensLightbox="OpensLightbox(Embed)" />
