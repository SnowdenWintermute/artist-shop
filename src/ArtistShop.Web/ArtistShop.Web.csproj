<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ArtistShop.Web</RootNamespace>
    <AssemblyName>$(AssemblyName.Replace(' ', '_'))</AssemblyName>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- dotnet watch builds the path to staticwebassets.development.json by pasting this
         property in front of it, and never normalises the separator, so the SDK default of
         'obj\' sends it looking for 'obj\Debug/net10.0/...' on linux. It cannot read the
         manifest, so it silently stops pushing static asset updates to the browser and
         regenerated tailwind css only lands on a reload. -->
    <BaseIntermediateOutputPath>obj/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <Target Name="BuildTailwindCss" BeforeTargets="ResolveStaticWebAssetsInputs">
    <Exec Command="../../tailwindcss -i Styles/app.css -o wwwroot/app.css" />
  </Target>

</Project>
