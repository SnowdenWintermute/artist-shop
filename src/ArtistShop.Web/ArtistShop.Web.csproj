<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ArtistShop.Web</RootNamespace>
    <AssemblyName>$(AssemblyName.Replace(' ', '_'))</AssemblyName>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- dotnet watch builds the path to staticwebassets.development.json by pasting this
      property in front of it, and never normalises the separator, so the SDK default of
      'obj\' sends it looking for 'obj\Debug/net10.0/...' on linux. It cannot read the
      manifest, so it silently stops pushing static asset updates to the browser and
    regenerated tailwind css only lands on a reload. -->
    <BaseIntermediateOutputPath>obj/</BaseIntermediateOutputPath>

    <!-- The SDK only downloads the package holding _framework/blazor.web.js when restore sees a
      .razor file. The Dockerfile restores from this file alone, before the source is copied in,
      so without this the published app has no Blazor script. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>

    <!-- A switch expression over an enum raises two different warnings. CS8509 names a member of
      the enum that no arm handles, which is the one worth having: it turns a forgotten case into a
      build failure. CS8524 complains that integers with no name in the enum, like (DatePrecision)7,
      aren't handled either; an arm for those is only ever dead code, and adding "_ => throw" to
      silence it takes CS8509 away with it. So CS8524 is off and CS8509 is an error. A value that
      genuinely can't happen still throws, now as SwitchExpressionException. -->
    <NoWarn>$(NoWarn);CS8524</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors);CS8509</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BlazorBlueprint.Primitives" Version="3.16.1" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="dbup-postgresql" Version="7.0.1" />
    <!-- EF Core and Identity stay on 10.0 under .NET 11 RC1: Npgsql's EF provider 11.0.0-rc.1 pins
         an EF Core build nuget.org doesn't have (npgsql/efcore.pg#3913). Move these to 11 with it -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NetVips" Version="3.2.0" />
    <PackageReference Include="NetVips.Native.linux-x64" Version="8.18.6" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Sylvan.Data.Csv" Version="1.4.4" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Database/**/*.sql" />
    <EmbeddedResource Include="Database/**/*.sql" />
  </ItemGroup>
  <Target Name="BuildTailwindCss" BeforeTargets="ResolveProjectStaticWebAssets">
    <Exec Command="../../tailwindcss -i Styles/app.css -o wwwroot/app.css" />
    <!-- ResolveProjectStaticWebAssets reads wwwroot's files from Content, which was filled before
      any target ran. On a clean checkout (like the Docker build) app.css didn't exist yet, so it
      has to be added once it does, unless an earlier build's copy was already listed -->
    <ItemGroup>
      <Content Include="wwwroot/app.css" Exclude="@(Content)" />
    </ItemGroup>
  </Target>

</Project>
