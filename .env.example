# Copy to .env (gitignored) and set a real password.
#
# Avoid ; and " -- they terminate and quote values in the connection strings env.sh assembles
# from this.
#
# This is only read the first time the container initialises a new volume. After that the password
# lives in the database: changing it here silently does nothing and logins start failing. The same
# goes for POSTGRES_APP_PASSWORD below. To
# actually change it, either ALTER USER postgres PASSWORD '...' inside Postgres, or throw the data
# away with `docker compose down -v` and let it initialise again.
POSTGRES_PASSWORD=
# the password of artist_shop_app, the role the app logs in as. Also read only when a new volume is
# set up (postgres-init/create-app-role.sh); change it afterwards with ALTER ROLE artist_shop_app
POSTGRES_APP_PASSWORD=
# the dev account's password: the platform operator, and owner of the dev sites; env.sh passes it
# on as Platform__OperatorPassword
DEV_OWNER_PASSWORD=
