# Copy to .env (gitignored) and set a real password.
#
# Avoid ; and " -- they terminate and quote values in the connection strings env.sh assembles
# from this.
#
# This is only read the first time the container initialises a new volume. After that the password
# lives in the database: changing it here silently does nothing and logins start failing. To
# actually change it, either ALTER USER postgres PASSWORD '...' inside Postgres, or throw the data
# away with `docker compose down -v` and let it initialise again.
POSTGRES_PASSWORD=
# the dev admin account's password; env.sh passes it on as Admin__Password
DEV_ADMIN_PASSWORD=
